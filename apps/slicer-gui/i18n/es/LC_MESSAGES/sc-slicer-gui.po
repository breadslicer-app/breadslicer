#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "What the app did in this session: steps, times and errors, without models, file names or anything you typed."
msgstr "Lo que hizo la app en esta sesión: pasos, tiempos y errores, sin modelos, nombres de archivo ni nada de lo que escribiste."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "The logs saved on this computer: crash reports, and the diagnostic log if you turned it on."
msgstr "Los registros guardados en esta computadora: los reportes de cierres inesperados y, si lo activaste, el registro de diagnóstico."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "The app version, the system, the graphics card and the screens."
msgstr "La versión de la app, el sistema, la placa de video y las pantallas."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Your preferences, without folders."
msgstr "Tus preferencias, sin carpetas."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "The scene in numbers: models, triangles, supports and hollowing."
msgstr "La escena en números: modelos, triángulos, soportes y ahuecado."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Your user name and your user folder are replaced in every file."
msgstr "Tu nombre de usuario y tu carpeta de usuario se reemplazan en todos los archivos."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Include the scene's models (.bread)"
msgstr "Incluir los modelos de la escena (.bread)"

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Breadslicer never sends us anything. The file stays on your computer, and only reaches us if you send it yourself."
msgstr "Breadslicer nunca nos envía nada. El archivo queda en tu computadora y solo nos llega si nos lo mandás vos."

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Cancel"
msgstr "Cancelar"

#: ui/message-layer.slint
msgctxt "DiagnosticsDialog"
msgid "Save…"
msgstr "Guardar…"

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "Save a diagnostic log?"
msgstr "¿Guardar un registro de diagnóstico?"

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "Until you close Breadslicer, closing included, it writes what it does to the logs folder on this computer: steps, times and errors, without models, file names or anything you type."
msgstr "Hasta que cierres Breadslicer, cierre incluido, anota lo que hace en la carpeta de registros de esta computadora: pasos, tiempos y errores, sin modelos, nombres de archivo ni nada de lo que escribas."

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "The next time you open Breadslicer, the log turns off by itself."
msgstr "La próxima vez que abras Breadslicer, el registro se apaga solo."

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "Breadslicer never sends us anything. The log stays on your computer, and only reaches us if you send it yourself."
msgstr "Breadslicer nunca nos envía nada. El registro queda en tu computadora y solo nos llega si nos lo mandás vos."

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "Cancel"
msgstr "Cancelar"

#: ui/message-layer.slint
msgctxt "DiagnosticLogDialog"
msgid "Turn on"
msgstr "Activar"

#: src/diagnostics/mod.rs
msgctxt "FileDialog"
msgid "ZIP files"
msgstr "Archivos ZIP"

#: src/diagnostics/mod.rs
msgctxt "DiagnosticsDialog"
msgid "Could not export the diagnostics"
msgstr "No se pudo exportar el diagnóstico"

#: src/diagnostics/mod.rs
msgctxt "DiagnosticsDialog"
msgid "Diagnostics saved"
msgstr "Diagnóstico guardado"

#: src/diagnostics/mod.rs
#, rust-format
msgctxt "DiagnosticsDialog"
msgid "Attach {} to your bug report. Nothing was sent: Breadslicer never sends us anything by itself."
msgstr "Adjuntá {} a tu reporte de error. No se envió nada: Breadslicer nunca nos envía nada por su cuenta."

#: ui/main-window.slint
msgctxt "MenuBar"
msgid "Previous Versions…"
msgstr "Versiones anteriores…"

#: src/wiring.rs
msgctxt "FileDialog"
msgid "Previous versions"
msgstr "Versiones anteriores"

#: src/error_dialog.rs
msgctxt "RecoveryDialog"
msgid "Breadslicer closed without saving"
msgstr "Breadslicer se cerró sin guardar"

#: src/error_dialog.rs
msgctxt "RecoveryDialog"
msgid "These scenes had unsaved changes. Recover them to keep working on them, or discard them."
msgstr "Estas escenas tenían cambios sin guardar. Recuperalas para seguir trabajando en ellas, o descartalas."

#: ui/message-layer.slint
msgctxt "RecoveryDialog"
msgid "Discard"
msgstr "Descartar"

#: ui/message-layer.slint
msgctxt "RecoveryDialog"
msgid "Recover"
msgstr "Recuperar"

#: src/preferences_window/mod.rs
#, rust-format
msgctxt "PrivacyPreferences"
msgid "The diagnostic log could not start: {}"
msgstr "El registro de diagnóstico no pudo empezar: {}"

#: src/hollow_run.rs
#, rust-format
msgctxt "HollowRun"
msgid "Drain not drilled"
msgid_plural "{n} drains not drilled"
msgstr[0] "Drenaje sin perforar"
msgstr[1] "{n} drenajes sin perforar"

#: src/hollow_run.rs
#, rust-format
msgctxt "HollowRun"
msgid "This drain does not reach the cavity, so it was left out: drilled, it would only bore into the model, or through it. Place it where the cavity preview shows behind the wall."
msgid_plural "These drains do not reach the cavity, so they were left out: drilled, they would only bore into the model, or through it. Place them where the cavity preview shows behind the wall."
msgstr[0] "Este drenaje no llega a la cavidad, así que se quitó: perforado, solo entraría en el modelo o lo atravesaría. Ponelo donde la vista previa de la cavidad se ve detrás de la pared."
msgstr[1] "Estos drenajes no llegan a la cavidad, así que se quitaron: perforados, solo entrarían en el modelo o lo atravesarían. Ponelos donde la vista previa de la cavidad se ve detrás de la pared."
