msgctxt "Workspace"
msgid "Hollow"
msgstr "Ahuecar"

#: ui/main-window.slint
msgctxt "Workspace"
msgid "Supports"
msgstr "Soportes"

#: ui/main-window.slint
msgctxt "Workspace"
msgid "Hollowing is on its way; supports can be generated before or after it."
msgstr "El ahuecado está en camino; los soportes se pueden generar antes o después."

#: ui/main-window.slint
msgctxt "Workspace"
msgid "Export"
msgstr "Exportar"

#: ui/main-window.slint
msgctxt "Workspace"
msgid "The printer file uses the printer and resin in force."
msgstr "El archivo de impresora usa la impresora y la resina elegidas."

