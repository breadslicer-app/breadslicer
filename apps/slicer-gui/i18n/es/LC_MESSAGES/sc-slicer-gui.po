msgctxt "Inspector"
msgid "PRINTER FILE"
msgstr "ARCHIVO DE IMPRESORA"

#: ui/workspace/inspectors.slint
msgctxt "Inspector"
msgid "Slice first: the printer file is written from the held slice."
msgstr "Laminá primero: el archivo de impresora se escribe a partir del laminado actual."

#: ui/workspace/inspectors.slint
msgctxt "Inspector"
msgid "ALSO"
msgstr "TAMBIÉN"

