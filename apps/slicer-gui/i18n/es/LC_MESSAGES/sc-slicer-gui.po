msgid "DRAINS"
msgstr "DRENAJES"

#: ui/workspace/inspectors.slint
msgctxt "Inspector"
msgid "Placing drains (D)"
msgstr "Poniendo drenajes (D)"

#: ui/workspace/inspectors.slint
msgctxt "Inspector"
msgid "Place drains (D)"
msgstr "Poner drenajes (D)"

#: ui/workspace/inspectors.slint
msgctxt "Inspector"
msgid "Drain radius"
msgstr "Radio del drenaje"

