import { Theme } from "kit/theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";
import { ScButton as Button, ScCheckBox as CheckBox, ScLineEdit as LineEdit } from "kit/controls.slint";
import { ThemePreference } from "preferences/appearance.slint";

// A calibration block of the source: the generic machine's, or the block of the
// printer named `printer-name`.
export struct ForkBlock {
    generic: bool,
    printer-name: string,
}

// Fork dialog: names the new profile and picks which parts of the source it
// carries over (intent, defaults, and any of the source's own calibration
// blocks; every part starts selected). This component only reports the choices;
// the fork itself is assembled in Rust.
export component ForkDialog inherits Window {
    // The app's own surface, not the platform style's (#507).
    background: Theme.panel;
    title: @tr("ForkDialog" => "Fork resin profile");
    icon: @image-url("../assets/images/breadslicer.png");
    default-font-family: "Noto Sans";

    in-out property <ThemePreference> theme: ThemePreference.System;

    in property <string> source-name;
    in-out property <string> fork-name;
    in-out property <string> fork-brand;
    in-out property <bool> copy-intent: true;
    in-out property <bool> copy-defaults: true;
    // The source's calibration blocks, 1 checkbox each. Their checked state
    // lives on the Rust side, updated through `block-toggled`; every block
    // starts selected.
    in property <[ForkBlock]> blocks;
    in property <string> error-message;

    callback block-toggled(int, bool);
    callback confirm-requested();
    callback cancel-requested();

    min-width: 420px;
    preferred-width: 460px;
    min-height: 280px;
    preferred-height: 420px;

    forward-focus: name-input;

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    // External updates (the caller's prefill) must be pushed back into the
    // LineEdit explicitly: its text binding breaks the first time the user
    // types.
    changed fork-name => {
        name-input.text = root.fork-name;
    }

    changed fork-brand => {
        brand-input.text = root.fork-brand;
    }

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: @tr("ForkDialog" => "Fork {}", root.source-name);
                font-size: Theme.font-lg;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }

            GridLayout {
                spacing: 8px;

                Row {
                    Text {
                        text: @tr("ForkDialog" => "Brand");
                        font-size: Theme.font-sm;
                        color: Theme.text.transparentize(0.3);
                        vertical-alignment: center;
                    }
                    brand-input := LineEdit {
                        text: root.fork-brand;
                        horizontal-stretch: 1;
                        edited(t) => {
                            root.fork-brand = t;
                        }
                    }
                }
                Row {
                    Text {
                        text: @tr("ForkDialog" => "Name");
                        font-size: Theme.font-sm;
                        color: Theme.text.transparentize(0.3);
                        vertical-alignment: center;
                    }
                    name-input := LineEdit {
                        text: root.fork-name;
                        horizontal-stretch: 1;
                        edited(t) => {
                            root.fork-name = t;
                        }
                    }
                }
            }

            Text {
                text: @tr("ForkDialog" => "Copy from the source:");
                font-size: Theme.font-sm;
                color: Theme.text.transparentize(0.3);
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 6px;
                    alignment: start;

                    CheckBox {
                        text: @tr("ForkDialog" => "Intent");
                        checked <=> root.copy-intent;
                    }
                    CheckBox {
                        text: @tr("ForkDialog" => "Defaults");
                        checked <=> root.copy-defaults;
                    }
                    for block[index] in root.blocks: CheckBox {
                        text: @tr(
                            "ForkDialog" => "Calibration: {}",
                            block.generic ? @tr("ForkDialog" => "Generic") : block.printer-name
                        );
                        checked: true;
                        toggled => {
                            root.block-toggled(index, self.checked);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.error-message;
                    color: Theme.danger;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("ForkDialog" => "Create");
                    primary: true;
                    clicked => {
                        root.confirm-requested();
                    }
                }
                Button {
                    text: @tr("ForkDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
