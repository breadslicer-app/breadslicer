// The right-hand inspector of each workflow tab (BS-68). Each component
// shows only what its tab acts on; the window binds them to its own
// properties and callbacks, which Rust drives.

import { ScrollView } from "std-widgets.slint";
import { ScCheckBox as CheckBox, ScComboBox as ComboBox, ScLineEdit as LineEdit, ScProgress as ProgressIndicator, ScSlider as Slider } from "../kit/controls.slint";
import { Theme } from "../kit/theme.slint";
import { Icons } from "../kit/icons.slint";
import { HandToolButton, OwnPresets, PageTabs, PartHead, PresetCard, PresetCards, ScopeBox, ShapeCallout, ShapeField, ShapeSize, ShapeViewer, SizeChips, ZoneRow, ZoneRowView } from "support-shape.slint";
import { LayerTimeline, TimelineMark } from "layer-timeline.slint";
import { ButtonKind, Card, DisclosureChevron, Dot, Icon, InfoRow, LabeledRow, Note, NumberField, ScButton, Segmented, StatTile, WarningNote } from "../kit/controls.slint";

// One finding of the slice review (#90), as Rust lays it out.
export struct ReviewRow {
    // The finding's index in the review, for the callbacks.
    id: int,
    // 0 error, 1 warning, 2 information.
    severity: int,
    // The group heading on the first row of a severity, else empty.
    header: string,
    title: string,
    // "Layer 12" or "Layers 11–25".
    layers: string,
    // One sentence with the numbers.
    detail: string,
    // 0 none, 1 add a support, 2 add a drain, 4 lift the model clear of the
    // raft or turn the raft off.
    fix: int,
    // The fix was applied since the slice.
    fixed: bool,
    // A cavity that can be cured on the next slice (#132): 0 no fill, 1
    // offered, 2 marked to fill.
    fill: int,
    // The resin a fill cures ("0.67 ml"), or empty.
    fill-resin: string,
    // A tiny cavity that can be left alone (hidden until the scene changes).
    leave: bool,
    // The lift button of fix 4 ("Lift 17 layers").
    lift-label: string,
    // A small island no support reaches (#462): 0 nothing, 1 can be deleted
    // from the print, 2 marked to delete, 3 deleted by this slice (its note).
    delete: int,
    // What deleting it takes: "12 layers · 0.70 mm²".
    delete-size: string,
    // A suction cup: its model can be turned with the Orient tool (#128).
    turn: bool,
    // After Fix All (#156): why it left this finding, else empty.
    remains: string,
}

// The colour of a review severity.
global ReviewTint {
    public pure function of(severity: int) -> brush {
        return severity == 0 ? Theme.danger : severity == 1 ? Theme.warning : Theme.text-muted;
    }
}

// A selectable object row.
component ObjectRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    // Shift+click or Ctrl+click (#13).
    callback toggled();
    property <bool> extend: false;

    height: 30px;
    border-radius: Theme.radius;
    background: self.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
    accessible-role: list-item;
    accessible-label: self.text;
    accessible-item-selected: self.selected;
    accessible-action-default => {
        self.clicked();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: root.selected ? Theme.selection : transparent;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.extend = event.modifiers.shift || event.modifiers.control || event.modifiers.meta;
            }
        }
        clicked => {
            if (root.extend) {
                root.toggled();
            } else {
                root.clicked();
            }
        }
    }
}

// A paragraph indented under a finding's title. Laid out by hand, as
// WarningNote is: a wrapped text in a layout under an `if` was measured one
// line high, and the list cut it off.
component FindingNote inherits Rectangle {
    in property <string> text;
    in property <brush> tint: Theme.text-muted;
    preferred-height: body.preferred-height;
    min-height: body.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    body := Text {
        x: 32px;
        y: 0;
        width: root.width - 36px;
        text: root.text;
        font-size: Theme.font-sm;
        color: root.tint;
        wrap: word-wrap;
    }
}

// A finding of the review: its severity icon, title and layers. Selected,
// it unfolds its detail and its fix.
component FindingRow inherits VerticalLayout {
    in property <ReviewRow> finding;
    in property <bool> selected;
    callback clicked();
    callback fix();
    callback fill-toggled();
    callback leave();
    // The second fix of fix 4: turn the raft off.
    callback fix-alt();
    // Delete a small island from the print, or bring it back (#462).
    callback delete-toggled();
    // Turn the model of a suction cup with the Orient tool (#128).
    callback turn();

    spacing: 4px;

    if root.finding.header != "": Text {
        text: root.finding.header;
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: ReviewTint.of(root.finding.severity);
    }
    Rectangle {
        // Laid out by hand: the title wraps, the layers stand under it.
        min-height: 6px + title.preferred-height + 2px + layers.preferred-height + 6px;
        preferred-height: self.min-height;
        border-radius: Theme.radius;
        background: root.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
        accessible-role: list-item;
        accessible-label: root.finding.title + ", " + root.finding.layers;
        accessible-item-selected: root.selected;
        accessible-action-default => {
            root.clicked();
        }

        Icon {
            x: 8px;
            y: 6px + 2px;
            commands: root.finding.severity == 0 ? Icons.error : root.finding.severity == 1 ? Icons.warning : Icons.info;
            color: ReviewTint.of(root.finding.severity);
            size: 16px;
        }
        title := Text {
            x: 32px;
            y: 6px;
            width: parent.width - 40px;
            text: root.finding.title;
            font-size: Theme.font;
            color: Theme.text;
            wrap: word-wrap;
        }
        layers := Text {
            x: 32px;
            y: title.y + title.preferred-height + 2px;
            width: parent.width - 40px;
            text: root.finding.layers;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    if root.finding.remains != "": FindingNote {
        text: root.finding.remains;
    }
    if root.selected: FindingNote {
        text: root.finding.detail;
        tint: Theme.text-soft;
    }
    if root.selected: VerticalLayout {
        padding-left: 32px;
        padding-right: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        if root.finding.fix == 1 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add support here");
            icon: Icons.add-support;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 2 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add drain holes…");
            icon: Icons.hole;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 4 && !root.finding.fixed: HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.finding.lift-label;
                horizontal-stretch: 1;
                clicked => {
                    root.fix();
                }
            }
            ScButton {
                text: @tr("Review" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.fix-alt();
                }
            }
        }
        if root.finding.fixed: Text {
            font-size: Theme.font-sm;
            text: root.finding.fix == 1 ? @tr("Review" => "Support added.")
                : root.finding.fix == 4 ? @tr("Review" => "Done. Generate the supports again, then slice.")
                : @tr("Review" => "Drain requested.");
            color: Theme.success;
        }
        if root.finding.fill > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;

            ScButton {
                text: root.finding.fill == 2 ? @tr("Review" => "Do not fill")
                    : root.finding.fill-resin != "" ? @tr("Review" => "Fill on the next slice ({})", root.finding.fill-resin)
                    : @tr("Review" => "Fill on the next slice");
                icon: root.finding.fill == 2 ? "" : Icons.check;
                clicked => {
                    root.fill-toggled();
                }
            }
        }
        if root.finding.turn: ScButton {
            text: @tr("Review" => "Turn the model…");
            clicked => {
                root.turn();
            }
        }
        if root.finding.delete > 0: HorizontalLayout {
            alignment: start;

            ScButton {
                text: root.finding.delete == 2 ? @tr("Review" => "Keep it in the print")
                    : root.finding.delete == 3 ? @tr("Review" => "Bring it back")
                    : @tr("Review" => "Delete from the print ({})", root.finding.delete-size);
                kind: root.finding.delete == 1 ? ButtonKind.normal : ButtonKind.ghost;
                clicked => {
                    root.delete-toggled();
                }
            }
        }
        if root.finding.leave: HorizontalLayout {
            alignment: start;

            ScButton {
                text: @tr("Review" => "Ignore");
                kind: ButtonKind.ghost;
                clicked => {
                    root.leave();
                }
            }
        }
    }
    if root.selected && root.finding.fill == 2: FindingNote {
        text: @tr("Review" => "Marked: the next slice cures this cavity solid.");
        tint: Theme.success;
    }
    if root.selected && root.finding.delete == 2: FindingNote {
        text: @tr("Review" => "Marked: the next slice takes this island off the layers, up to where it joins the model.");
        tint: Theme.warning;
    }
}

// A labelled field stacked over its control.
// A line edit showing a value pushed from Rust: the text binding breaks
// the first time the user types, so each new value is written in
// explicitly.
component PushedEdit inherits LineEdit {
    in property <string> pushed;
    text: root.pushed;
    changed pushed => {
        if (self.text != self.pushed) {
            self.text = self.pushed;
        }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;

    Text {
        text: root.label;
        font-size: Theme.font-sm;
        color: Theme.text-muted;
    }
    @children
}

// One option of the Orient tool (#182), as Rust lays it out.
export struct OrientOption {
    // "A", "B" or "C".
    letter: string,
    // The search that found it: "Quick" or "Full".
    mode: string,
    // "≈ 84 tips".
    tips: string,
    // Against the current pose: "−32 %", or empty.
    change: string,
    // Fewer tips than the current pose.
    better: bool,
    // "Peak 18 N".
    peak: string,
    // "62 mm tall".
    height: string,
    // "Tilts 35°", maybe with the turn about the vertical.
    tilt: string,
    // It fits the printer's build volume.
    fits: bool,
    // "0 on detail" with detail painted, or empty.
    detail: string,
    // No tips on the painted detail.
    detail-clear: bool,
}

// One option card: hovering it shows the pose on the model, a click picks it
// for Apply.
component OrientOptionCard inherits Rectangle {
    in property <OrientOption> option;
    in property <bool> selected;
    callback hovered(bool);
    callback clicked();

    min-height: rows.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.selected ? Theme.indicator : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    background: touch.has-hover ? Theme.hover : Theme.well;
    accessible-role: button;
    accessible-label: root.option.letter + " " + root.option.tips;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    rows := VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.option.letter;
                font-weight: 700;
                font-size: Theme.font;
                color: root.selected ? Theme.indicator : Theme.text;
            }
            Text {
                text: root.option.tips;
                font-family: Theme.mono;
                font-size: Theme.font;
                color: Theme.text;
            }
            Text {
                text: root.option.change;
                font-family: Theme.mono;
                font-size: Theme.font-sm;
                color: root.option.better ? Theme.success : Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.option.mode;
                font-size: Theme.font-xs;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 10px;

            Text {
                text: root.option.peak;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            Text {
                text: root.option.height;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            Text {
                text: root.option.tilt;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                horizontal-stretch: 1;
                horizontal-alignment: right;
            }
        }
        if root.option.detail != "": Text {
            text: root.option.detail;
            font-size: Theme.font-sm;
            color: root.option.detail-clear ? Theme.success : Theme.warning;
        }
        if !root.option.fits: Text {
            text: @tr("Inspector" => "Does not fit the printer");
            font-size: Theme.font-sm;
            color: Theme.warning;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            root.hovered(self.has-hover);
        }
        clicked => {
            root.clicked();
        }
    }
}

// The Orient tool (#182): finds the best way up for printing and offers
// three poses. Shown above the Transform inspector while the tool is open.
export component OrientCard inherits Card {
    // A model is selected and the scene can be edited.
    in property <bool> enabled;
    in property <bool> running;
    // 0 preparing the model, 1 searching, 2 refining, 3 judging the best.
    in property <int> phase;
    in property <float> progress;
    // 0 Balanced, 1 Fewer supports, 2 Lower force, 3 Faster, 4 No suction
    // cups (#128).
    in property <int> preset;
    in property <float> max-tilt;
    in property <bool> align;
    in property <float> weight-supports;
    in property <float> weight-force;
    in property <float> weight-height;
    in property <[OrientOption]> options;
    in property <int> selected: -1;
    // The current pose's numbers, or empty.
    in property <string> current;
    in property <string> status;
    in property <string> warning;
    // After Apply, with more than one model: offer Arrange all.
    in property <bool> offer-arrange;
    // The protect-detail brush (#184): whether it is on, its radius in mm,
    // whether it erases, and "Painted: 312 mm² (8 %)" with paint on the model.
    in property <bool> brush-on;
    in property <float> brush-size;
    in property <bool> brush-erase;
    in property <bool> brush-visible-only;
    in property <string> painted;
    callback brush-toggled();
    callback brush-size-changed(float);
    callback brush-erase-toggled();
    callback brush-visible-changed(bool);
    // 0 grow, 1 shrink, 2 invert, 3 clear all.
    callback brush-op(int);
    // 0 Quick, 1 Full.
    callback search(int);
    callback cancel();
    // 0 preset, 1 max tilt, 2 align (0/1), 3 supports weight, 4 force
    // weight, 5 height weight.
    callback option-changed(int, float);
    callback option-hovered(int, bool);
    callback option-picked(int);
    callback apply();
    callback close();
    callback arrange();

    property <bool> advanced: false;

    title: @tr("Inspector" => "ORIENT");
    note: "O";
    highlighted: true;

    Note {
        text: @tr("Inspector" => "Finds the best way up for printing: fewer supports, less peel force, less height. Hover an option to see it on the model.");
    }
    Text {
        text: @tr("Inspector" => "PROTECT DETAIL");
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: Theme.text-muted;
    }
    if !root.brush-on && root.painted == "": Note {
        text: @tr("Inspector" => "Optional: paint what matters most, like the face. The search keeps supports off it and turns it up.");
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: root.brush-on ? @tr("Inspector" => "Painting") : @tr("Inspector" => "Paint detail");
            icon: Icons.brush;
            kind: root.brush-on ? ButtonKind.primary : ButtonKind.normal;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.brush-toggled();
            }
        }
        if root.brush-on: ScButton {
            text: @tr("Inspector" => "Erase");
            kind: root.brush-erase ? ButtonKind.primary : ButtonKind.normal;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.brush-erase-toggled();
            }
        }
    }
    if root.brush-on: NumberField {
        label: @tr("Inspector" => "Brush size");
        unit: "mm";
        decimals: 1;
        value: root.brush-size;
        committed(v) => {
            root.brush-size-changed(v);
        }
    }
    if root.brush-on: CheckBox {
        text: @tr("Inspector" => "Only what the camera sees");
        checked: root.brush-visible-only;
        toggled => {
            root.brush-visible-changed(self.checked);
        }
    }
    if root.brush-on: Note {
        text: @tr("Inspector" => "Drag paints, Alt + drag erases, Shift + click fills a region. [ and ] size the brush, B turns it off.");
    }
    if root.painted != "": HorizontalLayout {
        spacing: 7px;

        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: Theme.surface-paint;
        }
        Text {
            text: root.painted;
            font-size: Theme.font-sm;
            color: Theme.text-soft;
            horizontal-stretch: 1;
        }
    }
    if root.painted != "": GridLayout {
        spacing: 8px;

        Row {
            ScButton {
                text: @tr("Inspector" => "Grow");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(0);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Shrink");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(1);
                }
            }
        }
        Row {
            ScButton {
                text: @tr("Inspector" => "Invert");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(2);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Clear all");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(3);
                }
            }
        }
    }
    Field {
        label: @tr("Inspector" => "Objective");
        preset-combo := ComboBox {
            model: [
                @tr("Inspector" => "Balanced"),
                @tr("Inspector" => "Fewer supports"),
                @tr("Inspector" => "Lower force"),
                @tr("Inspector" => "Faster"),
                @tr("Inspector" => "No suction cups"),
            ];
            current-index: root.preset;
            enabled: !root.running;
            selected => {
                root.option-changed(0, preset-combo.current-index);
            }
        }
    }
    Rectangle {
        height: 22px;
        accessible-role: button;
        accessible-label: @tr("Inspector" => "Advanced");
        accessible-expanded: root.advanced;
        accessible-action-default => {
            root.advanced = !root.advanced;
        }

        HorizontalLayout {
            spacing: 6px;

            DisclosureChevron {
                open: root.advanced;
                color: Theme.text-muted;
                size: 9px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: @tr("Inspector" => "Advanced");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.advanced = !root.advanced;
            }
        }
    }
    // Each one under its own `if`: a wrapped Note inside a nested layout
    // under an `if` is measured as one line, and the card came out short.
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Max tilt from now");
        unit: "°";
        decimals: 0;
        value: root.max-tilt;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(1, v);
        }
    }
    if root.advanced: CheckBox {
        text: @tr("Inspector" => "Align to the plate");
        checked: root.align;
        enabled: !root.running;
        toggled => {
            root.option-changed(2, self.checked ? 1 : 0);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of supports");
        unit: "%";
        decimals: 0;
        value: root.weight-supports;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(3, v);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of peel force");
        unit: "%";
        decimals: 0;
        value: root.weight-force;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(4, v);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of height");
        unit: "%";
        decimals: 0;
        value: root.weight-height;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(5, v);
        }
    }
    if root.advanced: Note {
        text: @tr("Inspector" => "180° allows any pose, upside down included. Without aligning, an option turns about the vertical only to fit the plate.");
    }
    Text {
        text: @tr("Inspector" => "AUTO-ORIENT");
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: Theme.text-muted;
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: @tr("Inspector" => "Quick");
            icon: Icons.auto;
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.search(0);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Full");
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.search(1);
            }
        }
    }
    if root.running: HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.phase == 0 ? @tr("Inspector" => "Preparing the model…")
                    : root.phase == 1 ? @tr("Inspector" => "Searching…")
                    : root.phase == 2 ? @tr("Inspector" => "Refining the best poses…")
                    : @tr("Inspector" => "Judging the finalists…");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
            }
            ProgressIndicator {
                progress: root.progress;
            }
        }
        ScButton {
            text: @tr("Inspector" => "Cancel");
            clicked => {
                root.cancel();
            }
        }
    }
    if root.status != "": Note {
        text: root.status;
    }
    if root.warning != "": WarningNote {
        text: root.warning;
    }
    for option[i] in root.options: OrientOptionCard {
        option: option;
        selected: i == root.selected;
        hovered(on) => {
            root.option-hovered(i, on);
        }
        clicked => {
            root.option-picked(i);
        }
    }
    if root.current != "": Note {
        text: root.current;
    }
    HorizontalLayout {
        spacing: 8px;

        if root.options.length > 0: ScButton {
            text: root.selected >= 0 && root.selected < root.options.length
                ? @tr("Inspector" => "Apply {}", root.options[root.selected].letter)
                : @tr("Inspector" => "Apply");
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running && root.selected >= 0;
            clicked => {
                root.apply();
            }
        }
        if root.offer-arrange: ScButton {
            text: @tr("Inspector" => "Arrange all");
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.arrange();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Close");
            kind: ButtonKind.ghost;
            clicked => {
                root.close();
            }
        }
    }
}

// The Cut tool (#56): a plane through the selected model, its height and
// tilt, and optionally the shape its four corners make on it, which bounds
// the cut. The same is set by the plane's handles in the scene. The parts of
// the cut show on the plane; a click on one takes it or leaves it (Rust:
// `cut_run.rs`, `cut_gizmo.rs`).
export component CutCard inherits Card {
    // A model is selected and the scene can be edited.
    in property <bool> enabled;
    // The model is being made ready, or the cut worked out.
    in property <bool> working;
    in property <float> plane-height;
    in property <float> height-min;
    in property <float> height-max;
    in property <float> tilt-x;
    in property <float> tilt-y;
    in property <bool> bounded;
    in property <float> rect-width;
    in property <float> rect-depth;
    in property <float> offset-u;
    in property <float> offset-v;
    in property <string> status;
    in property <string> warning;
    in property <bool> can-cut;
    // The joints across the cut (#109, #442): 0 none, 1 pin, 2 magnet.
    in property <int> joint-kind;
    in property <bool> joint-square;
    in property <float> joint-size;
    in property <float> joint-depth;
    in property <float> joint-clearance;
    in property <int> joint-preset: -1;
    // Strokes drawn over the model in place of the plane (#440, #441).
    in property <bool> stroke-mode;
    // 0 height, 1 tilt about x, 2 tilt about y, 3 bounded (0/1), 4 width,
    // 5 depth, 6 offset along the plane, 7 offset across it; the joints:
    // 8 kind, 9 square (0/1), 10 size, 11 depth, 12 clearance, 13 magnet
    // preset.
    callback option-changed(int, float);
    callback apply();
    callback close();

    title: @tr("Inspector" => "CUT");
    note: "K";
    highlighted: true;

    LabeledRow {
        label: @tr("Inspector" => "Cut by");
        Segmented {
            width: 190px;
            options: [@tr("Inspector" => "Plane"), @tr("Inspector" => "Stroke")];
            current: root.stroke-mode ? 1 : 0;
            enabled: root.enabled;
            picked(i) => {
                root.option-changed(14, i);
            }
        }
    }
    if root.stroke-mode: Note {
        text: @tr("Inspector" => "Drag over the model in the view: a stroke from one side to the other cuts it along the stroke, through the model as seen; a loop round a part cuts that part off. Then press Cut.");
    }
    if !root.stroke-mode: Note {
        text: @tr("Inspector" => "Cuts the selected model with a plane and closes the pieces. In the scene, the arrow moves the plane, the rings tilt it, the corners shape it and a drag on it moves it along. Click a part of the cut to take it or leave it.");
    }
    if !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Height");
        unit: "mm";
        decimals: 2;
        value: root.plane-height;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(0, v);
        }
    }
    if !root.stroke-mode: Slider {
        minimum: root.height-min;
        maximum: root.height-max;
        value: root.plane-height;
        enabled: root.enabled;
        changed(v) => {
            root.option-changed(0, v);
        }
    }
    if !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Tilt front to back");
        unit: "°";
        decimals: 1;
        value: root.tilt-x;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(1, v);
        }
    }
    if !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Tilt side to side");
        unit: "°";
        decimals: 1;
        value: root.tilt-y;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(2, v);
        }
    }
    if !root.stroke-mode: CheckBox {
        text: @tr("Inspector" => "Limit the plane");
        checked: root.bounded;
        enabled: root.enabled;
        toggled => {
            root.option-changed(3, self.checked ? 1 : 0);
        }
    }
    // Each one under its own `if`: a wrapped Note inside a nested layout
    // under an `if` is measured as one line, and the card came out short.
    if root.bounded && !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Width");
        unit: "mm";
        decimals: 1;
        value: root.rect-width;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(4, v);
        }
    }
    if root.bounded && !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Depth");
        unit: "mm";
        decimals: 1;
        value: root.rect-depth;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(5, v);
        }
    }
    if root.bounded && !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Move along X");
        unit: "mm";
        decimals: 1;
        value: root.offset-u;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(6, v);
        }
    }
    if root.bounded && !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Move along Y");
        unit: "mm";
        decimals: 1;
        value: root.offset-v;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(7, v);
        }
    }
    // Joints across the cut (#109, #442), in the middle of each part cut.
    if !root.stroke-mode: LabeledRow {
        label: @tr("Inspector" => "Joints");
        Segmented {
            width: 190px;
            options: [@tr("Inspector" => "None"), @tr("Inspector" => "Pins"), @tr("Inspector" => "Magnets")];
            current: root.joint-kind;
            enabled: root.enabled;
            picked(i) => {
                root.option-changed(8, i);
            }
        }
    }
    if root.joint-kind == 1 && !root.stroke-mode: LabeledRow {
        label: @tr("Inspector" => "Pin shape");
        Segmented {
            width: 190px;
            options: [@tr("Inspector" => "Round"), @tr("Inspector" => "Square")];
            current: root.joint-square ? 1 : 0;
            enabled: root.enabled;
            picked(i) => {
                root.option-changed(9, i);
            }
        }
    }
    if root.joint-kind == 2 && !root.stroke-mode: LabeledRow {
        label: @tr("Inspector" => "Magnet");
        Segmented {
            width: 190px;
            options: ["2 × 1", "3 × 2", "5 × 2"];
            current: root.joint-preset;
            enabled: root.enabled;
            picked(i) => {
                root.option-changed(13, i);
            }
        }
    }
    if root.joint-kind != 0 && !root.stroke-mode: NumberField {
        label: root.joint-kind == 1 ? @tr("Inspector" => "Pin size") : @tr("Inspector" => "Magnet diameter");
        unit: "mm";
        decimals: 2;
        value: root.joint-size;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(10, v);
        }
    }
    if root.joint-kind != 0 && !root.stroke-mode: NumberField {
        label: root.joint-kind == 1 ? @tr("Inspector" => "Pin depth") : @tr("Inspector" => "Magnet height");
        unit: "mm";
        decimals: 2;
        value: root.joint-depth;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(11, v);
        }
    }
    if root.joint-kind != 0 && !root.stroke-mode: NumberField {
        label: @tr("Inspector" => "Clearance");
        unit: "mm";
        decimals: 2;
        value: root.joint-clearance;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(12, v);
        }
    }
    if root.status != "": Note {
        text: root.status;
    }
    if root.warning != "": WarningNote {
        text: root.warning;
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: root.working ? @tr("Inspector" => "Working…") : @tr("Inspector" => "Cut");
            icon: Icons.cut;
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && root.can-cut;
            clicked => {
                root.apply();
            }
        }
        if !root.stroke-mode: ScButton {
            text: @tr("Inspector" => "Suggest");
            kind: ButtonKind.ghost;
            enabled: root.enabled;
            clicked => {
                root.option-changed(15, 0);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Close");
            kind: ButtonKind.ghost;
            clicked => {
                root.close();
            }
        }
    }
}

// The Repair button of the MESH CHECK card; while a run goes, what it is
// doing, how far it is and Cancel, which discards the run (#253). Under it,
// when a run left something broken, whether the viewport marks it.
component RepairControls inherits VerticalLayout {
    in property <bool> enabled;
    in property <bool> primary;
    in property <bool> repairing;
    in property <string> phase;
    in property <float> progress;
    in property <bool> marks-available;
    in property <bool> marks-shown;
    callback repair-requested();
    callback cancel-requested();
    callback marks-toggled(bool);

    spacing: 6px;

    if !root.repairing: ScButton {
        text: @tr("Inspector" => "Repair meshes");
        icon: Icons.repair;
        kind: root.primary ? ButtonKind.primary : ButtonKind.normal;
        enabled: root.enabled;
        clicked => {
            root.repair-requested();
        }
    }
    if root.repairing: HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Repairing…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            ProgressIndicator {
                progress: root.progress;
            }
        }
        ScButton {
            text: @tr("Inspector" => "Cancel");
            clicked => {
                root.cancel-requested();
            }
        }
    }
    if root.marks-available && !root.repairing: CheckBox {
        text: @tr("Inspector" => "Show what is left on the model");
        checked: root.marks-shown;
        toggled => {
            root.marks-toggled(self.checked);
        }
    }
}

// One colour of the overhang map, with what it means.
component OverhangKey inherits HorizontalLayout {
    in property <brush> tint;
    in property <string> text;

    spacing: 6px;
    alignment: start;

    VerticalLayout {
        alignment: center;

        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: root.tint;
        }
    }
    Note {
        text: root.text;
        wrap: no-wrap;
    }
}

// The overhang map's card (#91): its box, the colours it paints and what it
// follows. In Transform, Supports and Slice, one box for the three (#484).
export component OverhangCard inherits Card {
    in-out property <bool> on;
    in property <string> limit;
    callback toggled(bool);

    title: @tr("Inspector" => "OVERHANGS");
    note: root.on ? root.limit : "";

    CheckBox {
        text: @tr("Inspector" => "Show overhang map");
        checked <=> root.on;
        toggled => {
            root.toggled(self.checked);
        }
    }
    if root.on: HorizontalLayout {
        spacing: 14px;

        OverhangKey {
            tint: #ed4d40;
            text: @tr("Inspector" => "Needs supports");
        }
        OverhangKey {
            tint: #e67a85;
            text: @tr("Inspector" => "Close to the limit");
        }
    }
    if root.on: Note {
        text: @tr("Inspector" => "Follows the overhang angle of the Supports tab, measured from the plate.");
    }
    if root.on: Note {
        text: @tr("Inspector" => "What a support tip holds shows plain: as far around it as its preset spaces overhang tips.");
    }
}

// One row of the SIZE card: the world box and, when `split`, the size along
// the object's own axes beside it (BS-393).
component SizeRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> model-label;
    in property <bool> split;
    in property <float> world;
    in property <float> model;
    callback world-committed(float);
    callback model-committed(float);

    spacing: 10px;

    NumberField {
        horizontal-stretch: 1;
        label: root.label;
        unit: "mm";
        field-width: root.split ? 88px : 112px;
        value: root.world;
        committed(v) => {
            root.world-committed(v);
        }
    }
    if root.split: NumberField {
        horizontal-stretch: 0;
        accessible-name: root.model-label;
        unit: "mm";
        field-width: 88px;
        value: root.model;
        committed(v) => {
            root.model-committed(v);
        }
    }
}

export component TransformInspector inherits VerticalLayout {
    in property <[StandardListViewItem]> objects;
    in property <int> selected-index: -1;
    // Every selected row, and how many objects are selected (#13).
    in property <[bool]> selected-rows;
    in property <int> selected-count;
    in property <bool> needs-repair;

    // What the MESH CHECK card says when a mesh does not slice: its short
    // status and which objects, why, and what to do (see `mesh_check.rs`).
    in property <string> check-note;
    in property <string> check-text;
    in property <bool> repair-enabled;
    in property <bool> repairing;
    // A Repair run's step and how far it is (#253).
    in property <string> repair-phase;
    in property <float> repair-progress;
    // Whether the viewport can mark what a run left broken, and does.
    in property <bool> repair-marks-available;
    in property <bool> repair-marks-shown;
    // The overhang map (#91): its box, and the angle it paints by, as text.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    // The selected object, in world millimetres and degrees (see
    // `viewport/numeric_transform.rs`); `selection-valid` is false with no
    // selection.
    in property <bool> selection-valid;
    in property <float> size-x;
    in property <float> size-y;
    in property <float> size-z;
    // Size along the object's own axes; shown next to the world box when
    // `tilted` (a turn off a multiple of 90° about X or Y, BS-393).
    in property <float> model-x;
    in property <float> model-y;
    in property <float> model-z;
    in property <bool> tilted;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    in property <float> scale;
    // Scale along each of the object's own axes, percent, and whether the
    // Size card scales all three together (#14; on by default).
    in property <float> scale-x;
    in property <float> scale-y;
    in property <float> scale-z;
    in-out property <bool> size-uniform: true;
    callback object-picked(int);
    // Shift+click or Ctrl+click on a row.
    callback object-toggled(int);
    callback repair-requested();
    callback repair-cancel();
    callback repair-marks-toggled(bool);
    // A typed value: the field code (NumericEdit::from_ui) and the value.
    callback numeric-edit(int, float);
    // Arrange (#180): the card's settings, whether a run is going, and what
    // the last one did.
    in property <bool> arrange-enabled;
    in property <bool> arranging;
    in property <string> arrange-last-run;
    in property <float> arrange-gap;
    in property <float> arrange-margin;
    in property <bool> arrange-turns;
    in property <bool> arrange-shadow-only;
    in property <bool> arrange-one-raft;
    // How many models have supports made on another pillar grid than the
    // Supports tab's (#576): Arrange and Fill bed measure them as they are.
    in property <int> arrange-grid-stale;
    callback arrange-grid-regenerate();
    // Fill bed (#356): a fill in flight, its count so far, and at most how
    // many copies it adds (0: as many as fit).
    in property <bool> arrange-filling;
    in property <string> arrange-fill-progress;
    in property <float> arrange-max-copies;
    // The scene's plates (#545).
    in property <int> plate-count: 1;
    in property <int> active-plate: 0;
    in property <bool> active-plate-used;
    // The plates' names (#547), and whether a selection can be sent to
    // another plate (#549).
    in property <[string]> plate-names;
    in property <bool> can-send;
    callback plate-add();
    callback plate-remove();
    callback plate-send(int);
    // Arrange all (false) or the selection (true).
    callback arrange-requested(bool);
    callback arrange-fill-requested();
    callback arrange-cancel();
    // 0 gap, 1 edge margin, 2 turns (0/1), 3 shadow only (0/1), 4 max copies.
    callback arrange-option-changed(int, float);
    // The Auto-orient button of the ROTATE card opens the Orient tool (#182).
    callback orient-requested();
    // Lay on face (#15): armed, and the button that arms or disarms it.
    in property <bool> lay-face-on;
    callback lay-face-requested(bool);

    spacing: 12px;

    if root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: root.check-note;
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: root.check-text;
        }
        RepairControls {
            enabled: root.repair-enabled;
            primary: true;
            repairing: root.repairing;
            phase: root.repair-phase;
            progress: root.repair-progress;
            marks-available: root.repair-marks-available;
            marks-shown: root.repair-marks-shown;
            repair-requested => {
                root.repair-requested();
            }
            cancel-requested => {
                root.repair-cancel();
            }
            marks-toggled(on) => {
                root.repair-marks-toggled(on);
            }
        }
    }

    if root.objects.length > 0: Card {
        title: @tr("Inspector" => "ARRANGE");
        note: "A";

        Note {
            text: root.arrange-shadow-only
                ? @tr("Inspector" => "Packs the objects with their supports by their whole shadow: nothing reaches over another object.")
                : @tr("Inspector" => "Packs the objects with their supports by their real shape: a part may reach over a shorter object, never closer than the gap.");
        }
        if root.arrange-one-raft: Note {
            text: @tr("Inspector" => "One raft for all is on (Supports › Raft): Arrange and Fill bed pack the models closer, by what stands on it.");
        }
        if root.arrange-grid-stale > 0: WarningNote {
            text: @tr("Inspector" => "{n} model has supports made on another grid: Arrange and Fill bed measure them as they are. Regenerate them to follow the grid of the Supports tab." | "{n} models have supports made on another grid: Arrange and Fill bed measure them as they are. Regenerate them to follow the grid of the Supports tab." % root.arrange-grid-stale);
        }
        if root.arrange-grid-stale > 0: ScButton {
            text: @tr("Inspector" => "Regenerate their supports");
            icon: Icons.rotate;
            enabled: !root.arranging;
            clicked => {
                root.arrange-grid-regenerate();
            }
        }
        NumberField {
            label: @tr("Inspector" => "Gap");
            unit: "mm";
            decimals: 1;
            value: root.arrange-gap;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(0, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Edge margin");
            unit: "mm";
            decimals: 1;
            value: root.arrange-margin;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(1, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Turn objects to fit");
            checked: root.arrange-turns;
            enabled: !root.arranging;
            toggled => {
                root.arrange-option-changed(2, self.checked ? 1 : 0);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Shadow only");
            checked: root.arrange-shadow-only;
            enabled: !root.arranging;
            toggled => {
                root.arrange-option-changed(3, self.checked ? 1 : 0);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.arranging && !root.arrange-filling ? @tr("Inspector" => "Cancel") : @tr("Inspector" => "Arrange all");
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                enabled: root.arrange-enabled || (root.arranging && !root.arrange-filling);
                clicked => {
                    if root.arranging {
                        root.arrange-cancel();
                    } else {
                        root.arrange-requested(false);
                    }
                }
            }
            ScButton {
                text: @tr("Inspector" => "Arrange selection");
                horizontal-stretch: 1;
                enabled: root.arrange-enabled && root.selection-valid && !root.arranging;
                clicked => {
                    root.arrange-requested(true);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Max copies");
            placeholder: @tr("Inspector" => "All that fit");
            decimals: 0;
            value: root.arrange-max-copies;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(4, v);
            }
        }
        ScButton {
            text: root.arrange-filling ? @tr("Inspector" => "Cancel") : @tr("Inspector" => "Fill bed");
            enabled: (root.arrange-enabled && root.selection-valid) || root.arrange-filling;
            clicked => {
                if root.arrange-filling {
                    root.arrange-cancel();
                } else {
                    root.arrange-fill-requested();
                }
            }
        }
        if root.arranging && !root.arrange-filling: Note {
            text: @tr("Inspector" => "Arranging…");
        }
        if root.arrange-filling: Note {
            text: root.arrange-fill-progress;
        }
        if !root.arranging && root.arrange-last-run != "": Note {
            text: root.arrange-last-run;
        }
    }

    if !root.selection-valid && root.objects.length > 0: Card {
        title: @tr("Inspector" => "TRANSFORM");
        Note {
            text: @tr("Inspector" => "Select an object to see its size and to move, rotate or scale it by numbers.");
        }
    }

    if root.selection-valid && root.selected-count > 1: Card {
        title: @tr("Inspector" => "TRANSFORM");
        note: root.selected-count;
        Note {
            text: @tr("Inspector" => "{} objects selected. Move, rotate or scale them together about their shared centre with the gizmo, G, R or S. To type values, select one.", root.selected-count);
        }
        // Each drops to the plate on its own (#516).
        ScButton {
            text: @tr("Inspector" => "Drop to plate");
            clicked => {
                root.numeric-edit(10, 0);
            }
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "MOVE");
        note: "G";

        NumberField {
            label: "X";
            unit: "mm";
            value: root.pos-x;
            committed(v) => {
                root.numeric-edit(0, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "mm";
            value: root.pos-y;
            committed(v) => {
                root.numeric-edit(1, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Lift (Z)");
            unit: "mm";
            value: root.pos-z;
            committed(v) => {
                root.numeric-edit(2, v);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Drop to plate");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(10, 0);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Center");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(11, 0);
                }
            }
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "ROTATE");
        note: "R";

        NumberField {
            label: "X";
            unit: "°";
            decimals: 1;
            value: root.rot-x;
            committed(v) => {
                root.numeric-edit(3, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "°";
            decimals: 1;
            value: root.rot-y;
            committed(v) => {
                root.numeric-edit(4, v);
            }
        }
        NumberField {
            label: "Z";
            unit: "°";
            decimals: 1;
            value: root.rot-z;
            committed(v) => {
                root.numeric-edit(5, v);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Auto-orient");
                icon: Icons.orient;
                kind: ButtonKind.ghost;
                horizontal-stretch: 1;
                clicked => {
                    root.orient-requested();
                }
            }
            ScButton {
                text: root.lay-face-on ? @tr("Inspector" => "Pick a face…") : @tr("Inspector" => "Lay on face");
                kind: root.lay-face-on ? ButtonKind.primary : ButtonKind.ghost;
                horizontal-stretch: 1;
                clicked => {
                    root.lay-face-requested(!root.lay-face-on);
                }
            }
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "SIZE");
        note: "S";

        if root.tilted: HorizontalLayout {
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                width: 88px;
                text: @tr("Inspector" => "World");
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            Text {
                width: 88px;
                text: @tr("Inspector" => "Model");
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Width (X)");
            model-label: @tr("Inspector" => "Model width (X)");
            split: root.tilted;
            world: root.size-x;
            model: root.model-x;
            world-committed(v) => {
                root.numeric-edit(root.size-uniform ? 7 : 15, v);
            }
            model-committed(v) => {
                root.numeric-edit(root.size-uniform ? 12 : 18, v);
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Depth (Y)");
            model-label: @tr("Inspector" => "Model depth (Y)");
            split: root.tilted;
            world: root.size-y;
            model: root.model-y;
            world-committed(v) => {
                root.numeric-edit(root.size-uniform ? 8 : 16, v);
            }
            model-committed(v) => {
                root.numeric-edit(root.size-uniform ? 13 : 19, v);
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Height (Z)");
            model-label: @tr("Inspector" => "Model height (Z)");
            split: root.tilted;
            world: root.size-z;
            model: root.model-z;
            world-committed(v) => {
                root.numeric-edit(root.size-uniform ? 9 : 17, v);
            }
            model-committed(v) => {
                root.numeric-edit(root.size-uniform ? 14 : 20, v);
            }
        }
        // With two columns, Scale spans from the middle of World to the
        // middle of Model, centred under both (BS-393).
        if root.size-uniform: HorizontalLayout {
            spacing: 0px;

            NumberField {
                horizontal-stretch: 1;
                label: @tr("Inspector" => "Scale");
                unit: "%";
                decimals: 1;
                field-width: root.tilted ? 88px + 10px : 112px;
                value: root.scale;
                committed(v) => {
                    root.numeric-edit(6, v);
                }
            }
            if root.tilted: Rectangle {
                width: 88px / 2;
            }
        }
        // Scale per axis (#14): the uniform lock off, each axis on its own.
        if !root.size-uniform: NumberField {
            label: @tr("Inspector" => "Scale X");
            unit: "%";
            decimals: 1;
            value: root.scale-x;
            committed(v) => {
                root.numeric-edit(21, v);
            }
        }
        if !root.size-uniform: NumberField {
            label: @tr("Inspector" => "Scale Y");
            unit: "%";
            decimals: 1;
            value: root.scale-y;
            committed(v) => {
                root.numeric-edit(22, v);
            }
        }
        if !root.size-uniform: NumberField {
            label: @tr("Inspector" => "Scale Z");
            unit: "%";
            decimals: 1;
            value: root.scale-z;
            committed(v) => {
                root.numeric-edit(23, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Uniform scale");
            checked <=> root.size-uniform;
        }
        Note {
            text: root.size-uniform ? @tr("Inspector" => "Sizes scale uniformly, keeping proportions.") : @tr("Inspector" => "Each size and scale changes its own axis alone.");
        }
        if root.tilted: Note {
            text: @tr("Inspector" => "Tilted: World is the box it takes on the plate; Model is its size along its own axes.");
        }
    }

    if !root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: @tr("Inspector" => "No problems");
        note-color: Theme.success;
        collapsible: true;
        expanded: false;

        RepairControls {
            enabled: root.repair-enabled;
            primary: false;
            repairing: root.repairing;
            phase: root.repair-phase;
            progress: root.repair-progress;
            repair-requested => {
                root.repair-requested();
            }
            cancel-requested => {
                root.repair-cancel();
            }
        }
    }
}

export component HollowInspector inherits VerticalLayout {
    in property <bool> selection-valid;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <string> last-run;
    // What the selected model is: 0 solid, 1 hollow, 2 the support mesh, 3
    // a model that came hollow (#447): drains are drilled into it as it is.
    in property <int> model-state;
    in property <int> drain-count;
    // Its cavities still closed all round (#130); -1 not counted yet.
    in property <int> sealed-count: -1;
    // Show where a drain works best (#455).
    in property <bool> drain-map;
    callback drain-map-toggled(bool);
    // The drain picked to edit (#450), -1 none; and whether the next click
    // moves it.
    in property <int> drain-picked: -1;
    in property <bool> drain-moving;
    callback drain-step(int);
    callback drain-remove();
    callback drain-move();
    in property <bool> drain-tool-on;
    // The lasso (#179): how many regions the model keeps solid.
    in property <int> solid-count;
    in property <bool> lasso-tool-on;
    in property <bool> show-cavity;
    callback show-cavity-toggled(bool);
    // The options (HollowRun::on_option), pushed by Rust after every change.
    in property <float> wall;
    in property <float> recommended-wall;
    in property <float> voxel;
    // The narrowest cavity channel kept (#454); 0 keeps them all.
    in property <float> narrowest-cavity;
    in property <int> fill-index;
    in property <float> cell;
    in property <float> beam;
    in property <float> drain-radius;
    // The drain tool's shape (#316, #317, #318).
    in property <bool> drain-depth-set;
    in property <float> drain-depth;
    in property <bool> drain-cone;
    in property <float> drain-inner-radius;
    in property <bool> drain-plug;
    in property <float> plug-clearance;
    callback apply-requested();
    callback cancel-requested();
    callback restore-requested();
    callback clear-drains-requested();
    callback drain-tool-toggled();
    callback lasso-tool-toggled();
    callback remove-last-solid-requested();
    callback clear-solids-requested();
    callback option-changed(int, float);

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "HOLLOWING");
        note: root.running ? @tr("Inspector" => "Working") : root.model-state == 1 || root.model-state == 3 ? @tr("Inspector" => "Hollow") : "";
        note-color: Theme.indicator;

        if !root.selection-valid: Note {
            text: @tr("Inspector" => "Select a model to hollow it.");
        }
        if root.selection-valid && root.model-state == 2: Note {
            text: @tr("Inspector" => "That is the support mesh; select a model.");
        }
        if root.selection-valid && root.model-state == 3: Note {
            text: @tr("Inspector" => "This model came hollow: drains are drilled into it as it is, and it is not hollowed again.");
        }
        ScButton {
            text: root.model-state == 1 ? @tr("Inspector" => "Hollow again") : @tr("Inspector" => "Hollow model");
            icon: Icons.hollow;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.selection-valid && root.model-state != 2 && root.model-state != 3 && !root.running;
            clicked => {
                root.apply-requested();
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
        CheckBox {
            text: @tr("Inspector" => "Show the cavity (live preview)");
            checked: root.show-cavity;
            toggled => {
                root.show-cavity-toggled(self.checked);
            }
        }
        if !root.running && root.model-state == 1: ScButton {
            text: @tr("Inspector" => "Make solid again");
            clicked => {
                root.restore-requested();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "WALL");
        collapsible: true;

        NumberField {
            label: @tr("Inspector" => "Wall thickness");
            unit: "mm";
            value: root.wall;
            committed(v) => {
                root.option-changed(0, v);
            }
        }
        Slider {
            minimum: 0.5;
            maximum: 6;
            value: root.wall;
            changed(v) => {
                root.option-changed(0, Math.round(v * 10) / 10);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Recommended ({} mm)", Math.round(root.recommended-wall * 10) / 10);
            kind: Math.abs(root.wall - root.recommended-wall) < 0.05 ? ButtonKind.primary : ButtonKind.normal;
            clicked => {
                root.option-changed(0, root.recommended-wall);
            }
        }
        HorizontalLayout {
            spacing: 6px;

            ScButton {
                text: "−1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 1) * 10) / 10);
                }
            }
            ScButton {
                text: "−0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 1) * 10) / 10);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Detail (voxel)");
            unit: "mm";
            value: root.voxel;
            committed(v) => {
                root.option-changed(1, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Narrowest cavity");
            unit: "mm";
            value: root.narrowest-cavity;
            committed(v) => {
                root.option-changed(13, v);
            }
        }
        Note {
            text: @tr("Inspector" => "Narrower channels stay solid: they trap resin and are hard to wash. 0 keeps them all.");
        }
        LabeledRow {
            label: @tr("Inspector" => "Inside");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Empty"), @tr("Inspector" => "Lattice"), @tr("Inspector" => "Pillars")];
                current: root.fill-index;
                picked(i) => {
                    root.option-changed(3, i);
                }
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Cell size");
            unit: "mm";
            value: root.cell;
            committed(v) => {
                root.option-changed(4, v);
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Beam radius");
            unit: "mm";
            value: root.beam;
            committed(v) => {
                root.option-changed(5, v);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "SOLID AREAS");
        note: root.solid-count > 0 ? "\{root.solid-count}" : "";

        ScButton {
            text: root.lasso-tool-on ? @tr("Inspector" => "Drawing solid areas (M)") : @tr("Inspector" => "Keep an area solid (M)");
            icon: Icons.lasso;
            kind: root.lasso-tool-on ? ButtonKind.primary : ButtonKind.normal;
            enabled: root.selection-valid && root.model-state != 2 && root.model-state != 3 && !root.running;
            clicked => {
                root.lasso-tool-toggled();
            }
        }
        Note {
            text: @tr("Inspector" => "Turn the camera to the side you want, then drag around a part: everything behind the curve, through the model, stays solid. The cavity is computed again at once.");
        }
        if root.solid-count > 0: HorizontalLayout {
            spacing: 8px;
            ScButton {
                text: @tr("Inspector" => "Remove the last");
                enabled: !root.running;
                clicked => {
                    root.remove-last-solid-requested();
                }
            }
            ScButton {
                text: @tr("Inspector" => "Remove all");
                enabled: !root.running;
                clicked => {
                    root.clear-solids-requested();
                }
            }
        }
    }

    Card {
        title: @tr("Inspector" => "DRAINS");
        note: root.drain-count > 0 ? "\{root.drain-count}" : "";

        ScButton {
            text: root.drain-tool-on ? @tr("Inspector" => "Placing drains (D)") : @tr("Inspector" => "Place drains (D)");
            icon: Icons.hole;
            kind: root.drain-tool-on ? ButtonKind.primary : ButtonKind.normal;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.drain-tool-toggled();
            }
        }
        // Pick a drain to change, move or take away (#450): with the
        // arrows, or a click on it with the drain tool.
        if root.drain-count > 0: HorizontalLayout {
            spacing: 6px;
            ScButton {
                icon: Icons.chevron-left;
                enabled: !root.running;
                clicked => {
                    root.drain-step(-1);
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.drain-picked >= 0
                    ? @tr("Inspector" => "Drain {} of {}", root.drain-picked + 1, root.drain-count)
                    : @tr("Inspector" => "New drains");
                font-size: Theme.font;
                color: root.drain-picked >= 0 ? Theme.text : Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            ScButton {
                icon: Icons.chevron-right;
                enabled: !root.running;
                clicked => {
                    root.drain-step(1);
                }
            }
        }
        if root.drain-picked >= 0: HorizontalLayout {
            spacing: 6px;
            ScButton {
                horizontal-stretch: 1;
                text: root.drain-moving ? @tr("Inspector" => "Click where it goes…") : @tr("Inspector" => "Move it");
                enabled: !root.running;
                clicked => {
                    root.drain-move();
                }
            }
            ScButton {
                horizontal-stretch: 1;
                text: @tr("Inspector" => "Remove it");
                enabled: !root.running;
                clicked => {
                    root.drain-remove();
                }
            }
        }
        NumberField {
            label: root.drain-cone ? @tr("Inspector" => "Radius at the surface") : @tr("Inspector" => "Drain radius");
            unit: "mm";
            value: root.drain-radius;
            committed(v) => {
                root.option-changed(6, v);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Shape");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Cylinder"), @tr("Inspector" => "Cone")];
                current: root.drain-cone ? 1 : 0;
                picked(i) => {
                    root.option-changed(9, i);
                }
            }
        }
        if root.drain-cone: NumberField {
            label: @tr("Inspector" => "Radius at the end");
            unit: "mm";
            value: root.drain-inner-radius;
            committed(v) => {
                root.option-changed(10, v);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Depth");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Through the wall"), @tr("Inspector" => "Set")];
                current: root.drain-depth-set ? 1 : 0;
                picked(i) => {
                    root.option-changed(7, i);
                }
            }
        }
        if root.drain-depth-set: NumberField {
            label: @tr("Inspector" => "Depth from the surface");
            unit: "mm";
            value: root.drain-depth;
            committed(v) => {
                root.option-changed(8, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Make a plug for each new drain");
            checked: root.drain-plug;
            toggled => {
                root.option-changed(11, self.checked ? 1 : 0);
            }
        }
        if root.drain-plug: NumberField {
            label: @tr("Inspector" => "Plug clearance (across)");
            unit: "mm";
            value: root.plug-clearance;
            committed(v) => {
                root.option-changed(12, v);
            }
        }
        Note {
            text: root.drain-picked >= 0
                ? @tr("Inspector" => "These fields change the drain picked, and its plug. Click a drain with the drain tool to pick it, or empty surface to place a new one.")
                : @tr("Inspector" => "Each drain keeps the shape it was placed with. A plug is a separate part on the plate, as long as the hole and narrower by the clearance: print it with the model and close the hole with it after cleaning.");
        }
        if root.model-state == 1 || root.model-state == 3: CheckBox {
            text: @tr("Inspector" => "Show where a drain works best");
            checked: root.drain-map;
            toggled => {
                root.drain-map-toggled(self.checked);
            }
        }
        if (root.model-state == 1 || root.model-state == 3) && root.drain-map: Note {
            text: @tr("Inspector" => "Green, with the drain tool: low on the model, where the wall is thin, so resin runs out through a short hole. Red: the same, on detail you painted to protect. A guide only: where the hole goes is yours to choose.");
        }
        if root.drain-count > 0: ScButton {
            text: @tr("Inspector" => "Remove all drains");
            enabled: !root.running;
            clicked => {
                root.clear-drains-requested();
            }
        }
        if (root.model-state == 1 || root.model-state == 3) && root.sealed-count > 0: WarningNote {
            text: @tr("Inspector" => "{n} sealed cavity: resin stays trapped inside and the walls act as a suction cup. Drill a drain into it, near the plate." | "{n} sealed cavities: resin stays trapped in each and the walls act as suction cups. Drill a drain into each, near the plate." % root.sealed-count);
        }
        if root.model-state == 0 && root.drain-count == 0: Note {
            text: @tr("Inspector" => "Place drains now or after hollowing: click the model's surface with the drain tool. They are drilled when the model is hollowed.");
        }
        if root.model-state == 0 && root.drain-count > 0: Note {
            text: @tr("Inspector" => "These drains are drilled when you hollow the model.");
        }
        if root.model-state == 1: Note {
            text: @tr("Inspector" => "Each new drain hollows the model again with it: one undo per drain.");
        }
        if root.model-state == 3: Note {
            text: @tr("Inspector" => "Each new drain is drilled into the model as it is: one undo per drain.");
        }
    }
}

export component SupportsInspector inherits VerticalLayout {
    in property <bool> has-scene;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <bool> cancelable;
    in property <string> last-run;
    // The options (DfSupportOptions), pushed by Rust after every change.
    in property <[string]> preset-names;
    in property <int> preset-index: -1;
    in property <int> sizing-index: 1;
    in property <float> density;
    in property <float> angle;
    in property <float> size-scale;
    in property <float> min-island;
    in property <float> coverage;
    in property <bool> stabilization;
    in property <bool> bracing;
    in property <bool> smooth;
    in property <int> raft-index;
    in property <float> raft-thickness;
    in property <bool> raft-wall;
    // A solid raft's other shapes (#138, #99).
    in property <bool> raft-pads;
    in property <float> raft-holes;
    in property <bool> raft-tabs;
    // One raft for all (#556).
    in property <bool> one-raft;
    // A zone preset's summary (#360), empty without one: the preset sizes
    // and spaces the supports itself, so the placement knobs give way to it.
    in property <string> zone-summary;
    // The zone preset's pillar grid (#464): on or off, its spacing, and the
    // spacing the preset recommends in words, empty when none does.
    in property <bool> grid-on;
    // Every support stands on the plate (#471): none on the model below.
    in property <bool> plate-only;
    // Mini supports, an adaptive base, braces as thick as their trunks
    // allow (#471).
    in property <bool> mini-supports: true;
    in property <bool> adaptive-base;
    in property <bool> braces-follow;
    in property <float> grid-spacing: 7;
    in property <string> grid-hint;
    // How many models have supports made on another grid than this one
    // (#576), and the press that makes theirs again.
    in property <int> grid-stale;
    callback grid-regenerate();
    // The raft would take the models' first layers (#131): the warning, empty
    // when it does not, and the label of its lift button.
    in property <string> raft-clash-message;
    in property <string> raft-lift-label;
    // Whether Generate lifts the models resting on the plate first (#389),
    // a setting, and its box's text with the height.
    in property <bool> lift-on-plate;
    in property <string> lift-on-plate-label;
    callback lift-on-plate-toggled(bool);
    // From under the plate, settings: whether the rafts fade out with the
    // plate (#481, #492), and whether the supports do too, drawn as dotted
    // lines (#493).
    in property <bool> hide-rafts-under-plate: true;
    callback hide-rafts-under-plate-toggled(bool);
    in property <bool> lines-under-plate;
    callback lines-under-plate-toggled(bool);
    // The Add tool (#3): whether it is armed, the tip size it places (0 the
    // preset's, 1 to 4 extra small to large), that tip in words, and the
    // hover preview's line, with whether it warns.
    in property <bool> add-tool-on;
    in property <int> tip-size;
    in property <string> tip-label;
    in property <string> add-note;
    in property <bool> add-note-warns;
    callback tip-size-picked(int);
    // Remove (#3): whether it is armed, and its drag: 0 a box, 1 a brush of
    // this radius (logical px).
    in property <bool> remove-tool-on;
    in property <int> remove-mode;
    in property <float> brush-radius;
    callback remove-mode-picked(int);
    // The selected object lift, editable here too.
    in property <bool> selection-valid;
    in property <float> lift;
    callback generate-requested();
    callback cancel-requested();
    // An option change: its code (DfSupportRun::on_option) and value.
    callback option-changed(int, float);
    callback preset-picked(int);
    callback preset-save(string);
    callback preset-delete();
    callback lift-edit(float);
    callback drop-to-plate();
    callback raft-lift();
    callback raft-off();
    callback raft-ignore();
    // The overhang map (#91, #484): its box, and the angle it paints by.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    // The supports the selected model came with (#259): how many bodies they
    // have, 0 for none, and the ways to be rid of them.
    in property <int> imported-bodies;
    callback remove-imported();
    callback replace-imported();
    // Made editable at the same contacts (#261).
    callback editable-imported();
    // The islands an analysis found (#525): how many no tip covers yet, -1
    // with no analysis of the models as they stand; whether a slice or Fix
    // All is busy; and the ways to find them and to support them all.
    in property <int> islands-left: -1;
    in property <bool> islands-busy;
    callback analyze-islands();
    callback support-islands();
    callback go-to-island();
    // The shape of a support (#564), with a zone preset: the built-in
    // presets as cards and the one in force (-1 the person's own), what a
    // custom one was made from, the drawing and its numbers, the sizes, the
    // numbers of the size shown, and where each size goes.
    in property <[PresetCard]> preset-cards;
    in property <int> preset-card-index: -1;
    in property <string> based-on;
    in property <bool> preset-resettable;
    callback preset-revert();
    in property <string> shape-scope;
    in property <image> shape-picture;
    in property <image> shape-tip-picture;
    in property <[ShapeCallout]> shape-tip-callouts;
    in property <image> shape-foot-picture;
    in property <[ShapeCallout]> shape-foot-callouts;
    // The plan (2D) is shown, not the 3D view.
    in property <bool> shape-flat;
    callback shape-flat-picked(bool);
    property <bool> braces-open;
    in property <[ShapeCallout]> shape-callouts;
    in property <int> shape-hot;
    callback shape-dragged(float, float);
    callback shape-pointed(int);
    in property <[ShapeSize]> shape-sizes;
    in property <int> shape-size;
    in property <string> shape-size-name;
    in property <[float]> shape-defaults;
    in property <float> zone-angle-default: -1;
    callback shape-size-picked(int);
    // The numbers, in this order: tip diameter, trunk diameter, tip length,
    // foot diameter, extra insertion, break point, foot thickness, join
    // cone, the tip of a support standing on the model, brace diameter,
    // bracing start.
    in property <[float]> shape-values;
    callback shape-value(int, float);
    // The whole preset's choices (#363): bottom, middle and top pattern
    // (simple, double, zigzag), the rings' diagonal (none, simple, double),
    // the bracing preset it is (-1 none), ignore small islands (0 or 1).
    // The line tool's spacing between supports, mm (#178).
    in property <float> line-spacing: 2;
    callback line-spacing-edited(float);
    // The Area tool (#177): its brush, and filling or clearing the paint.
    in property <float> area-brush: 3;
    callback area-brush-edited(float);
    callback area-fill();
    callback area-clear();
    // The supports picked routed again (#377), and how many there are.
    callback picked-reroute(bool);
    in property <int> picked-count;
    in property <[int]> shape-choices;
    in property <[int]> shape-choice-defaults;
    in property <[string]> bracing-presets;
    callback shape-choice(int, int);
    in property <[ZoneRow]> zone-rows;
    in property <[string]> zone-size-names;
    in property <float> zone-angle;
    callback zone-size(int, int);
    callback zone-spacing(int, float);
    callback zone-angle-edited(float);
    // The page shown: 0 what Generate places, 1 what the hand tools place.
    in property <int> page;
    callback page-picked(int);
    // The hand tool armed (0 none, 1 Add, 2 Remove, 3 Move tip, 4 Brace).
    in property <int> tool;
    callback tool-picked(int);
    // The hand sizes are off the ones that ship.
    in property <bool> hand-changed;
    callback hand-reset();
    // The person's own presets, and which of them is in use (-1 none).
    in property <[string]> own-presets;
    in property <int> own-preset-index: -1;
    callback own-preset-picked(int);
    // One file with presets and hand sizes, to hand to someone else.
    callback share-export();
    callback share-import();

    spacing: 12px;

    PageTabs {
        pages: [@tr("Inspector" => "Auto supports"), @tr("Inspector" => "Manual supports")];
        current: root.page;
        picked(i) => {
            root.page-picked(i);
        }
    }

    if root.imported-bodies > 0: Card {
        title: @tr("Inspector" => "IMPORTED SUPPORTS");

        Note {
            text: @tr("Inspector" => "This model came with its supports: {} bodies, raft included. They move with it; moving it up or down, tilting it or scaling it replaces them with supports made here.", root.imported-bodies);
        }
        ScButton {
            text: @tr("Inspector" => "Replace with Breadslicer supports");
            kind: ButtonKind.primary;
            enabled: !root.running;
            clicked => {
                root.replace-imported();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Make editable at the same contacts");
            enabled: !root.running;
            clicked => {
                root.editable-imported();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Remove imported supports");
            enabled: !root.running;
            clicked => {
                root.remove-imported();
            }
        }
        Note {
            text: @tr("Inspector" => "With Remove, a click takes off one body of them.");
        }
    }

    if root.raft-clash-message != "": Card {
        title: @tr("Inspector" => "RAFT");
        note: @tr("Inspector" => "Interferes with the model");
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: root.raft-clash-message;
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.raft-lift-label;
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                clicked => {
                    root.raft-lift();
                }
            }
            ScButton {
                text: @tr("Inspector" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.raft-off();
                }
            }
        }
        CheckBox {
            text: root.lift-on-plate-label;
            checked: root.lift-on-plate;
            toggled => {
                root.lift-on-plate-toggled(self.checked);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Generate anyway");
            kind: ButtonKind.ghost;
            clicked => {
                root.raft-ignore();
            }
        }
    }

    if root.page == 1: Card {
        title: @tr("Inspector" => "TOOLS");
        note: root.tool == 1 ? root.tip-label : "";
        note-color: Theme.indicator;

        HorizontalLayout {
            spacing: 6px;

            HandToolButton {
                icon: Icons.select;
                label: @tr("Inspector" => "Select");
                shortcut: "E";
                active: root.tool == 5;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 5 ? 0 : 5);
                }
            }
            HandToolButton {
                icon: Icons.add-support;
                label: @tr("Inspector" => "Add");
                shortcut: "A";
                active: root.tool == 1;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 1 ? 0 : 1);
                }
            }
            HandToolButton {
                icon: Icons.support-line;
                label: @tr("Inspector" => "Line");
                shortcut: "N";
                active: root.tool == 6;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 6 ? 0 : 6);
                }
            }
            HandToolButton {
                icon: Icons.support-area;
                label: @tr("Inspector" => "Area");
                shortcut: "P";
                active: root.tool == 7;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 7 ? 0 : 7);
                }
            }
            HandToolButton {
                icon: Icons.move-tip;
                label: @tr("Inspector" => "Move tip");
                shortcut: "M";
                active: root.tool == 3;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 3 ? 0 : 3);
                }
            }
            HandToolButton {
                icon: Icons.brace-supports;
                label: @tr("Inspector" => "Brace");
                shortcut: "C";
                active: root.tool == 4;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 4 ? 0 : 4);
                }
            }
            HandToolButton {
                icon: Icons.remove-support;
                label: @tr("Inspector" => "Remove");
                shortcut: "X";
                active: root.tool == 2;
                enabled: root.has-scene && !root.running;
                clicked => {
                    root.tool-picked(root.tool == 2 ? 0 : 2);
                }
            }
        }
        if root.tool == 0: Note {
            text: @tr("Inspector" => "Pick a tool, or press its key. The size below is the one Add places; keys 1–4 pick it.");
        }
        if root.tool == 1: Note {
            text: @tr("Inspector" => "Click the model where the support should touch it. Shift+click hangs it from the nearest support, or places nothing. Keys 1–4 pick the size.");
        }
        if root.tool == 3: Note {
            text: @tr("Inspector" => "Drag a support by its tip over the model; it is routed again where you let go.");
        }
        if root.tool == 5 && root.picked-count > 0: HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Own trunk");
                enabled: !root.running;
                clicked => {
                    root.picked-reroute(true);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Hang from nearest");
                enabled: !root.running;
                clicked => {
                    root.picked-reroute(false);
                }
            }
        }
        if root.tool == 5: Note {
            text: @tr("Inspector" => "Click a support to pick it, Shift+click to pick more. The numbers below then draw the picked supports again; a size chip gives them that size. Esc lets go.");
        }
        if root.tool == 4: Note {
            text: @tr("Inspector" => "Click a support where the brace starts, then the support it goes to.");
        }
        if root.tool == 6: Note {
            text: @tr("Inspector" => "Click the model where the row starts, then where it ends: a support at every dot, along the surface. Keys 1–4 pick the size. Esc drops the first point.");
        }
        if root.tool == 7: Note {
            text: @tr("Inspector" => "Paint the faces where supports go; Shift+click takes the connected faces of the same plane, Alt erases. Then place a support on every node of a grid over the paint.");
        }
        if root.tool == 7: NumberField {
            label: @tr("Inspector" => "Brush");
            unit: "mm";
            decimals: 1;
            value: root.area-brush;
            committed(v) => {
                root.area-brush-edited(v);
            }
        }
        if root.tool == 7: NumberField {
            label: @tr("Inspector" => "Supports apart");
            unit: "mm";
            decimals: 1;
            value: root.line-spacing;
            committed(v) => {
                root.line-spacing-edited(v);
            }
        }
        if root.tool == 7: HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Place supports on the paint");
                kind: ButtonKind.primary;
                enabled: !root.running;
                clicked => {
                    root.area-fill();
                }
            }
            ScButton {
                text: @tr("Inspector" => "Clear paint");
                kind: ButtonKind.ghost;
                clicked => {
                    root.area-clear();
                }
            }
        }
        if root.tool == 6: NumberField {
            label: @tr("Inspector" => "Supports apart");
            unit: "mm";
            decimals: 1;
            value: root.line-spacing;
            committed(v) => {
                root.line-spacing-edited(v);
            }
        }
        if root.tool == 2: LabeledRow {
            label: @tr("Inspector" => "Drag");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Box"), @tr("Inspector" => "Brush")];
                current: root.remove-mode;
                picked(i) => {
                    root.remove-mode-picked(i);
                }
            }
        }
        if root.tool == 2: Note {
            text: root.remove-mode == 1
                ? @tr("Inspector" => "Paint over the supports to remove, anywhere along them; [ ] or the mouse wheel size the brush ({} px). B switches to a box.", Math.round(root.brush-radius))
                : @tr("Inspector" => "Drag a box: every support it touches goes, from the selected supports only. B switches to a brush.");
        }
        if root.tool != 0 && root.add-note != "": Note {
            text: root.add-note;
            color: root.add-note-warns ? Theme.danger : Theme.text-soft;
        }
    }

    if root.page == 0: Card {
        title: @tr("Inspector" => "AUTO SUPPORTS");
        note: root.running ? @tr("Inspector" => "Working") : "";
        note-color: Theme.indicator;

        PresetCards {
            cards: root.preset-cards;
            current: root.preset-card-index;
            enabled: !root.running;
            picked(i) => {
                root.preset-picked(i);
            }
        }
        // One line that is always there: what the options are, and the
        // way back to the preset as it ships. Nothing under it moves when
        // a number changes.
        HorizontalLayout {
            spacing: 8px;
            height: 28px;

            Text {
                text: root.based-on;
                font-size: Theme.font-sm;
                color: root.preset-resettable ? Theme.indicator : Theme.text-muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            ScButton {
                text: @tr("Inspector" => "Reset to default");
                kind: ButtonKind.ghost;
                enabled: !root.running && root.preset-resettable;
                opacity: root.preset-resettable ? 1 : 0;
                clicked => {
                    root.preset-revert();
                }
            }
        }
    }

    if root.page == 1 || root.zone-summary != "": Card {
        title: @tr("Inspector" => "THE SUPPORT");
        note: root.shape-size-name;

        ScopeBox {
            title: root.shape-scope;
            note: root.page == 1 ? @tr("Inspector" => "for the next one placed") : @tr("Inspector" => "for the next Generate");
        }
        ShapeViewer {
            picture: root.shape-picture;
            callouts: root.shape-callouts;
            hot: root.shape-hot;
            turnable: !root.shape-flat;
            switchable: true;
            flat: root.shape-flat;
            dragged(dx, dy) => {
                root.shape-dragged(dx, dy);
            }
            part-clicked(part) => {
                root.shape-pointed(part);
            }
            value-dragged(field, v) => {
                root.shape-value(field, v);
            }
            flat-picked(flat) => {
                root.shape-flat-picked(flat);
            }
        }
        // What is too small to see in the whole support: the tip and the
        // foot, close up.
        HorizontalLayout {
            spacing: 6px;

            ShapeViewer {
                height: 112px;
                picture: root.shape-tip-picture;
                callouts: root.shape-tip-callouts;
                hot: root.shape-hot;
                part-clicked(part) => {
                    root.shape-pointed(part);
                }
                value-dragged(field, v) => {
                    root.shape-value(field, v);
                }
            }
            ShapeViewer {
                height: 112px;
                picture: root.shape-foot-picture;
                callouts: root.shape-foot-callouts;
                hot: root.shape-hot;
                part-clicked(part) => {
                    root.shape-pointed(part);
                }
                value-dragged(field, v) => {
                    root.shape-value(field, v);
                }
            }
        }
        SizeChips {
            sizes: root.shape-sizes;
            current: root.shape-size;
            picked(i) => {
                root.shape-size-picked(i);
            }
        }
        tip-head := PartHead {
            title: @tr("Inspector" => "TIP");
            more: 2;
        }
        ShapeField {
            label: @tr("Inspector" => "Diameter");
            full-label: @tr("Inspector" => "Tip diameter");
            value: root.shape-values[0];
            default-value: root.shape-defaults.length > 0 ? root.shape-defaults[0] : -1;
            part: 1;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(0, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        ShapeField {
            label: @tr("Inspector" => "Length");
            full-label: @tr("Inspector" => "Tip length");
            value: root.shape-values[2];
            default-value: root.shape-defaults.length > 2 ? root.shape-defaults[2] : -1;
            part: 1;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(2, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if tip-head.open: ShapeField {
            label: @tr("Inspector" => "Extra into the model");
            full-label: @tr("Inspector" => "Extra into the model");
            value: root.shape-values[4];
            default-value: root.shape-defaults.length > 4 ? root.shape-defaults[4] : -1;
            part: 1;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(4, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if tip-head.open: ShapeField {
            label: @tr("Inspector" => "Break point");
            full-label: @tr("Inspector" => "Break point");
            value: root.shape-values[5];
            default-value: root.shape-defaults.length > 5 ? root.shape-defaults[5] : -1;
            part: 1;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(5, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        PartHead {
            title: @tr("Inspector" => "TRUNK");
        }
        ShapeField {
            label: @tr("Inspector" => "Diameter");
            full-label: @tr("Inspector" => "Trunk diameter");
            value: root.shape-values[1];
            default-value: root.shape-defaults.length > 1 ? root.shape-defaults[1] : -1;
            part: 2;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(1, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        foot-head := PartHead {
            title: @tr("Inspector" => "FOOT");
            more: 3;
        }
        ShapeField {
            label: @tr("Inspector" => "Diameter");
            full-label: @tr("Inspector" => "Foot diameter");
            value: root.shape-values[3];
            default-value: root.shape-defaults.length > 3 ? root.shape-defaults[3] : -1;
            part: 3;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(3, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if foot-head.open: ShapeField {
            label: @tr("Inspector" => "Thickness");
            full-label: @tr("Inspector" => "Foot thickness");
            value: root.shape-values[6];
            default-value: root.shape-defaults.length > 6 ? root.shape-defaults[6] : -1;
            part: 3;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(6, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if foot-head.open: ShapeField {
            label: @tr("Inspector" => "Join cone");
            full-label: @tr("Inspector" => "Join cone");
            value: root.shape-values[7];
            default-value: root.shape-defaults.length > 7 ? root.shape-defaults[7] : -1;
            part: 3;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(7, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if foot-head.open: ShapeField {
            label: @tr("Inspector" => "Tip on the model, length");
            full-label: @tr("Inspector" => "Tip on the model, length");
            value: root.shape-values[8];
            default-value: root.shape-defaults.length > 8 ? root.shape-defaults[8] : -1;
            part: 3;
            hot: root.shape-hot;
            edited(v) => { root.shape-value(8, v); }
            pointed(p) => { root.shape-pointed(p); }
        }
        if root.page == 0: PartHead {
            title: @tr("Inspector" => "BRACES");
            more: 3;
            open <=> root.braces-open;
        }
        if root.page == 0 && root.braces-open: CheckBox {
            text: @tr("Inspector" => "Cross-bracing");
            checked: root.bracing;
            toggled => {
                root.option-changed(7, self.checked ? 1 : 0);
            }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Brace diameter");
            value: root.shape-values[9];
            default-value: root.shape-defaults.length > 9 ? root.shape-defaults[9] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(9, v); }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Braces start at");
            value: root.shape-values[10];
            default-value: root.shape-defaults.length > 10 ? root.shape-defaults[10] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(10, v); }
        }
        if root.page == 0 && root.braces-open: LabeledRow {
            label: @tr("Inspector" => "Start from");

            bracing-start-combo := ComboBox {
                model: root.bracing-presets;
                // Follows the preset after a pick broke the binding.
                property <int> wanted: root.shape-choices.length > 4 ? root.shape-choices[4] : 0;
                changed wanted => {
                    self.current-index = self.wanted;
                }
                current-index: self.wanted;
                enabled: root.bracing;
                selected => {
                    root.shape-choice(4, bracing-start-combo.current-index);
                }
            }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Gap between links");
            unit: "mm";
            value: root.shape-values.length > 11 ? root.shape-values[11] : 0;
            default-value: root.shape-defaults.length > 11 ? root.shape-defaults[11] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(11, v); }
        }
        if root.page == 0 && root.braces-open: LabeledRow {
            label: @tr("Inspector" => "Bottom pattern");

            bottom-pattern-combo := ComboBox {
                model: [@tr("Inspector" => "Simple"), @tr("Inspector" => "Double"), @tr("Inspector" => "Zigzag")];
                // Follows the preset after a pick broke the binding.
                property <int> wanted: root.shape-choices.length > 0 ? root.shape-choices[0] : 0;
                changed wanted => {
                    self.current-index = self.wanted;
                }
                current-index: self.wanted;
                enabled: root.bracing;
                selected => {
                    root.shape-choice(0, bottom-pattern-combo.current-index);
                }
            }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Bottom links");
            unit: "";
            value: root.shape-values.length > 12 ? root.shape-values[12] : 0;
            default-value: root.shape-defaults.length > 12 ? root.shape-defaults[12] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(12, v); }
        }
        if root.page == 0 && root.braces-open: LabeledRow {
            label: @tr("Inspector" => "Middle pattern");

            middle-pattern-combo := ComboBox {
                model: [@tr("Inspector" => "Simple"), @tr("Inspector" => "Double"), @tr("Inspector" => "Zigzag")];
                // Follows the preset after a pick broke the binding.
                property <int> wanted: root.shape-choices.length > 1 ? root.shape-choices[1] : 0;
                changed wanted => {
                    self.current-index = self.wanted;
                }
                current-index: self.wanted;
                enabled: root.bracing;
                selected => {
                    root.shape-choice(1, middle-pattern-combo.current-index);
                }
            }
        }
        if root.page == 0 && root.braces-open: LabeledRow {
            label: @tr("Inspector" => "Top pattern");

            top-pattern-combo := ComboBox {
                model: [@tr("Inspector" => "Simple"), @tr("Inspector" => "Double"), @tr("Inspector" => "Zigzag")];
                // Follows the preset after a pick broke the binding.
                property <int> wanted: root.shape-choices.length > 2 ? root.shape-choices[2] : 0;
                changed wanted => {
                    self.current-index = self.wanted;
                }
                current-index: self.wanted;
                enabled: root.bracing;
                selected => {
                    root.shape-choice(2, top-pattern-combo.current-index);
                }
            }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Top links");
            unit: "";
            value: root.shape-values.length > 13 ? root.shape-values[13] : 0;
            default-value: root.shape-defaults.length > 13 ? root.shape-defaults[13] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(13, v); }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "First ring at");
            unit: "mm";
            value: root.shape-values.length > 14 ? root.shape-values[14] : 0;
            default-value: root.shape-defaults.length > 14 ? root.shape-defaults[14] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(14, v); }
        }
        if root.page == 0 && root.braces-open: ShapeField {
            label: @tr("Inspector" => "Second ring at");
            unit: "mm";
            value: root.shape-values.length > 15 ? root.shape-values[15] : 0;
            default-value: root.shape-defaults.length > 15 ? root.shape-defaults[15] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.bracing;
            edited(v) => { root.shape-value(15, v); }
        }
        if root.page == 0 && root.braces-open: LabeledRow {
            label: @tr("Inspector" => "Ring diagonal");

            ring-diagonal-combo := ComboBox {
                model: [@tr("Inspector" => "None"), @tr("Inspector" => "Simple"), @tr("Inspector" => "Double")];
                // Follows the preset after a pick broke the binding.
                property <int> wanted: root.shape-choices.length > 3 ? root.shape-choices[3] : 0;
                changed wanted => {
                    self.current-index = self.wanted;
                }
                current-index: self.wanted;
                enabled: root.bracing;
                selected => {
                    root.shape-choice(3, ring-diagonal-combo.current-index);
                }
            }
        }
        if root.page == 0 && root.braces-open: Note {
            text: @tr("Inspector" => "Links from the bottom and the top take their pattern, the rest the middle one. A ring is a cross between every pair at that height; 0 leaves it out.");
        }
    }

    if root.page == 1 && root.hand-changed: HorizontalLayout {
        spacing: 8px;

        Note {
            text: @tr("Inspector" => "The sizes are not the ones that ship.");
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ScButton {
            text: @tr("Inspector" => "Reset to default");
            kind: ButtonKind.ghost;
            clicked => {
                root.hand-reset();
            }
        }
    }

    if root.page == 0 && root.zone-summary != "": Card {
        title: @tr("Inspector" => "WHERE EACH SIZE GOES");
        collapsible: true;
        expanded: false;

        ShapeField {
            label: @tr("Inspector" => "Overhangs from");
            unit: "°";
            value: root.zone-angle;
            default-value: root.zone-angle-default;
            part: 0;
            hot: 0;
            edited(v) => { root.zone-angle-edited(v); }
        }
        for row[i] in root.zone-rows: ZoneRowView {
            zone: row;
            size-names: root.zone-size-names;
            size-picked(k) => {
                root.zone-size(i, k);
            }
            spacing-edited(v) => {
                root.zone-spacing(i, v);
            }
        }
        Note {
            text: @tr("Inspector" => "Each zone places the size picked, this many mm apart.");
        }
        CheckBox {
            text: @tr("Inspector" => "Ignore small islands");
            checked: root.shape-choices.length > 5 && root.shape-choices[5] != 0;
            toggled => {
                root.shape-choice(5, self.checked ? 1 : 0);
            }
        }
        ShapeField {
            label: @tr("Inspector" => "Smaller than");
            unit: "mm³";
            value: root.shape-values.length > 16 ? root.shape-values[16] : 0;
            default-value: root.shape-defaults.length > 16 ? root.shape-defaults[16] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.shape-choices.length > 5 && root.shape-choices[5] != 0;
            edited(v) => { root.shape-value(16, v); }
        }
        ShapeField {
            label: @tr("Inspector" => "Shorter than");
            unit: "mm";
            value: root.shape-values.length > 17 ? root.shape-values[17] : 0;
            default-value: root.shape-defaults.length > 17 ? root.shape-defaults[17] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: root.shape-choices.length > 5 && root.shape-choices[5] != 0;
            edited(v) => { root.shape-value(17, v); }
        }
        Note {
            text: @tr("Inspector" => "An island that joins the rest before gathering this much resin, within this height, gets no support of its own.");
        }
        ShapeField {
            label: @tr("Inspector" => "Look for the plate up to");
            unit: "mm";
            value: root.shape-values.length > 18 ? root.shape-values[18] : 0;
            default-value: root.shape-defaults.length > 18 ? root.shape-defaults[18] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: true;
            edited(v) => { root.shape-value(18, v); }
        }
        ShapeField {
            label: @tr("Inspector" => "Model stands above the plate");
            unit: "mm";
            value: root.shape-values.length > 19 ? root.shape-values[19] : 0;
            default-value: root.shape-defaults.length > 19 ? root.shape-defaults[19] : -1;
            part: 0;
            hot: root.shape-hot;
            enabled: true;
            edited(v) => { root.shape-value(19, v); }
        }
        CheckBox {
            text: @tr("Inspector" => "Pillars on a grid");
            checked: root.grid-on;
            // Under one raft for all the supports drop next to their model,
            // off the grid (#576).
            enabled: !root.one-raft;
            toggled => {
                root.option-changed(12, self.checked ? root.grid-spacing : 0);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Grid spacing");
            unit: "mm";
            decimals: 1;
            enabled: root.grid-on && !root.one-raft;
            value: root.grid-spacing;
            committed(v) => {
                root.option-changed(13, v);
            }
        }
        if root.one-raft: Note {
            text: @tr("Inspector" => "With one raft for all the supports drop next to their model, off the grid: the grid comes back with one raft for all off.");
        }
        CheckBox {
            text: @tr("Inspector" => "Supports only from the plate");
            checked: root.plate-only;
            toggled => {
                root.option-changed(15, self.checked ? 1 : 0);
            }
        }
        if root.plate-only: Note {
            text: @tr("Inspector" => "No support starts on the model: what cannot reach the plate is left out, and Review lists it.");
        }
        CheckBox {
            text: @tr("Inspector" => "Mini supports");
            checked: root.mini-supports;
            toggled => {
                root.option-changed(19, self.checked ? 1 : 0);
            }
        }
        if root.mini-supports: Note {
            text: @tr("Inspector" => "A long branch out to an island hangs from the nearest support instead, shorter.");
        }
        CheckBox {
            text: @tr("Inspector" => "Adaptive base");
            checked: root.adaptive-base;
            toggled => {
                root.option-changed(20, self.checked ? 1 : 0);
            }
        }
        if root.adaptive-base: Note {
            text: @tr("Inspector" => "A tall support stands on a wider base: from 20 mm up it grows, to one and a half times at 60 mm.");
        }
        CheckBox {
            text: @tr("Inspector" => "Braces as thick as their trunks");
            checked: root.braces-follow;
            toggled => {
                root.option-changed(21, self.checked ? 1 : 0);
            }
        }
        if root.braces-follow: Note {
            text: @tr("Inspector" => "A brace is 0.8 of the thinner trunk it joins, instead of the preset's diameter.");
        }
        if root.grid-hint != "" && !root.one-raft: Note {
            text: root.grid-hint;
        }
        if root.grid-stale > 0: WarningNote {
            text: @tr("Inspector" => "{n} model has supports made on another grid. They are not made again on their own." | "{n} models have supports made on another grid. They are not made again on their own." % root.grid-stale);
        }
        if root.grid-stale > 0: ScButton {
            text: @tr("Inspector" => "Regenerate their supports");
            icon: Icons.rotate;
            clicked => {
                root.grid-regenerate();
            }
        }
    }

    if root.page == 0: Card {
        title: @tr("Inspector" => "ISLANDS");
        note: root.islands-left > 0 ? @tr("Inspector" => "{n} left" | "{n} left" % root.islands-left) : "";
        note-color: Theme.warning;

        if root.islands-busy: Note {
            text: @tr("Inspector" => "Finding the islands and supporting them…");
        }
        if root.islands-left < 0 && !root.islands-busy: Note {
            text: @tr("Inspector" => "Slices the plate and marks in red where a part starts with nothing under it.");
        }
        if root.islands-left == 0: Note {
            text: @tr("Inspector" => "No island is left without a support.");
        }
        if root.islands-left > 0: Note {
            text: @tr("Inspector" => "{n} island without a support, marked in red." | "{n} islands without a support, marked in red." % root.islands-left);
        }
        ScButton {
            text: root.islands-left < 0 ? @tr("Inspector" => "Analyze islands") : @tr("Inspector" => "Analyze again");
            icon: Icons.search;
            enabled: root.has-scene && !root.running && !root.islands-busy;
            clicked => {
                root.analyze-islands();
            }
        }
        if root.islands-left > 0: ScButton {
            text: root.islands-left == 1 ? @tr("Inspector" => "Go to the island") : @tr("Inspector" => "Go to the next island");
            icon: Icons.target;
            enabled: !root.islands-busy;
            clicked => {
                root.go-to-island();
            }
        }
        if root.islands-left > 0: ScButton {
            text: @tr("Inspector" => "Support all islands");
            kind: ButtonKind.primary;
            enabled: !root.running && !root.islands-busy;
            clicked => {
                root.support-islands();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "LIFT");

        if root.raft-clash-message == "": CheckBox {
            text: root.lift-on-plate-label;
            checked: root.lift-on-plate;
            toggled => {
                root.lift-on-plate-toggled(self.checked);
            }
        }
        if root.selection-valid: NumberField {
            label: @tr("Inspector" => "Height above plate");
            unit: "mm";
            value: root.lift;
            committed(v) => {
                root.lift-edit(v);
            }
        }
        if root.selection-valid: ScButton {
            text: @tr("Inspector" => "Drop to plate");
            clicked => {
                root.drop-to-plate();
            }
        }
        if root.selection-valid: Note {
            text: @tr("Inspector" => "Room under the model for the supports; moving it again marks them out of date.");
        }
    }

    if root.page == 0 && root.zone-summary == "": Card {
        title: @tr("Inspector" => "PLACEMENT");
        collapsible: true;

        if root.zone-summary == "": VerticalLayout {
            spacing: 10px;

            LabeledRow {
                label: @tr("Inspector" => "Support size");
                Segmented {
                    width: 190px;
                    options: [@tr("Inspector" => "Detail"), @tr("Inspector" => "Structure"), @tr("Inspector" => "Anchor")];
                    current: root.sizing-index;
                    picked(i) => {
                        root.option-changed(0, i);
                    }
                }
            }
            NumberField {
                label: @tr("Inspector" => "Area per support");
                unit: "mm²";
                decimals: 1;
                value: root.density;
                committed(v) => {
                    root.option-changed(1, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Overhang angle");
                unit: "°";
                decimals: 0;
                value: root.angle;
                committed(v) => {
                    root.option-changed(2, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Size scale");
                unit: "×";
                value: root.size-scale;
                committed(v) => {
                    root.option-changed(3, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Smallest island");
                unit: "mm²";
                value: root.min-island;
                committed(v) => {
                    root.option-changed(4, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Coverage");
                unit: "%";
                decimals: 0;
                value: root.coverage;
                committed(v) => {
                    root.option-changed(5, v);
                }
            }
            CheckBox {
                text: @tr("Inspector" => "Stabilize poses on a point or edge");
                checked: root.stabilization;
                toggled => {
                    root.option-changed(6, self.checked ? 1 : 0);
                }
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Cross-bracing");
            checked: root.bracing;
            toggled => {
                root.option-changed(7, self.checked ? 1 : 0);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Shape");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Smooth"), @tr("Inspector" => "Classic")];
                current: root.smooth ? 0 : 1;
                picked(i) => {
                    root.option-changed(8, i == 0 ? 1 : 0);
                }
            }
        }
    }

    if root.page == 0: Card {
        title: @tr("Inspector" => "RAFT");
        collapsible: true;
        expanded: false;

        LabeledRow {
            label: @tr("Inspector" => "Bottom");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Solid"), @tr("Inspector" => "Lines"), @tr("Inspector" => "Off")];
                current: root.raft-index;
                picked(i) => {
                    root.option-changed(9, i);
                }
            }
        }
        CheckBox {
            text: @tr("Inspector" => "One raft for all");
            checked: root.one-raft;
            toggled => {
                root.option-changed(14, self.checked ? 1 : 0);
            }
        }
        if root.one-raft: Note {
            text: @tr("Inspector" => "One raft of lines under every model of the plate, drawn again as they move.");
        }
        NumberField {
            label: @tr("Inspector" => "Thickness");
            unit: "mm";
            value: root.raft-thickness;
            enabled: root.raft-index != 2;
            committed(v) => {
                root.option-changed(10, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Crenelated wall");
            checked: root.raft-wall;
            enabled: root.raft-index == 0;
            toggled => {
                root.option-changed(11, self.checked ? 1 : 0);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "A pad under each support");
            checked: root.raft-pads;
            enabled: root.raft-index == 0;
            toggled => {
                root.option-changed(16, self.checked ? 1 : 0);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Holes between supports");
            unit: "mm";
            decimals: 1;
            value: root.raft-holes;
            enabled: root.raft-index == 0;
            committed(v) => {
                root.option-changed(17, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Peel tabs");
            checked: root.raft-tabs;
            enabled: root.raft-index == 0;
            toggled => {
                root.option-changed(18, self.checked ? 1 : 0);
            }
        }
        if root.raft-index == 0 && (root.raft-pads || root.raft-holes > 0 || root.raft-tabs): Note {
            text: @tr("Inspector" => "Less raft to peel off the film: holes 0 for none. Print one to see how it holds before using it on a plate.");
        }
    }

    if root.page == 0: Card {
        title: @tr("Inspector" => "PRESETS");
        collapsible: true;
        expanded: false;

        if root.own-presets.length > 0: OwnPresets {
            names: root.own-presets;
            current: root.own-preset-index;
            enabled: !root.running;
            picked(i) => {
                root.own-preset-picked(i);
            }
        }
        preset-name := LineEdit {
            placeholder-text: @tr("Inspector" => "Name for a new preset");
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Save as preset");
                horizontal-stretch: 1;
                enabled: preset-name.text != "";
                clicked => {
                    root.preset-save(preset-name.text);
                    preset-name.text = "";
                }
            }
            ScButton {
                text: @tr("Inspector" => "Delete");
                clicked => {
                    root.preset-delete();
                }
            }
        }
        Note {
            text: @tr("Inspector" => "Built-in presets cannot be deleted. Presets are saved as TOML files in the app data folder.");
        }
    }

    Card {
        title: @tr("Inspector" => "SHARE");
        collapsible: true;
        expanded: false;

        Note {
            text: @tr("Inspector" => "One file with your presets and your hand sizes, whichever you tick, to hand to someone else or to keep.");
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Export…");
                horizontal-stretch: 1;
                clicked => {
                    root.share-export();
                }
            }
            ScButton {
                text: @tr("Inspector" => "Import…");
                horizontal-stretch: 1;
                clicked => {
                    root.share-import();
                }
            }
        }
    }
}

// Generate, pinned under the Supports tab (#564): its button, the lift
// box, the run's progress and Cancel, and how the last run went.
export component SupportsFooter inherits Rectangle {
    in property <bool> has-scene;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <bool> cancelable;
    in property <string> last-run;
    callback generate-requested();
    callback cancel-requested();

    background: Theme.chrome;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        ScButton {
            text: @tr("Inspector" => "Generate supports");
            icon: Icons.auto;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.has-scene && !root.running;
            clicked => {
                root.generate-requested();
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            if root.cancelable: ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
    }
}

export component SliceInspector inherits VerticalLayout {
    // The plates' names, with several (#547): the one picked is the one
    // sliced, and the active one.
    in property <[string]> plate-options;
    in-out property <int> plate-current-index;
    callback plate-picked(int);
    // Every plate sliced in turn, those up to date left as they are (#547),
    // and what it did.
    callback slice-every-plate();
    in property <string> every-plate-note;
    // How many hidden models the slice leaves out (#16), said; empty with
    // none.
    in property <string> hidden-note;
    // The printer file, written from here once the slice is up to date
    // (#578): its format, why it may not be written, and the action that
    // takes the place of Slice.
    in property <[string]> format-options;
    in-out property <int> format-current-index: -1;
    in property <string> format-note;
    in property <bool> export-enabled;
    // A save, an export or a load running.
    in property <bool> exporting;
    callback format-picked(int);
    callback export-printer-file();
    // With several plates (#549): each plate sliced in turn, a file each.
    callback export-every-plate();
    // Send to printer (#630), for a printer that takes a print over the
    // network: Send leaves the file on it, Send and start prints it.
    in property <bool> send-shown;
    in property <[string]> send-printers;
    in-out property <int> send-index: -1;
    in property <bool> send-searching;
    in property <bool> send-busy;
    in property <bool> send-preparing;
    in property <float> send-progress;
    in property <string> send-status;
    in property <bool> send-status-bad;
    // The file's name on the printer, asked before each send.
    in-out property <bool> send-naming;
    in property <bool> send-naming-start;
    in-out property <string> send-name;
    in property <string> send-name-preview;
    callback send-name-asked(bool);
    callback send-name-edited(string);
    callback send-search(bool);
    callback send-address(string);
    callback send(bool, string);
    callback send-cancel();
    callback send-picked(int);
    // The printer picked, as Breadslicer knows it (#631): its own name, the
    // printer profile it is, the resin it is kept for and a note.
    in property <string> send-own-summary;
    in-out property <bool> send-own-open;
    in-out property <string> send-own-name;
    in property <string> send-own-reported;
    in property <[string]> send-own-printers;
    in-out property <int> send-own-printer-index;
    in property <[string]> send-own-resins;
    in-out property <int> send-own-resin-index;
    in-out property <string> send-own-note;
    in property <bool> send-own-can-use;
    in-out property <bool> send-use-asking;
    in property <string> send-use-question;
    // Why sending to it may print wrong; empty when its profile is the plate's.
    in property <string> send-mismatch;
    // 0 name, 1 printer profile, 2 resin, 3 note, 4 use them, 5 use them
    // over the slice made.
    callback send-own-edited(int, string, int);
    // The picked printer's camera (#633).
    in property <bool> camera-on;
    in property <bool> camera-live;
    in-out property <bool> camera-large;
    in property <image> camera-image;
    in property <string> camera-status;
    in property <bool> camera-status-bad;
    callback camera-toggle();
    // Opens every printer's camera at once (#643).
    callback cameras-open();
    // PRINT SETUP open or folded: kept by the window, so it stays as left
    // when the tab is left and come back to.
    in-out property <bool> setup-open: true;
    in property <[string]> printer-options;
    in-out property <int> printer-current-index: -1;
    in property <[string]> resin-options;
    in-out property <int> resin-current-index: -1;
    in-out property <string> first-layer-height-text;
    // Adaptive layer heights (#60): on or off, the thinnest and the thickest
    // layer in millimetres, and what the format picked does with them.
    in-out property <bool> adaptive-on;
    in property <float> adaptive-min;
    in property <float> adaptive-max;
    in property <string> adaptive-note;
    in property <bool> slicing;
    in property <bool> up-to-date;
    in property <int> layer-count;
    in property <float> selected-layer;
    in property <image> layer-image;
    in property <bool> estimate-valid;
    in property <string> estimate-time;
    in property <string> estimate-time-caption;
    in property <string> estimate-volume;
    in property <string> estimate-mass;
    in property <string> estimate-note;
    // The layer timeline (#94): see `LayerTimeline`.
    in property <bool> timeline-valid;
    in property <string> timeline-force;
    in property <string> timeline-area;
    in property <string> timeline-perimeter;
    in property <string> timeline-time;
    in property <[TimelineMark]> timeline-spikes;
    in property <string> timeline-peak;
    in property <int> timeline-generation;
    in-out property <int> timeline-figure;
    in-out property <bool> timeline-open: true;
    pure callback timeline-readout(int, int) -> string;
    callback timeline-layer-picked(int);
    // What the print costs in resin (#101): the cost, why there is none,
    // each model's share with several, and the price of the slice's resin
    // as typed (0 price, 1 currency, 2 bottle content, 3 losses %, 4 grams
    // a print was weighed to take); the content in ml (0) or g (1).
    in property <string> cost;
    in property <string> cost-note;
    in property <[string]> cost-rows;
    in-out property <bool> cost-open: true;
    in-out property <string> price-text;
    in-out property <string> price-currency;
    in-out property <string> price-amount;
    in-out property <string> price-losses;
    in-out property <string> price-weighed;
    in-out property <int> price-unit;
    callback price-edited(int, string);
    callback price-unit-picked(int);
    // Fix All placing its supports (#390): Slice and Export wait.
    in property <bool> review-fixing;
    // The overhang map (#91, #484): its box, and the angle it paints by.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    callback printer-picked(int);
    callback resin-picked(int);
    callback first-layer-height-edited(string);
    callback adaptive-layers-changed(bool, float, float);
    callback slice-requested();

    // The LineEdit's text binding breaks the first time the user types, so
    // a value pushed from Rust is written into it explicitly.
    changed first-layer-height-text => {
        first-layer-input.text = root.first-layer-height-text;
    }

    spacing: 12px;
    // What the review cannot take of the height stays below it, not between
    // the cards (PRINT SETUP folded leaves more over).
    alignment: start;

    Card {
        title: @tr("Inspector" => "PRINT SETUP");
        vertical-stretch: 0;
        collapsible: true;
        expanded <=> root.setup-open;
        // Folded, the resin in use beside the title: the printer is in the
        // top bar.
        note: !root.setup-open && root.resin-current-index >= 0
            ? root.resin-options[root.resin-current-index] : "";

        Field {
            label: @tr("SlicePanel" => "Printer");
            printer-combo := ComboBox {
                model: root.printer-options;
                current-index <=> root.printer-current-index;
                enabled: root.printer-options.length > 0;
                selected => {
                    root.printer-picked(printer-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "Resin");
            resin-combo := ComboBox {
                model: root.resin-options;
                current-index <=> root.resin-current-index;
                enabled: root.resin-options.length > 0;
                selected => {
                    root.resin-picked(resin-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "Print format");
            format-combo := ComboBox {
                model: root.format-options;
                current-index <=> root.format-current-index;
                enabled: root.format-options.length > 0;
                selected => {
                    root.format-picked(format-combo.current-index);
                }
            }
        }
        if root.format-note != "": Note {
            text: root.format-note;
        }
        Field {
            label: @tr("SlicePanel" => "First layer height (mm)");
            first-layer-input := LineEdit {
                text: root.first-layer-height-text;
                placeholder-text: @tr("SlicePanel" => "from resin profile");
                accessible-label: @tr("SlicePanel" => "First layer height in millimetres");
                edited(t) => {
                    root.first-layer-height-edited(t);
                }
            }
        }
        CheckBox {
            text: @tr("SlicePanel" => "Adaptive layers");
            checked <=> root.adaptive-on;
            toggled => {
                root.adaptive-layers-changed(self.checked, root.adaptive-min, root.adaptive-max);
            }
        }
        if root.adaptive-on: NumberField {
            label: @tr("SlicePanel" => "Thinnest layer");
            unit: "mm";
            decimals: 3;
            value: root.adaptive-min;
            committed(value) => {
                root.adaptive-layers-changed(true, value, root.adaptive-max);
            }
        }
        if root.adaptive-on: NumberField {
            label: @tr("SlicePanel" => "Thickest layer");
            unit: "mm";
            decimals: 3;
            value: root.adaptive-max;
            committed(value) => {
                root.adaptive-layers-changed(true, root.adaptive-min, value);
            }
        }
        if root.adaptive-on && root.adaptive-note != "": Note {
            text: root.adaptive-note;
        }
    }

    // Slice, then Export (#578): Export works once the slice is up to date
    // and a format is picked, and is the one drawn as the main action then.
    // The plate is the one picked in the scene panel.
    VerticalLayout {
        spacing: 8px;
        vertical-stretch: 0;

        ScButton {
            text: root.plate-options.length > 1
                ? @tr("SlicePanel" => "Slice “{}”", root.plate-options[root.plate-current-index])
                : @tr("SlicePanel" => "Slice");
            icon: Icons.slice;
            kind: root.export-enabled ? ButtonKind.normal : ButtonKind.primary;
            button-height: 38px;
            enabled: root.printer-current-index >= 0 && root.resin-current-index >= 0 && !root.slicing && !root.review-fixing;
            clicked => {
                root.slice-requested();
            }
        }
        ScButton {
            text: root.plate-options.length > 1
                ? @tr("SlicePanel" => "Export “{}”", root.plate-options[root.plate-current-index])
                : @tr("SlicePanel" => "Export for printer");
            icon: Icons.file;
            kind: root.export-enabled ? ButtonKind.primary : ButtonKind.normal;
            button-height: 38px;
            enabled: root.export-enabled && !root.slicing && !root.exporting && !root.review-fixing;
            clicked => {
                root.export-printer-file();
            }
        }
        if root.plate-options.length > 1: ScButton {
            text: @tr("SlicePanel" => "Slice every plate");
            icon: Icons.slice;
            enabled: root.printer-current-index >= 0 && root.resin-current-index >= 0 && !root.slicing && !root.review-fixing;
            clicked => {
                root.slice-every-plate();
            }
        }
        if root.plate-options.length > 1: ScButton {
            text: @tr("SlicePanel" => "Export every plate");
            icon: Icons.file;
            enabled: root.format-options.length > 0 && !root.slicing && !root.exporting && !root.review-fixing;
            clicked => {
                root.export-every-plate();
            }
        }
        if root.hidden-note != "": WarningNote {
            text: root.hidden-note;
        }
        if root.up-to-date: Note {
            text: @tr("SlicePanel" => "Slice is up to date.");
        }
        if root.every-plate-note != "": Note {
            text: root.every-plate-note;
        }
    }

    if root.send-shown: Card {
        title: @tr("Inspector" => "SEND TO PRINTER");
        vertical-stretch: 0;
        note: root.send-searching ? @tr("SlicePanel" => "Searching…") : "";
        // Showing, it looks for the printers on the network, unless it
        // looked a moment ago.
        init => {
            root.send-search(false);
        }

        Field {
            label: @tr("SlicePanel" => "Printer on the network");
            HorizontalLayout {
                spacing: 6px;
                send-combo := ComboBox {
                    horizontal-stretch: 1;
                    model: root.send-printers;
                    current-index <=> root.send-index;
                    enabled: root.send-printers.length > 0 && !root.send-busy;
                    selected(value) => {
                        root.send-picked(self.current-index);
                    }
                }
                ScButton {
                    text: @tr("SlicePanel" => "Search");
                    enabled: !root.send-searching && !root.send-busy;
                    clicked => {
                        root.send-search(true);
                    }
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "Or its IP address");
            HorizontalLayout {
                spacing: 6px;
                address-input := LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "192.168.1.50";
                    enabled: !root.send-busy;
                    accepted(t) => {
                        root.send-address(t);
                    }
                }
                ScButton {
                    text: @tr("SlicePanel" => "Add");
                    enabled: address-input.text != "" && !root.send-busy;
                    clicked => {
                        root.send-address(address-input.text);
                    }
                }
            }
        }
        // What the picked printer is kept for, folded to one line.
        if root.send-index >= 0: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                // One line: a text that wraps under an `if` is measured as
                // one line, and the card would cut its last row.
                Text {
                    text: root.send-own-summary;
                    color: Theme.text-soft;
                    font-size: Theme.font-sm;
                    overflow: elide;
                }
            }
            ScButton {
                text: root.send-own-open
                    ? @tr("SlicePanel" => "Done")
                    : @tr("SlicePanel" => "Edit printer");
                enabled: !root.send-busy;
                clicked => {
                    root.send-own-open = !root.send-own-open;
                }
            }
        }
        if root.send-index >= 0 && root.send-own-open: VerticalLayout {
            spacing: 6px;
            Field {
                label: @tr("SlicePanel" => "Its name in Breadslicer");
                LineEdit {
                    text <=> root.send-own-name;
                    placeholder-text: root.send-own-reported;
                    accessible-label: @tr("SlicePanel" => "The printer's name in Breadslicer");
                    edited(t) => {
                        root.send-own-edited(0, t, 0);
                    }
                }
            }
            Field {
                label: @tr("SlicePanel" => "Printer profile");
                ComboBox {
                    model: root.send-own-printers;
                    current-index <=> root.send-own-printer-index;
                    selected(value) => {
                        root.send-own-edited(1, "", self.current-index);
                    }
                }
            }
            Field {
                label: @tr("SlicePanel" => "Resin it is kept for");
                ComboBox {
                    model: root.send-own-resins;
                    current-index <=> root.send-own-resin-index;
                    selected(value) => {
                        root.send-own-edited(2, "", self.current-index);
                    }
                }
            }
            Field {
                label: @tr("SlicePanel" => "Note");
                LineEdit {
                    text <=> root.send-own-note;
                    placeholder-text: @tr("SlicePanel" => "Dental only, the one by the window…");
                    edited(t) => {
                        root.send-own-edited(3, t, 0);
                    }
                }
            }
        }
        if root.send-index >= 0 && root.send-own-can-use && !root.send-use-asking: ScButton {
            text: @tr("SlicePanel" => "Slice for this printer");
            enabled: !root.send-busy && !root.slicing && !root.exporting;
            clicked => {
                root.send-own-edited(4, "", 0);
            }
        }
        if root.send-use-asking: VerticalLayout {
            spacing: 6px;
            WarningNote {
                text: root.send-use-question;
            }
            HorizontalLayout {
                spacing: 8px;
                ScButton {
                    horizontal-stretch: 1;
                    text: @tr("SlicePanel" => "Use them");
                    kind: ButtonKind.primary;
                    clicked => {
                        root.send-own-edited(5, "", 0);
                    }
                }
                ScButton {
                    text: @tr("SlicePanel" => "Back");
                    clicked => {
                        root.send-use-asking = false;
                    }
                }
            }
        }
        // Said again by the send button, which then reads Send anyway.
        if root.send-index >= 0 && root.send-mismatch != "": WarningNote {
            text: root.send-mismatch;
        }
        HorizontalLayout {
            spacing: 8px;
            ScButton {
                horizontal-stretch: 1;
                text: root.camera-on
                    ? @tr("SlicePanel" => "Hide camera")
                    : @tr("SlicePanel" => "Show camera");
                icon: Icons.camera;
                enabled: root.send-index >= 0 || root.camera-on;
                clicked => {
                    root.camera-toggle();
                }
            }
            ScButton {
                horizontal-stretch: 1;
                text: @tr("SlicePanel" => "All cameras");
                icon: Icons.enlarge;
                clicked => {
                    root.cameras-open();
                }
            }
        }
        if root.camera-on: Rectangle {
            height: 180px;
            background: #0b0c0d;
            border-radius: 3px;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.camera-image;
                image-fit: contain;
            }
            if !root.camera-live: Text {
                x: 10px;
                width: parent.width - 20px;
                height: 100%;
                text: root.camera-status;
                color: root.camera-status-bad ? Theme.warning : Theme.text-muted;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.camera-live;
                double-clicked => {
                    root.camera-large = true;
                }
            }
            if root.camera-live: ScButton {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                icon: Icons.enlarge;
                text: @tr("SlicePanel" => "Enlarge");
                clicked => {
                    root.camera-large = true;
                }
            }
        }
        if !root.send-busy && !root.send-naming: HorizontalLayout {
            spacing: 8px;
            ScButton {
                horizontal-stretch: 1;
                text: @tr("SlicePanel" => "Send to printer");
                icon: Icons.file;
                button-height: 34px;
                enabled: root.send-index >= 0 && root.export-enabled && !root.slicing && !root.exporting && !root.review-fixing;
                clicked => {
                    root.send-name-asked(false);
                }
            }
            ScButton {
                horizontal-stretch: 1;
                text: @tr("SlicePanel" => "Send and start");
                icon: Icons.slice;
                button-height: 34px;
                enabled: root.send-index >= 0 && root.export-enabled && !root.slicing && !root.exporting && !root.review-fixing;
                clicked => {
                    root.send-name-asked(true);
                }
            }
        }
        // Before each send, the name the file goes onto the printer by.
        if !root.send-busy && root.send-naming: VerticalLayout {
            spacing: 6px;
            Field {
                label: @tr("SlicePanel" => "Name on the printer");
                name-input := LineEdit {
                    text <=> root.send-name;
                    accessible-label: @tr("SlicePanel" => "Name of the file on the printer");
                    init => {
                        self.focus-all();
                    }
                    edited(t) => {
                        root.send-name-edited(t);
                    }
                    accepted(t) => {
                        root.send(root.send-naming-start, t);
                    }
                }
            }
            Note {
                text: @tr("SlicePanel" => "On the printer: {}", root.send-name-preview);
            }
            HorizontalLayout {
                spacing: 8px;
                ScButton {
                    horizontal-stretch: 1;
                    text: root.send-mismatch != ""
                        ? @tr("SlicePanel" => "Send anyway")
                        : root.send-naming-start
                        ? @tr("SlicePanel" => "Send and start")
                        : @tr("SlicePanel" => "Send to printer");
                    icon: root.send-naming-start ? Icons.slice : Icons.file;
                    kind: ButtonKind.primary;
                    button-height: 34px;
                    enabled: root.export-enabled && !root.slicing && !root.exporting;
                    clicked => {
                        root.send(root.send-naming-start, root.send-name);
                    }
                }
                ScButton {
                    text: @tr("SlicePanel" => "Back");
                    button-height: 34px;
                    clicked => {
                        root.send-naming = false;
                    }
                }
            }
        }
        if root.send-busy: HorizontalLayout {
            spacing: 8px;
            ProgressIndicator {
                horizontal-stretch: 1;
                progress: root.send-progress;
                indeterminate: root.send-preparing;
            }
            ScButton {
                text: @tr("SlicePanel" => "Cancel");
                enabled: !root.send-preparing;
                clicked => {
                    root.send-cancel();
                }
            }
        }
        if root.send-status != "" && root.send-status-bad: WarningNote {
            text: root.send-status;
        }
        if root.send-status != "" && !root.send-status-bad: Note {
            text: root.send-status;
        }
        if root.send-status == "" && !root.export-enabled: Note {
            text: @tr("SlicePanel" => "Slice first: what is sent is the file Export writes.");
        }
    }

    Card {
        title: @tr("Inspector" => "RESULT");
        vertical-stretch: 0;
        note: root.layer-count > 0 ? @tr("Inspector" => "Sliced") : @tr("Inspector" => "Not sliced");
        note-color: root.layer-count > 0 ? Theme.success : Theme.text-muted;

        if root.layer-count == 0: Note {
            text: @tr("Inspector" => "Slice to see the layers, the estimates and the checks.");
        }
        if root.layer-count > 0: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.layer-count;
                caption: @tr("Inspector" => "layers");
            }
            StatTile {
                value: Math.round(root.selected-layer) + 1;
                caption: @tr("Inspector" => "current layer");
            }
        }
        if root.layer-count > 0 && root.estimate-valid: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.estimate-time;
                caption: root.estimate-time-caption;
            }
            StatTile {
                value: root.estimate-volume;
                caption: @tr("Inspector" => "resin");
            }
            StatTile {
                value: root.estimate-mass;
                caption: @tr("Inspector" => "weight");
            }
        }
        if root.layer-count > 0 && !root.estimate-valid && root.estimate-note != "": Note {
            text: root.estimate-note;
        }
        if root.layer-count > 0: Rectangle {
            height: 180px;
            background: #0e0f10;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                width: parent.width - 8px;
                height: parent.height - 8px;
                source: root.layer-image;
                image-fit: contain;
            }
        }
    }

    // LAYERS (#94): each layer's force, area, perimeter and time.
    if root.layer-count > 0 && root.timeline-valid: Card {
        title: @tr("Inspector" => "LAYERS");
        vertical-stretch: 0;
        collapsible: true;
        expanded <=> root.timeline-open;

        if root.timeline-open: LayerTimeline {
            layer-count: root.layer-count;
            selected-layer: root.selected-layer;
            force-path: root.timeline-force;
            area-path: root.timeline-area;
            perimeter-path: root.timeline-perimeter;
            time-path: root.timeline-time;
            spikes: root.timeline-spikes;
            peak: root.timeline-peak;
            generation: root.timeline-generation;
            figure <=> root.timeline-figure;
            readout(layer, generation) => {
                return root.timeline-readout(layer, generation);
            }
            layer-picked(layer) => {
                root.timeline-layer-picked(layer);
            }
        }
    }

    // COST (#101): the resin the print takes, at the user's price.
    if root.layer-count > 0 && root.estimate-valid: Card {
        title: @tr("Inspector" => "COST");
        vertical-stretch: 0;
        collapsible: true;
        expanded <=> root.cost-open;
        // Folded, the cost beside the title.
        note: root.cost-open ? "" : root.cost;
        note-color: Theme.text;

        if root.cost != "": HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.cost;
                caption: @tr("Inspector" => "this print");
            }
        }
        for row in root.cost-rows: Text {
            text: row;
            font-size: Theme.font-sm;
            color: Theme.text-soft;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;

            Field {
                label: @tr("Inspector" => "Bottle price");
                price-input := PushedEdit {
                    pushed: root.price-text;
                    accessible-label: @tr("Inspector" => "What a bottle of this resin costs");
                    edited(t) => {
                        root.price-edited(0, t);
                    }
                }
            }
            Field {
                label: @tr("Inspector" => "Currency");
                width: 76px;
                currency-input := PushedEdit {
                    pushed: root.price-currency;
                    placeholder-text: "$";
                    edited(t) => {
                        root.price-edited(1, t);
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;

            Field {
                label: @tr("Inspector" => "Bottle holds");
                amount-input := PushedEdit {
                    pushed: root.price-amount;
                    placeholder-text: "1000";
                    edited(t) => {
                        root.price-edited(2, t);
                    }
                }
            }
            Field {
                label: @tr("Inspector" => "In");
                width: 76px;
                unit-combo := ComboBox {
                    model: ["ml", "g"];
                    current-index <=> root.price-unit;
                    selected => {
                        root.price-unit-picked(unit-combo.current-index);
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;

            Field {
                label: @tr("Inspector" => "Losses (%)");
                losses-input := PushedEdit {
                    pushed: root.price-losses;
                    placeholder-text: "0";
                    edited(t) => {
                        root.price-edited(3, t);
                    }
                }
            }
            Field {
                label: @tr("Inspector" => "Weighed used (g)");
                weighed-input := PushedEdit {
                    pushed: root.price-weighed;
                    accessible-label: @tr("Inspector" => "What the bottle lost to this print, weighed, in grams");
                    edited(t) => {
                        root.price-edited(4, t);
                    }
                }
            }
        }
        if root.cost-note != "": Note {
            text: root.cost-note;
        }
        Note {
            text: @tr("Inspector" => "Your price stays on this computer. Weigh the bottle before and after a print: what it lost sets the losses.");
        }
    }

}

// REVIEW (#90), floating over the 3D view in the Slice tab, low on its left:
// the column beside the view keeps the setup, the result and the cost whole
// on a 1080p screen. As tall as what it holds, up to `tallest`, past
// which its list scrolls; its heading folds it to see the model.
export component ReviewCard inherits Rectangle {
    // The review of the held slice (#90): 0 no slice, 1 reviewed, 2 failed,
    // 3 a slice not reviewed here (a reopened project's).
    in property <int> review-state;
    in property <string> review-summary;
    // The worst severity found (0 error, 1 warning, 2 information), -1 none.
    in property <int> review-worst: -1;
    in property <[ReviewRow]> review-rows;
    in property <bool> review-stale;
    in property <string> review-message;
    in-out property <int> review-selected: -1;
    // The notes (information) shown or folded, and how many there are.
    in property <int> review-notes;
    in property <bool> review-notes-open;
    // Resin traps that offer a fill and are not marked yet (#132).
    in property <int> review-fill-small;
    // The fills marked or cured, as one line, and whether they can be
    // cleared.
    in property <string> review-fills-note;
    in property <bool> review-fills-clearable;
    // The label of the button that clears the marks.
    in property <string> review-fills-clear-label;
    // How many findings Fix All (#156) would fix: 0 hides its button.
    in property <int> review-fix-all;
    // Fix All placing its supports (#390): its progress and Cancel stand
    // where its button was, and Slice waits.
    in property <bool> review-fixing;
    in property <float> review-fix-progress;
    in property <string> review-fix-phase;
    // "Repeat until clean" next to Fix all (#163): a setting.
    in property <bool> review-fix-repeat;
    callback review-fix-repeat-toggled(bool);
    callback review-finding-clicked(int);
    callback review-fix-requested(int);
    callback review-fill-toggled(int);
    callback review-leave-requested(int);
    callback review-delete-toggled(int);
    callback review-turn-requested(int);
    callback review-fill-small-requested();
    callback review-fills-cleared();
    callback review-notes-toggled();
    callback review-raft-off-requested(int);
    callback review-fix-all-requested();
    callback review-fix-all-cancel();
    // Unfolded or folded to its heading.
    in-out property <bool> open: true;
    // How tall it may grow.
    in property <length> tallest: 600px;

    // Folded, the card shows its heading alone: the body stays laid out
    // (a layout under an `if` was measured short) and is cut off.
    height: root.open ? card-layout.height : 36px;
    clip: true;

    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;

    card-layout := VerticalLayout {
        y: 0;
        height: Math.min(self.preferred-height, root.tallest);
        // The heading folds the card, with how it stands beside it folded.
        Rectangle {
            height: 36px;
            accessible-role: button;
            accessible-label: @tr("Review" => "REVIEW");
            accessible-expanded: root.open;
            accessible-action-default => {
                root.open = !root.open;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                DisclosureChevron {
                    open: root.open;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: @tr("Review" => "REVIEW");
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.review-stale ? @tr("Review" => "Out of date")
                        : root.open || root.review-state != 1 ? "" : root.review-summary;
                    font-size: Theme.font-xs;
                    color: root.review-stale ? Theme.warning
                        : root.review-worst < 0 ? Theme.success : ReviewTint.of(root.review-worst);
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border-soft;
        }
        VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 10px;


            if root.review-state == 1: HorizontalLayout {
                spacing: 8px;

                Icon {
                    commands: root.review-worst == 0 ? Icons.error : root.review-worst == 1 ? Icons.warning
                        : root.review-worst == 2 ? Icons.info : Icons.check;
                    color: root.review-worst < 0 ? Theme.success : ReviewTint.of(root.review-worst);
                    size: 18px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.review-summary;
                    font-size: Theme.font;
                    font-weight: 600;
                    color: root.review-worst < 0 ? Theme.success : Theme.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            if root.review-state == 3: Note {
                text: @tr("Review" => "This slice was not reviewed. Slice again to check it.");
            }
            if root.review-stale: WarningNote {
                text: @tr("Review" => "The scene changed since this slice. Slice again to review it.");
            }
            if root.review-message != "": Note {
                text: root.review-message;
                color: root.review-state == 2 ? Theme.danger : Theme.text-soft;
            }
            // The list asks for all its rows (a scroll view's content is as
            // tall as its layout's minimum); when the card reaches its height
            // it takes what is left and scrolls on its own.
            if root.review-state == 1 && root.review-rows.length > 0: ScrollView {
                vertical-stretch: 1;
                preferred-height: review-list.min-height;
                min-height: Math.min(review-list.min-height, 96px);
                viewport-width: self.visible-width;

                review-list := VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for row in root.review-rows: FindingRow {
                            finding: row;
                            selected: root.review-selected == row.id;
                            clicked => {
                                root.review-selected = row.id;
                                root.review-finding-clicked(row.id);
                            }
                            fix => {
                                root.review-fix-requested(row.id);
                            }
                            fill-toggled => {
                                root.review-fill-toggled(row.id);
                            }
                            leave => {
                                root.review-leave-requested(row.id);
                            }
                            delete-toggled => {
                                root.review-delete-toggled(row.id);
                            }
                            turn => {
                                root.review-turn-requested(row.id);
                            }
                            fix-alt => {
                                root.review-raft-off-requested(row.id);
                            }
                        }
                }
            }
            if root.review-state == 1 && root.review-notes > 0: ScButton {
                text: root.review-notes-open ? @tr("Review" => "Hide the notes") : @tr("Review" => "Show {n} note" | "Show {n} notes" % root.review-notes);
                kind: ButtonKind.ghost;
                clicked => {
                    root.review-notes-toggled();
                }
            }
            if root.review-state == 1 && root.review-fix-all > 0 && !root.review-fixing: HorizontalLayout {
                spacing: 10px;

                ScButton {
                    text: @tr("Review" => "Fix all ({})", root.review-fix-all);
                    icon: Icons.check;
                    clicked => {
                        root.review-fix-all-requested();
                    }
                }
                CheckBox {
                    text: @tr("Review" => "Repeat until clean");
                    checked: root.review-fix-repeat;
                    horizontal-stretch: 1;
                    toggled => {
                        root.review-fix-repeat-toggled(self.checked);
                    }
                }
            }
            if root.review-fixing: HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    alignment: center;

                    Text {
                        text: root.review-fix-phase == "" ? @tr("Review" => "Fixing all…") : root.review-fix-phase;
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    ProgressIndicator {
                        progress: root.review-fix-progress;
                    }
                }
                ScButton {
                    text: @tr("Review" => "Cancel");
                    clicked => {
                        root.review-fix-all-cancel();
                    }
                }
            }
            if root.review-state == 1 && root.review-fill-small > 0: ScButton {
                text: @tr("Review" => "Fill all small traps ({})", root.review-fill-small);
                icon: Icons.check;
                clicked => {
                    root.review-fill-small-requested();
                }
            }
            if root.review-fills-note != "": HorizontalLayout {
                spacing: 8px;

                Note {
                    text: root.review-fills-note;
                    horizontal-stretch: 1;
                }
                if root.review-fills-clearable: ScButton {
                    text: root.review-fills-clear-label;
                    kind: ButtonKind.ghost;
                    clicked => {
                        root.review-fills-cleared();
                    }
                }
            }
            if root.review-state == 1 && root.review-rows.length > 0: Note {
                text: @tr("Review" => "Click a finding to show its layer and centre the view on it.");
            }
        }
    }
}
