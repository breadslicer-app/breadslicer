// The right-hand inspector of each workflow tab (BS-68). Each component
// shows only what its tab acts on; the window binds them to its own
// properties and callbacks, which Rust drives.

import { CheckBox, ComboBox, LineEdit, ProgressIndicator, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "../kit/theme.slint";
import { Icons } from "../kit/icons.slint";
import { ButtonKind, Card, Dot, Icon, InfoRow, LabeledRow, Note, NumberField, ScButton, Segmented, StatTile } from "../kit/controls.slint";

// One finding of the slice review (#90), as Rust lays it out.
export struct ReviewRow {
    // The finding's index in the review, for the callbacks.
    id: int,
    // 0 error, 1 warning, 2 information.
    severity: int,
    // The group heading on the first row of a severity, else empty.
    header: string,
    title: string,
    // "Layer 12" or "Layers 11–25".
    layers: string,
    // One sentence with the numbers.
    detail: string,
    // 0 none, 1 add a support, 2 add a drain, 3 a drain that needs a model
    // hollowed in this window, 4 lift the model clear of the raft or turn
    // the raft off.
    fix: int,
    // The fix was applied since the slice.
    fixed: bool,
    // A cavity that can be cured on the next slice (#132): 0 no fill, 1
    // offered, 2 marked to fill.
    fill: int,
    // A tiny cavity that can be left alone (hidden until the scene changes).
    leave: bool,
    // The lift button of fix 4 ("Lift 17 layers").
    lift-label: string,
}

// The colour of a review severity.
global ReviewTint {
    public pure function of(severity: int) -> brush {
        return severity == 0 ? Theme.danger : severity == 1 ? Theme.warning : Theme.text-muted;
    }
}

// A selectable object row.
component ObjectRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    background: self.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
    accessible-role: list-item;
    accessible-label: self.text;
    accessible-item-selected: self.selected;
    accessible-action-default => {
        self.clicked();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: root.selected ? Theme.accent : transparent;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A finding of the review: its severity icon, title and layers. Selected,
// it unfolds its detail and its fix.
component FindingRow inherits VerticalLayout {
    in property <ReviewRow> finding;
    in property <bool> selected;
    callback clicked();
    callback fix();
    callback fill-toggled();
    callback leave();
    // The second fix of fix 4: turn the raft off.
    callback fix-alt();

    spacing: 4px;

    if root.finding.header != "": Text {
        text: root.finding.header;
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: ReviewTint.of(root.finding.severity);
    }
    Rectangle {
        min-height: line.preferred-height;
        border-radius: Theme.radius;
        background: root.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
        accessible-role: list-item;
        accessible-label: root.finding.title + ", " + root.finding.layers;
        accessible-item-selected: root.selected;
        accessible-action-default => {
            root.clicked();
        }

        line := HorizontalLayout {
            padding: 6px;
            padding-left: 8px;
            spacing: 8px;

            Icon {
                commands: root.finding.severity == 0 ? Icons.error : root.finding.severity == 1 ? Icons.warning : Icons.info;
                color: ReviewTint.of(root.finding.severity);
                size: 16px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.finding.title;
                font-size: Theme.font;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.finding.layers;
                font-family: Theme.mono;
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    if root.selected: VerticalLayout {
        padding-left: 32px;
        padding-right: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Note {
            text: root.finding.detail;
            color: Theme.text-soft;
        }
        if root.finding.fix == 1 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add support here");
            icon: Icons.add-support;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 2 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add drain here");
            icon: Icons.hole;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 4 && !root.finding.fixed: HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.finding.lift-label;
                horizontal-stretch: 1;
                clicked => {
                    root.fix();
                }
            }
            ScButton {
                text: @tr("Review" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.fix-alt();
                }
            }
        }
        if root.finding.fix == 3: Note {
            text: @tr("Review" => "A drain through the floor would empty it. Drains are drilled into models hollowed in the Hollow tab.");
        }
        if root.finding.fixed: Note {
            text: root.finding.fix == 1 ? @tr("Review" => "Support added.")
                : root.finding.fix == 4 ? @tr("Review" => "Done. Generate the supports again, then slice.")
                : @tr("Review" => "Drain requested.");
            color: Theme.success;
        }
        if root.finding.fill > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;

            ScButton {
                text: root.finding.fill == 2 ? @tr("Review" => "Do not fill") : @tr("Review" => "Fill on the next slice");
                icon: root.finding.fill == 2 ? "" : Icons.check;
                clicked => {
                    root.fill-toggled();
                }
            }
            if root.finding.leave && root.finding.fill == 1: ScButton {
                text: @tr("Review" => "Leave it");
                kind: ButtonKind.ghost;
                clicked => {
                    root.leave();
                }
            }
        }
        if root.finding.fill == 2: Note {
            text: @tr("Review" => "Marked: the next slice cures this cavity solid.");
            color: Theme.success;
        }
    }
}

// A labelled field stacked over its control.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;

    Text {
        text: root.label;
        font-size: Theme.font-sm;
        color: Theme.text-muted;
    }
    @children
}

export component TransformInspector inherits VerticalLayout {
    in property <[StandardListViewItem]> objects;
    in property <int> selected-index: -1;
    in property <bool> needs-repair;
    in property <bool> repair-enabled;
    in property <bool> repairing;
    // The selected object, in world millimetres and degrees (see
    // `viewport/numeric_transform.rs`); `selection-valid` is false with no
    // selection.
    in property <bool> selection-valid;
    in property <float> size-x;
    in property <float> size-y;
    in property <float> size-z;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    in property <float> scale;
    callback object-picked(int);
    callback repair-requested();
    // A typed value: the field code (NumericEdit::from_ui) and the value.
    callback numeric-edit(int, float);

    spacing: 12px;

    if root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: @tr("Inspector" => "Problems found");
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: @tr("Inspector" => "Some meshes are not watertight. Slicing needs closed meshes; repair fixes most files.");
        }
        ScButton {
            text: root.repairing ? @tr("Inspector" => "Repairing…") : @tr("Inspector" => "Repair meshes");
            icon: Icons.repair;
            kind: ButtonKind.primary;
            enabled: root.repair-enabled;
            clicked => {
                root.repair-requested();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "OBJECTS");
        note: root.objects.length;

        if root.objects.length == 0: Note {
            text: @tr("Inspector" => "Open or drop a model to start.");
        }
        VerticalLayout {
            spacing: 2px;

            for item[i] in root.objects: ObjectRow {
                text: item.text;
                selected: i == root.selected-index;
                clicked => {
                    root.object-picked(i);
                }
            }
        }
    }

    if !root.selection-valid && root.objects.length > 0: Card {
        title: @tr("Inspector" => "TRANSFORM");
        Note {
            text: @tr("Inspector" => "Select an object to see its size and to move, rotate or scale it by numbers.");
        }
    }

    if root.selection-valid: Card {
        title: @tr("Inspector" => "MOVE");
        note: "G";

        NumberField {
            label: "X";
            unit: "mm";
            value: root.pos-x;
            committed(v) => {
                root.numeric-edit(0, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "mm";
            value: root.pos-y;
            committed(v) => {
                root.numeric-edit(1, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Lift (Z)");
            unit: "mm";
            value: root.pos-z;
            committed(v) => {
                root.numeric-edit(2, v);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Drop to plate");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(10, 0);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Center");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(11, 0);
                }
            }
        }
    }

    if root.selection-valid: Card {
        title: @tr("Inspector" => "ROTATE");
        note: "R";

        NumberField {
            label: "X";
            unit: "°";
            decimals: 1;
            value: root.rot-x;
            committed(v) => {
                root.numeric-edit(3, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "°";
            decimals: 1;
            value: root.rot-y;
            committed(v) => {
                root.numeric-edit(4, v);
            }
        }
        NumberField {
            label: "Z";
            unit: "°";
            decimals: 1;
            value: root.rot-z;
            committed(v) => {
                root.numeric-edit(5, v);
            }
        }
    }

    if root.selection-valid: Card {
        title: @tr("Inspector" => "SIZE");
        note: "S";

        NumberField {
            label: @tr("Inspector" => "Width (X)");
            unit: "mm";
            value: root.size-x;
            committed(v) => {
                root.numeric-edit(7, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Depth (Y)");
            unit: "mm";
            value: root.size-y;
            committed(v) => {
                root.numeric-edit(8, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Height (Z)");
            unit: "mm";
            value: root.size-z;
            committed(v) => {
                root.numeric-edit(9, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Scale");
            unit: "%";
            decimals: 1;
            value: root.scale;
            committed(v) => {
                root.numeric-edit(6, v);
            }
        }
        Note {
            text: @tr("Inspector" => "Sizes scale uniformly, keeping proportions.");
        }
    }

    if !root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: @tr("Inspector" => "No problems");
        note-color: Theme.success;
        collapsible: true;
        expanded: false;

        ScButton {
            text: root.repairing ? @tr("Inspector" => "Repairing…") : @tr("Inspector" => "Repair meshes");
            icon: Icons.repair;
            enabled: root.repair-enabled;
            clicked => {
                root.repair-requested();
            }
        }
    }
}

export component HollowInspector inherits VerticalLayout {
    in property <bool> selection-valid;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <string> last-run;
    // What the selected model is: 0 solid, 1 hollow, 2 the support mesh.
    in property <int> model-state;
    in property <int> drain-count;
    in property <bool> drain-tool-on;
    in property <bool> show-cavity;
    callback show-cavity-toggled(bool);
    // The options (HollowRun::on_option), pushed by Rust after every change.
    in property <float> wall;
    in property <float> recommended-wall;
    in property <float> voxel;
    in property <int> fill-index;
    in property <float> cell;
    in property <float> beam;
    in property <bool> smooth;
    in property <float> drain-radius;
    callback apply-requested();
    callback cancel-requested();
    callback restore-requested();
    callback clear-drains-requested();
    callback drain-tool-toggled();
    callback option-changed(int, float);

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "HOLLOWING");
        note: root.running ? @tr("Inspector" => "Working") : root.model-state == 1 ? @tr("Inspector" => "Hollow") : "";
        note-color: Theme.accent;

        if !root.selection-valid: Note {
            text: @tr("Inspector" => "Select a model to hollow it.");
        }
        if root.selection-valid && root.model-state == 2: Note {
            text: @tr("Inspector" => "That is the support mesh; select a model.");
        }
        ScButton {
            text: root.model-state == 1 ? @tr("Inspector" => "Hollow again") : @tr("Inspector" => "Hollow model");
            icon: Icons.hollow;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.apply-requested();
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
        CheckBox {
            text: @tr("Inspector" => "Show the cavity (live preview)");
            checked: root.show-cavity;
            toggled => {
                root.show-cavity-toggled(self.checked);
            }
        }
        if !root.running && root.model-state == 1: ScButton {
            text: @tr("Inspector" => "Make solid again");
            clicked => {
                root.restore-requested();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "WALL");
        collapsible: true;

        NumberField {
            label: @tr("Inspector" => "Wall thickness");
            unit: "mm";
            value: root.wall;
            committed(v) => {
                root.option-changed(0, v);
            }
        }
        Slider {
            minimum: 0.5;
            maximum: 6;
            value: root.wall;
            changed(v) => {
                root.option-changed(0, Math.round(v * 10) / 10);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Recommended ({} mm)", Math.round(root.recommended-wall * 10) / 10);
            kind: Math.abs(root.wall - root.recommended-wall) < 0.05 ? ButtonKind.primary : ButtonKind.normal;
            clicked => {
                root.option-changed(0, root.recommended-wall);
            }
        }
        HorizontalLayout {
            spacing: 6px;

            ScButton {
                text: "−1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 1) * 10) / 10);
                }
            }
            ScButton {
                text: "−0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 1) * 10) / 10);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Detail (voxel)");
            unit: "mm";
            value: root.voxel;
            committed(v) => {
                root.option-changed(1, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Smooth the inner surface");
            checked: root.smooth;
            toggled => {
                root.option-changed(2, self.checked ? 1 : 0);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Inside");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Empty"), @tr("Inspector" => "Lattice"), @tr("Inspector" => "Pillars")];
                current: root.fill-index;
                picked(i) => {
                    root.option-changed(3, i);
                }
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Cell size");
            unit: "mm";
            value: root.cell;
            committed(v) => {
                root.option-changed(4, v);
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Beam radius");
            unit: "mm";
            value: root.beam;
            committed(v) => {
                root.option-changed(5, v);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "DRAINS");
        note: root.drain-count > 0 ? "\{root.drain-count}" : "";

        ScButton {
            text: root.drain-tool-on ? @tr("Inspector" => "Placing drains (D)") : @tr("Inspector" => "Place drains (D)");
            icon: Icons.hole;
            kind: root.drain-tool-on ? ButtonKind.primary : ButtonKind.normal;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.drain-tool-toggled();
            }
        }
        NumberField {
            label: @tr("Inspector" => "Drain radius");
            unit: "mm";
            value: root.drain-radius;
            committed(v) => {
                root.option-changed(6, v);
            }
        }
        if root.drain-count > 0: ScButton {
            text: @tr("Inspector" => "Remove all drains");
            enabled: !root.running;
            clicked => {
                root.clear-drains-requested();
            }
        }
        if root.model-state == 1 && root.drain-count == 0: Note {
            text: @tr("Inspector" => "Sealed cavity: resin stays trapped inside and the walls act as a suction cup. Add at least one drain near the plate.");
        }
        if root.model-state == 0 && root.drain-count == 0: Note {
            text: @tr("Inspector" => "Place drains now or after hollowing: click the model's surface with the drain tool. They are drilled when the model is hollowed.");
        }
        if root.model-state == 0 && root.drain-count > 0: Note {
            text: @tr("Inspector" => "These drains are drilled when you hollow the model.");
        }
        if root.model-state == 1: Note {
            text: @tr("Inspector" => "Each new drain hollows the model again with it: one undo per drain.");
        }
    }
}

export component SupportsInspector inherits VerticalLayout {
    in property <bool> has-scene;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <bool> cancelable;
    in property <string> last-run;
    // The options (DfSupportOptions), pushed by Rust after every change.
    in property <[string]> preset-names;
    in property <int> preset-index: -1;
    in property <int> sizing-index: 1;
    in property <float> density;
    in property <float> angle;
    in property <float> size-scale;
    in property <float> min-island;
    in property <float> coverage;
    in property <bool> stabilization;
    in property <bool> bracing;
    in property <bool> smooth;
    in property <int> raft-index;
    in property <float> raft-thickness;
    in property <bool> raft-wall;
    // The raft would take the models' first layers (#131): the warning, empty
    // when it does not, and the label of its lift button.
    in property <string> raft-clash-message;
    in property <string> raft-lift-label;
    // The selected object lift, editable here too.
    in property <bool> selection-valid;
    in property <float> lift;
    callback generate-requested();
    callback cancel-requested();
    // An option change: its code (DfSupportRun::on_option) and value.
    callback option-changed(int, float);
    callback preset-picked(int);
    callback preset-save(string);
    callback preset-delete();
    callback lift-edit(float);
    callback drop-to-plate();
    callback raft-lift();
    callback raft-off();

    spacing: 12px;

    if root.raft-clash-message != "": Card {
        title: @tr("Inspector" => "RAFT");
        note: @tr("Inspector" => "Interferes with the model");
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: root.raft-clash-message;
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.raft-lift-label;
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                clicked => {
                    root.raft-lift();
                }
            }
            ScButton {
                text: @tr("Inspector" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.raft-off();
                }
            }
        }
    }

    Card {
        title: @tr("Inspector" => "AUTO SUPPORTS");
        note: root.running ? @tr("Inspector" => "Working") : "";
        note-color: Theme.accent;

        LabeledRow {
            label: @tr("Inspector" => "Preset");
            preset-combo := ComboBox {
                width: 170px;
                model: root.preset-names;
                current-index: root.preset-index;
                selected => {
                    root.preset-picked(preset-combo.current-index);
                }
            }
        }
        ScButton {
            text: @tr("Inspector" => "Generate supports");
            icon: Icons.auto;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.has-scene && !root.running;
            clicked => {
                root.generate-requested();
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            if root.cancelable: ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
    }

    if root.selection-valid: Card {
        title: @tr("Inspector" => "LIFT");

        NumberField {
            label: @tr("Inspector" => "Height above plate");
            unit: "mm";
            value: root.lift;
            committed(v) => {
                root.lift-edit(v);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Drop to plate");
            clicked => {
                root.drop-to-plate();
            }
        }
        Note {
            text: @tr("Inspector" => "Room under the model for the supports; moving it again marks them out of date.");
        }
    }

    Card {
        title: @tr("Inspector" => "PLACEMENT");
        collapsible: true;

        LabeledRow {
            label: @tr("Inspector" => "Support size");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Detail"), @tr("Inspector" => "Structure"), @tr("Inspector" => "Anchor")];
                current: root.sizing-index;
                picked(i) => {
                    root.option-changed(0, i);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Area per support");
            unit: "mm²";
            decimals: 1;
            value: root.density;
            committed(v) => {
                root.option-changed(1, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Overhang angle");
            unit: "°";
            decimals: 0;
            value: root.angle;
            committed(v) => {
                root.option-changed(2, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Size scale");
            unit: "×";
            value: root.size-scale;
            committed(v) => {
                root.option-changed(3, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Smallest island");
            unit: "mm²";
            value: root.min-island;
            committed(v) => {
                root.option-changed(4, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Coverage");
            unit: "%";
            decimals: 0;
            value: root.coverage;
            committed(v) => {
                root.option-changed(5, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Stabilize poses on a point or edge");
            checked: root.stabilization;
            toggled => {
                root.option-changed(6, self.checked ? 1 : 0);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Cross-bracing");
            checked: root.bracing;
            toggled => {
                root.option-changed(7, self.checked ? 1 : 0);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Shape");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Smooth"), @tr("Inspector" => "Classic")];
                current: root.smooth ? 0 : 1;
                picked(i) => {
                    root.option-changed(8, i == 0 ? 1 : 0);
                }
            }
        }
    }

    Card {
        title: @tr("Inspector" => "RAFT");
        collapsible: true;

        LabeledRow {
            label: @tr("Inspector" => "Bottom");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Solid"), @tr("Inspector" => "Lines"), @tr("Inspector" => "Off")];
                current: root.raft-index;
                picked(i) => {
                    root.option-changed(9, i);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Thickness");
            unit: "mm";
            value: root.raft-thickness;
            enabled: root.raft-index != 2;
            committed(v) => {
                root.option-changed(10, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Crenelated wall");
            checked: root.raft-wall;
            enabled: root.raft-index == 0;
            toggled => {
                root.option-changed(11, self.checked ? 1 : 0);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "PRESETS");
        collapsible: true;
        expanded: false;

        preset-name := LineEdit {
            placeholder-text: @tr("Inspector" => "Name for a new preset");
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Save as preset");
                horizontal-stretch: 1;
                enabled: preset-name.text != "";
                clicked => {
                    root.preset-save(preset-name.text);
                    preset-name.text = "";
                }
            }
            ScButton {
                text: @tr("Inspector" => "Delete");
                clicked => {
                    root.preset-delete();
                }
            }
        }
        Note {
            text: @tr("Inspector" => "Built-in presets cannot be deleted. Presets are saved as TOML files in the app data folder.");
        }
    }
}

export component SliceInspector inherits VerticalLayout {
    in property <[string]> printer-options;
    in-out property <int> printer-current-index: -1;
    in property <[string]> resin-options;
    in-out property <int> resin-current-index: -1;
    in-out property <string> first-layer-height-text;
    in property <bool> slicing;
    in property <bool> up-to-date;
    in property <int> layer-count;
    in property <float> selected-layer;
    in property <image> layer-image;
    in property <bool> estimate-valid;
    in property <string> estimate-time;
    in property <string> estimate-volume;
    in property <string> estimate-mass;
    in property <string> estimate-note;
    // The review of the held slice (#90): 0 no slice, 1 reviewed, 2 failed,
    // 3 a slice not reviewed here (a reopened project's).
    in property <int> review-state;
    in property <string> review-summary;
    // The worst severity found (0 error, 1 warning, 2 information), -1 none.
    in property <int> review-worst: -1;
    in property <[ReviewRow]> review-rows;
    in property <bool> review-stale;
    in property <string> review-message;
    in-out property <int> review-selected: -1;
    // The notes (information) shown or folded, and how many there are.
    in property <int> review-notes;
    in property <bool> review-notes-open;
    // Resin traps that offer a fill and are not marked yet (#132).
    in property <int> review-fill-small;
    // The fills marked or cured, as one line, and whether they can be
    // cleared.
    in property <string> review-fills-note;
    in property <bool> review-fills-clearable;
    callback printer-picked(int);
    callback resin-picked(int);
    callback first-layer-height-edited(string);
    callback slice-requested();
    callback review-finding-clicked(int);
    callback review-fix-requested(int);
    callback review-fill-toggled(int);
    callback review-leave-requested(int);
    callback review-fill-small-requested();
    callback review-fills-cleared();
    callback review-notes-toggled();
    callback review-raft-off-requested(int);

    // The LineEdit's text binding breaks the first time the user types, so
    // a value pushed from Rust is written into it explicitly.
    changed first-layer-height-text => {
        first-layer-input.text = root.first-layer-height-text;
    }

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "PRINT SETUP");

        Field {
            label: @tr("SlicePanel" => "Printer");
            printer-combo := ComboBox {
                model: root.printer-options;
                current-index <=> root.printer-current-index;
                enabled: root.printer-options.length > 0;
                selected => {
                    root.printer-picked(printer-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "Resin");
            resin-combo := ComboBox {
                model: root.resin-options;
                current-index <=> root.resin-current-index;
                enabled: root.resin-options.length > 0;
                selected => {
                    root.resin-picked(resin-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "First layer height (mm)");
            first-layer-input := LineEdit {
                text: root.first-layer-height-text;
                placeholder-text: @tr("SlicePanel" => "from resin profile");
                accessible-label: @tr("SlicePanel" => "First layer height in millimetres");
                edited(t) => {
                    root.first-layer-height-edited(t);
                }
            }
        }
        ScButton {
            text: @tr("SlicePanel" => "Slice");
            icon: Icons.slice;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.printer-current-index >= 0 && root.resin-current-index >= 0 && !root.slicing;
            clicked => {
                root.slice-requested();
            }
        }
        if root.up-to-date: Note {
            text: @tr("SlicePanel" => "Slice is up to date.");
        }
    }

    Card {
        title: @tr("Inspector" => "RESULT");
        note: root.layer-count > 0 ? @tr("Inspector" => "Sliced") : @tr("Inspector" => "Not sliced");
        note-color: root.layer-count > 0 ? Theme.success : Theme.text-muted;

        if root.layer-count == 0: Note {
            text: @tr("Inspector" => "Slice to see the layers, the estimates and the checks.");
        }
        if root.layer-count > 0: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.layer-count;
                caption: @tr("Inspector" => "layers");
            }
            StatTile {
                value: Math.round(root.selected-layer) + 1;
                caption: @tr("Inspector" => "current layer");
            }
        }
        if root.layer-count > 0 && root.estimate-valid: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.estimate-time;
                caption: @tr("Inspector" => "print time");
            }
            StatTile {
                value: root.estimate-volume;
                caption: @tr("Inspector" => "resin");
            }
            StatTile {
                value: root.estimate-mass;
                caption: @tr("Inspector" => "weight");
            }
        }
        if root.layer-count > 0 && !root.estimate-valid && root.estimate-note != "": Note {
            text: root.estimate-note;
        }
        if root.layer-count > 0: Rectangle {
            height: 180px;
            background: #0e0f10;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                width: parent.width - 8px;
                height: parent.height - 8px;
                source: root.layer-image;
                image-fit: contain;
            }
        }
    }

    if root.layer-count > 0: Card {
        title: @tr("Review" => "REVIEW");
        note: root.review-stale ? @tr("Review" => "Out of date") : "";
        note-color: Theme.warning;

        if root.review-state == 1: HorizontalLayout {
            spacing: 8px;

            Icon {
                commands: root.review-worst == 0 ? Icons.error : root.review-worst == 1 ? Icons.warning
                    : root.review-worst == 2 ? Icons.info : Icons.check;
                color: root.review-worst < 0 ? Theme.success : ReviewTint.of(root.review-worst);
                size: 18px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.review-summary;
                font-size: Theme.font;
                font-weight: 600;
                color: root.review-worst < 0 ? Theme.success : Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.review-state == 3: Note {
            text: @tr("Review" => "This slice was not reviewed. Slice again to check it.");
        }
        if root.review-stale: Note {
            text: @tr("Review" => "The scene changed since this slice. Slice again to review it.");
            color: Theme.warning;
        }
        if root.review-message != "": Note {
            text: root.review-message;
            color: root.review-state == 2 ? Theme.danger : Theme.text-soft;
        }
        if root.review-state == 1 && root.review-rows.length > 0: Rectangle {
            // Long reviews scroll inside the card.
            height: Math.min(findings.preferred-height, 360px);

            ScrollView {
                findings := VerticalLayout {
                    spacing: 2px;

                    for row in root.review-rows: FindingRow {
                        finding: row;
                        selected: root.review-selected == row.id;
                        clicked => {
                            root.review-selected = row.id;
                            root.review-finding-clicked(row.id);
                        }
                        fix => {
                            root.review-fix-requested(row.id);
                        }
                        fill-toggled => {
                            root.review-fill-toggled(row.id);
                        }
                        leave => {
                            root.review-leave-requested(row.id);
                        }
                        fix-alt => {
                            root.review-raft-off-requested(row.id);
                        }
                    }
                }
            }
        }
        if root.review-state == 1 && root.review-notes > 0: ScButton {
            text: root.review-notes-open ? @tr("Review" => "Hide the notes") : @tr("Review" => "Show {n} note" | "Show {n} notes" % root.review-notes);
            kind: ButtonKind.ghost;
            clicked => {
                root.review-notes-toggled();
            }
        }
        if root.review-state == 1 && root.review-fill-small > 0: ScButton {
            text: @tr("Review" => "Fill all small traps ({})", root.review-fill-small);
            icon: Icons.check;
            clicked => {
                root.review-fill-small-requested();
            }
        }
        if root.review-fills-note != "": HorizontalLayout {
            spacing: 8px;

            Note {
                text: root.review-fills-note;
                horizontal-stretch: 1;
            }
            if root.review-fills-clearable: ScButton {
                text: @tr("Review" => "Clear fills");
                kind: ButtonKind.ghost;
                clicked => {
                    root.review-fills-cleared();
                }
            }
        }
        if root.review-state == 1 && root.review-rows.length > 0: Note {
            text: @tr("Review" => "Click a finding to show its layer and centre the view on it.");
        }
    }
}

export component ExportInspector inherits VerticalLayout {
    in property <[string]> format-options;
    in-out property <int> format-current-index: -1;
    in property <string> format-note;
    in property <bool> export-enabled;
    in property <bool> busy;
    in property <bool> has-scene;
    callback format-picked(int);
    callback export-printer-file();
    callback save-project();
    callback export-mesh();

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "PRINTER FILE");

        Field {
            label: @tr("SlicePanel" => "Print format");
            format-combo := ComboBox {
                model: root.format-options;
                current-index <=> root.format-current-index;
                enabled: root.format-options.length > 0;
                selected => {
                    root.format-picked(format-combo.current-index);
                }
            }
        }
        if root.format-note != "": Note {
            text: root.format-note;
        }
        ScButton {
            text: @tr("SlicePanel" => "Export for printer");
            icon: Icons.file;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.export-enabled && !root.busy;
            clicked => {
                root.export-printer-file();
            }
        }
        if !root.export-enabled: Note {
            text: @tr("Inspector" => "Slice first: the printer file is written from the held slice.");
        }
    }

    Card {
        title: @tr("Inspector" => "ALSO");

        ScButton {
            text: @tr("Inspector" => "Save project (.3mf with slices)");
            icon: Icons.save;
            enabled: root.has-scene && !root.busy;
            clicked => {
                root.save-project();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Export mesh (STL / OBJ / 3MF)");
            icon: Icons.file;
            enabled: root.has-scene && !root.busy;
            clicked => {
                root.export-mesh();
            }
        }
    }
}
