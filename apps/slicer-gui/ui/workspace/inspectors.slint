// The right-hand inspector of each workflow tab (BS-68). Each component
// shows only what its tab acts on; the window binds them to its own
// properties and callbacks, which Rust drives.

import { ScrollView } from "std-widgets.slint";
import { ScCheckBox as CheckBox, ScComboBox as ComboBox, ScLineEdit as LineEdit, ScProgress as ProgressIndicator, ScSlider as Slider } from "../kit/controls.slint";
import { Theme } from "../kit/theme.slint";
import { Icons } from "../kit/icons.slint";
import { ButtonKind, Card, DisclosureChevron, Dot, Icon, InfoRow, LabeledRow, Note, NumberField, ScButton, Segmented, StatTile } from "../kit/controls.slint";

// One finding of the slice review (#90), as Rust lays it out.
export struct ReviewRow {
    // The finding's index in the review, for the callbacks.
    id: int,
    // 0 error, 1 warning, 2 information.
    severity: int,
    // The group heading on the first row of a severity, else empty.
    header: string,
    title: string,
    // "Layer 12" or "Layers 11–25".
    layers: string,
    // One sentence with the numbers.
    detail: string,
    // 0 none, 1 add a support, 2 add a drain, 4 lift the model clear of the
    // raft or turn the raft off.
    fix: int,
    // The fix was applied since the slice.
    fixed: bool,
    // A cavity that can be cured on the next slice (#132): 0 no fill, 1
    // offered, 2 marked to fill.
    fill: int,
    // The resin a fill cures ("0.67 ml"), or empty.
    fill-resin: string,
    // A tiny cavity that can be left alone (hidden until the scene changes).
    leave: bool,
    // The lift button of fix 4 ("Lift 17 layers").
    lift-label: string,
    // After Fix All (#156): why it left this finding, else empty.
    remains: string,
}

// The colour of a review severity.
global ReviewTint {
    public pure function of(severity: int) -> brush {
        return severity == 0 ? Theme.danger : severity == 1 ? Theme.warning : Theme.text-muted;
    }
}

// A selectable object row.
component ObjectRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    // Shift+click or Ctrl+click (#13).
    callback toggled();
    property <bool> extend: false;

    height: 30px;
    border-radius: Theme.radius;
    background: self.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
    accessible-role: list-item;
    accessible-label: self.text;
    accessible-item-selected: self.selected;
    accessible-action-default => {
        self.clicked();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 3px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: root.selected ? Theme.accent : transparent;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.extend = event.modifiers.shift || event.modifiers.control || event.modifiers.meta;
            }
        }
        clicked => {
            if (root.extend) {
                root.toggled();
            } else {
                root.clicked();
            }
        }
    }
}

// A finding of the review: its severity icon, title and layers. Selected,
// it unfolds its detail and its fix.
component FindingRow inherits VerticalLayout {
    in property <ReviewRow> finding;
    in property <bool> selected;
    callback clicked();
    callback fix();
    callback fill-toggled();
    callback leave();
    // The second fix of fix 4: turn the raft off.
    callback fix-alt();

    spacing: 4px;

    if root.finding.header != "": Text {
        text: root.finding.header;
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: ReviewTint.of(root.finding.severity);
    }
    Rectangle {
        min-height: line.preferred-height;
        border-radius: Theme.radius;
        background: root.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
        accessible-role: list-item;
        accessible-label: root.finding.title + ", " + root.finding.layers;
        accessible-item-selected: root.selected;
        accessible-action-default => {
            root.clicked();
        }

        line := HorizontalLayout {
            padding: 6px;
            padding-left: 8px;
            spacing: 8px;

            Icon {
                commands: root.finding.severity == 0 ? Icons.error : root.finding.severity == 1 ? Icons.warning : Icons.info;
                color: ReviewTint.of(root.finding.severity);
                size: 16px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.finding.title;
                font-size: Theme.font;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.finding.layers;
                font-family: Theme.mono;
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    if root.finding.remains != "": HorizontalLayout {
        padding-left: 32px;
        padding-right: 4px;

        Note {
            text: root.finding.remains;
            color: Theme.text-muted;
        }
    }
    if root.selected: VerticalLayout {
        padding-left: 32px;
        padding-right: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Note {
            text: root.finding.detail;
            color: Theme.text-soft;
        }
        if root.finding.fix == 1 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add support here");
            icon: Icons.add-support;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 2 && !root.finding.fixed: ScButton {
            text: @tr("Review" => "Add drain holes…");
            icon: Icons.hole;
            clicked => {
                root.fix();
            }
        }
        if root.finding.fix == 4 && !root.finding.fixed: HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.finding.lift-label;
                horizontal-stretch: 1;
                clicked => {
                    root.fix();
                }
            }
            ScButton {
                text: @tr("Review" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.fix-alt();
                }
            }
        }
        if root.finding.fixed: Note {
            text: root.finding.fix == 1 ? @tr("Review" => "Support added.")
                : root.finding.fix == 4 ? @tr("Review" => "Done. Generate the supports again, then slice.")
                : @tr("Review" => "Drain requested.");
            color: Theme.success;
        }
        if root.finding.fill > 0: HorizontalLayout {
            spacing: 6px;
            alignment: start;

            ScButton {
                text: root.finding.fill == 2 ? @tr("Review" => "Do not fill")
                    : root.finding.fill-resin != "" ? @tr("Review" => "Fill on the next slice ({})", root.finding.fill-resin)
                    : @tr("Review" => "Fill on the next slice");
                icon: root.finding.fill == 2 ? "" : Icons.check;
                clicked => {
                    root.fill-toggled();
                }
            }
        }
        if root.finding.leave: HorizontalLayout {
            alignment: start;

            ScButton {
                text: @tr("Review" => "Ignore");
                kind: ButtonKind.ghost;
                clicked => {
                    root.leave();
                }
            }
        }
        if root.finding.fill == 2: Note {
            text: @tr("Review" => "Marked: the next slice cures this cavity solid.");
            color: Theme.success;
        }
    }
}

// A labelled field stacked over its control.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;

    Text {
        text: root.label;
        font-size: Theme.font-sm;
        color: Theme.text-muted;
    }
    @children
}

// One option of the Orient tool (#182), as Rust lays it out.
export struct OrientOption {
    // "A", "B" or "C".
    letter: string,
    // The search that found it: "Quick" or "Full".
    mode: string,
    // "≈ 84 tips".
    tips: string,
    // Against the current pose: "−32 %", or empty.
    change: string,
    // Fewer tips than the current pose.
    better: bool,
    // "Peak 18 N".
    peak: string,
    // "62 mm tall".
    height: string,
    // "Tilts 35°", maybe with the turn about the vertical.
    tilt: string,
    // It fits the printer's build volume.
    fits: bool,
    // "0 on detail" with detail painted, or empty.
    detail: string,
    // No tips on the painted detail.
    detail-clear: bool,
}

// One option card: hovering it shows the pose on the model, a click picks it
// for Apply.
component OrientOptionCard inherits Rectangle {
    in property <OrientOption> option;
    in property <bool> selected;
    callback hovered(bool);
    callback clicked();

    min-height: rows.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    background: touch.has-hover ? Theme.hover : Theme.well;
    accessible-role: button;
    accessible-label: root.option.letter + " " + root.option.tips;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    rows := VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.option.letter;
                font-weight: 700;
                font-size: Theme.font;
                color: root.selected ? Theme.accent : Theme.text;
            }
            Text {
                text: root.option.tips;
                font-family: Theme.mono;
                font-size: Theme.font;
                color: Theme.text;
            }
            Text {
                text: root.option.change;
                font-family: Theme.mono;
                font-size: Theme.font-sm;
                color: root.option.better ? Theme.success : Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.option.mode;
                font-size: Theme.font-xs;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 10px;

            Text {
                text: root.option.peak;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            Text {
                text: root.option.height;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            Text {
                text: root.option.tilt;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                horizontal-stretch: 1;
                horizontal-alignment: right;
            }
        }
        if root.option.detail != "": Text {
            text: root.option.detail;
            font-size: Theme.font-sm;
            color: root.option.detail-clear ? Theme.success : Theme.warning;
        }
        if !root.option.fits: Text {
            text: @tr("Inspector" => "Does not fit the printer");
            font-size: Theme.font-sm;
            color: Theme.warning;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            root.hovered(self.has-hover);
        }
        clicked => {
            root.clicked();
        }
    }
}

// The Orient tool (#182): finds the best way up for printing and offers
// three poses. Shown above the Transform inspector while the tool is open.
export component OrientCard inherits Card {
    // A model is selected and the scene can be edited.
    in property <bool> enabled;
    in property <bool> running;
    // 0 preparing the model, 1 searching, 2 refining, 3 judging the best.
    in property <int> phase;
    in property <float> progress;
    // 0 Balanced, 1 Fewer supports, 2 Lower force, 3 Faster.
    in property <int> preset;
    in property <float> max-tilt;
    in property <bool> align;
    in property <float> weight-supports;
    in property <float> weight-force;
    in property <float> weight-height;
    in property <[OrientOption]> options;
    in property <int> selected: -1;
    // The current pose's numbers, or empty.
    in property <string> current;
    in property <string> status;
    in property <string> warning;
    // After Apply, with more than one model: offer Arrange all.
    in property <bool> offer-arrange;
    // The protect-detail brush (#184): whether it is on, its radius in mm,
    // whether it erases, and "Painted: 312 mm² (8 %)" with paint on the model.
    in property <bool> brush-on;
    in property <float> brush-size;
    in property <bool> brush-erase;
    in property <bool> brush-visible-only;
    in property <string> painted;
    callback brush-toggled();
    callback brush-size-changed(float);
    callback brush-erase-toggled();
    callback brush-visible-changed(bool);
    // 0 grow, 1 shrink, 2 invert, 3 clear all.
    callback brush-op(int);
    // 0 Quick, 1 Full.
    callback search(int);
    callback cancel();
    // 0 preset, 1 max tilt, 2 align (0/1), 3 supports weight, 4 force
    // weight, 5 height weight.
    callback option-changed(int, float);
    callback option-hovered(int, bool);
    callback option-picked(int);
    callback apply();
    callback close();
    callback arrange();

    property <bool> advanced: false;

    title: @tr("Inspector" => "ORIENT");
    note: "O";
    highlighted: true;

    Note {
        text: @tr("Inspector" => "Finds the best way up for printing: fewer supports, less peel force, less height. Hover an option to see it on the model.");
    }
    Text {
        text: @tr("Inspector" => "PROTECT DETAIL");
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: Theme.text-muted;
    }
    if !root.brush-on && root.painted == "": Note {
        text: @tr("Inspector" => "Optional: paint what matters most, like the face. The search keeps supports off it and turns it up.");
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: root.brush-on ? @tr("Inspector" => "Painting") : @tr("Inspector" => "Paint detail");
            icon: Icons.brush;
            kind: root.brush-on ? ButtonKind.primary : ButtonKind.normal;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.brush-toggled();
            }
        }
        if root.brush-on: ScButton {
            text: @tr("Inspector" => "Erase");
            kind: root.brush-erase ? ButtonKind.primary : ButtonKind.normal;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.brush-erase-toggled();
            }
        }
    }
    if root.brush-on: NumberField {
        label: @tr("Inspector" => "Brush size");
        unit: "mm";
        decimals: 1;
        value: root.brush-size;
        committed(v) => {
            root.brush-size-changed(v);
        }
    }
    if root.brush-on: CheckBox {
        text: @tr("Inspector" => "Only what the camera sees");
        checked: root.brush-visible-only;
        toggled => {
            root.brush-visible-changed(self.checked);
        }
    }
    if root.brush-on: Note {
        text: @tr("Inspector" => "Drag paints, Alt + drag erases, Shift + click fills a region. [ and ] size the brush, B turns it off.");
    }
    if root.painted != "": HorizontalLayout {
        spacing: 7px;

        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: Theme.surface-paint;
        }
        Text {
            text: root.painted;
            font-size: Theme.font-sm;
            color: Theme.text-soft;
            horizontal-stretch: 1;
        }
    }
    if root.painted != "": GridLayout {
        spacing: 8px;

        Row {
            ScButton {
                text: @tr("Inspector" => "Grow");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(0);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Shrink");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(1);
                }
            }
        }
        Row {
            ScButton {
                text: @tr("Inspector" => "Invert");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(2);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Clear all");
                button-height: 26px;
                horizontal-stretch: 1;
                enabled: root.enabled && !root.running;
                clicked => {
                    root.brush-op(3);
                }
            }
        }
    }
    Field {
        label: @tr("Inspector" => "Objective");
        preset-combo := ComboBox {
            model: [
                @tr("Inspector" => "Balanced"),
                @tr("Inspector" => "Fewer supports"),
                @tr("Inspector" => "Lower force"),
                @tr("Inspector" => "Faster"),
            ];
            current-index: root.preset;
            enabled: !root.running;
            selected => {
                root.option-changed(0, preset-combo.current-index);
            }
        }
    }
    Rectangle {
        height: 22px;
        accessible-role: button;
        accessible-label: @tr("Inspector" => "Advanced");
        accessible-expanded: root.advanced;
        accessible-action-default => {
            root.advanced = !root.advanced;
        }

        HorizontalLayout {
            spacing: 6px;

            DisclosureChevron {
                open: root.advanced;
                color: Theme.text-muted;
                size: 9px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: @tr("Inspector" => "Advanced");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.advanced = !root.advanced;
            }
        }
    }
    // Each one under its own `if`: a wrapped Note inside a nested layout
    // under an `if` is measured as one line, and the card came out short.
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Max tilt from now");
        unit: "°";
        decimals: 0;
        value: root.max-tilt;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(1, v);
        }
    }
    if root.advanced: CheckBox {
        text: @tr("Inspector" => "Align to the plate");
        checked: root.align;
        enabled: !root.running;
        toggled => {
            root.option-changed(2, self.checked ? 1 : 0);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of supports");
        unit: "%";
        decimals: 0;
        value: root.weight-supports;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(3, v);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of peel force");
        unit: "%";
        decimals: 0;
        value: root.weight-force;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(4, v);
        }
    }
    if root.advanced: NumberField {
        label: @tr("Inspector" => "Weight of height");
        unit: "%";
        decimals: 0;
        value: root.weight-height;
        enabled: !root.running;
        committed(v) => {
            root.option-changed(5, v);
        }
    }
    if root.advanced: Note {
        text: @tr("Inspector" => "180° allows any pose, upside down included. Without aligning, an option turns about the vertical only to fit the plate.");
    }
    Text {
        text: @tr("Inspector" => "AUTO-ORIENT");
        font-size: Theme.font-xs;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: Theme.text-muted;
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: @tr("Inspector" => "Quick");
            icon: Icons.auto;
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.search(0);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Full");
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.search(1);
            }
        }
    }
    if root.running: HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.phase == 0 ? @tr("Inspector" => "Preparing the model…")
                    : root.phase == 1 ? @tr("Inspector" => "Searching…")
                    : root.phase == 2 ? @tr("Inspector" => "Refining the best poses…")
                    : @tr("Inspector" => "Judging the finalists…");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
            }
            ProgressIndicator {
                progress: root.progress;
            }
        }
        ScButton {
            text: @tr("Inspector" => "Cancel");
            clicked => {
                root.cancel();
            }
        }
    }
    if root.status != "": Note {
        text: root.status;
    }
    if root.warning != "": Note {
        text: root.warning;
        color: Theme.warning;
    }
    for option[i] in root.options: OrientOptionCard {
        option: option;
        selected: i == root.selected;
        hovered(on) => {
            root.option-hovered(i, on);
        }
        clicked => {
            root.option-picked(i);
        }
    }
    if root.current != "": Note {
        text: root.current;
    }
    HorizontalLayout {
        spacing: 8px;

        if root.options.length > 0: ScButton {
            text: root.selected >= 0 && root.selected < root.options.length
                ? @tr("Inspector" => "Apply {}", root.options[root.selected].letter)
                : @tr("Inspector" => "Apply");
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running && root.selected >= 0;
            clicked => {
                root.apply();
            }
        }
        if root.offer-arrange: ScButton {
            text: @tr("Inspector" => "Arrange all");
            horizontal-stretch: 1;
            enabled: root.enabled && !root.running;
            clicked => {
                root.arrange();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Close");
            kind: ButtonKind.ghost;
            clicked => {
                root.close();
            }
        }
    }
}

// The Cut tool (#56): a plane through the selected model, its height and
// tilt, and optionally the shape its four corners make on it, which bounds
// the cut. The same is set by the plane's handles in the scene. The parts of
// the cut show on the plane; a click on one takes it or leaves it (Rust:
// `cut_run.rs`, `cut_gizmo.rs`).
export component CutCard inherits Card {
    // A model is selected and the scene can be edited.
    in property <bool> enabled;
    // The model is being made ready, or the cut worked out.
    in property <bool> working;
    in property <float> plane-height;
    in property <float> height-min;
    in property <float> height-max;
    in property <float> tilt-x;
    in property <float> tilt-y;
    in property <bool> bounded;
    in property <float> rect-width;
    in property <float> rect-depth;
    in property <float> offset-u;
    in property <float> offset-v;
    in property <string> status;
    in property <string> warning;
    in property <bool> can-cut;
    // 0 height, 1 tilt about x, 2 tilt about y, 3 bounded (0/1), 4 width,
    // 5 depth, 6 offset along the plane, 7 offset across it.
    callback option-changed(int, float);
    callback apply();
    callback close();

    title: @tr("Inspector" => "CUT");
    note: "K";
    highlighted: true;

    Note {
        text: @tr("Inspector" => "Cuts the selected model with a plane and closes the pieces. In the scene, the arrow moves the plane, the rings tilt it, the corners shape it and a drag on it moves it along. Click a part of the cut to take it or leave it.");
    }
    NumberField {
        label: @tr("Inspector" => "Height");
        unit: "mm";
        decimals: 2;
        value: root.plane-height;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(0, v);
        }
    }
    Slider {
        minimum: root.height-min;
        maximum: root.height-max;
        value: root.plane-height;
        enabled: root.enabled;
        changed(v) => {
            root.option-changed(0, v);
        }
    }
    NumberField {
        label: @tr("Inspector" => "Tilt front to back");
        unit: "°";
        decimals: 1;
        value: root.tilt-x;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(1, v);
        }
    }
    NumberField {
        label: @tr("Inspector" => "Tilt side to side");
        unit: "°";
        decimals: 1;
        value: root.tilt-y;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(2, v);
        }
    }
    CheckBox {
        text: @tr("Inspector" => "Limit the plane");
        checked: root.bounded;
        enabled: root.enabled;
        toggled => {
            root.option-changed(3, self.checked ? 1 : 0);
        }
    }
    // Each one under its own `if`: a wrapped Note inside a nested layout
    // under an `if` is measured as one line, and the card came out short.
    if root.bounded: NumberField {
        label: @tr("Inspector" => "Width");
        unit: "mm";
        decimals: 1;
        value: root.rect-width;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(4, v);
        }
    }
    if root.bounded: NumberField {
        label: @tr("Inspector" => "Depth");
        unit: "mm";
        decimals: 1;
        value: root.rect-depth;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(5, v);
        }
    }
    if root.bounded: NumberField {
        label: @tr("Inspector" => "Move along X");
        unit: "mm";
        decimals: 1;
        value: root.offset-u;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(6, v);
        }
    }
    if root.bounded: NumberField {
        label: @tr("Inspector" => "Move along Y");
        unit: "mm";
        decimals: 1;
        value: root.offset-v;
        enabled: root.enabled;
        committed(v) => {
            root.option-changed(7, v);
        }
    }
    if root.status != "": Note {
        text: root.status;
    }
    if root.warning != "": Note {
        text: root.warning;
        color: Theme.warning;
    }
    HorizontalLayout {
        spacing: 8px;

        ScButton {
            text: root.working ? @tr("Inspector" => "Working…") : @tr("Inspector" => "Cut");
            icon: Icons.cut;
            kind: ButtonKind.primary;
            horizontal-stretch: 1;
            enabled: root.enabled && root.can-cut;
            clicked => {
                root.apply();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Close");
            kind: ButtonKind.ghost;
            clicked => {
                root.close();
            }
        }
    }
}

// The Repair button of the MESH CHECK card; while a run goes, what it is
// doing, how far it is and Cancel, which discards the run (#253). Under it,
// when a run left something broken, whether the viewport marks it.
component RepairControls inherits VerticalLayout {
    in property <bool> enabled;
    in property <bool> primary;
    in property <bool> repairing;
    in property <string> phase;
    in property <float> progress;
    in property <bool> marks-available;
    in property <bool> marks-shown;
    callback repair-requested();
    callback cancel-requested();
    callback marks-toggled(bool);

    spacing: 6px;

    if !root.repairing: ScButton {
        text: @tr("Inspector" => "Repair meshes");
        icon: Icons.repair;
        kind: root.primary ? ButtonKind.primary : ButtonKind.normal;
        enabled: root.enabled;
        clicked => {
            root.repair-requested();
        }
    }
    if root.repairing: HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Repairing…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            ProgressIndicator {
                progress: root.progress;
            }
        }
        ScButton {
            text: @tr("Inspector" => "Cancel");
            clicked => {
                root.cancel-requested();
            }
        }
    }
    if root.marks-available && !root.repairing: CheckBox {
        text: @tr("Inspector" => "Show what is left on the model");
        checked: root.marks-shown;
        toggled => {
            root.marks-toggled(self.checked);
        }
    }
}

// One colour of the overhang map, with what it means.
component OverhangKey inherits HorizontalLayout {
    in property <brush> tint;
    in property <string> text;

    spacing: 6px;
    alignment: start;

    VerticalLayout {
        alignment: center;

        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: root.tint;
        }
    }
    Note {
        text: root.text;
        wrap: no-wrap;
    }
}

// The overhang map's card (#91): its box, the colours it paints and what it
// follows. In Transform, Supports and Slice, one box for the three (#484).
export component OverhangCard inherits Card {
    in-out property <bool> on;
    in property <string> limit;
    callback toggled(bool);

    title: @tr("Inspector" => "OVERHANGS");
    note: root.on ? root.limit : "";

    CheckBox {
        text: @tr("Inspector" => "Show overhang map");
        checked <=> root.on;
        toggled => {
            root.toggled(self.checked);
        }
    }
    if root.on: HorizontalLayout {
        spacing: 14px;

        OverhangKey {
            tint: #ed4d40;
            text: @tr("Inspector" => "Needs supports");
        }
        OverhangKey {
            tint: #e67a85;
            text: @tr("Inspector" => "Close to the limit");
        }
    }
    if root.on: Note {
        text: @tr("Inspector" => "Follows the overhang angle of the Supports tab, measured from the plate.");
    }
    if root.on: Note {
        text: @tr("Inspector" => "What a support tip holds shows plain: as far around it as its preset spaces overhang tips.");
    }
}

// One row of the SIZE card: the world box and, when `split`, the size along
// the object's own axes beside it (BS-393).
component SizeRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> model-label;
    in property <bool> split;
    in property <float> world;
    in property <float> model;
    callback world-committed(float);
    callback model-committed(float);

    spacing: 10px;

    NumberField {
        horizontal-stretch: 1;
        label: root.label;
        unit: "mm";
        field-width: root.split ? 88px : 112px;
        value: root.world;
        committed(v) => {
            root.world-committed(v);
        }
    }
    if root.split: NumberField {
        horizontal-stretch: 0;
        accessible-name: root.model-label;
        unit: "mm";
        field-width: 88px;
        value: root.model;
        committed(v) => {
            root.model-committed(v);
        }
    }
}

export component TransformInspector inherits VerticalLayout {
    in property <[StandardListViewItem]> objects;
    in property <int> selected-index: -1;
    // Every selected row, and how many objects are selected (#13).
    in property <[bool]> selected-rows;
    in property <int> selected-count;
    in property <bool> needs-repair;
    // What the MESH CHECK card says when a mesh does not slice: its short
    // status and which objects, why, and what to do (see `mesh_check.rs`).
    in property <string> check-note;
    in property <string> check-text;
    in property <bool> repair-enabled;
    in property <bool> repairing;
    // A Repair run's step and how far it is (#253).
    in property <string> repair-phase;
    in property <float> repair-progress;
    // Whether the viewport can mark what a run left broken, and does.
    in property <bool> repair-marks-available;
    in property <bool> repair-marks-shown;
    // The overhang map (#91): its box, and the angle it paints by, as text.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    // The selected object, in world millimetres and degrees (see
    // `viewport/numeric_transform.rs`); `selection-valid` is false with no
    // selection.
    in property <bool> selection-valid;
    in property <float> size-x;
    in property <float> size-y;
    in property <float> size-z;
    // Size along the object's own axes; shown next to the world box when
    // `tilted` (a turn off a multiple of 90° about X or Y, BS-393).
    in property <float> model-x;
    in property <float> model-y;
    in property <float> model-z;
    in property <bool> tilted;
    in property <float> pos-x;
    in property <float> pos-y;
    in property <float> pos-z;
    in property <float> rot-x;
    in property <float> rot-y;
    in property <float> rot-z;
    in property <float> scale;
    callback object-picked(int);
    // Shift+click or Ctrl+click on a row.
    callback object-toggled(int);
    callback repair-requested();
    callback repair-cancel();
    callback repair-marks-toggled(bool);
    // A typed value: the field code (NumericEdit::from_ui) and the value.
    callback numeric-edit(int, float);
    // Arrange (#180): the card's settings, whether a run is going, and what
    // the last one did.
    in property <bool> arrange-enabled;
    in property <bool> arranging;
    in property <string> arrange-last-run;
    in property <float> arrange-gap;
    in property <float> arrange-margin;
    in property <bool> arrange-turns;
    in property <bool> arrange-shadow-only;
    // Fill bed (#356): a fill in flight, its count so far, and at most how
    // many copies it adds (0: as many as fit).
    in property <bool> arrange-filling;
    in property <string> arrange-fill-progress;
    in property <float> arrange-max-copies;
    // Arrange all (false) or the selection (true).
    callback arrange-requested(bool);
    callback arrange-fill-requested();
    callback arrange-cancel();
    // 0 gap, 1 edge margin, 2 turns (0/1), 3 shadow only (0/1), 4 max copies.
    callback arrange-option-changed(int, float);
    // The Auto-orient button of the ROTATE card opens the Orient tool (#182).
    callback orient-requested();

    spacing: 12px;

    if root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: root.check-note;
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: root.check-text;
        }
        RepairControls {
            enabled: root.repair-enabled;
            primary: true;
            repairing: root.repairing;
            phase: root.repair-phase;
            progress: root.repair-progress;
            marks-available: root.repair-marks-available;
            marks-shown: root.repair-marks-shown;
            repair-requested => {
                root.repair-requested();
            }
            cancel-requested => {
                root.repair-cancel();
            }
            marks-toggled(on) => {
                root.repair-marks-toggled(on);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "OBJECTS");
        note: root.objects.length;

        if root.objects.length == 0: Note {
            text: @tr("Inspector" => "Open or drop a model to start.");
        }
        VerticalLayout {
            spacing: 2px;

            for item[i] in root.objects: ObjectRow {
                text: item.text;
                selected: i == root.selected-index || root.selected-rows[i];
                clicked => {
                    root.object-picked(i);
                }
                toggled => {
                    root.object-toggled(i);
                }
            }
        }
    }

    if root.objects.length > 0: Card {
        title: @tr("Inspector" => "ARRANGE");
        note: "A";

        Note {
            text: root.arrange-shadow-only
                ? @tr("Inspector" => "Packs the objects with their supports by their whole shadow: nothing reaches over another object.")
                : @tr("Inspector" => "Packs the objects with their supports by their real shape: a part may reach over a shorter object, never closer than the gap.");
        }
        NumberField {
            label: @tr("Inspector" => "Gap");
            unit: "mm";
            decimals: 1;
            value: root.arrange-gap;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(0, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Edge margin");
            unit: "mm";
            decimals: 1;
            value: root.arrange-margin;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(1, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Turn objects to fit");
            checked: root.arrange-turns;
            enabled: !root.arranging;
            toggled => {
                root.arrange-option-changed(2, self.checked ? 1 : 0);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Shadow only");
            checked: root.arrange-shadow-only;
            enabled: !root.arranging;
            toggled => {
                root.arrange-option-changed(3, self.checked ? 1 : 0);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.arranging && !root.arrange-filling ? @tr("Inspector" => "Cancel") : @tr("Inspector" => "Arrange all");
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                enabled: root.arrange-enabled || (root.arranging && !root.arrange-filling);
                clicked => {
                    if root.arranging {
                        root.arrange-cancel();
                    } else {
                        root.arrange-requested(false);
                    }
                }
            }
            ScButton {
                text: @tr("Inspector" => "Arrange selection");
                horizontal-stretch: 1;
                enabled: root.arrange-enabled && root.selection-valid && !root.arranging;
                clicked => {
                    root.arrange-requested(true);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Max copies");
            placeholder: @tr("Inspector" => "All that fit");
            decimals: 0;
            value: root.arrange-max-copies;
            enabled: !root.arranging;
            committed(v) => {
                root.arrange-option-changed(4, v);
            }
        }
        ScButton {
            text: root.arrange-filling ? @tr("Inspector" => "Cancel") : @tr("Inspector" => "Fill bed");
            enabled: (root.arrange-enabled && root.selection-valid) || root.arrange-filling;
            clicked => {
                if root.arrange-filling {
                    root.arrange-cancel();
                } else {
                    root.arrange-fill-requested();
                }
            }
        }
        if root.arranging && !root.arrange-filling: Note {
            text: @tr("Inspector" => "Arranging…");
        }
        if root.arrange-filling: Note {
            text: root.arrange-fill-progress;
        }
        if !root.arranging && root.arrange-last-run != "": Note {
            text: root.arrange-last-run;
        }
    }

    if !root.selection-valid && root.objects.length > 0: Card {
        title: @tr("Inspector" => "TRANSFORM");
        Note {
            text: @tr("Inspector" => "Select an object to see its size and to move, rotate or scale it by numbers.");
        }
    }

    if root.selection-valid && root.selected-count > 1: Card {
        title: @tr("Inspector" => "TRANSFORM");
        note: root.selected-count;
        Note {
            text: @tr("Inspector" => "{} objects selected. Move, rotate or scale them together about their shared centre with the gizmo, G, R or S. To type values, select one.", root.selected-count);
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "MOVE");
        note: "G";

        NumberField {
            label: "X";
            unit: "mm";
            value: root.pos-x;
            committed(v) => {
                root.numeric-edit(0, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "mm";
            value: root.pos-y;
            committed(v) => {
                root.numeric-edit(1, v);
            }
        }
        NumberField {
            label: @tr("Inspector" => "Lift (Z)");
            unit: "mm";
            value: root.pos-z;
            committed(v) => {
                root.numeric-edit(2, v);
            }
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Drop to plate");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(10, 0);
                }
            }
            ScButton {
                text: @tr("Inspector" => "Center");
                horizontal-stretch: 1;
                clicked => {
                    root.numeric-edit(11, 0);
                }
            }
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "ROTATE");
        note: "R";

        NumberField {
            label: "X";
            unit: "°";
            decimals: 1;
            value: root.rot-x;
            committed(v) => {
                root.numeric-edit(3, v);
            }
        }
        NumberField {
            label: "Y";
            unit: "°";
            decimals: 1;
            value: root.rot-y;
            committed(v) => {
                root.numeric-edit(4, v);
            }
        }
        NumberField {
            label: "Z";
            unit: "°";
            decimals: 1;
            value: root.rot-z;
            committed(v) => {
                root.numeric-edit(5, v);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Auto-orient");
            icon: Icons.orient;
            kind: ButtonKind.ghost;
            clicked => {
                root.orient-requested();
            }
        }
    }

    if root.objects.length > 0: OverhangCard {
        on <=> root.overhang-map-on;
        limit: root.overhang-map-limit;
        toggled(on) => {
            root.overhang-map-toggled(on);
        }
    }

    if root.selection-valid && root.selected-count <= 1: Card {
        title: @tr("Inspector" => "SIZE");
        note: "S";

        if root.tilted: HorizontalLayout {
            spacing: 10px;

            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                width: 88px;
                text: @tr("Inspector" => "World");
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            Text {
                width: 88px;
                text: @tr("Inspector" => "Model");
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Width (X)");
            model-label: @tr("Inspector" => "Model width (X)");
            split: root.tilted;
            world: root.size-x;
            model: root.model-x;
            world-committed(v) => {
                root.numeric-edit(7, v);
            }
            model-committed(v) => {
                root.numeric-edit(12, v);
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Depth (Y)");
            model-label: @tr("Inspector" => "Model depth (Y)");
            split: root.tilted;
            world: root.size-y;
            model: root.model-y;
            world-committed(v) => {
                root.numeric-edit(8, v);
            }
            model-committed(v) => {
                root.numeric-edit(13, v);
            }
        }
        SizeRow {
            label: @tr("Inspector" => "Height (Z)");
            model-label: @tr("Inspector" => "Model height (Z)");
            split: root.tilted;
            world: root.size-z;
            model: root.model-z;
            world-committed(v) => {
                root.numeric-edit(9, v);
            }
            model-committed(v) => {
                root.numeric-edit(14, v);
            }
        }
        // With two columns, Scale spans from the middle of World to the
        // middle of Model, centred under both (BS-393).
        HorizontalLayout {
            spacing: 0px;

            NumberField {
                horizontal-stretch: 1;
                label: @tr("Inspector" => "Scale");
                unit: "%";
                decimals: 1;
                field-width: root.tilted ? 88px + 10px : 112px;
                value: root.scale;
                committed(v) => {
                    root.numeric-edit(6, v);
                }
            }
            if root.tilted: Rectangle {
                width: 88px / 2;
            }
        }
        Note {
            text: @tr("Inspector" => "Sizes scale uniformly, keeping proportions.");
        }
        if root.tilted: Note {
            text: @tr("Inspector" => "Tilted: World is the box it takes on the plate; Model is its size along its own axes.");
        }
    }

    if !root.needs-repair: Card {
        title: @tr("Inspector" => "MESH CHECK");
        note: @tr("Inspector" => "No problems");
        note-color: Theme.success;
        collapsible: true;
        expanded: false;

        RepairControls {
            enabled: root.repair-enabled;
            primary: false;
            repairing: root.repairing;
            phase: root.repair-phase;
            progress: root.repair-progress;
            repair-requested => {
                root.repair-requested();
            }
            cancel-requested => {
                root.repair-cancel();
            }
        }
    }
}

export component HollowInspector inherits VerticalLayout {
    in property <bool> selection-valid;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <string> last-run;
    // What the selected model is: 0 solid, 1 hollow, 2 the support mesh.
    in property <int> model-state;
    in property <int> drain-count;
    in property <bool> drain-tool-on;
    // The lasso (#179): how many regions the model keeps solid.
    in property <int> solid-count;
    in property <bool> lasso-tool-on;
    in property <bool> show-cavity;
    callback show-cavity-toggled(bool);
    // The options (HollowRun::on_option), pushed by Rust after every change.
    in property <float> wall;
    in property <float> recommended-wall;
    in property <float> voxel;
    in property <int> fill-index;
    in property <float> cell;
    in property <float> beam;
    in property <float> drain-radius;
    // The drain tool's shape (#316, #317, #318).
    in property <bool> drain-depth-set;
    in property <float> drain-depth;
    in property <bool> drain-cone;
    in property <float> drain-inner-radius;
    in property <bool> drain-plug;
    in property <float> plug-clearance;
    callback apply-requested();
    callback cancel-requested();
    callback restore-requested();
    callback clear-drains-requested();
    callback drain-tool-toggled();
    callback lasso-tool-toggled();
    callback remove-last-solid-requested();
    callback clear-solids-requested();
    callback option-changed(int, float);

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "HOLLOWING");
        note: root.running ? @tr("Inspector" => "Working") : root.model-state == 1 ? @tr("Inspector" => "Hollow") : "";
        note-color: Theme.accent;

        if !root.selection-valid: Note {
            text: @tr("Inspector" => "Select a model to hollow it.");
        }
        if root.selection-valid && root.model-state == 2: Note {
            text: @tr("Inspector" => "That is the support mesh; select a model.");
        }
        ScButton {
            text: root.model-state == 1 ? @tr("Inspector" => "Hollow again") : @tr("Inspector" => "Hollow model");
            icon: Icons.hollow;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.apply-requested();
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
        CheckBox {
            text: @tr("Inspector" => "Show the cavity (live preview)");
            checked: root.show-cavity;
            toggled => {
                root.show-cavity-toggled(self.checked);
            }
        }
        if !root.running && root.model-state == 1: ScButton {
            text: @tr("Inspector" => "Make solid again");
            clicked => {
                root.restore-requested();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "WALL");
        collapsible: true;

        NumberField {
            label: @tr("Inspector" => "Wall thickness");
            unit: "mm";
            value: root.wall;
            committed(v) => {
                root.option-changed(0, v);
            }
        }
        Slider {
            minimum: 0.5;
            maximum: 6;
            value: root.wall;
            changed(v) => {
                root.option-changed(0, Math.round(v * 10) / 10);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Recommended ({} mm)", Math.round(root.recommended-wall * 10) / 10);
            kind: Math.abs(root.wall - root.recommended-wall) < 0.05 ? ButtonKind.primary : ButtonKind.normal;
            clicked => {
                root.option-changed(0, root.recommended-wall);
            }
        }
        HorizontalLayout {
            spacing: 6px;

            ScButton {
                text: "−1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 1) * 10) / 10);
                }
            }
            ScButton {
                text: "−0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall - 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+0.1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 0.1) * 10) / 10);
                }
            }
            ScButton {
                text: "+1";
                horizontal-stretch: 1;
                clicked => {
                    root.option-changed(0, Math.round((root.wall + 1) * 10) / 10);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Detail (voxel)");
            unit: "mm";
            value: root.voxel;
            committed(v) => {
                root.option-changed(1, v);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Inside");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Empty"), @tr("Inspector" => "Lattice"), @tr("Inspector" => "Pillars")];
                current: root.fill-index;
                picked(i) => {
                    root.option-changed(3, i);
                }
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Cell size");
            unit: "mm";
            value: root.cell;
            committed(v) => {
                root.option-changed(4, v);
            }
        }
        if root.fill-index != 0: NumberField {
            label: @tr("Inspector" => "Beam radius");
            unit: "mm";
            value: root.beam;
            committed(v) => {
                root.option-changed(5, v);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "SOLID AREAS");
        note: root.solid-count > 0 ? "\{root.solid-count}" : "";

        ScButton {
            text: root.lasso-tool-on ? @tr("Inspector" => "Drawing solid areas (M)") : @tr("Inspector" => "Keep an area solid (M)");
            icon: Icons.lasso;
            kind: root.lasso-tool-on ? ButtonKind.primary : ButtonKind.normal;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.lasso-tool-toggled();
            }
        }
        Note {
            text: @tr("Inspector" => "Turn the camera to the side you want, then drag around a part: everything behind the curve, through the model, stays solid. The cavity is computed again at once.");
        }
        if root.solid-count > 0: HorizontalLayout {
            spacing: 8px;
            ScButton {
                text: @tr("Inspector" => "Remove the last");
                enabled: !root.running;
                clicked => {
                    root.remove-last-solid-requested();
                }
            }
            ScButton {
                text: @tr("Inspector" => "Remove all");
                enabled: !root.running;
                clicked => {
                    root.clear-solids-requested();
                }
            }
        }
    }

    Card {
        title: @tr("Inspector" => "DRAINS");
        note: root.drain-count > 0 ? "\{root.drain-count}" : "";

        ScButton {
            text: root.drain-tool-on ? @tr("Inspector" => "Placing drains (D)") : @tr("Inspector" => "Place drains (D)");
            icon: Icons.hole;
            kind: root.drain-tool-on ? ButtonKind.primary : ButtonKind.normal;
            enabled: root.selection-valid && root.model-state != 2 && !root.running;
            clicked => {
                root.drain-tool-toggled();
            }
        }
        NumberField {
            label: root.drain-cone ? @tr("Inspector" => "Radius at the surface") : @tr("Inspector" => "Drain radius");
            unit: "mm";
            value: root.drain-radius;
            committed(v) => {
                root.option-changed(6, v);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Shape");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Cylinder"), @tr("Inspector" => "Cone")];
                current: root.drain-cone ? 1 : 0;
                picked(i) => {
                    root.option-changed(9, i);
                }
            }
        }
        if root.drain-cone: NumberField {
            label: @tr("Inspector" => "Radius at the end");
            unit: "mm";
            value: root.drain-inner-radius;
            committed(v) => {
                root.option-changed(10, v);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Depth");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Through the wall"), @tr("Inspector" => "Set")];
                current: root.drain-depth-set ? 1 : 0;
                picked(i) => {
                    root.option-changed(7, i);
                }
            }
        }
        if root.drain-depth-set: NumberField {
            label: @tr("Inspector" => "Depth from the surface");
            unit: "mm";
            value: root.drain-depth;
            committed(v) => {
                root.option-changed(8, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Make a plug for each new drain");
            checked: root.drain-plug;
            toggled => {
                root.option-changed(11, self.checked ? 1 : 0);
            }
        }
        if root.drain-plug: NumberField {
            label: @tr("Inspector" => "Plug clearance (across)");
            unit: "mm";
            value: root.plug-clearance;
            committed(v) => {
                root.option-changed(12, v);
            }
        }
        Note {
            text: @tr("Inspector" => "Each drain keeps the shape it was placed with. A plug is a separate part on the plate, as long as the hole and narrower by the clearance: print it with the model and close the hole with it after cleaning.");
        }
        if root.drain-count > 0: ScButton {
            text: @tr("Inspector" => "Remove all drains");
            enabled: !root.running;
            clicked => {
                root.clear-drains-requested();
            }
        }
        if root.model-state == 1 && root.drain-count == 0: Note {
            text: @tr("Inspector" => "Sealed cavity: resin stays trapped inside and the walls act as a suction cup. Add at least one drain near the plate.");
        }
        if root.model-state == 0 && root.drain-count == 0: Note {
            text: @tr("Inspector" => "Place drains now or after hollowing: click the model's surface with the drain tool. They are drilled when the model is hollowed.");
        }
        if root.model-state == 0 && root.drain-count > 0: Note {
            text: @tr("Inspector" => "These drains are drilled when you hollow the model.");
        }
        if root.model-state == 1: Note {
            text: @tr("Inspector" => "Each new drain hollows the model again with it: one undo per drain.");
        }
    }
}

export component SupportsInspector inherits VerticalLayout {
    in property <bool> has-scene;
    in property <bool> running;
    in property <string> phase;
    in property <float> progress;
    in property <bool> cancelable;
    in property <string> last-run;
    // The options (DfSupportOptions), pushed by Rust after every change.
    in property <[string]> preset-names;
    in property <int> preset-index: -1;
    in property <int> sizing-index: 1;
    in property <float> density;
    in property <float> angle;
    in property <float> size-scale;
    in property <float> min-island;
    in property <float> coverage;
    in property <bool> stabilization;
    in property <bool> bracing;
    in property <bool> smooth;
    in property <int> raft-index;
    in property <float> raft-thickness;
    in property <bool> raft-wall;
    // A zone preset's summary (#360), empty without one: the preset sizes
    // and spaces the supports itself, so the placement knobs give way to it.
    in property <string> zone-summary;
    // The zone preset's pillar grid (#464): on or off, its spacing, and the
    // spacing the preset recommends in words, empty when none does.
    in property <bool> grid-on;
    in property <float> grid-spacing: 7;
    in property <string> grid-hint;
    // The raft would take the models' first layers (#131): the warning, empty
    // when it does not, and the label of its lift button.
    in property <string> raft-clash-message;
    in property <string> raft-lift-label;
    // Whether Generate lifts the models resting on the plate first (#389),
    // a setting, and its box's text with the height.
    in property <bool> lift-on-plate;
    in property <string> lift-on-plate-label;
    callback lift-on-plate-toggled(bool);
    // From under the plate, settings: whether the rafts fade out with the
    // plate (#481, #492), and whether the supports do too, drawn as dotted
    // lines (#493).
    in property <bool> hide-rafts-under-plate: true;
    callback hide-rafts-under-plate-toggled(bool);
    in property <bool> lines-under-plate;
    callback lines-under-plate-toggled(bool);
    // The Add tool (#3): whether it is armed, the tip size it places (0 the
    // preset's, 1 to 4 extra small to large), that tip in words, and the
    // hover preview's line, with whether it warns.
    in property <bool> add-tool-on;
    in property <int> tip-size;
    in property <string> tip-label;
    in property <string> add-note;
    in property <bool> add-note-warns;
    callback tip-size-picked(int);
    // Remove (#3): whether it is armed, and its drag: 0 a box, 1 a brush of
    // this radius (logical px).
    in property <bool> remove-tool-on;
    in property <int> remove-mode;
    in property <float> brush-radius;
    callback remove-mode-picked(int);
    // The selected object lift, editable here too.
    in property <bool> selection-valid;
    in property <float> lift;
    callback generate-requested();
    callback cancel-requested();
    // An option change: its code (DfSupportRun::on_option) and value.
    callback option-changed(int, float);
    callback preset-picked(int);
    callback preset-save(string);
    callback preset-delete();
    callback lift-edit(float);
    callback drop-to-plate();
    callback raft-lift();
    callback raft-off();
    callback raft-ignore();
    // The overhang map (#91, #484): its box, and the angle it paints by.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    // The supports the selected model came with (#259): how many bodies they
    // have, 0 for none, and the ways to be rid of them.
    in property <int> imported-bodies;
    callback remove-imported();
    callback replace-imported();

    spacing: 12px;

    if root.imported-bodies > 0: Card {
        title: @tr("Inspector" => "IMPORTED SUPPORTS");

        Note {
            text: @tr("Inspector" => "This model came with its supports: {} bodies, raft included. They move with it; moving it up or down, tilting it or scaling it replaces them with supports made here.", root.imported-bodies);
        }
        ScButton {
            text: @tr("Inspector" => "Replace with Breadslicer supports");
            kind: ButtonKind.primary;
            enabled: !root.running;
            clicked => {
                root.replace-imported();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Remove imported supports");
            enabled: !root.running;
            clicked => {
                root.remove-imported();
            }
        }
        Note {
            text: @tr("Inspector" => "With Remove, a click takes off one body of them.");
        }
    }

    if root.raft-clash-message != "": Card {
        title: @tr("Inspector" => "RAFT");
        note: @tr("Inspector" => "Interferes with the model");
        note-color: Theme.warning;
        highlighted: true;

        Note {
            text: root.raft-clash-message;
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: root.raft-lift-label;
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                clicked => {
                    root.raft-lift();
                }
            }
            ScButton {
                text: @tr("Inspector" => "No raft");
                horizontal-stretch: 1;
                clicked => {
                    root.raft-off();
                }
            }
        }
        CheckBox {
            text: root.lift-on-plate-label;
            checked: root.lift-on-plate;
            toggled => {
                root.lift-on-plate-toggled(self.checked);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Generate anyway");
            kind: ButtonKind.ghost;
            clicked => {
                root.raft-ignore();
            }
        }
    }

    Card {
        title: @tr("Inspector" => "AUTO SUPPORTS");
        note: root.running ? @tr("Inspector" => "Working") : "";
        note-color: Theme.accent;

        LabeledRow {
            label: @tr("Inspector" => "Preset");
            preset-combo := ComboBox {
                width: 170px;
                model: root.preset-names;
                current-index: root.preset-index;
                selected => {
                    root.preset-picked(preset-combo.current-index);
                }
            }
        }
        ScButton {
            text: @tr("Inspector" => "Generate supports");
            icon: Icons.auto;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.has-scene && !root.running;
            clicked => {
                root.generate-requested();
            }
        }
        // Under the raft warning's lift button while the warning shows.
        if root.raft-clash-message == "": CheckBox {
            text: root.lift-on-plate-label;
            checked: root.lift-on-plate;
            toggled => {
                root.lift-on-plate-toggled(self.checked);
            }
        }
        if root.running: VerticalLayout {
            spacing: 6px;

            Text {
                text: root.phase == "" ? @tr("Inspector" => "Starting…") : root.phase;
                font-size: Theme.font-sm;
                color: Theme.text-soft;
            }
            ProgressIndicator {
                progress: root.progress;
            }
            if root.cancelable: ScButton {
                text: @tr("Inspector" => "Cancel");
                clicked => {
                    root.cancel-requested();
                }
            }
        }
        if !root.running && root.last-run != "": Note {
            text: root.last-run;
        }
    }

    if root.add-tool-on: Card {
        title: @tr("Inspector" => "ADD SUPPORT");
        note: root.tip-label;
        note-color: Theme.accent;

        LabeledRow {
            label: @tr("Inspector" => "Tip");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Preset"), "XS", "S", "M", "L"];
                current: root.tip-size;
                picked(i) => {
                    root.tip-size-picked(i);
                }
            }
        }
        Note {
            text: @tr("Inspector" => "Keys 1–4 pick the tip: extra small, small, medium, large. Shift+click hangs the support from the nearest one, or places nothing.");
        }
        if root.add-note != "": Note {
            text: root.add-note;
            color: root.add-note-warns ? Theme.danger : Theme.text-soft;
        }
    }

    if root.remove-tool-on: Card {
        title: @tr("Inspector" => "REMOVE SUPPORTS");

        LabeledRow {
            label: @tr("Inspector" => "Drag");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Box"), @tr("Inspector" => "Brush")];
                current: root.remove-mode;
                picked(i) => {
                    root.remove-mode-picked(i);
                }
            }
        }
        Note {
            text: root.remove-mode == 1
                ? @tr("Inspector" => "Paint over the supports to remove, anywhere along them; [ ] or the mouse wheel size the brush ({} px). B switches to a box.", Math.round(root.brush-radius))
                : @tr("Inspector" => "Drag a box: every support it touches goes, from the selected supports only. B switches to a brush.");
        }
        if root.add-note != "": Note {
            text: root.add-note;
            color: root.add-note-warns ? Theme.danger : Theme.text-soft;
        }
    }

    OverhangCard {
        on <=> root.overhang-map-on;
        limit: root.overhang-map-limit;
        toggled(on) => {
            root.overhang-map-toggled(on);
        }
    }

    if root.selection-valid: Card {
        title: @tr("Inspector" => "LIFT");

        NumberField {
            label: @tr("Inspector" => "Height above plate");
            unit: "mm";
            value: root.lift;
            committed(v) => {
                root.lift-edit(v);
            }
        }
        ScButton {
            text: @tr("Inspector" => "Drop to plate");
            clicked => {
                root.drop-to-plate();
            }
        }
        Note {
            text: @tr("Inspector" => "Room under the model for the supports; moving it again marks them out of date.");
        }
    }

    Card {
        title: @tr("Inspector" => "PLACEMENT");
        collapsible: true;

        // Each row of a zone preset sits in the card's own layout: a note
        // that wraps, inside a layout of its own in a conditional, was
        // measured one line high, and the card cut its last rows (#492).
        if root.zone-summary != "": Note {
            text: root.zone-summary;
        }
        if root.zone-summary != "": CheckBox {
            text: @tr("Inspector" => "Pillars on a grid");
            checked: root.grid-on;
            toggled => {
                root.option-changed(12, self.checked ? root.grid-spacing : 0);
            }
        }
        if root.zone-summary != "": NumberField {
            label: @tr("Inspector" => "Grid spacing");
            unit: "mm";
            decimals: 1;
            enabled: root.grid-on;
            value: root.grid-spacing;
            committed(v) => {
                root.option-changed(13, v);
            }
        }
        if root.zone-summary != "" && root.grid-hint != "": Note {
            text: root.grid-hint;
        }
        if root.zone-summary == "": VerticalLayout {
            spacing: 10px;

            LabeledRow {
                label: @tr("Inspector" => "Support size");
                Segmented {
                    width: 190px;
                    options: [@tr("Inspector" => "Detail"), @tr("Inspector" => "Structure"), @tr("Inspector" => "Anchor")];
                    current: root.sizing-index;
                    picked(i) => {
                        root.option-changed(0, i);
                    }
                }
            }
            NumberField {
                label: @tr("Inspector" => "Area per support");
                unit: "mm²";
                decimals: 1;
                value: root.density;
                committed(v) => {
                    root.option-changed(1, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Overhang angle");
                unit: "°";
                decimals: 0;
                value: root.angle;
                committed(v) => {
                    root.option-changed(2, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Size scale");
                unit: "×";
                value: root.size-scale;
                committed(v) => {
                    root.option-changed(3, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Smallest island");
                unit: "mm²";
                value: root.min-island;
                committed(v) => {
                    root.option-changed(4, v);
                }
            }
            NumberField {
                label: @tr("Inspector" => "Coverage");
                unit: "%";
                decimals: 0;
                value: root.coverage;
                committed(v) => {
                    root.option-changed(5, v);
                }
            }
            CheckBox {
                text: @tr("Inspector" => "Stabilize poses on a point or edge");
                checked: root.stabilization;
                toggled => {
                    root.option-changed(6, self.checked ? 1 : 0);
                }
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Cross-bracing");
            checked: root.bracing;
            toggled => {
                root.option-changed(7, self.checked ? 1 : 0);
            }
        }
        LabeledRow {
            label: @tr("Inspector" => "Shape");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Smooth"), @tr("Inspector" => "Classic")];
                current: root.smooth ? 0 : 1;
                picked(i) => {
                    root.option-changed(8, i == 0 ? 1 : 0);
                }
            }
        }
    }

    Card {
        title: @tr("Inspector" => "RAFT");
        collapsible: true;

        LabeledRow {
            label: @tr("Inspector" => "Bottom");
            Segmented {
                width: 190px;
                options: [@tr("Inspector" => "Solid"), @tr("Inspector" => "Lines"), @tr("Inspector" => "Off")];
                current: root.raft-index;
                picked(i) => {
                    root.option-changed(9, i);
                }
            }
        }
        NumberField {
            label: @tr("Inspector" => "Thickness");
            unit: "mm";
            value: root.raft-thickness;
            enabled: root.raft-index != 2;
            committed(v) => {
                root.option-changed(10, v);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Crenelated wall");
            checked: root.raft-wall;
            enabled: root.raft-index == 0;
            toggled => {
                root.option-changed(11, self.checked ? 1 : 0);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "FROM BELOW");
        collapsible: true;

        Note {
            text: @tr("Inspector" => "When the camera goes under the plate.");
        }
        CheckBox {
            text: @tr("Inspector" => "Hide the raft");
            checked: root.hide-rafts-under-plate;
            toggled => {
                root.hide-rafts-under-plate-toggled(self.checked);
            }
        }
        CheckBox {
            text: @tr("Inspector" => "Supports as dotted lines");
            checked: root.lines-under-plate;
            toggled => {
                root.lines-under-plate-toggled(self.checked);
            }
        }
    }

    Card {
        title: @tr("Inspector" => "PRESETS");
        collapsible: true;
        expanded: false;

        preset-name := LineEdit {
            placeholder-text: @tr("Inspector" => "Name for a new preset");
        }
        HorizontalLayout {
            spacing: 8px;

            ScButton {
                text: @tr("Inspector" => "Save as preset");
                horizontal-stretch: 1;
                enabled: preset-name.text != "";
                clicked => {
                    root.preset-save(preset-name.text);
                    preset-name.text = "";
                }
            }
            ScButton {
                text: @tr("Inspector" => "Delete");
                clicked => {
                    root.preset-delete();
                }
            }
        }
        Note {
            text: @tr("Inspector" => "Built-in presets cannot be deleted. Presets are saved as TOML files in the app data folder.");
        }
    }
}

export component SliceInspector inherits VerticalLayout {
    in property <[string]> printer-options;
    in-out property <int> printer-current-index: -1;
    in property <[string]> resin-options;
    in-out property <int> resin-current-index: -1;
    in-out property <string> first-layer-height-text;
    in property <bool> slicing;
    in property <bool> up-to-date;
    in property <int> layer-count;
    in property <float> selected-layer;
    in property <image> layer-image;
    in property <bool> estimate-valid;
    in property <string> estimate-time;
    in property <string> estimate-volume;
    in property <string> estimate-mass;
    in property <string> estimate-note;
    // The review of the held slice (#90): 0 no slice, 1 reviewed, 2 failed,
    // 3 a slice not reviewed here (a reopened project's).
    in property <int> review-state;
    in property <string> review-summary;
    // The worst severity found (0 error, 1 warning, 2 information), -1 none.
    in property <int> review-worst: -1;
    in property <[ReviewRow]> review-rows;
    in property <bool> review-stale;
    in property <string> review-message;
    in-out property <int> review-selected: -1;
    // The notes (information) shown or folded, and how many there are.
    in property <int> review-notes;
    in property <bool> review-notes-open;
    // Resin traps that offer a fill and are not marked yet (#132).
    in property <int> review-fill-small;
    // The fills marked or cured, as one line, and whether they can be
    // cleared.
    in property <string> review-fills-note;
    in property <bool> review-fills-clearable;
    // The label of the button that clears the marks.
    in property <string> review-fills-clear-label;
    // How many findings Fix All (#156) would fix: 0 hides its button.
    in property <int> review-fix-all;
    // Fix All placing its supports (#390): its progress and Cancel stand
    // where its button was, and Slice waits.
    in property <bool> review-fixing;
    in property <float> review-fix-progress;
    in property <string> review-fix-phase;
    // "Repeat until clean" next to Fix all (#163): a setting.
    in property <bool> review-fix-repeat;
    callback review-fix-repeat-toggled(bool);
    // The overhang map (#91, #484): its box, and the angle it paints by.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;
    callback overhang-map-toggled(bool);
    callback printer-picked(int);
    callback resin-picked(int);
    callback first-layer-height-edited(string);
    callback slice-requested();
    callback review-finding-clicked(int);
    callback review-fix-requested(int);
    callback review-fill-toggled(int);
    callback review-leave-requested(int);
    callback review-fill-small-requested();
    callback review-fills-cleared();
    callback review-notes-toggled();
    callback review-raft-off-requested(int);
    callback review-fix-all-requested();
    callback review-fix-all-cancel();

    // The LineEdit's text binding breaks the first time the user types, so
    // a value pushed from Rust is written into it explicitly.
    changed first-layer-height-text => {
        first-layer-input.text = root.first-layer-height-text;
    }

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "PRINT SETUP");
        vertical-stretch: 0;

        Field {
            label: @tr("SlicePanel" => "Printer");
            printer-combo := ComboBox {
                model: root.printer-options;
                current-index <=> root.printer-current-index;
                enabled: root.printer-options.length > 0;
                selected => {
                    root.printer-picked(printer-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "Resin");
            resin-combo := ComboBox {
                model: root.resin-options;
                current-index <=> root.resin-current-index;
                enabled: root.resin-options.length > 0;
                selected => {
                    root.resin-picked(resin-combo.current-index);
                }
            }
        }
        Field {
            label: @tr("SlicePanel" => "First layer height (mm)");
            first-layer-input := LineEdit {
                text: root.first-layer-height-text;
                placeholder-text: @tr("SlicePanel" => "from resin profile");
                accessible-label: @tr("SlicePanel" => "First layer height in millimetres");
                edited(t) => {
                    root.first-layer-height-edited(t);
                }
            }
        }
        ScButton {
            text: @tr("SlicePanel" => "Slice");
            icon: Icons.slice;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.printer-current-index >= 0 && root.resin-current-index >= 0 && !root.slicing && !root.review-fixing;
            clicked => {
                root.slice-requested();
            }
        }
        if root.up-to-date: Note {
            text: @tr("SlicePanel" => "Slice is up to date.");
        }
    }

    Card {
        title: @tr("Inspector" => "RESULT");
        vertical-stretch: 0;
        note: root.layer-count > 0 ? @tr("Inspector" => "Sliced") : @tr("Inspector" => "Not sliced");
        note-color: root.layer-count > 0 ? Theme.success : Theme.text-muted;

        if root.layer-count == 0: Note {
            text: @tr("Inspector" => "Slice to see the layers, the estimates and the checks.");
        }
        if root.layer-count > 0: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.layer-count;
                caption: @tr("Inspector" => "layers");
            }
            StatTile {
                value: Math.round(root.selected-layer) + 1;
                caption: @tr("Inspector" => "current layer");
            }
        }
        if root.layer-count > 0 && root.estimate-valid: HorizontalLayout {
            spacing: 8px;

            StatTile {
                value: root.estimate-time;
                caption: @tr("Inspector" => "print time");
            }
            StatTile {
                value: root.estimate-volume;
                caption: @tr("Inspector" => "resin");
            }
            StatTile {
                value: root.estimate-mass;
                caption: @tr("Inspector" => "weight");
            }
        }
        if root.layer-count > 0 && !root.estimate-valid && root.estimate-note != "": Note {
            text: root.estimate-note;
        }
        if root.layer-count > 0: Rectangle {
            height: 180px;
            background: #0e0f10;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                width: parent.width - 8px;
                height: parent.height - 8px;
                source: root.layer-image;
                image-fit: contain;
            }
        }
    }

    OverhangCard {
        vertical-stretch: 0;
        on <=> root.overhang-map-on;
        limit: root.overhang-map-limit;
        toggled(on) => {
            root.overhang-map-toggled(on);
        }
    }

    // REVIEW, drawn as a Card that stretches: it takes the height left in
    // the tab, so its finding list can scroll inside it.
    if root.layer-count > 0: Rectangle {
        vertical-stretch: 1;
        min-height: 200px;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;

        VerticalLayout {
            HorizontalLayout {
                height: 36px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: @tr("Review" => "REVIEW");
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.review-stale ? @tr("Review" => "Out of date") : "";
                    font-size: Theme.font-xs;
                    color: Theme.warning;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border-soft;
            }
            VerticalLayout {
                vertical-stretch: 1;
                padding: 12px;
                spacing: 10px;


                if root.review-state == 1: HorizontalLayout {
                    spacing: 8px;

                    Icon {
                        commands: root.review-worst == 0 ? Icons.error : root.review-worst == 1 ? Icons.warning
                            : root.review-worst == 2 ? Icons.info : Icons.check;
                        color: root.review-worst < 0 ? Theme.success : ReviewTint.of(root.review-worst);
                        size: 18px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.review-summary;
                        font-size: Theme.font;
                        font-weight: 600;
                        color: root.review-worst < 0 ? Theme.success : Theme.text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.review-state == 3: Note {
                    text: @tr("Review" => "This slice was not reviewed. Slice again to check it.");
                }
                if root.review-stale: Note {
                    text: @tr("Review" => "The scene changed since this slice. Slice again to review it.");
                    color: Theme.warning;
                }
                if root.review-message != "": Note {
                    text: root.review-message;
                    color: root.review-state == 2 ? Theme.danger : Theme.text-soft;
                }
                // The list takes the room left in the tab and scrolls on its own;
                // the setup, the Slice button and the result above stay put.
                if root.review-state == 1 && root.review-rows.length > 0: ScrollView {
                    vertical-stretch: 1;
                    min-height: 96px;

                    VerticalLayout {
                            spacing: 2px;
                            alignment: start;

                            for row in root.review-rows: FindingRow {
                                finding: row;
                                selected: root.review-selected == row.id;
                                clicked => {
                                    root.review-selected = row.id;
                                    root.review-finding-clicked(row.id);
                                }
                                fix => {
                                    root.review-fix-requested(row.id);
                                }
                                fill-toggled => {
                                    root.review-fill-toggled(row.id);
                                }
                                leave => {
                                    root.review-leave-requested(row.id);
                                }
                                fix-alt => {
                                    root.review-raft-off-requested(row.id);
                                }
                            }
                    }
                }
                if root.review-state == 1 && root.review-notes > 0: ScButton {
                    text: root.review-notes-open ? @tr("Review" => "Hide the notes") : @tr("Review" => "Show {n} note" | "Show {n} notes" % root.review-notes);
                    kind: ButtonKind.ghost;
                    clicked => {
                        root.review-notes-toggled();
                    }
                }
                if root.review-state == 1 && root.review-fix-all > 0 && !root.review-fixing: HorizontalLayout {
                    spacing: 10px;

                    ScButton {
                        text: @tr("Review" => "Fix all ({})", root.review-fix-all);
                        icon: Icons.check;
                        clicked => {
                            root.review-fix-all-requested();
                        }
                    }
                    CheckBox {
                        text: @tr("Review" => "Repeat until clean");
                        checked: root.review-fix-repeat;
                        horizontal-stretch: 1;
                        toggled => {
                            root.review-fix-repeat-toggled(self.checked);
                        }
                    }
                }
                if root.review-fixing: HorizontalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        alignment: center;

                        Text {
                            text: root.review-fix-phase == "" ? @tr("Review" => "Fixing all…") : root.review-fix-phase;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        ProgressIndicator {
                            progress: root.review-fix-progress;
                        }
                    }
                    ScButton {
                        text: @tr("Review" => "Cancel");
                        clicked => {
                            root.review-fix-all-cancel();
                        }
                    }
                }
                if root.review-state == 1 && root.review-fill-small > 0: ScButton {
                    text: @tr("Review" => "Fill all small traps ({})", root.review-fill-small);
                    icon: Icons.check;
                    clicked => {
                        root.review-fill-small-requested();
                    }
                }
                if root.review-fills-note != "": HorizontalLayout {
                    spacing: 8px;

                    Note {
                        text: root.review-fills-note;
                        horizontal-stretch: 1;
                    }
                    if root.review-fills-clearable: ScButton {
                        text: root.review-fills-clear-label;
                        kind: ButtonKind.ghost;
                        clicked => {
                            root.review-fills-cleared();
                        }
                    }
                }
                if root.review-state == 1 && root.review-rows.length > 0: Note {
                    text: @tr("Review" => "Click a finding to show its layer and centre the view on it.");
                }
            }
        }
    }
}

export component ExportInspector inherits VerticalLayout {
    in property <[string]> format-options;
    in-out property <int> format-current-index: -1;
    in property <string> format-note;
    in property <bool> export-enabled;
    in property <bool> busy;
    in property <bool> has-scene;
    callback format-picked(int);
    callback export-printer-file();
    callback save-project();
    callback export-mesh();

    spacing: 12px;

    Card {
        title: @tr("Inspector" => "PRINTER FILE");

        Field {
            label: @tr("SlicePanel" => "Print format");
            format-combo := ComboBox {
                model: root.format-options;
                current-index <=> root.format-current-index;
                enabled: root.format-options.length > 0;
                selected => {
                    root.format-picked(format-combo.current-index);
                }
            }
        }
        if root.format-note != "": Note {
            text: root.format-note;
        }
        ScButton {
            text: @tr("SlicePanel" => "Export for printer");
            icon: Icons.file;
            kind: ButtonKind.primary;
            button-height: 38px;
            enabled: root.export-enabled && !root.busy;
            clicked => {
                root.export-printer-file();
            }
        }
        if !root.export-enabled: Note {
            text: @tr("Inspector" => "Slice first: the printer file is written from the held slice.");
        }
    }

    Card {
        title: @tr("Inspector" => "ALSO");

        ScButton {
            text: @tr("Inspector" => "Save project (.3mf with slices)");
            icon: Icons.save;
            enabled: root.has-scene && !root.busy;
            clicked => {
                root.save-project();
            }
        }
        ScButton {
            text: @tr("Inspector" => "Export mesh (STL / OBJ / 3MF)");
            icon: Icons.file;
            enabled: root.has-scene && !root.busy;
            clicked => {
                root.export-mesh();
            }
        }
    }
}
