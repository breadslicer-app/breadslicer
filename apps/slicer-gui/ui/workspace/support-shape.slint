// The shape of a support in the Supports tab (#564): one support drawn in
// 3D that turns when dragged and changes as its numbers do, the sizes a
// preset places, the fields of each part, and where each size goes.
// Rust draws the support (`support_shape.rs`) and lays out its numbers.

import { ScComboBox as ComboBox } from "../kit/controls.slint";
import { Theme } from "../kit/theme.slint";
import { Card, DisclosureChevron, Note, ScButton, ButtonKind } from "../kit/controls.slint";

// A number of the drawing: where its label goes in logical pixels, whether
// it ends there instead of starting, the part it measures and its text.
export struct ShapeCallout {
    x: float,
    y: float,
    right: bool,
    part: int,
    prefix: string,
    value: float,
}

// One size a preset places: its short name and its tip in mm.
export struct ShapeSize {
    name: string,
    tip: float,
}

// One row of where each size goes: the zone, what it covers, the size it
// places (an index into the sizes) and how far apart.
export struct ZoneRow {
    name: string,
    detail: string,
    size: int,
    spacing: float,
}

// A built-in preset as a card: its name and the models it is for.
export struct PresetCard {
    title: string,
    range: string,
}

// The support, drawn by Rust, with its numbers over it. Drag to turn it;
// a number clicked lights its part.
export component ShapeViewer inherits Rectangle {
    in property <image> picture;
    in property <[ShapeCallout]> callouts;
    in property <int> hot;
    callback dragged(float, float);
    callback part-clicked(int);

    property <length> last-x;
    property <length> last-y;

    height: 200px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;
    clip: true;

    Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.picture;
        image-fit: fill;
    }

    touch := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.dragged((self.mouse-x - root.last-x) / 1px, (self.mouse-y - root.last-y) / 1px);
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
        }
    }

    for c in root.callouts: Rectangle {
        x: 1px + (c.right ? c.x * 1px - label.preferred-width : c.x * 1px);
        y: 1px + c.y * 1px - 8px;
        width: label.preferred-width;
        height: 16px;

        label := Text {
            text: c.prefix + round(c.value * 100) / 100;
            font-family: Theme.mono;
            font-size: 10.5px;
            color: c.part == root.hot ? Theme.selection : Theme.text-soft;
            vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.part-clicked(c.part);
            }
        }
    }

    Text {
        x: 8px;
        y: 5px;
        text: @tr("Inspector" => "drag to turn");
        font-family: Theme.mono;
        font-size: 10px;
        color: Theme.text-faint;
    }
}

// A number of the support: changes as it is typed, so the drawing follows;
// ↑ ↓ step it by 0.01, with Shift by 0.1. Pointing at it lights its part.
export component ShapeField inherits HorizontalLayout {
    in property <string> label;
    in property <string> unit: "mm";
    in property <float> value;
    in property <int> part;
    in property <int> hot;
    in property <bool> enabled: true;
    callback edited(float);
    callback pointed(int);

    function shown() -> string {
        return round(root.value * 100) / 100;
    }
    changed value => {
        if !input.has-focus {
            input.text = root.shown();
        }
    }

    spacing: 8px;
    min-height: 26px;

    if root.label != "": Rectangle {
        horizontal-stretch: 1;

        HorizontalLayout {
            spacing: 7px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.part == root.hot && root.part != 0 ? Theme.selection : Theme.border-strong;
                }
            }
            Text {
                text: root.label;
                font-size: Theme.font;
                color: root.part == root.hot && root.part != 0 ? Theme.text : root.enabled ? Theme.text-soft : Theme.text-faint;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        TouchArea {
            changed has-hover => {
                root.pointed(self.has-hover ? root.part : 0);
            }
        }
    }
    Rectangle {
        width: root.label != "" ? 96px : 72px;
        height: 26px;
        background: Theme.well;
        border-width: 1px;
        border-color: input.has-focus ? Theme.indicator : Theme.border;
        border-radius: Theme.radius;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;

            input := TextInput {
                text: root.shown();
                enabled: root.enabled;
                font-family: Theme.mono;
                font-size: Theme.font-sm;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                single-line: true;
                input-type: decimal;
                accessible-label: root.label;
                edited => {
                    if self.text.is-float() && self.text.to-float() >= 0 {
                        root.edited(self.text.to-float());
                    }
                }
                accepted => {
                    self.text = root.shown();
                    self.clear-focus();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        self.text = root.shown();
                        self.clear-focus();
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        // Snapped to the step, so 0.24 + 0.01 is 0.25.
                        let step = event.modifiers.shift ? 0.1 : 0.01;
                        let v = Math.max(0, round((root.value + (event.text == Key.UpArrow ? step : -step)) * 100) / 100);
                        self.text = round(v * 100) / 100;
                        root.edited(v);
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if !self.has-focus {
                        self.text = root.shown();
                        root.pointed(0);
                    } else {
                        self.select-all();
                        root.pointed(root.part);
                    }
                }
            }
            Text {
                text: root.unit;
                font-family: Theme.mono;
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

// The sizes a preset places, as one row: picking one shows it.
export component SizeChips inherits Rectangle {
    in property <[ShapeSize]> sizes;
    in property <int> current;
    callback picked(int);

    height: 38px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: Theme.radius;
    clip: true;

    HorizontalLayout {
        for size[i] in root.sizes: Rectangle {
            width: root.width / Math.max(1, root.sizes.length);
            background: i == root.current ? Theme.action : chip.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: size.name + " " + round(size.tip * 100) / 100;
            accessible-checked: i == root.current;
            accessible-action-default => {
                root.picked(i);
            }

            VerticalLayout {
                alignment: center;

                Text {
                    text: size.name;
                    font-family: Theme.mono;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    color: i == root.current ? Theme.on-action : Theme.text-soft;
                    horizontal-alignment: center;
                }
                Text {
                    text: round(size.tip * 100) / 100;
                    font-family: Theme.mono;
                    font-size: 10px;
                    color: i == root.current ? Theme.on-action : Theme.text-faint;
                    horizontal-alignment: center;
                }
            }
            if i > 0: Rectangle {
                x: 0;
                width: 1px;
                background: Theme.border-strong;
            }
            chip := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// The built-in presets as cards; none lit while the options are the
// person's own.
export component PresetCards inherits HorizontalLayout {
    in property <[PresetCard]> cards;
    in property <int> current;
    in property <bool> enabled: true;
    callback picked(int);

    spacing: 6px;

    for card[i] in root.cards: Rectangle {
        horizontal-stretch: 1;
        height: 44px;
        background: Theme.card;
        border-width: i == root.current ? 2px : 1px;
        border-color: i == root.current ? Theme.indicator : pick.has-hover ? Theme.border-strong : Theme.border;
        border-radius: Theme.radius;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: button;
        accessible-label: card.title;
        accessible-checked: i == root.current;
        accessible-action-default => {
            root.picked(i);
        }

        VerticalLayout {
            padding-left: 8px;
            padding-right: 6px;
            alignment: center;
            spacing: 1px;

            Text {
                text: card.title;
                font-size: Theme.font-sm;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: card.range;
                font-family: Theme.mono;
                font-size: 10px;
                color: Theme.text-faint;
                overflow: elide;
            }
        }
        pick := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.picked(i);
            }
        }
    }
}

// What the fields edit: the preset for the next Generate, said in a box
// over the drawing.
export component ScopeBox inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <bool> warm;

    height: 30px;
    background: Theme.card;
    border-width: 1px;
    border-color: root.warm ? Theme.selection : Theme.border;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.warm ? Theme.selection : Theme.text-faint;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.font-sm;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.note;
            font-family: Theme.mono;
            font-size: 10px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    }
}

// One row of where each size goes: the zone, the size it places and how
// far apart.
export component ZoneRowView inherits HorizontalLayout {
    in property <ZoneRow> zone;
    in property <[string]> size-names;
    callback size-picked(int);
    callback spacing-edited(float);

    spacing: 6px;
    min-height: 34px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;

        Text {
            text: root.zone.name;
            font-size: Theme.font;
            color: Theme.text-soft;
            overflow: elide;
        }
        Text {
            text: root.zone.detail;
            font-family: Theme.mono;
            font-size: 10px;
            color: Theme.text-faint;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;

        ComboBox {
            width: 62px;
            horizontal-stretch: 0;
            model: root.size-names;
            current-index: root.zone.size;
            selected => {
                root.size-picked(self.current-index);
            }
        }
    }
    VerticalLayout {
        alignment: center;

        ShapeField {
            label: "";
            value: root.zone.spacing;
            part: 0;
            hot: 0;
            edited(v) => {
                root.spacing-edited(v);
            }
        }
    }
}
