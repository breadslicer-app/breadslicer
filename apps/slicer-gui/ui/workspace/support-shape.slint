// The shape of a support in the Supports tab (#564, #567): one support
// drawn in 3D that turns when dragged, or as a plan at its real scale, with
// a lens on its tip and one on its foot; the sizes a preset places, the
// fields of each part, and where each size goes. Rust draws the support
// (`support_shape.rs`) and says where its numbers and words go.

import { ScrollView } from "std-widgets.slint";
import { ScCheckBox as CheckBox, ScComboBox as ComboBox } from "../kit/controls.slint";
import { Theme } from "../kit/theme.slint";
import { Card, DisclosureChevron, Icon, Note, ScButton, ButtonKind } from "../kit/controls.slint";
import { Icons } from "../kit/icons.slint";
import { DialogHead, DialogRule, SectionLabel } from "../kit/dialog.slint";

// A text of a drawing: where it goes in logical pixels (its middle in
// height) and how it stands about that point (0 starts there, 1 ends
// there, 2 is centred on it), the part it is about, whether it is a number
// in its box, the word it is (0 for none) and its number, and the field
// the number is (-1 for none), so it can be dragged where it stands.
export struct ShapeCallout {
    x: float,
    y: float,
    anchor: int,
    part: int,
    chip: bool,
    word: int,
    prefix: string,
    value: float,
    field: int,
}

// One size a preset places: its short name, and its tip, its trunk and its
// tip's length in mm, which draw its tip on its chip.
export struct ShapeSize {
    name: string,
    tip: float,
    trunk: float,
    length: float,
}

// One row of where each size goes: the zone, what it covers, the size it
// places (an index into the sizes) and how far apart, and what the
// built-in preset has for both (-1 where it has nothing).
export struct ZoneRow {
    name: string,
    detail: string,
    size: int,
    spacing: float,
    default-size: int,
    default-spacing: float,
}

// The round arrow beside a field: shown while the field is off the
// built-in preset's number, a click puts that number back. Its room is kept
// when hidden, so the fields stay in line.
export component ResetMark inherits Rectangle {
    in property <bool> shown;
    callback clicked();

    width: 16px;

    touch := TouchArea {
        enabled: root.shown;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    if root.shown: Icon {
        commands: Icons.rotate;
        size: 12px;
        x: 2px;
        y: (parent.height - 12px) / 2;
        color: touch.has-hover ? Theme.text : Theme.text-muted;
        accessible-role: button;
        accessible-label: @tr("Inspector" => "Reset to default");
    }
}

// One thing to put in a support settings file, or to take from one.
export struct ShareItem {
    // The head of a group, which ticks all of it, or 1 thing of it.
    header: bool,
    // 0 the presets of Generate, 1 the hand sizes.
    group: int,
    name: string,
    detail: string,
    // For a hand size: its tip, trunk and foot, in mm.
    numbers: [float],
    // 0 not ticked, 1 some of the group, 2 ticked (all of the group).
    state: int,
    // The last row of its group: its branch ends there.
    last: bool,
    enabled: bool,
}

// A built-in preset as a card: its name and the models it is for.
export struct PresetCard {
    title: string,
    range: string,
}

// One text of a drawing: a number in its box, which drags as a field does
// (left and right; Shift finer, Ctrl to tenths) and lights its part when
// clicked, or a plain word.
component CalloutView inherits Rectangle {
    in property <ShapeCallout> c;
    in property <int> hot;
    callback part-clicked(int);
    callback value-dragged(int, float);

    property <bool> lit: root.c.part == root.hot && root.c.part != 0;
    property <length> wide: label.preferred-width + (root.c.chip ? 10px : 0px);
    property <length> scrub-x;
    property <float> scrub-value;
    property <float> scrub-start;
    property <bool> scrubbing;

    pure function number(v: float) -> string {
        return round(v * 100) / 100;
    }
    pure function words() -> string {
        if root.c.word == 1 {
            return @tr("Inspector" => "model");
        }
        if root.c.word == 2 {
            return @tr("Inspector" => "plate");
        }
        if root.c.word == 3 {
            return @tr("Inspector" => "TIP");
        }
        if root.c.word == 4 {
            return @tr("Inspector" => "FOOT · half section");
        }
        if root.c.word == 5 {
            return @tr("Inspector" => "sinks");
        }
        if root.c.word == 6 {
            return @tr("Inspector" => "break");
        }
        if root.c.word == 7 {
            return @tr("Inspector" => "cone");
        }
        if root.c.word == 8 {
            return @tr("Inspector" => "thickness");
        }
        if root.c.word == 9 {
            return @tr("Inspector" => "ships with {}", root.number(root.c.value));
        }
        if root.c.word == 10 {
            return "1 mm";
        }
        if root.c.word == 11 {
            return @tr("Inspector" => "1 mm grid");
        }
        return "";
    }

    visible: root.c.chip || root.c.word != 0;
    x: 1px + root.c.x * 1px - (root.c.anchor == 1 ? root.wide : root.c.anchor == 2 ? root.wide / 2 : 0px);
    y: 1px + root.c.y * 1px - self.height / 2;
    width: root.wide;
    height: root.c.chip ? 16px : 12px;
    background: root.c.chip ? Theme.well : transparent;
    border-width: root.c.chip ? 1px : 0px;
    border-color: root.lit ? Theme.selection : Theme.border-strong;
    border-radius: Theme.radius-sm;

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.c.chip ? root.c.prefix + root.number(root.c.value) : root.words();
        font-family: Theme.mono;
        font-size: root.c.chip ? 10.5px : 9.5px;
        color: root.c.chip ? (root.lit ? Theme.selection : Theme.text-soft) : Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.c.chip: TouchArea {
        mouse-cursor: root.c.field >= 0 ? ew-resize : pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.scrub-x = self.mouse-x;
                root.scrub-value = root.c.value;
                root.scrub-start = root.c.value;
                root.scrubbing = false;
            } else if event.kind == PointerEventKind.move && self.pressed && root.c.field >= 0 {
                let dx = (self.mouse-x - root.scrub-x) / 1px;
                if !root.scrubbing && Math.abs(dx) < 3 {
                    return;
                }
                if !root.scrubbing {
                    root.scrubbing = true;
                    root.part-clicked(root.c.part);
                }
                let rate = Math.max(0.0025, Math.abs(root.scrub-start) * 0.005) * (event.modifiers.shift ? 0.1 : 1);
                root.scrub-value = Math.max(0, root.scrub-value + dx * rate);
                root.scrub-x = self.mouse-x;
                let steps = event.modifiers.control ? 10 : 100;
                let v = round(root.scrub-value * steps) / steps;
                if v != round(root.c.value * steps) / steps {
                    root.value-dragged(root.c.field, v);
                }
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                if root.scrubbing {
                    root.scrubbing = false;
                    root.part-clicked(0);
                } else {
                    root.part-clicked(root.c.part);
                }
            }
        }
    }
}

// A drawing of the support made by Rust, with its numbers and words over
// it. `turnable` turns it when dragged (the 3D view); `switchable` shows the
// 2D / 3D switch at its top right.
export component ShapeViewer inherits Rectangle {
    in property <image> picture;
    in property <[ShapeCallout]> callouts;
    in property <int> hot;
    in property <bool> turnable;
    in property <bool> switchable;
    // The plan (2D) is shown, not the 3D view.
    in property <bool> flat;
    callback dragged(float, float);
    callback part-clicked(int);
    callback value-dragged(int, float);
    callback flat-picked(bool);

    property <length> last-x;
    property <length> last-y;

    height: 242px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius;
    clip: true;

    Image {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        source: root.picture;
        image-fit: fill;
    }

    if root.turnable: TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.dragged((self.mouse-x - root.last-x) / 1px, (self.mouse-y - root.last-y) / 1px);
                root.last-x = self.mouse-x;
                root.last-y = self.mouse-y;
            }
        }
    }

    for c in root.callouts: CalloutView {
        c: c;
        hot: root.hot;
        part-clicked(part) => {
            root.part-clicked(part);
        }
        value-dragged(field, v) => {
            root.value-dragged(field, v);
        }
    }

    if root.turnable: Text {
        x: 8px;
        y: 5px;
        text: @tr("Inspector" => "drag to turn");
        font-family: Theme.mono;
        font-size: 10px;
        color: Theme.text-faint;
    }

    if root.switchable: Rectangle {
        x: parent.width - self.width - 6px;
        y: 5px;
        width: 52px;
        height: 18px;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-sm;
        clip: true;

        for name[i] in ["2D", "3D"]: Rectangle {
            property <bool> on: (i == 0) == root.flat;
            x: i * 26px;
            width: 26px;
            background: self.on ? Theme.action : mode.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: name;
            accessible-checkable: true;
            accessible-checked: self.on;
            accessible-action-default => {
                root.flat-picked(i == 0);
            }

            Text {
                text: name;
                font-family: Theme.mono;
                font-size: 10px;
                font-weight: 600;
                color: parent.on ? Theme.on-action : Theme.text-soft;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            mode := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.flat-picked(i == 0);
                }
            }
        }
    }
}

// The head of a part's fields: its name, a rule, and, when the part has
// more fields than the ones always shown, how many, to open and close them.
export component PartHead inherits HorizontalLayout {
    in property <string> title;
    in property <int> more;
    in-out property <bool> open;

    spacing: 8px;
    height: 18px;

    Text {
        text: root.title;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.8px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
    if root.more > 0: Rectangle {
        width: count.preferred-width + 16px;
        accessible-role: button;
        accessible-label: root.title + " +" + root.more;
        accessible-expanded: root.open;
        accessible-action-default => {
            root.open = !root.open;
        }

        count := Text {
            x: 0px;
            height: parent.height;
            text: "+" + root.more;
            font-family: Theme.mono;
            font-size: 10px;
            color: more-touch.has-hover ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
        }
        DisclosureChevron {
            x: parent.width - 9px;
            y: (parent.height - 8px) / 2;
            size: 8px;
            open: root.open;
            color: more-touch.has-hover ? Theme.text : Theme.text-muted;
        }
        more-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open = !root.open;
            }
        }
    }
}

// A number of the support: changes as it is typed, so the drawing follows;
// ↑ ↓ step it by 0.01, with Shift by 0.1. Pointing at it lights its part.
export component ShapeField inherits HorizontalLayout {
    in property <string> label;
    // What assistive tools read, when the label is short for its place
    // ("Diameter" under TIP): "Tip diameter".
    in property <string> full-label;
    in property <string> unit: "mm";
    in property <float> value;
    in property <int> part;
    in property <int> hot;
    in property <bool> enabled: true;
    // The built-in preset's number, or below 0 where there is none.
    in property <float> default-value: -1;
    callback edited(float);
    callback pointed(int);

    property <bool> off-default: root.enabled && root.default-value >= 0 && Math.abs(root.default-value - root.value) > 0.0005;

    // Dragging the number left or right turns it down or up, as in
    // Blender; a click without a drag types into it. Shift goes ten times
    // finer, Ctrl snaps to tenths.
    property <length> scrub-x;
    property <float> scrub-value;
    property <float> scrub-start;
    property <bool> scrubbing;

    function shown() -> string {
        return round(root.value * 100) / 100;
    }
    changed value => {
        if !input.has-focus {
            input.text = root.shown();
        }
    }

    spacing: 8px;
    min-height: 26px;

    if root.label != "": Rectangle {
        horizontal-stretch: 1;

        HorizontalLayout {
            spacing: 7px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.part == root.hot && root.part != 0 ? Theme.selection : Theme.border-strong;
                }
            }
            Text {
                text: root.label;
                font-size: Theme.font;
                color: root.part == root.hot && root.part != 0 ? Theme.text : root.enabled ? Theme.text-soft : Theme.text-faint;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        TouchArea {
            changed has-hover => {
                root.pointed(self.has-hover ? root.part : 0);
            }
        }
    }
    // The number it ships with, while it is not that.
    if root.off-default && root.label != "": Text {
        text: round(root.default-value * 100) / 100;
        font-family: Theme.mono;
        font-size: 10px;
        color: Theme.text-faint;
        vertical-alignment: center;
    }
    Rectangle {
        width: root.label != "" ? 96px : 72px;
        height: 26px;
        background: Theme.well;
        border-width: 1px;
        border-color: input.has-focus ? Theme.indicator : Theme.border;
        border-radius: Theme.radius;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;

            input := TextInput {
                text: root.shown();
                enabled: root.enabled;
                font-family: Theme.mono;
                font-size: Theme.font-sm;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                single-line: true;
                input-type: decimal;
                accessible-label: root.full-label != "" ? root.full-label : root.label;
                edited => {
                    if self.text.is-float() && self.text.to-float() >= 0 {
                        root.edited(self.text.to-float());
                    }
                }
                accepted => {
                    self.text = root.shown();
                    self.clear-focus();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        self.text = root.shown();
                        self.clear-focus();
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        // Snapped to the step, so 0.24 + 0.01 is 0.25.
                        let step = event.modifiers.shift ? 0.1 : 0.01;
                        let v = Math.max(0, round((root.value + (event.text == Key.UpArrow ? step : -step)) * 100) / 100);
                        self.text = round(v * 100) / 100;
                        root.edited(v);
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if !self.has-focus {
                        self.text = root.shown();
                        root.pointed(0);
                    } else {
                        self.select-all();
                        root.pointed(root.part);
                    }
                }
            }
            Text {
                text: root.unit;
                font-family: Theme.mono;
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        TouchArea {
            enabled: root.enabled && !input.has-focus;
            mouse-cursor: self.enabled ? ew-resize : default;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.scrub-x = self.mouse-x;
                    root.scrub-value = root.value;
                    root.scrub-start = root.value;
                    root.scrubbing = false;
                } else if event.kind == PointerEventKind.move && self.pressed {
                    let dx = (self.mouse-x - root.scrub-x) / 1px;
                    if !root.scrubbing && Math.abs(dx) < 3 {
                        return;
                    }
                    if !root.scrubbing {
                        root.scrubbing = true;
                        root.pointed(root.part);
                    }
                    // Per pixel: a fraction of the number at the press, so a 5 mm foot
                    // moves as readily as a 0.24 mm tip.
                    let rate = Math.max(0.0025, Math.abs(root.scrub-start) * 0.005) * (event.modifiers.shift ? 0.1 : 1);
                    root.scrub-value = Math.max(0, root.scrub-value + dx * rate);
                    root.scrub-x = self.mouse-x;
                    let steps = event.modifiers.control ? 10 : 100;
                    let v = round(root.scrub-value * steps) / steps;
                    if v != round(root.value * steps) / steps {
                        root.edited(v);
                    }
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    if root.scrubbing {
                        root.scrubbing = false;
                        root.pointed(0);
                    } else {
                        input.focus();
                    }
                }
            }
        }
    }
    ResetMark {
        shown: root.off-default;
        clicked => {
            input.text = round(root.default-value * 100) / 100;
            root.edited(root.default-value);
        }
    }
}

// The sizes a preset places, as one row: picking one shows it. Each chip
// draws its tip at the same zoom, so the sizes tell apart at a glance.
export component SizeChips inherits Rectangle {
    in property <[ShapeSize]> sizes;
    in property <int> current;
    callback picked(int);

    height: 52px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border-strong;
    border-radius: Theme.radius;
    clip: true;

    HorizontalLayout {
        for size[i] in root.sizes: cell := Rectangle {
            // The tip's ball and the start of its cone, 45 units a
            // millimetre in a box 60 by 28.
            property <float> r: Math.min(11, Math.max(1.5, size.tip / 2 * 45));
            property <float> top: self.r + 2;
            property <float> slope: Math.max(0, (size.trunk - size.tip) / 2 / Math.max(0.1, size.length));
            property <float> foot: Math.min(28, self.r + self.slope * (28 - self.top));
            property <brush> ink: i == root.current ? Theme.on-action : Theme.text-muted;

            width: root.width / Math.max(1, root.sizes.length);
            background: i == root.current ? Theme.action : chip.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: size.name + " " + round(size.tip * 100) / 100;
            accessible-checked: i == root.current;
            accessible-action-default => {
                root.picked(i);
            }

            Rectangle {
                x: (parent.width - 60px) / 2;
                y: 3px;
                width: 60px;
                height: 28px;
                clip: true;

                Path {
                    width: 60px;
                    height: 28px;
                    viewbox-width: 60;
                    viewbox-height: 28;
                    fill: cell.ink;
                    stroke: transparent;
                    opacity: 0.55;

                    MoveTo {
                        x: 30 - cell.r;
                        y: cell.top;
                    }

                    LineTo {
                        x: 30 + cell.r;
                        y: cell.top;
                    }

                    LineTo {
                        x: 30 + cell.foot;
                        y: 28;
                    }

                    LineTo {
                        x: 30 - cell.foot;
                        y: 28;
                    }

                    Close { }
                }
                Rectangle {
                    x: 30px - cell.r * 1px;
                    y: cell.top * 1px - cell.r * 1px;
                    width: cell.r * 2px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: cell.ink;
                }
            }
            HorizontalLayout {
                y: 33px;
                height: 16px;
                alignment: center;
                spacing: 5px;

                Text {
                    text: size.name;
                    font-family: Theme.mono;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    color: i == root.current ? Theme.on-action : Theme.text-soft;
                    vertical-alignment: center;
                }
                Text {
                    text: round(size.tip * 100) / 100;
                    font-family: Theme.mono;
                    font-size: 10px;
                    color: i == root.current ? Theme.on-action : Theme.text-faint;
                    vertical-alignment: center;
                }
            }
            if i > 0: Rectangle {
                x: 0;
                width: 1px;
                background: Theme.border-strong;
            }
            chip := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// The built-in presets as cards; none lit while the options are the
// person's own.
export component PresetCards inherits HorizontalLayout {
    in property <[PresetCard]> cards;
    in property <int> current;
    in property <bool> enabled: true;
    callback picked(int);

    spacing: 6px;

    for card[i] in root.cards: Rectangle {
        horizontal-stretch: 1;
        height: 44px;
        background: Theme.card;
        border-width: i == root.current ? 2px : 1px;
        border-color: i == root.current ? Theme.indicator : pick.has-hover ? Theme.border-strong : Theme.border;
        border-radius: Theme.radius;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: button;
        accessible-label: card.title;
        accessible-checked: i == root.current;
        accessible-action-default => {
            root.picked(i);
        }

        VerticalLayout {
            padding-left: 8px;
            padding-right: 6px;
            alignment: center;
            spacing: 1px;

            Text {
                text: card.title;
                font-size: Theme.font-sm;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: card.range;
                font-family: Theme.mono;
                font-size: 10px;
                color: Theme.text-faint;
                overflow: elide;
            }
        }
        pick := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.picked(i);
            }
        }
    }
}

// What the fields edit: the preset for the next Generate, said in a box
// over the drawing.
export component ScopeBox inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <bool> warm;

    height: 30px;
    background: Theme.card;
    border-width: 1px;
    border-color: root.warm ? Theme.selection : Theme.border;
    border-radius: Theme.radius;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.warm ? Theme.selection : Theme.text-faint;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.font-sm;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.note;
            font-family: Theme.mono;
            font-size: 10px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    }
}

// One row of where each size goes: the zone, the size it places and how
// far apart.
export component ZoneRowView inherits HorizontalLayout {
    in property <ZoneRow> zone;
    in property <[string]> size-names;
    callback size-picked(int);
    callback spacing-edited(float);

    spacing: 6px;
    min-height: 34px;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;

        Text {
            text: root.zone.name;
            font-size: Theme.font;
            color: Theme.text-soft;
            overflow: elide;
        }
        Text {
            text: root.zone.detail;
            font-family: Theme.mono;
            font-size: 10px;
            color: Theme.text-faint;
            overflow: elide;
        }
    }
    VerticalLayout {
        alignment: center;

        ComboBox {
            width: 62px;
            horizontal-stretch: 0;
            model: root.size-names;
            current-index: root.zone.size;
            selected => {
                root.size-picked(self.current-index);
            }
        }
    }
    ResetMark {
        shown: root.zone.default-size >= 0 && root.zone.default-size != root.zone.size;
        clicked => {
            root.size-picked(root.zone.default-size);
        }
    }
    VerticalLayout {
        alignment: center;

        ShapeField {
            label: "";
            value: root.zone.spacing;
            default-value: root.zone.default-spacing;
            part: 0;
            hot: 0;
            edited(v) => {
                root.spacing-edited(v);
            }
        }
    }
}

// The two pages of the Supports tab: what Generate places, and what the
// hand tools place.
export component PageTabs inherits Rectangle {
    in property <[string]> pages;
    in property <int> current;
    callback picked(int);

    height: 34px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        for page[i] in root.pages: Rectangle {
            horizontal-stretch: 1;
            accessible-role: AccessibleRole.tab;
            accessible-label: page;
            accessible-checked: i == root.current;
            accessible-action-default => {
                root.picked(i);
            }

            Text {
                text: page;
                font-size: Theme.font;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.text : tab.has-hover ? Theme.text-soft : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: i == root.current ? Theme.indicator : transparent;
            }
            tab := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// A hand tool of the Supports tab, as a button of the tools row: its icon,
// its name and its key.
export component HandToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 1;
    height: 52px;
    background: root.active ? Theme.action : touch.has-hover ? Theme.hover : Theme.card;
    border-width: 1px;
    border-color: root.active ? Theme.action : Theme.border;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    Icon {
        commands: root.icon;
        size: 18px;
        x: (parent.width - 18px) / 2;
        y: 7px;
        color: root.active ? Theme.on-action : Theme.text-soft;
    }
    Text {
        x: 2px;
        y: 29px;
        width: parent.width - 4px;
        text: root.label;
        font-size: 10.5px;
        color: root.active ? Theme.on-action : Theme.text-soft;
        horizontal-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 13px;
        y: 3px;
        text: root.shortcut;
        font-family: Theme.mono;
        font-size: 9px;
        color: root.active ? Theme.on-action : Theme.text-faint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// The person's own presets as a list: a click picks one.
export component OwnPresets inherits VerticalLayout {
    in property <[string]> names;
    in property <int> current: -1;
    in property <bool> enabled: true;
    callback picked(int);

    spacing: 4px;

    for name[i] in root.names: Rectangle {
        height: 28px;
        background: i == root.current ? Theme.hover : row.has-hover ? Theme.hover : Theme.card;
        border-width: i == root.current ? 2px : 1px;
        border-color: i == root.current ? Theme.indicator : Theme.border;
        border-radius: Theme.radius;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: button;
        accessible-label: name;
        accessible-checked: i == root.current;
        accessible-action-default => {
            root.picked(i);
        }

        Text {
            x: 9px;
            width: parent.width - 18px;
            text: name;
            font-size: Theme.font-sm;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        row := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                root.picked(i);
            }
        }
    }
}

// A check box of the tree: ticked, empty, or a dash when some of its
// group are ticked.
component TreeBox inherits Rectangle {
    in property <int> state;
    in property <bool> hot;

    width: 16px;
    height: 16px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.state != 0 ? Theme.action : root.hot ? Theme.text-muted : Theme.border-strong;
    background: root.state != 0 ? Theme.action : Theme.well;

    if root.state == 2: Icon {
        commands: Icons.check;
        size: 12px;
        x: 2px;
        y: 2px;
        stroke-width: 2.4px;
        color: Theme.on-action;
    }
    if root.state == 1: Rectangle {
        width: 8px;
        height: 2px;
        x: 4px;
        y: 7px;
        background: Theme.on-action;
    }
}

// 1 row of the tree of what a support settings file holds: a group's head
// (its box ticks all of it) or 1 thing of it, hung from the head by a line.
// A click anywhere on the row ticks it.
component ShareRow inherits Rectangle {
    in property <ShareItem> item;
    callback toggled(bool);

    // Where the head's box sits; its children's lines drop from its middle.
    property <length> box-x: 10px;
    property <length> branch-x: root.box-x + 8px;
    property <length> gap: root.item.header && root.item.group == 1 ? 12px : 0px;
    property <length> body: root.item.header ? 46px : 36px;

    height: root.gap + root.body;
    opacity: root.item.enabled ? 1 : 0.6;
    accessible-role: checkbox;
    accessible-label: root.item.name;
    accessible-checkable: true;
    accessible-checked: root.item.state == 2;
    accessible-action-default => {
        root.toggled(root.item.state != 2);
    }

    Rectangle {
        y: root.gap;
        height: root.body;
        border-radius: Theme.radius;
        background: touch.has-hover && root.item.enabled ? Theme.hover : transparent;
    }
    // The tree's lines: from the head's box down, and to each child.
    if root.item.header && !root.item.last: Rectangle {
        x: root.branch-x;
        y: root.gap + root.body / 2 + 8px;
        width: 1px;
        height: root.body / 2 - 8px;
        background: Theme.border-strong;
    }
    if !root.item.header: Rectangle {
        x: root.branch-x;
        y: 0;
        width: 1px;
        height: root.item.last ? root.body / 2 : root.body;
        background: Theme.border-strong;
    }
    if !root.item.header: Rectangle {
        x: root.branch-x;
        y: root.body / 2;
        width: 14px;
        height: 1px;
        background: Theme.border-strong;
    }

    TreeBox {
        x: root.item.header ? root.box-x : root.branch-x + 18px;
        y: root.gap + (root.body - self.height) / 2;
        state: root.item.state;
        hot: touch.has-hover && root.item.enabled;
    }
    if root.item.header: Rectangle {
        x: root.box-x + 28px;
        y: root.gap + (root.body - self.height) / 2;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.border;

        Icon {
            commands: root.item.group == 1 ? Icons.add-support : Icons.supports;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 16px;
            color: root.item.state != 0 ? Theme.text : Theme.text-muted;
        }
    }
    VerticalLayout {
        x: root.item.header ? root.box-x + 66px : root.branch-x + 46px;
        y: root.gap;
        width: root.width - self.x - 10px;
        height: root.body;
        alignment: center;
        spacing: 1px;

        Text {
            text: root.item.name;
            font-size: Theme.font;
            font-weight: root.item.header || root.item.group == 1 ? 600 : 400;
            font-family: !root.item.header && root.item.group == 1 ? Theme.mono : "";
            color: root.item.state != 0 ? Theme.text : Theme.text-soft;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: !root.item.header && root.item.numbers.length >= 3
                ? @tr("Inspector" => "tip {}  ·  trunk {}  ·  foot {} mm",
                    round(root.item.numbers[0] * 100) / 100,
                    round(root.item.numbers[1] * 100) / 100,
                    round(root.item.numbers[2] * 100) / 100)
                : root.item.detail;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            wrap: root.item.header ? TextWrap.word-wrap : TextWrap.no-wrap;
            overflow: elide;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.item.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled(root.item.state != 2);
        }
    }
}

// What goes into a support settings file, or comes out of one, as a list
// to tick: over the whole window, until it is answered.
export component SharePicker inherits Rectangle {
    // 1 picks what to export, 2 what to import.
    in property <int> mode;
    in property <[ShareItem]> items;
    in property <int> picked-count;
    in property <int> total;
    callback toggled(int, bool);
    callback accepted();
    callback cancelled();

    background: #00000099;

    // Swallows what is under it; a click outside the card cancels.
    TouchArea {
        clicked => {
            root.cancelled();
        }
    }
    // Over the click area: it keeps the keyboard from opening on, and must
    // not keep a click outside the card for itself.
    scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if event.text == Key.Return && root.picked-count > 0 {
                root.accepted();
                return accept;
            }
            return reject;
        }
    }
    init => {
        scope.focus();
    }

    card := Rectangle {
        width: Math.min(root.width - 32px, 480px);
        height: Math.min(root.height - 48px, layout.preferred-height);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000066;

        // A click on the card itself is not a click outside.
        TouchArea { }

        layout := VerticalLayout {
            DialogHead {
                icon: root.mode == 1 ? Icons.export : Icons.import;
                title: root.mode == 1 ? @tr("Inspector" => "Export support settings") : @tr("Inspector" => "Import support settings");
                subtitle: root.mode == 1
                    ? @tr("Inspector" => "One .breadsupports file with what you tick")
                    : @tr("Inspector" => "Tick what to take from the file");
                close-label: @tr("Inspector" => "Close");
                close => {
                    root.cancelled();
                }
            }
            DialogRule { }
            ScrollView {
                vertical-stretch: 1;
                min-height: Math.min(list.preferred-height, 120px);
                preferred-height: list.preferred-height;

                list := VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 12px;
                    padding-bottom: 14px;
                    spacing: 0px;
                    alignment: start;

                    for item[i] in root.items: ShareRow {
                        item: item;
                        toggled(on) => {
                            root.toggled(i, on);
                        }
                    }
                    if root.mode == 2: VerticalLayout {
                        padding-top: 12px;

                        Text {
                            text: @tr("Inspector" => "A preset named as one of yours comes in under a new name; none of yours is replaced. A hand size ticked replaces yours.");
                            font-size: Theme.font-xs;
                            color: Theme.text-faint;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            DialogRule { }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                Text {
                    text: @tr("Inspector" => "{} of {} ticked", root.picked-count, root.total);
                    font-family: Theme.mono;
                    font-size: Theme.font-xs;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                ScButton {
                    text: @tr("Inspector" => "Cancel");
                    kind: ButtonKind.ghost;
                    clicked => {
                        root.cancelled();
                    }
                }
                ScButton {
                    text: root.mode == 1 ? @tr("Inspector" => "Export…") : @tr("Inspector" => "Import");
                    kind: ButtonKind.primary;
                    enabled: root.picked-count > 0;
                    clicked => {
                        root.accepted();
                    }
                }
            }
        }
    }
}
