// Printer & resin (#151) and the first run (#608), drawn inside the main
// window like the start dialog: a dimmed layer with a card on it. The card
// picks the printer and its resin, and edits them: a printer's or a resin's
// every setting, in fixed slots. Rust (`setup_window.rs`) fills it through
// the `Picker` global, one per window.

import { Theme } from "kit/theme.slint";
import { ScrollView } from "std-widgets.slint";
import { ScButton as Button, ScCheckBox, ScComboBox, ScLineEdit as LineEdit } from "kit/controls.slint";
import { Icons } from "kit/icons.slint";
import { DialogHead, DialogRule } from "kit/dialog.slint";

// One printer of the picker (#151). `index` is its place in the Rust
// catalog, the handle the callbacks carry.
export struct PickPrinter {
    index: int,
    brand: string,
    name: string,
    // "223.6 × 127 × 230 mm" and the file it writes (".azf").
    size: string,
    file: string,
    // A file this build cannot write yet: listed, and said so.
    exports: bool,
    image: image,
    has-image: bool,
    in-use: bool,
    mine: bool,
}

// One entry of the left column: a group or a maker, with its count.
export struct PickNav {
    label: string,
    count: int,
    // Draws a line above it.
    rule: bool,
}

// One resin of the chosen printer.
export struct PickResin {
    index: int,
    brand: string,
    name: string,
    // "2 s" with the printer's own block, "" with none.
    exposure: string,
    calibrated: bool,
}

// One control layout of the first run (#609).
export struct PickLayout {
    name: string,
    summary: string,
}

component NavRow inherits Rectangle {
    in property <PickNav> nav;
    in property <bool> current;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    background: root.current ? Theme.hover : touch.has-hover ? Theme.raised : transparent;

    if root.nav.rule: Rectangle {
        y: -4px;
        height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: 0;
        width: 2px;
        background: root.current ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        Text {
            text: root.nav.label;
            color: root.current ? Theme.text : Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.nav.count;
            color: Theme.text-faint;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PrinterTile inherits Rectangle {
    in property <PickPrinter> printer;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();

    border-radius: Theme.radius-lg;
    background: Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    accessible-role: list-item;
    accessible-label: root.printer.brand + " " + root.printer.name;
    accessible-item-selected: root.selected;

    VerticalLayout {
        padding: 9px;
        spacing: 3px;
        Rectangle {
            height: 92px;
            border-radius: Theme.radius;
            background: Theme.well;
            if root.printer.has-image: Image {
                source: root.printer.image;
                height: 84px;
                width: parent.width - 8px;
                image-fit: contain;
            }
            if !root.printer.has-image: Text {
                text: @tr("PrinterPicker" => "NO PICTURE YET");
                font-family: Theme.mono;
                font-size: 9.5px;
                color: Theme.text-faint;
            }
        }
        Text {
            text: root.printer.brand;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.printer.name;
            font-size: Theme.font;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        HorizontalLayout {
            Text {
                text: root.printer.size;
                font-family: Theme.mono;
                font-size: 10px;
                color: Theme.text-soft;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.printer.file;
                font-family: Theme.mono;
                font-size: 10px;
                color: root.printer.exports ? Theme.text-soft : Theme.warning;
            }
        }
    }
    if root.printer.in-use || !root.printer.exports || root.printer.mine: Rectangle {
        x: 8px;
        y: 8px;
        width: tag.preferred-width + 10px;
        height: 16px;
        border-radius: 2px;
        background: root.printer.in-use ? #e2a75022 : #e9c85a1a;
        border-width: 1px;
        border-color: root.printer.in-use ? #e2a75066 : #e9c85a55;
        tag := Text {
            text: root.printer.in-use ? @tr("PrinterPicker" => "IN USE")
                : !root.printer.exports ? @tr("PrinterPicker" => "CAN'T EXPORT YET")
                : @tr("PrinterPicker" => "MINE");
            font-family: Theme.mono;
            font-size: 9px;
            color: root.printer.in-use ? Theme.accent : Theme.warning;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

component ResinRowView inherits Rectangle {
    in property <PickResin> resin;
    in property <bool> selected;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.border-strong;
    accessible-role: list-item;
    accessible-label: root.resin.brand + " " + root.resin.name;
    accessible-item-selected: root.selected;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.resin.brand;
            width: 76px;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.resin.name;
            font-size: Theme.font;
            color: root.resin.calibrated ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.resin.exposure;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            color: Theme.text-soft;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LayoutCard inherits Rectangle {
    in property <PickLayout> layout;
    in property <bool> selected;
    callback clicked();

    border-radius: Theme.radius-lg;
    background: Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    accessible-role: list-item;
    accessible-label: root.layout.name;
    accessible-item-selected: root.selected;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.layout.name;
            font-size: Theme.font-lg;
            font-weight: 600;
            color: Theme.text;
        }
        Text {
            text: root.layout.summary;
            font-size: Theme.font-sm;
            color: Theme.text-soft;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One setting of a printer or a resin form: a number or a text (`kind`
// 0), a box to tick (1) or a choice (2). `value` is what it holds, "" for
// none; `unit` follows it.
export struct FormField {
    key: string,
    label: string,
    unit: string,
    value: string,
    kind: int,
    on: bool,
    choices: [string],
    choice: int,
}

// A group of settings under its title, such as "LIFT & RETRACT".
export struct FormSection {
    title: string,
    fields: [FormField],
}

// What Rust sets and hears of the card: each window has its own.
export global Picker {
    in-out property <bool> open: false;
    // The first run: three steps, 0 printer, 1 resin, 2 controls.
    in property <bool> welcome;
    in-out property <int> step: 0;
    // 0 the picker, 1 a printer's form, 2 a resin's form.
    in-out property <int> page: 0;

    in property <[PickNav]> nav;
    in-out property <int> current-nav: 0;
    in-out property <string> search;
    in property <[PickPrinter]> printers;
    in property <string> list-title;
    // The printer chosen, `index` -1 for none.
    in property <PickPrinter> chosen: { index: -1 };
    in property <[PickResin]> resins;
    in-out property <int> chosen-resin: -1;
    in property <string> resins-note;
    in property <[PickLayout]> layouts;
    in-out property <int> chosen-layout: 0;

    // The form open (page 1 or 2): its title and the line under it, the
    // printers a resin has settings for (the chosen one first), its
    // sections in 2 columns, a line on what the numbers make, a note, the
    // error of the last save, and what Save is called.
    in property <string> form-title;
    in property <string> form-subtitle;
    in property <[string]> form-chips;
    in-out property <int> form-chip: 0;
    in property <[FormSection]> form-left;
    in property <[FormSection]> form-right;
    in property <string> form-summary;
    in property <string> form-note;
    in property <string> form-error;
    in property <string> form-save-label;

    callback search-edited(string);
    callback nav-picked(int);
    callback printer-picked(int);
    callback resin-picked(int);
    callback layout-picked(int);
    // Use these: the printer and resin chosen become the ones in use.
    callback use-pressed();
    callback add-printer-pressed();
    callback import-pressed();
    // The printer chosen, or the resin chosen, in its form.
    callback edit-printer-pressed();
    callback edit-resin-pressed();
    callback skip-pressed();

    callback form-edited(string, string);
    callback form-toggled(string, bool);
    callback form-picked(string, int);
    callback form-chip-picked(int);
    callback form-save();
    callback form-back();
}

component FormFieldView inherits Rectangle {
    in property <FormField> field;

    height: 30px;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.field.label;
            width: 45%;
            color: Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.field.kind == 0: LineEdit {
            horizontal-stretch: 1;
            text: root.field.value;
            placeholder-text: "—";
            edited(t) => {
                Picker.form-edited(root.field.key, t);
            }
        }
        if root.field.kind == 0: Text {
            width: 52px;
            text: root.field.unit;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
        if root.field.kind == 1: ScCheckBox {
            horizontal-stretch: 1;
            checked: root.field.on;
            toggled => {
                Picker.form-toggled(root.field.key, self.checked);
            }
        }
        if root.field.kind == 2: ScComboBox {
            horizontal-stretch: 1;
            model: root.field.choices;
            current-index: root.field.choice;
            selected => {
                Picker.form-picked(root.field.key, self.current-index);
            }
        }
    }
}

component FormSectionView inherits VerticalLayout {
    in property <FormSection> section;

    spacing: 4px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.section.title;
            font-family: Theme.mono;
            font-size: 10.5px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - 1px) / 2;
                height: 1px;
                background: Theme.border-soft;
            }
        }
    }
    for f in root.section.fields: FormFieldView {
        field: f;
    }
}

// A printer's or a resin's every setting, in 2 columns of fixed slots.
component FormPage inherits VerticalLayout {
    padding: 18px;
    padding-top: 12px;
    spacing: 10px;

    // The printer whose settings the slots show, the one chosen first.
    if Picker.form-chips.length > 0: HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Text {
            text: @tr("PrinterPicker" => "Settings for");
            color: Theme.text-soft;
            vertical-alignment: center;
        }
        ScComboBox {
            width: 340px;
            model: Picker.form-chips;
            current-index: Picker.form-chip;
            selected => {
                Picker.form-chip = self.current-index;
                Picker.form-chip-picked(self.current-index);
            }
        }
    }
    ScrollView {
        vertical-stretch: 1;
        HorizontalLayout {
            spacing: 28px;
            alignment: stretch;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 16px;
                for s in Picker.form-left: FormSectionView {
                    section: s;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 16px;
                for s in Picker.form-right: FormSectionView {
                    section: s;
                }
            }
        }
    }
    if Picker.form-summary != "": Text {
        text: Picker.form-summary;
        font-size: Theme.font-sm;
        color: Theme.text-soft;
        wrap: word-wrap;
    }
    if Picker.form-note != "": Text {
        text: Picker.form-note;
        font-size: Theme.font-xs;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    if Picker.form-error != "": Text {
        text: Picker.form-error;
        font-size: Theme.font-sm;
        color: Theme.danger;
        wrap: word-wrap;
    }
}

// Printer & resin over the window (#151), and the first run (#608).
export component SetupLayer inherits Rectangle {
    visible: Picker.open;
    background: #0000008c;

    changed visible => {
        if (self.visible) {
            fs.focus();
        }
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: Picker.open;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (Picker.page != 0) {
                    Picker.form-back();
                } else {
                    Picker.skip-pressed();
                }
            }
            return accept;
        }

        // The dimmed window around the card holds the clicks.
        TouchArea {
            scroll-event(event) => {
                return accept;
            }
        }

        card := Rectangle {
            width: Math.min(parent.width - 48px, 1180px);
            height: Math.min(parent.height - 48px, 760px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            clip: true;

            TouchArea {
                scroll-event(event) => {
                    return accept;
                }
            }

            VerticalLayout {
                DialogHead {
                    icon: Icons.printer;
                    title: Picker.page != 0 ? Picker.form-title
                        : Picker.welcome ? @tr("PrinterPicker" => "Welcome to Breadslicer")
                        : @tr("PrinterPicker" => "Printer & resin");
                    subtitle: Picker.page != 0 ? Picker.form-subtitle
                        : Picker.welcome ? @tr("PrinterPicker" => "What you print on, in three steps")
                        : @tr("PrinterPicker" => "What this project prints on");
                    close-label: @tr("PrinterPicker" => "Close");
                    close => {
                        if (Picker.page != 0) {
                            Picker.form-back();
                        } else {
                            Picker.skip-pressed();
                        }
                    }
                }
                DialogRule { }

                if Picker.page != 0: FormPage {
                    vertical-stretch: 1;
                }
                if Picker.page != 0: Rectangle {
                    height: 52px;
                    background: Theme.chrome;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: @tr("PrinterPicker" => "Cancel");
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                Picker.form-back();
                            }
                        }
                        Button {
                            primary: true;
                            text: Picker.form-save-label;
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                Picker.form-save();
                            }
                        }
                    }
                }

                if Picker.page == 0: Rectangle {
                    vertical-stretch: 1;
                VerticalLayout {
                    if Picker.welcome: Rectangle {
                        height: 40px;
                        background: Theme.chrome;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            for label[i] in [
                                @tr("PrinterPicker" => "1  Printer"),
                                @tr("PrinterPicker" => "2  Resin"),
                                @tr("PrinterPicker" => "3  Controls"),
                            ]: Rectangle {
                                Text {
                                    text: label + (i < Picker.step ? "  ✓" : "");
                                    font-size: Theme.font;
                                    color: i == Picker.step ? Theme.text : i < Picker.step ? Theme.text-soft : Theme.text-faint;
                                }
                                Rectangle {
                                    y: parent.height - 2px;
                                    height: 2px;
                                    background: i == Picker.step ? Theme.accent : transparent;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.border;
                        }
                    }

                    if Picker.welcome && Picker.step == 2: VerticalLayout {
                        padding: 26px;
                        spacing: 14px;
                        vertical-stretch: 1;
                        Text {
                            text: @tr("PrinterPicker" => "How do you like to move around?");
                            font-size: 20px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: @tr("PrinterPicker" => "Pick the mouse you already know. Change it later in Preferences.");
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: stretch;
                            for layout[i] in Picker.layouts: LayoutCard {
                                width: (parent.width - (Picker.layouts.length - 1) * 12px) / max(1, Picker.layouts.length);
                                height: 190px;
                                layout: layout;
                                selected: i == Picker.chosen-layout;
                                clicked => {
                                    Picker.chosen-layout = i;
                                    Picker.layout-picked(i);
                                }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                        }
                    }

                    if !Picker.welcome || Picker.step < 2: HorizontalLayout {
                        vertical-stretch: 1;

                        // Search and groups.
                        Rectangle {
                            width: 210px;
                            background: Theme.chrome;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                search-field := LineEdit {
                                    placeholder-text: @tr("PrinterPicker" => "Search printers");
                                    text <=> Picker.search;
                                    edited(t) => {
                                        Picker.search-edited(t);
                                    }
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for nav[i] in Picker.nav: NavRow {
                                            nav: nav;
                                            current: i == Picker.current-nav;
                                            clicked => {
                                                Picker.current-nav = i;
                                                Picker.nav-picked(i);
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                x: parent.width - 1px;
                                width: 1px;
                                background: Theme.border;
                            }
                        }

                        // The printers.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            padding: 14px;
                            spacing: 10px;
                            if Picker.welcome: VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: Picker.step == 0 ? @tr("PrinterPicker" => "What do you print on?") : @tr("PrinterPicker" => "Which resin?");
                                    font-size: 20px;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: Picker.step == 0
                                        ? @tr("PrinterPicker" => "Pick your printer so the plate, the pixels and the file are right from the first print. You can change it any time.")
                                        : @tr("PrinterPicker" => "The resins on the right are set for your printer. Pick the one in the vat.");
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }
                            Text {
                                text: Picker.list-title;
                                font-family: Theme.mono;
                                font-size: 10.5px;
                                color: Theme.text-muted;
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                property <int> columns: max(1, floor((self.visible-width + 6px) / 176px));
                                property <length> tile-w: (self.visible-width - 4px - (self.columns - 1) * 10px) / self.columns;
                                viewport-height: ceil(Picker.printers.length / self.columns) * 186px;
                                for printer[i] in Picker.printers: PrinterTile {
                                    x: mod(i, parent.columns) * (parent.tile-w + 10px);
                                    y: floor(i / parent.columns) * 186px;
                                    width: parent.tile-w;
                                    height: 176px;
                                    printer: printer;
                                    selected: printer.index == Picker.chosen.index;
                                    clicked => {
                                        Picker.printer-picked(printer.index);
                                    }
                                    double-clicked => {
                                        Picker.printer-picked(printer.index);
                                        if !Picker.welcome {
                                            Picker.use-pressed();
                                        }
                                    }
                                }
                            }
                        }

                        // The printer chosen and its resins.
                        Rectangle {
                            width: 330px;
                            background: Theme.chrome;
                            Rectangle {
                                x: 0;
                                width: 1px;
                                background: Theme.border;
                            }
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                if Picker.chosen.index >= 0: Rectangle {
                                    height: 140px;
                                    border-radius: Theme.radius;
                                    background: Theme.well;
                                    if Picker.chosen.has-image: Image {
                                        source: Picker.chosen.image;
                                        height: 130px;
                                        width: parent.width - 10px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: Picker.chosen.index >= 0 ? Picker.chosen.name : @tr("PrinterPicker" => "Pick a printer");
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                if Picker.chosen.index >= 0: Text {
                                    text: Picker.chosen.brand + "  ·  " + Picker.chosen.size + "  ·  " + Picker.chosen.file;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                if Picker.chosen.index >= 0 && !Picker.chosen.exports: Text {
                                    text: @tr("PrinterPicker" => "This build cannot write this printer's file yet: you can prepare a project, not export it.");
                                    font-size: Theme.font-sm;
                                    color: Theme.warning;
                                    wrap: word-wrap;
                                }
                                if Picker.chosen.index >= 0: Button {
                                    text: @tr("PrinterPicker" => "Edit printer…");
                                    clicked => {
                                        Picker.edit-printer-pressed();
                                    }
                                }
                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }
                                Text {
                                    text: @tr("PrinterPicker" => "RESIN");
                                    font-family: Theme.mono;
                                    font-size: 10.5px;
                                    color: Theme.text-muted;
                                }
                                if Picker.resins-note != "": Text {
                                    text: Picker.resins-note;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for resin[i] in Picker.resins: ResinRowView {
                                            resin: resin;
                                            selected: resin.index == Picker.chosen-resin;
                                            clicked => {
                                                Picker.chosen-resin = resin.index;
                                                Picker.resin-picked(resin.index);
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: @tr("PrinterPicker" => "Edit resin…");
                                        enabled: Picker.chosen-resin >= 0;
                                        clicked => {
                                            Picker.edit-resin-pressed();
                                        }
                                    }
                                    Button {
                                        text: @tr("PrinterPicker" => "Import my resins…");
                                        clicked => {
                                            Picker.import-pressed();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The foot.
                    Rectangle {
                        height: 52px;
                        background: Theme.chrome;
                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.border;
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: stretch;
                            if !Picker.welcome || Picker.step == 0: Button {
                                text: @tr("PrinterPicker" => "Add a printer…");
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    Picker.add-printer-pressed();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            if Picker.welcome && Picker.step > 0: Button {
                                text: @tr("PrinterPicker" => "← Back");
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    Picker.step = Picker.step - 1;
                                }
                            }
                            Button {
                                text: Picker.welcome ? @tr("PrinterPicker" => "Skip for now") : @tr("PrinterPicker" => "Cancel");
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    Picker.skip-pressed();
                                }
                            }
                            Button {
                                primary: true;
                                y: (parent.height - self.height) / 2;
                                enabled: Picker.chosen.index >= 0 && (Picker.step != 1 || Picker.chosen-resin >= 0 || Picker.resins.length == 0);
                                text: !Picker.welcome ? @tr("PrinterPicker" => "Use these")
                                    : Picker.step == 0 ? @tr("PrinterPicker" => "Next: resin →")
                                    : Picker.step == 1 ? @tr("PrinterPicker" => "Next: controls →")
                                    : @tr("PrinterPicker" => "Start printing");
                                clicked => {
                                    if Picker.welcome && Picker.step < 2 {
                                        Picker.step = Picker.step + 1;
                                    } else {
                                        Picker.use-pressed();
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        }
    }
}
