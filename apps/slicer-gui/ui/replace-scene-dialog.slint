import { Button, Palette } from "std-widgets.slint";

// Modal shown when the user opens a new mesh into a window that already
// holds a loaded scene. Three exits: Discard (close current, load new),
// Export (run "Export As…" against the current scene first, then load
// new on successful export), Cancel (do nothing). The caller wires
// what each choice means; this component only reports it.
export component ReplaceSceneDialog inherits Window {
    title: @tr("ReplaceSceneDialog" => "Open new model");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    in property <string> source-name;
    // True when the loaded scene has unsaved changes (per the
    // document's dirty tracking). Hides the Export button when
    // false: there's nothing to export that the user couldn't
    // reproduce by reloading the source file.
    in property <bool> can-export: true;

    callback discard-requested();
    callback export-requested();
    callback cancel-requested();

    property <length> font-secondary: 0.85rem;

    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    preferred-height: body.preferred-height;

    // Cancel is the safe default: pressing Enter shouldn't discard or
    // overwrite the current scene.
    forward-focus: cancel-button;

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: @tr("ReplaceSceneDialog" => "Replace the current scene?");
                    font-weight: 700;
                    wrap: word-wrap;
                }

                if root.source-name != "": Text {
                    text: @tr("ReplaceSceneDialog" => "Opening: {}", root.source-name);
                    font-size: root.font-secondary;
                    color: Palette.foreground.transparentize(0.5);
                    wrap: word-wrap;
                }

                Text {
                    // No project files yet, so there is no "save".
                    // When the user has applied changes, the only way
                    // to keep them is to export; when nothing has
                    // changed there's nothing to lose. The body text
                    // adapts to match what the buttons offer.
                    text: root.can-export
                        ? @tr(
                            "ReplaceSceneDialog"
                            => "The current scene will be closed. Export it first to keep any changes you've made."
                        )
                        : @tr(
                            "ReplaceSceneDialog"
                            => "The current scene will be closed."
                        );
                    font-size: root.font-secondary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    text: @tr("ReplaceSceneDialog" => "Discard & Open");
                    clicked => {
                        root.discard-requested();
                    }
                }

                if root.can-export: Button {
                    text: @tr("ReplaceSceneDialog" => "Export & Open…");
                    clicked => {
                        root.export-requested();
                    }
                }

                cancel-button := Button {
                    text: @tr("ReplaceSceneDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
