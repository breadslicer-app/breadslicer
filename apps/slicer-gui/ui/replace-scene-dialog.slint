import { Button, Palette } from "std-widgets.slint";
import { ThemePreference } from "preferences/appearance.slint";

// Modal shown when the user opens a new mesh into a window that already holds a
// loaded scene. 4 exits: Discard (close current, load new), Save (save the
// current scene as a project first, then load new on success), Export (run
// "Export As..." against the current scene first, then load new on successful
// export), Cancel (do nothing). The caller wires what each choice means; this
// component only reports it.
export component ReplaceSceneDialog inherits Window {
    title: root.closing ? @tr("ReplaceSceneDialog" => "Close scene") : @tr("ReplaceSceneDialog" => "Open new model");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    in property <string> source-name;
    in property <bool> closing: false;
    // True when the loaded scene has unsaved changes (per the document's dirty
    // tracking). Hides the Save and Export buttons when false: there's nothing
    // to keep that the user couldn't reproduce by reloading the source file.
    in property <bool> has-unsaved-changes: true;
    // True when the scene has no project file yet, so saving goes through a
    // "pick a file" dialog. Switches the Save button and the body text to "Save
    // As" wording.
    in property <bool> save-as-mode: false;
    in property <ThemePreference> theme: ThemePreference.System;

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    callback discard-requested();
    callback save-requested();
    callback export-requested();
    callback cancel-requested();

    property <length> font-secondary: 0.85rem;

    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    preferred-height: body.preferred-height;

    // Cancel is the safe default: pressing Enter shouldn't discard or overwrite
    // the current scene.
    forward-focus: cancel-button;

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: root.closing ? @tr("ReplaceSceneDialog" => "Close the current scene?") : @tr("ReplaceSceneDialog" => "Replace the current scene?");
                    font-weight: 700;
                    wrap: word-wrap;
                }

                if root.source-name != "": Text {
                    text: @tr("ReplaceSceneDialog" => "Opening: {}", root.source-name);
                    font-size: root.font-secondary;
                    color: Palette.foreground.transparentize(0.5);
                    wrap: word-wrap;
                }

                Text {
                    // The body text adapts to match what the buttons offer:
                    // with unsaved changes the user can save them (to the
                    // project file, or to a new one) or export a copy; with
                    // nothing changed there is nothing to lose.
                    text: !root.has-unsaved-changes
                        ? @tr(
                            "ReplaceSceneDialog"
                            => "The current scene will be closed."
                        )
                        : (root.save-as-mode
                            ? @tr(
                                "ReplaceSceneDialog"
                                => "The current scene will be closed. Save it as a project or export a copy first to keep the changes you've made."
                            )
                            : @tr(
                                "ReplaceSceneDialog"
                                => "The current scene will be closed. Save it or export a copy first to keep the changes you've made."
                            ));
                    font-size: root.font-secondary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    text: root.closing ? @tr("ReplaceSceneDialog" => "Discard & Close") : @tr("ReplaceSceneDialog" => "Discard & Open");
                    clicked => {
                        root.discard-requested();
                    }
                }

                if root.has-unsaved-changes: Button {
                    text: root.closing
                        ? (root.save-as-mode ? @tr("ReplaceSceneDialog" => "Save As & Close…") : @tr("ReplaceSceneDialog" => "Save & Close"))
                        : root.save-as-mode
                        ? @tr("ReplaceSceneDialog" => "Save As & Open…")
                        : @tr("ReplaceSceneDialog" => "Save & Open");
                    clicked => {
                        root.save-requested();
                    }
                }

                if root.has-unsaved-changes: Button {
                    text: root.closing ? @tr("ReplaceSceneDialog" => "Export & Close…") : @tr("ReplaceSceneDialog" => "Export & Open…");
                    clicked => {
                        root.export-requested();
                    }
                }

                cancel-button := Button {
                    text: @tr("ReplaceSceneDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
