import { Palette } from "std-widgets.slint";

// Compact control used in the panel's title bar. Hosts a single glyph
// passed as its child and reports clicks. The background lightens on
// hover so it reads as an actionable button.
component PanelButton inherits Rectangle {
    callback clicked();

    width: 26px;
    border-radius: 4px;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    background: ta.has-hover ? Palette.foreground.transparentize(0.85) : transparent;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Floating panel showing the selected layer's 2D cross-section as an
// image. It shares the object-list panel's chrome: it positions and
// sizes itself within the window client area through its own geometry
// properties, so the window places it as an overlay rather than inside
// a layout. Draggable by the title bar and resizable from the bottom
// left corner; both interactions track the cursor in absolute window
// coordinates so they stay stable while the panel moves under the drag.
// Its body is display-only: it carries no list model and reports no
// selection.
export component SliceViewPanel inherits Rectangle {
    // The cross-section image to display, pushed from Rust. An empty
    // image (the default) leaves the body blank.
    in property <image> content;

    // Window client area, used to keep the panel fully inside the
    // window while dragging and resizing.
    in property <length> available-width;
    in property <length> available-height;

    callback close-requested();
    // Fired when a drag, resize, or minimize gesture ends, so the
    // window can persist the panel's geometry. Deliberately not fired
    // per pointer move, to keep persistence to gesture boundaries.
    callback geometry-committed();

    // Layout metrics.
    property <length> title-bar-height: 30px;
    property <length> edge-margin: 12px;
    property <length> panel-min-width: 160px;
    property <length> panel-max-width: 520px;
    property <length> panel-min-height: root.title-bar-height + 120px;
    property <length> panel-max-height: Math.max(root.panel-min-height, root.available-height - 2 * root.edge-margin);

    // Live geometry, stored relative to the window edges so a resize
    // keeps the panel pinned to its corner instead of drifting across
    // the viewport. `anchor-right` / `anchor-bottom` pick which pair of
    // edges the panel hugs (the corner of the quadrant its centre sits
    // in); `offset-x` / `offset-y` are the distances from those edges to
    // the matching panel edges. The default hugs the bottom-left corner,
    // clear of the top-right object list and the top-left slice controls.
    in-out property <bool> anchor-right: false;
    in-out property <bool> anchor-bottom: true;
    in-out property <length> offset-x: root.edge-margin;
    in-out property <length> offset-y: root.edge-margin;
    in-out property <length> panel-width: 240px;
    // 0px means "auto-size to a square-ish preview"; a positive value is
    // the height the user pinned by dragging the resize handle.
    in-out property <length> panel-height: 0px;
    in-out property <bool> minimized: false;

    // Height the panel takes when auto-sizing: room for a roughly square
    // preview. Used until the user pins an explicit height.
    property <length> auto-body-height: root.title-bar-height + 220px;
    property <length> effective-height: root.panel-height > 0px
        ? Math.min(Math.max(root.panel-height, root.panel-min-height), root.panel-max-height)
        : Math.min(Math.max(root.auto-body-height, root.panel-min-height), root.panel-max-height);

    // Position derived from the anchored edges and offsets, so it tracks
    // the window size automatically on resize.
    property <length> raw-x: root.anchor-right
        ? root.available-width - root.offset-x - root.width
        : root.offset-x;
    property <length> raw-y: root.anchor-bottom
        ? root.available-height - root.offset-y - root.height
        : root.offset-y;

    // Rendered geometry, clamped to the limits and to the window. Height
    // collapses to the title bar while minimized; the expanded height is
    // preserved so restoring returns to the same size.
    width: Math.min(Math.max(root.panel-width, root.panel-min-width), root.panel-max-width);
    height: root.minimized ? root.title-bar-height : root.effective-height;
    x: Math.min(Math.max(root.raw-x, 0px), Math.max(0px, root.available-width - root.width));
    y: Math.min(Math.max(root.raw-y, 0px), Math.max(0px, root.available-height - root.height));

    // Re-derive the anchored edges and offsets from an absolute top-left
    // position, hugging the edges of the quadrant the panel's centre
    // falls in. Both drag and resize funnel through here so the two
    // representations stay in sync.
    function reanchor(abs-left: length, abs-top: length) {
        if (abs-left + root.width / 2 > root.available-width / 2) {
            root.anchor-right = true;
            root.offset-x = Math.max(0px, root.available-width - (abs-left + root.width));
        } else {
            root.anchor-right = false;
            root.offset-x = Math.max(0px, abs-left);
        }
        if (abs-top + root.height / 2 > root.available-height / 2) {
            root.anchor-bottom = true;
            root.offset-y = Math.max(0px, root.available-height - (abs-top + root.height));
        } else {
            root.anchor-bottom = false;
            root.offset-y = Math.max(0px, abs-top);
        }
    }

    background: Palette.background.darker(0.15);
    border-color: Palette.border;
    border-width: 1px;
    border-radius: 8px;
    clip: true;
    drop-shadow-blur: 14px;
    drop-shadow-color: #0000004d;
    drop-shadow-offset-y: 3px;

    accessible-role: image;
    accessible-label: @tr("SliceView" => "Slice preview");

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Title bar: drag handle plus the panel name and window
        // controls. The drag TouchArea sits under the buttons, which
        // capture their own clicks, so pressing a button never starts a
        // drag.
        Rectangle {
            height: root.title-bar-height;
            background: Palette.background.darker(0.3);

            drag-area := TouchArea {
                mouse-cursor: move;

                property <length> press-cursor-x;
                property <length> press-cursor-y;
                property <length> press-x;
                property <length> press-y;

                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.press-cursor-x = self.absolute-position.x + self.mouse-x;
                        self.press-cursor-y = self.absolute-position.y + self.mouse-y;
                        self.press-x = root.x;
                        self.press-y = root.y;
                    }
                    if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                        root.geometry-committed();
                    }
                }

                moved => {
                    if (self.pressed) {
                        root.reanchor(
                            Math.min(
                                Math.max(
                                    self.press-x
                                        + ((self.absolute-position.x + self.mouse-x) - self.press-cursor-x),
                                    0px
                                ),
                                Math.max(0px, root.available-width - root.width)
                            ),
                            Math.min(
                                Math.max(
                                    self.press-y
                                        + ((self.absolute-position.y + self.mouse-y) - self.press-cursor-y),
                                    0px
                                ),
                                Math.max(0px, root.available-height - root.height)
                            )
                        );
                    }
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 4px;
                spacing: 2px;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    font-weight: 600;
                    color: Palette.foreground;
                    text: @tr("SliceView" => "Slice View");
                    overflow: elide;
                    accessible-role: none;
                }

                // Minimize / restore. The minimize glyph is a single
                // bar, the restore glyph a small square; both are drawn
                // with primitives to avoid a non-ASCII symbol.
                PanelButton {
                    clicked => {
                        root.minimized = !root.minimized;
                        root.geometry-committed();
                    }

                    if !root.minimized: Rectangle {
                        width: 12px;
                        height: 2px;
                        background: Palette.foreground;
                    }
                    if root.minimized: Rectangle {
                        width: 11px;
                        height: 10px;
                        border-width: 1.5px;
                        border-color: Palette.foreground;
                        border-radius: 1px;
                    }
                }

                // Close. The glyph is two crossed bars.
                PanelButton {
                    clicked => {
                        root.close-requested();
                    }

                    Rectangle {
                        width: 14px;
                        height: 14px;

                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 2px;
                            background: Palette.foreground;
                            transform-rotation: 45deg;
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 2px;
                            background: Palette.foreground;
                            transform-rotation: -45deg;
                        }
                    }
                }
            }
        }

        if !root.minimized: Image {
            vertical-stretch: 1;
            source: root.content;
            image-fit: contain;
        }
    }

    // Bottom-left resize handle. The top and right edges stay anchored:
    // dragging left grows the width, dragging down grows the height.
    if !root.minimized: resize-area := TouchArea {
        x: 0px;
        y: root.height - self.height;
        width: 16px;
        height: 16px;
        mouse-cursor: nesw-resize;

        property <length> press-cursor-x;
        property <length> press-cursor-y;
        property <length> press-right;
        property <length> press-top;
        property <length> press-width;
        property <length> press-height;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                self.press-cursor-x = self.absolute-position.x + self.mouse-x;
                self.press-cursor-y = self.absolute-position.y + self.mouse-y;
                self.press-right = root.x + root.width;
                self.press-top = root.y;
                self.press-width = root.width;
                self.press-height = root.height;
            }
            if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                root.geometry-committed();
            }
        }

        moved => {
            if (self.pressed) {
                root.panel-width = Math.min(
                    Math.max(
                        self.press-width
                            - ((self.absolute-position.x + self.mouse-x) - self.press-cursor-x),
                        root.panel-min-width
                    ),
                    root.panel-max-width
                );
                root.panel-height = Math.min(
                    Math.max(
                        self.press-height
                            + ((self.absolute-position.y + self.mouse-y) - self.press-cursor-y),
                        root.panel-min-height
                    ),
                    Math.max(root.panel-min-height, root.available-height - self.press-top - root.edge-margin)
                );
                // The top and right edges stay put: re-derive the anchor
                // from the fixed top-right corner and the new size.
                root.reanchor(self.press-right - root.width, self.press-top);
            }
        }

        // Resize grip: two short parallel lines, each running from the
        // left edge to the bottom edge that meet at this corner. The
        // viewbox maps path units 1:1 onto the handle's 16px box, so the
        // endpoints sit just clear of the panel's rounded corner.
        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: Palette.foreground.transparentize(0.5);
            stroke-width: 1.5px;

            MoveTo {
                x: 0;
                y: 7;
            }
            LineTo {
                x: 9;
                y: 16;
            }
            MoveTo {
                x: 0;
                y: 2;
            }
            LineTo {
                x: 14;
                y: 16;
            }
        }
    }
}
