import { Button, Palette, ScrollView } from "std-widgets.slint";

export component ErrorDialog inherits Window {
    title: @tr("Error");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    in property <string> heading: @tr("An error occurred");
    in property <string> context: "";
    in property <string> message: "";
    in property <string> details: "";

    property <bool> details-visible: false;

    // Font sizes in `rem`: 1rem = Window.default-font-size at render time,
    // so these track OS text-size preferences automatically. Centralised
    // here and shared across the dialog's text elements.
    // The warning glyph is deliberately a fixed absolute size: it's a
    // decorative alert, not reading text, and should not shrink on
    // small-default systems.
    property <length> font-secondary: 0.85rem;
    property <length> font-footnote: 0.8rem;

    min-width: 520px;
    max-width: 520px;
    preferred-width: 520px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    preferred-height: body.preferred-height;

    callback close-requested();

    // Focus the Close button when the dialog opens so Enter activates it.
    forward-focus: close-button;

    FocusScope {
        width: parent.width;
        height: parent.height;

        // Escape always closes the dialog; Enter is handled natively by the
        // focused Button.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Text {
                    text: "⚠";
                    font-size: 36px;
                    color: #e5a500;
                    vertical-alignment: top;
                    horizontal-alignment: center;
                    width: 48px;
                    // Screen readers otherwise pronounce U+26A0 inconsistently
                    // (or read the raw character name). Override so the icon
                    // is announced semantically as "Warning" in every locale.
                    accessible-role: text;
                    accessible-label: @tr("ErrorDialog" => "Warning");
                }

                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.heading;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.context != "": Text {
                        text: root.context;
                        font-size: root.font-secondary;
                        color: Palette.foreground.transparentize(0.5);
                        wrap: word-wrap;
                    }

                    if root.message != "": Text {
                        text: root.message;
                        font-size: root.font-secondary;
                        wrap: word-wrap;
                    }

                    if root.details != "": HorizontalLayout {
                        alignment: start;
                        TouchArea {
                            width: toggle-text.preferred-width;
                            height: toggle-text.preferred-height;
                            toggle-text := Text {
                                // The glyph is kept out of the translatable
                                // strings so translators can't accidentally
                                // drop or replace it. RTL placement is
                                // deferred: Slint 1.16 has no paragraph
                                // direction or layout mirroring (see the
                                // `bidi level` TODO in i-slint-core's text
                                // shaping). Once upstream lands RTL, BiDi
                                // will place the neutral-direction arrow on
                                // the visual right side of the label in RTL
                                // runs automatically.
                                text: (root.details-visible ? "▾ " : "▸ ") + (root.details-visible ? @tr("Hide technical details") : @tr("Show technical details"));
                                font-size: root.font-footnote;
                                color: Palette.accent-background;
                            }

                            clicked => {
                                root.details-visible = !root.details-visible;
                            }
                        }
                    }

                    if root.details != "" && root.details-visible: ScrollView {
                        max-height: 160px;
                        Text {
                            text: root.details;
                            font-size: root.font-footnote;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                            color: Palette.foreground.transparentize(0.35);
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                close-button := Button {
                    text: @tr("Close");
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
