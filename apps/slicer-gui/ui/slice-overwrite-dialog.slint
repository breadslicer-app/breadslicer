import { Button, Palette } from "std-widgets.slint";

// Shown when the Slice button is pressed on a scene that already holds a
// slice result produced from different geometry or settings. Two exits:
// Re-slice (recompute, overwriting the held slice) or Cancel (keep it).
// The caller wires what confirming means; this component only reports it.
export component SliceOverwriteDialog inherits Window {
    title: @tr("SliceOverwriteDialog" => "Re-slice");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    callback confirm-requested();
    callback cancel-requested();

    property <length> font-secondary: 0.85rem;

    min-width: 420px;
    max-width: 420px;
    preferred-width: 420px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    preferred-height: body.preferred-height;

    // Cancel is the safe default: pressing Enter shouldn't overwrite the
    // slice the user already has.
    forward-focus: cancel-button;

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: @tr("SliceOverwriteDialog" => "Re-slice this scene?");
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr(
                        "SliceOverwriteDialog"
                        => "The geometry or the print settings changed since the last slice. Re-slicing replaces the slice data you already have."
                    );
                    font-size: root.font-secondary;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    text: @tr("SliceOverwriteDialog" => "Re-slice");
                    clicked => {
                        root.confirm-requested();
                    }
                }

                cancel-button := Button {
                    text: @tr("SliceOverwriteDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
