import { Button } from "std-widgets.slint";

export component PreferencesWindow inherits Window {
    title: @tr("Preferences");
    icon: @image-url("../assets/images/soulcrafted.svg");

    min-width: 480px;
    min-height: 320px;
    preferred-width: 480px;
    preferred-height: 320px;

    forward-focus: key-handler;

    callback close-requested();

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: center;

            Text {
                text: @tr("Preferences" => "No preferences available yet.");
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: center;
                padding-top: 8px;

                Button {
                    text: @tr("Preferences" => "Close");
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
