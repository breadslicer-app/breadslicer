import { ComboBox } from "std-widgets.slint";
import { PreferencesPage } from "./preferences-page.slint";

export enum ThemePreference { System, Light, Dark }

export component AppearancePreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "UI & Theme");

    in-out property <ThemePreference> current-theme: ThemePreference.System;
    callback theme-selected(ThemePreference);

    // Order must match the `theme-for-index` / `index-for-theme` mappings
    // below; changing it requires updating both.
    property <[string]> theme-options: [
        @tr("AppearancePreferences" => "System"),
        @tr("AppearancePreferences" => "Light"),
        @tr("AppearancePreferences" => "Dark"),
    ];

    function theme-for-index(i: int) -> ThemePreference {
        if (i == 1) { return ThemePreference.Light; }
        if (i == 2) { return ThemePreference.Dark; }
        return ThemePreference.System;
    }

    function index-for-theme(t: ThemePreference) -> int {
        if (t == ThemePreference.Light) { return 1; }
        if (t == ThemePreference.Dark) { return 2; }
        return 0;
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Theme");
            vertical-alignment: center;
        }

        ComboBox {
            model: root.theme-options;
            current-index: root.index-for-theme(root.current-theme);
            selected(_value) => {
                root.current-theme = root.theme-for-index(self.current-index);
                root.theme-selected(root.current-theme);
            }
        }
    }
}
