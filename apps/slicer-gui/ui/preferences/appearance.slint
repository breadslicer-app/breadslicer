import { Button, CheckBox, ComboBox, Palette, ProgressIndicator } from "std-widgets.slint";
import { PreferencesPage } from "./preferences-page.slint";

export enum ThemePreference { System, Light, Dark }

export component AppearancePreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "UI & Theme");

    in-out property <ThemePreference> current-theme: ThemePreference.System;
    callback theme-selected(ThemePreference);

    // Language model is built in Rust (see src/language.rs): index 0 is
    // always "System (use the OS locale)", indices 1.. are the bundled
    // translations in the order produced by build.rs.
    in property <[string]> language-options;
    in-out property <int> current-language-index: 0;
    callback language-selected(int);

    // Whether models shade smooth in the viewport; supports always do
    // (`mesh_render/smooth_shading.rs`).
    in-out property <bool> smooth-models: false;
    callback smooth-models-changed(bool);

    // The gizmo style (#274) and size (#276). The combo orders must match
    // `GizmoStyle::combo_index` (Outline, Focused) and `GIZMO_SIZES` in
    // `gizmo/look.rs`.
    in-out property <int> current-gizmo-style-index: 0;
    callback gizmo-style-selected(int);
    in-out property <int> current-gizmo-size-index: 2;
    callback gizmo-size-selected(int);

    // The viewport's frame-rate cap (`frame_rate.rs`). The combo order must
    // match `FrameRateCap::combo_index`: Automatic, 30, 60, 120.
    in-out property <int> current-frame-rate-index: 0;
    callback frame-rate-selected(int);

    // The performance test (`viewport/performance_probe.rs`): its progress
    // while it runs, then the result and the rate it recommends (0 while
    // there is nothing to apply).
    in property <bool> probe-running: false;
    in property <float> probe-progress: 0;
    in property <string> probe-message;
    in property <int> probe-recommended-fps: 0;
    callback test-performance();
    callback use-recommended-frame-rate();

    // How many app messages are silenced with "Don't show again"; the reset
    // button shows them all again (#133).
    in property <int> silenced-message-count: 0;
    callback show-all-messages-again();

    // Whether the start dialog shows when the app opens with no file (#381).
    in-out property <bool> show-start-dialog: true;
    callback show-start-dialog-changed(bool);

    // Order must match the `theme-for-index` / `index-for-theme` mappings
    // below; changing it requires updating both.
    property <[string]> theme-options: [
        @tr("AppearancePreferences" => "System"),
        @tr("AppearancePreferences" => "Light"),
        @tr("AppearancePreferences" => "Dark"),
    ];

    function theme-for-index(i: int) -> ThemePreference {
        if (i == 1) { return ThemePreference.Light; }
        if (i == 2) { return ThemePreference.Dark; }
        return ThemePreference.System;
    }

    function index-for-theme(t: ThemePreference) -> int {
        if (t == ThemePreference.Light) { return 1; }
        if (t == ThemePreference.Dark) { return 2; }
        return 0;
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Theme");
            vertical-alignment: center;
            // Slint has no labelled-by relation; mirror the visible caption
            // onto the ComboBox via accessible-label and hide this text from
            // the a11y tree to avoid a disconnected duplicate announcement.
            accessible-role: none;
        }

        ComboBox {
            model: root.theme-options;
            current-index: root.index-for-theme(root.current-theme);
            accessible-label: @tr("AppearancePreferences" => "Theme");
            selected(_value) => {
                root.current-theme = root.theme-for-index(self.current-index);
                root.theme-selected(root.current-theme);
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Language");
            vertical-alignment: center;
            accessible-role: none;
        }

        ComboBox {
            model: root.language-options;
            current-index: root.current-language-index;
            accessible-label: @tr("AppearancePreferences" => "Language");
            selected(_value) => {
                root.current-language-index = self.current-index;
                root.language-selected(self.current-index);
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Button {
            text: @tr("AppearancePreferences" => "Show all messages again");
            enabled: root.silenced-message-count > 0;
            clicked => {
                root.show-all-messages-again();
            }
        }

        if root.silenced-message-count > 0: Text {
            text: @tr("AppearancePreferences" => "Hidden messages: {}", root.silenced-message-count);
            vertical-alignment: center;
            color: Palette.foreground.transparentize(0.4);
        }
    }

    CheckBox {
        text: @tr("AppearancePreferences" => "Show the start window when Breadslicer opens");
        checked: root.show-start-dialog;
        toggled => {
            root.show-start-dialog = self.checked;
            root.show-start-dialog-changed(self.checked);
        }
    }

    CheckBox {
        text: @tr("AppearancePreferences" => "Smooth shading on models");
        checked: root.smooth-models;
        toggled => {
            root.smooth-models = self.checked;
            root.smooth-models-changed(self.checked);
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Gizmo style");
            vertical-alignment: center;
            accessible-role: none;
        }

        ComboBox {
            model: [
                @tr("AppearancePreferences" => "Outline: every handle at once"),
                @tr("AppearancePreferences" => "Focused: the tool picked on the left rail"),
            ];
            current-index: root.current-gizmo-style-index;
            accessible-label: @tr("AppearancePreferences" => "Gizmo style");
            selected(_value) => {
                root.current-gizmo-style-index = self.current-index;
                root.gizmo-style-selected(self.current-index);
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Gizmo size");
            vertical-alignment: center;
            accessible-role: none;
        }

        ComboBox {
            model: ["75 %", "90 %", "100 %", "110 %", "125 %", "150 %"];
            current-index: root.current-gizmo-size-index;
            accessible-label: @tr("AppearancePreferences" => "Gizmo size");
            selected(_value) => {
                root.current-gizmo-size-index = self.current-index;
                root.gizmo-size-selected(self.current-index);
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("AppearancePreferences" => "Frame rate");
            vertical-alignment: center;
            accessible-role: none;
        }

        ComboBox {
            model: [
                @tr("AppearancePreferences" => "Automatic"),
                @tr("AppearancePreferences" => "30 FPS"),
                @tr("AppearancePreferences" => "60 FPS"),
                @tr("AppearancePreferences" => "120 FPS"),
            ];
            current-index: root.current-frame-rate-index;
            accessible-label: @tr("AppearancePreferences" => "Frame rate");
            selected(_value) => {
                root.current-frame-rate-index = self.current-index;
                root.frame-rate-selected(self.current-index);
            }
        }
    }

    Text {
        text: @tr("AppearancePreferences" => "Automatic follows your monitor and uses 30 FPS on battery. The 3D view only draws when something changes.");
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Button {
            text: @tr("AppearancePreferences" => "Test performance");
            enabled: !root.probe-running;
            clicked => {
                root.test-performance();
            }
        }

        if root.probe-recommended-fps > 0 && !root.probe-running: Button {
            text: @tr("AppearancePreferences" => "Use {} FPS", root.probe-recommended-fps);
            primary: true;
            clicked => {
                root.use-recommended-frame-rate();
            }
        }
    }

    if root.probe-running: ProgressIndicator {
        progress: root.probe-progress;
    }

    if root.probe-message != "": Text {
        text: root.probe-message;
        wrap: word-wrap;
    }
}
