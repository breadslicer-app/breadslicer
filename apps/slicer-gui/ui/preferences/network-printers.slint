import { Theme } from "../kit/theme.slint";
import { ScrollView } from "std-widgets.slint";
import {
    ScButton as Button,
    ScComboBox as ComboBox,
    ScLineEdit as LineEdit,
} from "../kit/controls.slint";
import { PreferencesPage } from "./preferences-page.slint";

// One network printer in the list (#631): the name it is shown by, what it
// is and where, and what it is kept for.
export struct NetworkPrinterRow {
    name: string,
    detail: string,
    kept: string,
    saved: bool,
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 150px;
        vertical-alignment: center;
        color: Theme.text-soft;
        font-size: Theme.font-sm;
    }
    @children
}

export component NetworkPrinterPreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "Network printers");
    fill: true;

    in property <[NetworkPrinterRow]> rows;
    // The printer picked in the list, or -1.
    in-out property <int> selected: -1;
    in-out property <string> own-name;
    in property <string> reported;
    in property <[string]> printer-options;
    in-out property <int> printer-index;
    in property <[string]> resin-options;
    in-out property <int> resin-index;
    in-out property <string> note;

    callback picked(int);
    // 0 its name (`text`), 1 its printer profile and 2 its resin (`index`
    // in their lists), 3 its note (`text`).
    callback edited(int, string, int);
    callback remove-requested();

    Text {
        text: @tr("NetworkPrinterPreferences" => "The printers Breadslicer has found on your network. Give each a name of your own, the printer profile it is, the resin it is kept for and a note; Send to printer lists the saved ones first.");
        wrap: word-wrap;
        color: Theme.text-soft;
    }

    if root.rows.length == 0: Text {
        text: @tr("NetworkPrinterPreferences" => "None yet: printers show up here once Send to printer finds them.");
        wrap: word-wrap;
        color: Theme.text-faint;
    }

    if root.rows.length > 0: ScrollView {
        vertical-stretch: 1;
        list := VerticalLayout {
            spacing: 4px;
            alignment: start;
            for row[i] in root.rows: Rectangle {
                height: 52px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: i == root.selected ? Theme.indicator : Theme.border;
                background: i == root.selected ? Theme.card : transparent;
                TouchArea {
                    clicked => {
                        root.selected = i;
                        root.picked(i);
                    }
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: row.name;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: row.kept != "" ? row.detail + "  ·  " + row.kept : row.detail;
                        color: row.saved ? Theme.text-soft : Theme.text-faint;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                }
            }
        }
    }

    if root.selected >= 0 && root.selected < root.rows.length: VerticalLayout {
        vertical-stretch: 0;
        spacing: 6px;
        FieldRow {
            label: @tr("SlicePanel" => "Its name in Breadslicer");
            LineEdit {
                text <=> root.own-name;
                placeholder-text: root.reported;
                accessible-label: @tr("SlicePanel" => "The printer's name in Breadslicer");
                edited(t) => {
                    root.edited(0, t, 0);
                }
            }
        }
        FieldRow {
            label: @tr("SlicePanel" => "Printer profile");
            ComboBox {
                model: root.printer-options;
                current-index <=> root.printer-index;
                selected(value) => {
                    root.edited(1, "", self.current-index);
                }
            }
        }
        FieldRow {
            label: @tr("SlicePanel" => "Resin it is kept for");
            ComboBox {
                model: root.resin-options;
                current-index <=> root.resin-index;
                selected(value) => {
                    root.edited(2, "", self.current-index);
                }
            }
        }
        FieldRow {
            label: @tr("SlicePanel" => "Note");
            LineEdit {
                text <=> root.note;
                placeholder-text: @tr("SlicePanel" => "Dental only, the one by the window…");
                edited(t) => {
                    root.edited(3, t, 0);
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("NetworkPrinterPreferences" => "Forget this printer");
                clicked => {
                    root.remove-requested();
                }
            }
        }
    }
}
