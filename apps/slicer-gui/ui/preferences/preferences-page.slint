export component PreferencesPage inherits VerticalLayout {
    in property <string> title;

    padding: 16px;
    spacing: 12px;
    alignment: start;

    Text {
        text: root.title;
        font-size: 1.2rem;
        font-weight: 700;
    }

    @children
}
