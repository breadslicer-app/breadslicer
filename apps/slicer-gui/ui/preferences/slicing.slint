import { ScCheckBox as CheckBox, ScComboBox as ComboBox } from "../kit/controls.slint";
import { PreferencesPage } from "./preferences-page.slint";

export component SlicingPreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "Slicing");

    // Anti-aliasing level, as an index into `aa-options`. The order must
    // match `aa_level.rs` on the Rust side: 0 = Off, 1 = 2x, 2 = 4x,
    // 3 = 8x.
    in-out property <int> current-aa-index: 0;
    callback aa-level-changed(int);

    // Whether the DragonFruit support scans run in the background while the
    // scene sits still (`df_support_run.rs`).
    in-out property <bool> prescan-supports: false;
    callback prescan-supports-changed(bool);

    property <[string]> aa-options: [
        @tr("SlicingPreferences" => "Off"),
        @tr("SlicingPreferences" => "2x"),
        @tr("SlicingPreferences" => "4x"),
        @tr("SlicingPreferences" => "8x"),
    ];

    VerticalLayout {
        spacing: 12px;
        alignment: start;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Text {
                text: @tr("SlicingPreferences" => "Anti-aliasing");
                vertical-alignment: center;
                // Slint has no labelled-by relation; mirror the caption onto
                // the ComboBox via accessible-label and hide this text from
                // the a11y tree to avoid a disconnected duplicate.
                accessible-role: none;
            }

            ComboBox {
                model: root.aa-options;
                current-index: root.current-aa-index;
                accessible-label: @tr("SlicingPreferences" => "Anti-aliasing");
                selected(_value) => {
                    root.current-aa-index = self.current-index;
                    root.aa-level-changed(self.current-index);
                }
            }
        }

        CheckBox {
            text: @tr("SlicingPreferences" => "Prepare supports in the background");
            checked: root.prescan-supports;
            toggled => {
                root.prescan-supports = self.checked;
                root.prescan-supports-changed(self.checked);
            }
        }
    }
}
