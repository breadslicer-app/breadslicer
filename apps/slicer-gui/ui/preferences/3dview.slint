import { Button, LineEdit } from "std-widgets.slint";
import { PreferencesPage } from "./preferences-page.slint";

export component _3DViewPreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "3D View");

    in property <string> build-volume-width-text;
    in property <string> build-volume-depth-text;
    in property <string> build-volume-height-text;
    callback build-volume-width-committed(string);
    callback build-volume-depth-committed(string);
    callback build-volume-height-committed(string);
    callback reset-build-volume-requested();

    // The user typing into a LineEdit imperatively writes its `text`
    // property and breaks the source binding `text: root.build-volume-*-text`.
    // Subsequent root-property updates (Rust pushing the snapshot
    // back, "Reset to default", clamp normalisation) are then ignored
    // by the field. Re-apply imperatively from a `changed` callback
    // so external updates always win over stale typed text.
    changed build-volume-width-text => {
        width-input.text = root.build-volume-width-text;
    }
    changed build-volume-depth-text => {
        depth-input.text = root.build-volume-depth-text;
    }
    changed build-volume-height-text => {
        height-input.text = root.build-volume-height-text;
    }

    Text {
        text: @tr("PreferencesPage" => "Build volume (mm)");
        font-weight: 600;
        accessible-role: none;
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("PreferencesPage" => "Width");
            vertical-alignment: center;
            accessible-role: none;
        }

        width-input := LineEdit {
            input-type: decimal;
            text: root.build-volume-width-text;
            accessible-label: @tr("PreferencesPage" => "Build volume width in millimetres");
            accepted(t) => { root.build-volume-width-committed(t); }
            // Slint's LineEdit fires `accepted` only on Enter, not on
            // focus-loss; commit on blur too so tabbing out applies
            // the change.
            changed has-focus => {
                if (!self.has-focus) {
                    root.build-volume-width-committed(self.text);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("PreferencesPage" => "Depth");
            vertical-alignment: center;
            accessible-role: none;
        }

        depth-input := LineEdit {
            input-type: decimal;
            text: root.build-volume-depth-text;
            accessible-label: @tr("PreferencesPage" => "Build volume depth in millimetres");
            accepted(t) => { root.build-volume-depth-committed(t); }
            changed has-focus => {
                if (!self.has-focus) {
                    root.build-volume-depth-committed(self.text);
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        Text {
            text: @tr("PreferencesPage" => "Height");
            vertical-alignment: center;
            accessible-role: none;
        }

        height-input := LineEdit {
            input-type: decimal;
            text: root.build-volume-height-text;
            accessible-label: @tr("PreferencesPage" => "Build volume height in millimetres");
            accepted(t) => { root.build-volume-height-committed(t); }
            changed has-focus => {
                if (!self.has-focus) {
                    root.build-volume-height-committed(self.text);
                }
            }
        }
    }

    HorizontalLayout {
        alignment: start;

        Button {
            text: @tr("PreferencesPage" => "Reset to default");
            clicked => { root.reset-build-volume-requested(); }
        }
    }
}
