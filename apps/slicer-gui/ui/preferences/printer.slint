import { Button, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { PreferencesPage } from "./preferences-page.slint";

// One printer tile. `id-index` is the printer's index in the Rust
// catalog and the stable handle carried through selection callbacks;
// the visible `printer-cards` model may be a filtered subset, so tile
// position is not a usable identity.
export struct PrinterCard {
    name: string,
    thumbnail: image,
    has-thumbnail: bool,
    is-custom: bool,
    id-index: int,
}

export component PrinterPreferences inherits PreferencesPage {
    title: @tr("PreferencesPage" => "Printer");
    fill: true;

    in property <[PrinterCard]> printer-cards;
    in property <[string]> manufacturer-tabs;
    in-out property <int> current-manufacturer-index: 0;
    // Catalog index of the selected printer, or -1 when none is chosen.
    in-out property <int> selected-printer-index: -1;
    // Position of the selected printer within the visible (filtered)
    // `printer-cards` model, or -1 when it is filtered out.
    in property <int> selected-visible-index: -1;
    // True until the one-time scroll to the selected printer has run.
    // Bound to window-level state so recreating this component (the
    // section sits behind a conditional) cannot re-arm the scroll.
    in-out property <bool> initial-scroll-pending: false;
    in property <string> search-text;

    callback manufacturer-tab-changed(int);
    callback search-changed(string);
    callback printer-selected(int);
    callback import-requested();
    callback export-printers-requested();

    property <length> tile-w: 128px;
    property <length> tile-h: 148px;
    property <length> tile-gap: 12px;

    // Manufacturer filter as a horizontal tab bar; scrolls sideways
    // when the maker list is wide. Pinned height with no vertical
    // stretch so the gallery below is the only child that grows.
    ScrollView {
        vertical-stretch: 0;
        min-height: 40px;
        max-height: 40px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for maker[i] in root.manufacturer-tabs: Button {
                text: maker;
                primary: i == root.current-manufacturer-index;
                clicked => {
                    root.current-manufacturer-index = i;
                    root.manufacturer-tab-changed(i);
                }
            }
        }
    }

    search-input := LineEdit {
        placeholder-text: @tr("PreferencesPage" => "Search models");
        text: root.search-text;
        accessible-label: @tr("PreferencesPage" => "Search printer models");
        edited(t) => {
            root.search-changed(t);
        }
    }

    // Image-forward gallery: tiles flow left-to-right, wrapping into as
    // many columns as the current viewport width fits (at least one).
    // The column count is derived from `gallery.visible-width` so the
    // grid reflows as the window resizes, and each row is centred in the
    // leftover horizontal space. Build volume is deliberately not shown;
    // it is a consequence of the choice, not a selection criterion.
    gallery := ScrollView {
        vertical-stretch: 1;
        property <int> columns: Math.max(1, Math.floor((self.visible-width + root.tile-gap) / (root.tile-w + root.tile-gap)));
        property <length> row-width: self.columns * root.tile-w + (self.columns - 1) * root.tile-gap;
        property <length> x-offset: Math.max(0px, (self.visible-width - self.row-width) / 2);
        viewport-height: Math.ceil(root.printer-cards.length / self.columns) * (root.tile-h + root.tile-gap);

        // One-time scroll that centres the selected printer's row in
        // the viewport. It cannot run at `init` because the column
        // count depends on `visible-width`, which is still 0 before
        // the first layout pass; the first width change is the
        // earliest point where the target row is computable.
        changed visible-width => {
            if (root.initial-scroll-pending && self.visible-width > 0px) {
                root.initial-scroll-pending = false;
                if (root.selected-visible-index >= 0) {
                    self.viewport-y = -Math.min(
                        Math.max(0px, self.viewport-height - self.visible-height),
                        Math.max(0px,
                            Math.floor(root.selected-visible-index / self.columns)
                                * (root.tile-h + root.tile-gap)
                                - (self.visible-height - root.tile-h) / 2));
                }
            }
        }
        for card[i] in root.printer-cards: Rectangle {
            x: gallery.x-offset + Math.mod(i, gallery.columns) * (root.tile-w + root.tile-gap);
            y: Math.floor(i / gallery.columns) * (root.tile-h + root.tile-gap);
            width: root.tile-w;
            height: root.tile-h;
            border-radius: 6px;
            border-width: card.id-index == root.selected-printer-index ? 2px : 1px;
            border-color: card.id-index == root.selected-printer-index
                ? Palette.accent-background
                : Palette.border;
            background: Palette.alternate-background;

            TouchArea {
                clicked => {
                    root.selected-printer-index = card.id-index;
                    root.printer-selected(card.id-index);
                }
            }

            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                if card.has-thumbnail: Image {
                    source: card.thumbnail;
                    image-fit: contain;
                    height: 96px;
                }
                if !card.has-thumbnail: Rectangle {
                    height: 96px;
                    border-radius: 4px;
                    background: Palette.background;
                    Text {
                        text: @tr("PreferencesPage" => "No image");
                        color: Palette.foreground.transparentize(0.5);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: card.name;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    font-size: 0.9rem;
                }
                if card.is-custom: Text {
                    text: @tr("PreferencesPage" => "custom");
                    color: Palette.foreground.transparentize(0.4);
                    font-size: 0.7rem;
                    horizontal-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 8px;
        alignment: start;
        Button {
            text: @tr("PreferencesPage" => "Import package...");
            clicked => {
                root.import-requested();
            }
        }
        Button {
            text: @tr("PreferencesPage" => "Export printers...");
            clicked => {
                root.export-printers-requested();
            }
        }
    }
}
