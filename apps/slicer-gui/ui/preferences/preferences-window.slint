import { Palette } from "std-widgets.slint";
import { SideBar } from "../sidebar.slint";
import { AppMessage, MessageAnswer, MessageKind, MessageLayer } from "../message-layer.slint";
import { AppearancePreferences, ThemePreference } from "./appearance.slint";
import { PrinterPreferences, PrinterCard } from "./printer.slint";
import { ResinPreferences, ResinRow } from "./resin.slint";
import { SlicingPreferences } from "./slicing.slint";
import { PrivacyPreferences } from "./privacy.slint";

export component PreferencesWindow inherits Window {
    title: @tr("Preferences");
    default-font-family: "Noto Sans";

    min-width: 520px;
    min-height: 360px;
    preferred-width: 680px;
    preferred-height: 540px;

    // Land initial focus on the tab list so arrow keys work straight away.
    // Escape still works from any descendant: the wrapping FocusScope
    // intercepts it via key-event bubbling.
    forward-focus: side-bar;

    in-out property <ThemePreference> theme: ThemePreference.System;
    in property <[string]> language-options;
    in-out property <int> current-language-index: 0;
    in-out property <int> current-aa-index: 0;
    in-out property <bool> prescan-supports: false;
    in-out property <bool> smooth-models: false;
    in-out property <int> current-frame-rate-index: 0;
    in property <bool> probe-running: false;
    in property <float> probe-progress: 0;
    in property <string> probe-message;
    in property <int> probe-recommended-fps: 0;
    in-out property <bool> diagnostic-log: false;
    // Why the diagnostic log could not start; empty when it could.
    in property <string> diagnostic-log-error;
    // The question before the diagnostic log starts (#74), drawn over the
    // window like the main window's messages. Rust opens it and reads the
    // answer.
    in property <bool> log-question-open: false;
    in property <int> log-question-serial: 0;
    in property <int> silenced-message-count: 0;

    in property <[PrinterCard]> printer-cards;
    in property <[string]> manufacturer-tabs;
    in-out property <int> current-manufacturer-index: 0;
    in-out property <int> selected-printer-index: -1;
    in property <int> selected-visible-printer-index: -1;
    in property <string> printer-search-text;
    // Armed once at startup; the printer gallery disarms it after its
    // one-time scroll to the selected printer. Lives here so it
    // survives the section component being destroyed and recreated.
    property <bool> printer-initial-scroll-pending: true;

    in property <[ResinRow]> resin-rows;
    in-out property <int> selected-resin-index: -1;
    in property <[string]> resin-brand-tabs;
    in-out property <int> current-brand-index: 0;
    in property <string> resin-search-text;

    callback close-requested();
    callback theme-changed(ThemePreference);
    callback language-changed(int);
    callback aa-level-changed(int);
    callback prescan-supports-changed(bool);
    callback smooth-models-changed(bool);
    callback frame-rate-changed(int);
    callback test-performance();
    callback use-recommended-frame-rate();
    callback diagnostic-log-changed(bool);
    callback log-question-answered(MessageAnswer);
    callback open-logs-folder();
    callback show-all-messages-again();
    callback manufacturer-tab-changed(int);
    callback printer-search-changed(string);
    callback printer-selected(int);
    callback printer-favourite-toggled(int);
    callback brand-tab-changed(int);
    callback resin-search-changed(string);
    callback resin-selected(int);
    callback resin-favourite-toggled(int);
    callback view-requested(int);
    callback fork-requested(int);
    callback extend-requested(int);
    callback edit-requested(int, bool);
    callback delete-requested(int, bool);
    callback import-requested();
    callback export-printers-requested();
    callback export-materials-requested();

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            side-bar := SideBar {
                title: @tr("PreferencesMenu" => "Preferences Sections");
                model: [
                    @tr("PreferencesMenu" => "UI & Theme"),
                    @tr("PreferencesMenu" => "Printer"),
                    @tr("PreferencesMenu" => "Resin"),
                    @tr("PreferencesMenu" => "Slicing"),
                    @tr("PreferencesMenu" => "Privacy"),
                ];
            }

            if(side-bar.current-item == 0) : AppearancePreferences {
                current-theme: root.theme;
                language-options: root.language-options;
                current-language-index: root.current-language-index;
                smooth-models <=> root.smooth-models;
                silenced-message-count: root.silenced-message-count;
                show-all-messages-again => {
                    root.show-all-messages-again();
                }
                smooth-models-changed(on) => {
                    root.smooth-models-changed(on);
                }
                current-frame-rate-index: root.current-frame-rate-index;
                frame-rate-selected(i) => {
                    root.current-frame-rate-index = i;
                    root.frame-rate-changed(i);
                }
                probe-running: root.probe-running;
                probe-progress: root.probe-progress;
                probe-message: root.probe-message;
                probe-recommended-fps: root.probe-recommended-fps;
                test-performance => {
                    root.test-performance();
                }
                use-recommended-frame-rate => {
                    root.use-recommended-frame-rate();
                }
                theme-selected(t) => {
                    root.theme = t;
                    root.theme-changed(t);
                }
                language-selected(i) => {
                    root.current-language-index = i;
                    root.language-changed(i);
                }
            }
            if(side-bar.current-item == 1) : PrinterPreferences {
                printer-cards: root.printer-cards;
                manufacturer-tabs: root.manufacturer-tabs;
                current-manufacturer-index <=> root.current-manufacturer-index;
                selected-printer-index <=> root.selected-printer-index;
                selected-visible-index: root.selected-visible-printer-index;
                initial-scroll-pending <=> root.printer-initial-scroll-pending;
                search-text: root.printer-search-text;
                manufacturer-tab-changed(i) => {
                    root.manufacturer-tab-changed(i);
                }
                search-changed(t) => {
                    root.printer-search-changed(t);
                }
                printer-selected(i) => {
                    root.printer-selected(i);
                }
                favourite-toggled(i) => {
                    root.printer-favourite-toggled(i);
                }
                import-requested => {
                    root.import-requested();
                }
                export-printers-requested => {
                    root.export-printers-requested();
                }
            }
            if(side-bar.current-item == 2) : ResinPreferences {
                resin-rows: root.resin-rows;
                selected-resin-index <=> root.selected-resin-index;
                brand-tabs: root.resin-brand-tabs;
                current-brand-index <=> root.current-brand-index;
                search-text: root.resin-search-text;
                brand-tab-changed(i) => {
                    root.brand-tab-changed(i);
                }
                search-changed(t) => {
                    root.resin-search-changed(t);
                }
                resin-selected(i) => {
                    root.resin-selected(i);
                }
                favourite-toggled(i) => {
                    root.resin-favourite-toggled(i);
                }
                view-requested(i) => {
                    root.view-requested(i);
                }
                fork-requested(i) => {
                    root.fork-requested(i);
                }
                extend-requested(i) => {
                    root.extend-requested(i);
                }
                edit-requested(i, is-extension) => {
                    root.edit-requested(i, is-extension);
                }
                delete-requested(i, is-extension) => {
                    root.delete-requested(i, is-extension);
                }
                import-requested => {
                    root.import-requested();
                }
                export-materials-requested => {
                    root.export-materials-requested();
                }
            }
            if(side-bar.current-item == 3) : SlicingPreferences {
                current-aa-index <=> root.current-aa-index;
                prescan-supports <=> root.prescan-supports;
                aa-level-changed(i) => {
                    root.aa-level-changed(i);
                }
                prescan-supports-changed(on) => {
                    root.prescan-supports-changed(on);
                }
            }
            if(side-bar.current-item == 4) : PrivacyPreferences {
                diagnostic-log <=> root.diagnostic-log;
                diagnostic-log-error: root.diagnostic-log-error;
                diagnostic-log-changed(on) => {
                    root.diagnostic-log-changed(on);
                }
                open-logs-folder => {
                    root.open-logs-folder();
                }
            }
        }
    }

    MessageLayer {
        width: 100%;
        height: 100%;
        message: { kind: MessageKind.diagnostic-log };
        open: root.log-question-open;
        serial: root.log-question-serial;
        answered(answer) => {
            root.log-question-answered(answer);
        }
        outside-clicked => {
            root.log-question-answered(MessageAnswer.cancel);
        }
    }
}
