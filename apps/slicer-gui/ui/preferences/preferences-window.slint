import { Palette } from "std-widgets.slint";
import { SideBar } from "../sidebar.slint";
import { AppearancePreferences, ThemePreference } from "./appearance.slint";
import { _3DViewPreferences } from "./3dview.slint";

export component PreferencesWindow inherits Window {
    title: @tr("Preferences");

    min-width: 480px;
    min-height: 320px;
    preferred-width: 480px;
    preferred-height: 320px;

    // Land initial focus on the tab list so arrow keys work straight away.
    // Escape still works from any descendant: the wrapping FocusScope
    // intercepts it via key-event bubbling.
    forward-focus: side-bar;

    in-out property <ThemePreference> theme: ThemePreference.System;
    in property <[string]> language-options;
    in-out property <int> current-language-index: 0;
    in property <string> build-volume-width-text;
    in property <string> build-volume-depth-text;
    in property <string> build-volume-height-text;
    callback close-requested();
    callback theme-changed(ThemePreference);
    callback language-changed(int);
    callback build-volume-width-committed(string);
    callback build-volume-depth-committed(string);
    callback build-volume-height-committed(string);
    callback reset-build-volume-requested();

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            side-bar := SideBar {
                title: @tr("PreferencesMenu" => "Preferences Sections");
                model: [
                    @tr("PreferencesMenu" => "UI & Theme"),
                    @tr("PreferencesMenu" => "3D View"),
                ];
            }

            if(side-bar.current-item == 0) : AppearancePreferences {
                current-theme: root.theme;
                language-options: root.language-options;
                current-language-index: root.current-language-index;
                theme-selected(t) => {
                    root.theme = t;
                    root.theme-changed(t);
                }
                language-selected(i) => {
                    root.current-language-index = i;
                    root.language-changed(i);
                }
            }
            if(side-bar.current-item == 1) : _3DViewPreferences {
                build-volume-width-text: root.build-volume-width-text;
                build-volume-depth-text: root.build-volume-depth-text;
                build-volume-height-text: root.build-volume-height-text;
                build-volume-width-committed(t) => {
                    root.build-volume-width-committed(t);
                }
                build-volume-depth-committed(t) => {
                    root.build-volume-depth-committed(t);
                }
                build-volume-height-committed(t) => {
                    root.build-volume-height-committed(t);
                }
                reset-build-volume-requested => {
                    root.reset-build-volume-requested();
                }
            }
        }
    }
}
