import { Button, Palette, ScrollView } from "std-widgets.slint";

export component InfoDialog inherits Window {
    title: @tr("Information");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    in property <string> heading: @tr("Information");
    in property <string> message: "";
    in property <string> details: "";

    property <bool> details-visible: false;

    // Font sizes in `rem`: 1rem = Window.default-font-size at render
    // time, so these track OS text-size preferences automatically.
    // The info glyph is deliberately a fixed absolute size: it's a
    // decorative marker, not reading text, and should not shrink on
    // small-default systems.
    property <length> font-secondary: 0.85rem;
    property <length> font-footnote: 0.8rem;

    min-width: 520px;
    max-width: 520px;
    preferred-width: 520px;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    preferred-height: body.preferred-height;

    callback close-requested();

    // Focus the Close button when the dialog opens so Enter activates it.
    forward-focus: close-button;

    FocusScope {
        width: parent.width;
        height: parent.height;

        // Escape always closes the dialog; Enter is handled natively by
        // the focused Button.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        body := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Text {
                    text: "ℹ";
                    font-size: 36px;
                    color: Palette.accent-background;
                    vertical-alignment: top;
                    horizontal-alignment: center;
                    width: 48px;
                    // Screen readers otherwise pronounce U+2139
                    // inconsistently (or read the raw character name).
                    // Override so the icon is announced semantically as
                    // "Information" in every locale.
                    accessible-role: text;
                    accessible-label: @tr("InfoDialog" => "Information");
                }

                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.heading;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.message != "": Text {
                        text: root.message;
                        font-size: root.font-secondary;
                        wrap: word-wrap;
                    }

                    if root.details != "": HorizontalLayout {
                        alignment: start;
                        TouchArea {
                            width: toggle-text.preferred-width;
                            height: toggle-text.preferred-height;
                            toggle-text := Text {
                                // The glyph is kept out of the
                                // translatable strings so translators
                                // can't accidentally drop or replace it.
                                text: (root.details-visible ? "▾ " : "▸ ") + (root.details-visible ? @tr("Hide details") : @tr("Show details"));
                                font-size: root.font-footnote;
                                color: Palette.accent-background;
                            }

                            clicked => {
                                root.details-visible = !root.details-visible;
                            }
                        }
                    }

                    if root.details != "" && root.details-visible: ScrollView {
                        max-height: 160px;
                        Text {
                            text: root.details;
                            font-size: root.font-footnote;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                            color: Palette.foreground.transparentize(0.35);
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                close-button := Button {
                    text: @tr("Close");
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }
}
