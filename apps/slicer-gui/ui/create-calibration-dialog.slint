import { Button, LineEdit, Palette } from "std-widgets.slint";
import { ThemePreference } from "preferences/appearance.slint";

// Dialog for authoring a new resin calibration profile for the selected
// printer. It edits a name plus the per-printer calibration values; the
// Rust side validates them, writes a new profile to the user library,
// and reports any problem back through `error-message`.
export component CreateCalibrationDialog inherits Window {
    title: @tr("CreateCalibrationDialog" => "New calibration");
    icon: @image-url("../assets/images/soulcrafted.svg");
    default-font-family: "Noto Sans";

    in-out property <ThemePreference> theme: ThemePreference.System;

    in property <string> source-name;
    in property <string> printer-name;
    in property <string> error-message;

    in-out property <string> name-text;
    in-out property <string> normal-exposure-text;
    in-out property <string> bottom-exposure-text;
    in-out property <string> bottom-layer-count-text;
    in-out property <string> lift-distance-text;
    in-out property <string> lift-speed-text;
    in-out property <string> retract-speed-text;

    callback save-requested();
    callback cancel-requested();

    min-width: 420px;
    preferred-width: 460px;

    forward-focus: name-input;

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: @tr("CreateCalibrationDialog" => "Calibrate {} for {}", root.source-name, root.printer-name);
                font-weight: 700;
                wrap: word-wrap;
                accessible-role: none;
            }

            GridLayout {
                spacing: 8px;

                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Name");
                        vertical-alignment: center;
                    }
                    name-input := LineEdit {
                        text <=> root.name-text;
                        placeholder-text: @tr("CreateCalibrationDialog" => "e.g. My Grey 0.05mm");
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Normal exposure (s)");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: decimal;
                        text <=> root.normal-exposure-text;
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Bottom exposure (s)");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: decimal;
                        text <=> root.bottom-exposure-text;
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Bottom layers");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: number;
                        text <=> root.bottom-layer-count-text;
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Lift distance (mm)");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: decimal;
                        text <=> root.lift-distance-text;
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Lift speed (mm/min)");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: decimal;
                        text <=> root.lift-speed-text;
                    }
                }
                Row {
                    Text {
                        text: @tr("CreateCalibrationDialog" => "Retract speed (mm/min)");
                        vertical-alignment: center;
                    }
                    LineEdit {
                        input-type: decimal;
                        text <=> root.retract-speed-text;
                    }
                }
            }

            if root.error-message != "": Text {
                text: root.error-message;
                color: red;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    text: @tr("CreateCalibrationDialog" => "Save");
                    primary: true;
                    clicked => {
                        root.save-requested();
                    }
                }
                cancel-button := Button {
                    text: @tr("CreateCalibrationDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
