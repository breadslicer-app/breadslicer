import { Palette } from "std-widgets.slint";

export enum AxisView {
    Front,
    Back,
    Right,
    Left,
    Top,
    Bottom,
}

// Snapshot of keyboard modifier state at the moment of a pointer event.
// Carried alongside the cursor coordinates on every viewport-pointer
// callback so the controller's drag FSM can read modifier state inline
// (Slint's `moved` callback alone does not carry modifiers, so the move
// path is dispatched through `pointer-event(Move)` instead).
export struct PointerModifiers {
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
}

export component MeshViewer inherits Rectangle {
    in property <image> rendering;
    in property <string> placeholder-text: "";

    // 0 = none, 1 = rotating, 2 = panning
    property <int> active-gesture: 0;
    // Whether the left button is currently pressed (for selection /
    // gizmo drag — see the pointer-down/move/up callbacks). Tracked
    // separately from `active-gesture` so a left-press doesn't stop
    // the user from also right-dragging to rotate the camera.
    property <bool> left-pressed: false;
    property <length> last-x;
    property <length> last-y;

    callback viewport-resized(length, length);
    callback rotate-drag(length, length);
    callback pan-drag(length, length);
    callback zoom-at(length, length, length);
    callback frame-view-requested();
    callback axis-view-requested(AxisView);
    // Left-button events. `down` fires on press, `up` on release;
    // `move` fires while the left button is held (and no camera
    // gesture is active). The Rust side decides whether a press →
    // release was a "click" (small movement) or a "drag", so this
    // callback set is finer-grained than Slint's built-in `clicked`.
    callback viewport-pointer-down(length, length, PointerModifiers);
    callback viewport-pointer-move(length, length, PointerModifiers);
    callback viewport-pointer-up(length, length, PointerModifiers);
    callback selection-cleared();

    accessible-role: image;
    accessible-label: root.rendering.width == 0
        ? (root.placeholder-text != "" ? root.placeholder-text : @tr("MeshViewer" => "3D model viewer, empty"))
        : @tr("MeshViewer" => "3D model viewer");
    accessible-description: @tr("MeshViewer" => "Right-click drag or arrow keys to rotate. Shift with right-click drag, middle-click drag, or Shift and arrow keys to pan. Scroll, Plus/Minus, or Page Up/Down to zoom. Press F or Home to frame the model. Press 1, 3, or 7 for front, right, or top views; hold Control for back, left, or bottom.");

    // Viewport background stays dark regardless of OS theme — the CAD/DCC
    // convention, keeps the light-grey mesh legible under both light and
    // dark app chrome. The border follows the Palette so it blends with the
    // surrounding chrome.
    background: #1e1e1e;
    border-color: Palette.border;
    border-width: 1px;

    changed width => {
        root.viewport-resized(self.width, self.height);
    }
    changed height => {
        root.viewport-resized(self.width, self.height);
    }

    Image {
        source: root.rendering;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
        // Accessibility metadata lives on the enclosing MeshViewer.
        accessible-role: none;
    }

    if (root.rendering.width == 0 || root.rendering.height == 0): Text {
        text: root.placeholder-text;
        color: #888;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: self.text;
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        // Accessibility metadata lives on the enclosing MeshViewer.
        accessible-role: none;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.selection-cleared();
                return accept;
            }
            if (event.text == Key.Home || event.text == "f" || event.text == "F") {
                root.frame-view-requested();
                return accept;
            }
            // Ctrl flips each axis to its opposite, matching the
            // Blender/CAD convention for numpad-based view switching.
            if (event.text == "1") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Back : AxisView.Front);
                return accept;
            }
            if (event.text == "3") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Left : AxisView.Right);
                return accept;
            }
            if (event.text == "7") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Bottom : AxisView.Top);
                return accept;
            }
            // Arrow keys drive rotate / pan with the same (dx, dy) sign
            // conventions as a right-drag: Right = positive dx, Down =
            // positive dy. Shift switches the gesture from rotate to pan,
            // matching the mouse modifier.
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift) {
                    root.pan-drag(-30px, 0px);
                } else {
                    root.rotate-drag(-20px, 0px);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift) {
                    root.pan-drag(30px, 0px);
                } else {
                    root.rotate-drag(20px, 0px);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) {
                    root.pan-drag(0px, -30px);
                } else {
                    root.rotate-drag(0px, -20px);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) {
                    root.pan-drag(0px, 30px);
                } else {
                    root.rotate-drag(0px, 20px);
                }
                return accept;
            }
            // Keyboard zoom targets the viewport centre and uses 120 logical
            // pixels per press, matching a single mouse-wheel notch on the
            // Rust side (`factor = exp(-delta * 0.005)`).
            if (event.text == "+" || event.text == "=" || event.text == Key.PageUp) {
                root.zoom-at(120px, root.width / 2, root.height / 2);
                return accept;
            }
            if (event.text == "-" || event.text == Key.PageDown) {
                root.zoom-at(-120px, root.width / 2, root.height / 2);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.active-gesture == 1 ? MouseCursor.grabbing : (root.active-gesture == 2 ? MouseCursor.move : MouseCursor.default);

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    fs.focus();
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                    if (event.button == PointerEventButton.left) {
                        root.left-pressed = true;
                        root.viewport-pointer-down(ta.mouse-x, ta.mouse-y, {
                            shift: event.modifiers.shift,
                            control: event.modifiers.control,
                            alt: event.modifiers.alt,
                            meta: event.modifiers.meta,
                        });
                    } else if (event.button == PointerEventButton.right) {
                        root.active-gesture = event.modifiers.shift ? 2 : 1;
                    } else if (event.button == PointerEventButton.middle) {
                        root.active-gesture = 2;
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.left) {
                        root.left-pressed = false;
                        root.viewport-pointer-up(ta.mouse-x, ta.mouse-y, {
                            shift: event.modifiers.shift,
                            control: event.modifiers.control,
                            alt: event.modifiers.alt,
                            meta: event.modifiers.meta,
                        });
                    } else if (event.button == PointerEventButton.right || event.button == PointerEventButton.middle) {
                        root.active-gesture = 0;
                    }
                } else if (event.kind == PointerEventKind.move && root.left-pressed && root.active-gesture == 0) {
                    // Camera gestures (right/middle drag) take priority
                    // over a left-press, so the pointer-move stream is
                    // suppressed while the camera is moving even if
                    // both buttons are held simultaneously. The Move
                    // case lives in `pointer-event` (not `moved`)
                    // because only `pointer-event` carries the
                    // `event.modifiers` snapshot the controller's drag
                    // FSM needs to read the Shift state inline.
                    root.viewport-pointer-move(ta.mouse-x, ta.mouse-y, {
                        shift: event.modifiers.shift,
                        control: event.modifiers.control,
                        alt: event.modifiers.alt,
                        meta: event.modifiers.meta,
                    });
                }
            }

            moved => {
                if (root.active-gesture == 1) {
                    root.rotate-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                } else if (root.active-gesture == 2) {
                    root.pan-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                }
            }

            scroll-event(event) => {
                root.zoom-at(event.delta-y, ta.mouse-x, ta.mouse-y);
                return accept;
            }
        }
    }
}
