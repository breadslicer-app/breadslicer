import { Palette } from "std-widgets.slint";
import { ViewWheel } from "view-wheel.slint";

export enum AxisView {
    Front,
    Back,
    Right,
    Left,
    Top,
    Bottom,
}

// Snapshot of keyboard modifier state at the moment of a pointer event.
// Carried alongside the cursor coordinates on every viewport-pointer
// callback so the controller's drag FSM can read modifier state inline
// (Slint's `moved` callback alone does not carry modifiers, so the move
// path is dispatched through `pointer-event(Move)` instead).
export struct PointerModifiers {
    shift: bool,
    control: bool,
    alt: bool,
    meta: bool,
}

export component MeshViewer inherits Rectangle {
    property <bool> view-wheel-open: false;
    property <bool> view-wheel-key-held: false;
    property <int> view-wheel-selection: -1;
    property <length> view-wheel-x;
    property <length> view-wheel-y;
    // Spanish keyboard ordinal key, plus US grave/tilde equivalents.
    function is-view-key(text: string) -> bool {
        return text == "º" || text == "ª" || text == "`" || text == "~";
    }
    function choose-view(code: int) {
            root.view-wheel-open = false;
            if (code == 0) { root.axis-view-requested(AxisView.Top); }
            if (code == 1) { root.axis-view-requested(AxisView.Bottom); }
            if (code == 2) { root.axis-view-requested(AxisView.Left); }
            if (code == 3) { root.axis-view-requested(AxisView.Right); }
            if (code == 4) { root.axis-view-requested(AxisView.Front); }
            if (code == 5) { root.axis-view-requested(AxisView.Back); }
            if (code == 6) { root.frame-selected-requested(); }
            if (code == 7) { root.toggle-projection-requested(); }
        }
    public function focus-viewport() { fs.focus(); }
    in property <image> rendering;
    in property <string> placeholder-text: "";

    // 0 = none, 1 = rotating, 2 = panning
    property <int> active-gesture: 0;
    // Whether the left button is currently pressed (for selection /
    // gizmo drag, see the pointer-down/move/up callbacks). Tracked
    // separately from `active-gesture` so a left-press doesn't stop
    // the user from also right-dragging to rotate the camera.
    property <bool> left-pressed: false;
    property <length> last-x;
    property <length> last-y;

    callback viewport-resized(length, length);
    callback rotate-drag(length, length);
    // A right or middle drag that orbits starts at the cursor and ends when
    // its button comes up; Rust picks the pivot and places its marker.
    callback orbit-begin(length, length);
    callback orbit-end();
    // Numpad 4/6 and 8/2: one orbit step left/right (-1/1) or up/down (1/-1).
    callback orbit-step(int, int);
    in property <bool> orbit-pivot-visible: false;
    in property <length> orbit-pivot-x;
    in property <length> orbit-pivot-y;
    // The pivot is off screen: the marker sits on the edge and points
    // toward it, `orbit-pivot-toward` degrees clockwise from the right.
    in property <bool> orbit-pivot-edge: false;
    in property <float> orbit-pivot-toward;
    callback pan-drag(length, length);
    callback zoom-at(length, length, length);
    in property <bool> orthographic-view: false;
    callback toggle-projection-requested();
    callback frame-selected-requested();
    callback frame-view-requested();
    callback axis-view-requested(AxisView);
    // Left-button events. `down` fires on press, `up` on release;
    // `move` fires while the left button is held (and no camera
    // gesture is active). The Rust side decides whether a press →
    // release was a "click" (small movement) or a "drag", so this
    // callback set is finer-grained than Slint's built-in `clicked`.
    callback viewport-pointer-down(length, length, PointerModifiers);
    callback viewport-pointer-move(length, length, PointerModifiers);
    callback viewport-pointer-up(length, length, PointerModifiers);
    callback selection-cleared();
    // Keyboard gizmo focus. `T`/`R`/`S` give the corresponding
    // operation type keyboard focus; arrow / PageUp / PageDown
    // events drive the per-frame integrator while a focus is
    // active. `gizmo-keyboard-focus-active` is mirrored from the
    // Rust controller so the FocusScope's key-pressed handler
    // knows whether to hijack the arrow keys (focus active) or
    // route them to the camera (focus None).
    in property <bool> modal-transform-active: false;
    in property <string> modal-transform-status: "";
    callback modal-transform-start(int, length, length);
    callback modal-transform-axis(int, length, length);
    callback modal-transform-finish(bool);
    // A plain letter the active workspace tab may claim for its own tools
    // (A / X support tools, L layer view); returns whether it did.
    callback tab-tool-key(string) -> bool;
    // Escape for the open tab tool (the Orient tool, #182): true when it
    // took the key, before Escape clears the selection.
    callback tool-escape() -> bool;
    property <bool> modal-click-pending: false;
    in property <bool> gizmo-keyboard-focus-active: false;
    callback gizmo-focus-translate-pressed();
    callback gizmo-focus-rotate-pressed();
    callback gizmo-focus-scale-pressed();
    // The `int` codes encode axis × sign:
    //   0 = +X, 1 = -X, 2 = +Y, 3 = -Y, 4 = +Z, 5 = -Z.
    callback gizmo-arrow-pressed(int);
    callback gizmo-arrow-released(int);
    // Tab / Shift+Tab selection cycling. `+1` advances forward,
    // `-1` advances backward. The Slint side `accept`s Tab only
    // when `can-cycle-selection` is true (i.e., the scene has at
    // least one object); otherwise Tab falls through to native
    // focus traversal.
    in property <bool> can-cycle-selection: false;
    callback selection-cycle(int);
    // Copy / paste of the current selection. Bound from the
    // FocusScope's key-pressed handler on `Ctrl+C` / `Ctrl+V` (and
    // `Cmd+C` / `Cmd+V` on macOS). The Rust side decides whether
    // there is anything to copy or paste; the callbacks fire even
    // on empty selections and the controller bails silently.
    callback copy-pressed();
    callback paste-pressed();
    // Fires when the cursor leaves the viewport rectangle. The
    // paste path uses this to clear its cached hover-cursor so a
    // `Ctrl+V` after the cursor has left falls back to the
    // viewport-centre placement instead of anchoring on a stale
    // last-known position.
    callback viewport-pointer-leave();

    // Right-click context menu. The Rust side classifies the
    // right-button press / release as a click (menu) or a drag
    // (camera orbit, kept on `pointer-event`) and, on a click,
    // invokes `show-context-menu` with the press pixel + the two
    // visibility flags. Menu-item clicks fire the matching
    // *-pressed callback; the popup auto-closes on click outside.
    property <length> context-anchor-x: 0px;
    property <length> context-anchor-y: 0px;
    property <bool> context-can-copy: false;
    property <bool> context-can-paste: false;
    property <bool> context-can-delete: false;
    callback show-context-menu(length, length, bool, bool, bool);
    show-context-menu(x, y, copy, paste, del) => {
        root.context-anchor-x = x;
        root.context-anchor-y = y;
        root.context-can-copy = copy;
        root.context-can-paste = paste;
        root.context-can-delete = del;
        ctx-menu.show({ x: x, y: y });
    }
    callback context-copy-pressed();
    // Paste from the context menu carries the anchor pixel so
    // Rust can place the new object at the right-click position
    // rather than at the (drifted) cursor when the menu entry was
    // clicked.
    callback context-paste-pressed(length, length);
    // Delete fires through the same callback regardless of surface
    // (Delete key, context menu, or the Edit > Delete menu item):
    // the Rust handler is a single document.delete_selected_root_leaf
    // call, no per-surface state to carry.
    callback delete-requested();
    // Right-button press / release events. The Rust side
    // classifies the gesture as click (context menu) or drag
    // (camera orbit / pan, also driven by the existing
    // active-gesture state in this component); these callbacks
    // give Rust the press / release positions it needs to make
    // the classification.
    callback viewport-right-pointer-down(length, length);
    callback viewport-right-pointer-up(length, length);

    accessible-role: image;
    accessible-label: root.rendering.width == 0
        ? (root.placeholder-text != "" ? root.placeholder-text : @tr("MeshViewer" => "3D model viewer, empty"))
        : @tr("MeshViewer" => "3D model viewer");
    accessible-description: @tr("MeshViewer" => "Right-click drag or arrow keys to rotate. Middle or right drag to orbit. Shift with middle/right drag or arrow keys to pan. 5 toggles perspective/orthographic. Scroll, Plus/Minus, or Page Up/Down to zoom. Press F or Home to frame the model. Press 1, 3, or 7 for front, right, or top views; hold Control for back, left, or bottom. Press 4 or 6 to orbit left or right, 8 or 2 to orbit up or down, 15 degrees per press.");

    // Viewport background stays dark regardless of OS theme: the CAD/DCC
    // convention, keeps the light-grey mesh legible under both light and
    // dark app chrome. The border follows the Palette so it blends with the
    // surrounding chrome.
    background: #1e1e1e;
    border-color: Palette.border;
    border-width: 1px;

    changed width => {
        root.viewport-resized(self.width, self.height);
    }
    changed height => {
        root.viewport-resized(self.width, self.height);
    }

    Image {
        source: root.rendering;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
        // Accessibility metadata lives on the enclosing MeshViewer.
        accessible-role: none;
    }

    if (root.rendering.width == 0 || root.rendering.height == 0): Text {
        text: root.placeholder-text;
        color: #888;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: self.text;
    }

    fs := FocusScope {
        changed has-focus => {
            if (!self.has-focus) { root.view-wheel-open = false; root.view-wheel-key-held = false; }
            if (!self.has-focus && root.modal-transform-active) { root.modal-transform-finish(false); }
        }
        width: parent.width;
        height: parent.height;
        // Accessibility metadata lives on the enclosing MeshViewer.
        accessible-role: none;

        key-pressed(event) => {
            // Ctrl (snap) and Shift (fine) change a drag or G/R/S in flight at
            // once, without waiting for the mouse to move.
            if ((event.text == Key.Control || event.text == Key.Shift) && (root.left-pressed || root.modal-transform-active)) {
                root.viewport-pointer-move(ta.mouse-x, ta.mouse-y, {
                    shift: event.text == Key.Shift || event.modifiers.shift,
                    control: event.text == Key.Control || event.modifiers.control,
                    alt: event.modifiers.alt,
                    meta: event.modifiers.meta,
                });
                return accept;
            }
            if (root.is-view-key(event.text) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                if (!root.modal-transform-active && root.active-gesture == 0 && !root.left-pressed && !root.view-wheel-key-held) {
                    root.view-wheel-x = ta.mouse-x;
                    root.view-wheel-y = ta.mouse-y;
                    root.view-wheel-selection = -1;
                    root.view-wheel-open = !root.view-wheel-open;
                }
                root.view-wheel-key-held = true;
                return accept;
            }
            if (root.view-wheel-open) {
                if (event.text == Key.Escape) { root.view-wheel-open = false; }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.modal-transform-active) { root.modal-transform-finish(false); }
                else if (!root.tool-escape()) { root.selection-cleared(); }
                return accept;
            }
            if (event.text == Key.Home || event.text == "f" || event.text == "F") {
                root.frame-view-requested();
                return accept;
            }
            // Plain keys only: never steal Save, reload, or modified shortcuts.
            if (!event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (event.text == "g" || event.text == "G") {
                    root.modal-transform-start(0, ta.mouse-x, ta.mouse-y);
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    root.modal-transform-start(1, ta.mouse-x, ta.mouse-y);
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.modal-transform-start(2, ta.mouse-x, ta.mouse-y);
                    return accept;
                }
                if (!root.modal-transform-active && root.tab-tool-key(event.text)) {
                    return accept;
                }
            }
            if (root.modal-transform-active) {
                if (event.text == Key.Return) { root.modal-transform-finish(true); }
                if (event.text == "x" || event.text == "X") { root.modal-transform-axis(0, ta.mouse-x, ta.mouse-y); }
                if (event.text == "y" || event.text == "Y") { root.modal-transform-axis(1, ta.mouse-x, ta.mouse-y); }
                if (event.text == "z" || event.text == "Z") { root.modal-transform-axis(2, ta.mouse-x, ta.mouse-y); }
                return accept;
            }
            if (event.text == "5" && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                root.toggle-projection-requested();
                return accept;
            }
            // Retain the original T + arrows workflow as a non-modal alternative.
            if ((event.text == "t" || event.text == "T") && !event.modifiers.control && !event.modifiers.meta) {
                root.gizmo-focus-translate-pressed();
                return accept;
            }
            // Ctrl flips each axis to its opposite, matching the
            // Blender/CAD convention for numpad-based view switching.
            if (event.text == "1") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Back : AxisView.Front);
                return accept;
            }
            if (event.text == "3") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Left : AxisView.Right);
                return accept;
            }
            if (event.text == "7") {
                root.axis-view-requested(event.modifiers.control ? AxisView.Bottom : AxisView.Top);
                return accept;
            }
            // The numpad orbit (#348). Slint reports a numpad digit as the
            // digit itself, so the top row turns the view too, as 1/3/5/7 do.
            if (!event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt) {
                if (event.text == "4") { root.orbit-step(-1, 0); return accept; }
                if (event.text == "6") { root.orbit-step(1, 0); return accept; }
                if (event.text == "8") { root.orbit-step(0, 1); return accept; }
                if (event.text == "2") { root.orbit-step(0, -1); return accept; }
            }
            // Arrow / PageUp / PageDown keys are hijacked by the
            // gizmo integrator while keyboard focus is active. Without
            // focus they keep their existing camera-rotate / pan /
            // zoom bindings; with focus they emit
            // `gizmo-arrow-pressed(code)` and the camera doesn't
            // hear them.
            if (event.text == Key.LeftArrow) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(1);
                } else if (event.modifiers.shift) {
                    root.pan-drag(-30px, 0px);
                } else {
                    root.rotate-drag(-20px, 0px);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(0);
                } else if (event.modifiers.shift) {
                    root.pan-drag(30px, 0px);
                } else {
                    root.rotate-drag(20px, 0px);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(2);
                } else if (event.modifiers.shift) {
                    root.pan-drag(0px, -30px);
                } else {
                    root.rotate-drag(0px, -20px);
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(3);
                } else if (event.modifiers.shift) {
                    root.pan-drag(0px, 30px);
                } else {
                    root.rotate-drag(0px, 20px);
                }
                return accept;
            }
            if (event.text == Key.PageUp) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(4);
                } else {
                    root.zoom-at(120px, root.width / 2, root.height / 2);
                }
                return accept;
            }
            if (event.text == Key.PageDown) {
                if (root.gizmo-keyboard-focus-active) {
                    root.gizmo-arrow-pressed(5);
                } else {
                    root.zoom-at(-120px, root.width / 2, root.height / 2);
                }
                return accept;
            }
            // `+` / `=` / `-` keep their zoom binding regardless of
            // focus, they aren't axis keys, so there's nothing to
            // hijack.
            if (event.text == "+" || event.text == "=") {
                root.zoom-at(120px, root.width / 2, root.height / 2);
                return accept;
            }
            if (event.text == "-") {
                root.zoom-at(-120px, root.width / 2, root.height / 2);
                return accept;
            }
            // Ctrl+C / Ctrl+V (and Cmd+C / Cmd+V on macOS) copy /
            // paste the current selection. The branches are gated
            // on `control || meta` so both Linux/Windows and macOS
            // conventions work; modifier-less C / V are reserved for
            // future plain-key bindings and fall through.
            if ((event.text == "c" || event.text == "C")
                && (event.modifiers.control || event.modifiers.meta)) {
                root.copy-pressed();
                return accept;
            }
            if ((event.text == "v" || event.text == "V")
                && (event.modifiers.control || event.modifiers.meta)) {
                root.paste-pressed();
                return accept;
            }
            // Tab / Shift+Tab cycle through the scene's objects when
            // anything is loaded. Only accepted when there's
            // something to cycle, an empty viewport leaves Tab to
            // native focus traversal so the user can leave the
            // viewport with the keyboard. `Key.Backtab` is the X11 /
            // Qt convention for Shift+Tab; on Mac / Win the same
            // gesture arrives as `Key.Tab` with `modifiers.shift`.
            if (event.text == Key.Backtab && root.can-cycle-selection) {
                root.selection-cycle(-1);
                return accept;
            }
            if (event.text == Key.Tab && root.can-cycle-selection) {
                root.selection-cycle(event.modifiers.shift ? -1 : 1);
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete-requested();
                return accept;
            }
            return reject;
        }

        key-released(event) => {
            if ((event.text == Key.Control || event.text == Key.Shift) && (root.left-pressed || root.modal-transform-active)) {
                root.viewport-pointer-move(ta.mouse-x, ta.mouse-y, {
                    shift: event.text != Key.Shift && event.modifiers.shift,
                    control: event.text != Key.Control && event.modifiers.control,
                    alt: event.modifiers.alt,
                    meta: event.modifiers.meta,
                });
                return accept;
            }
            if (root.is-view-key(event.text)) {
                root.view-wheel-key-held = false;
                if (root.view-wheel-open && root.view-wheel-selection >= 0) {
                    root.choose-view(root.view-wheel-selection);
                }
                // No aim: a quick tap leaves the menu open for clicking.
                return accept;
            }
            // Only the keyboard-focus-driven arrow events need a
            // matching release. Other keys are momentary (T/R/S
            // toggle focus, Esc cascades) and have no held state.
            if (!root.gizmo-keyboard-focus-active) {
                return reject;
            }
            if (event.text == Key.RightArrow) {
                root.gizmo-arrow-released(0);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.gizmo-arrow-released(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.gizmo-arrow-released(2);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.gizmo-arrow-released(3);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.gizmo-arrow-released(4);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.gizmo-arrow-released(5);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.active-gesture == 1 ? MouseCursor.grabbing : (root.active-gesture == 2 ? MouseCursor.move : MouseCursor.default);

            // The paste path's cursor anchor caches the last move
            // position; when the cursor leaves the viewport, drop
            // that cache so `Ctrl+V` falls back to the viewport
            // centre instead of anchoring on a stale pixel.
            changed has-hover => {
                if (!self.has-hover) {
                    root.viewport-pointer-leave();
                }
            }

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    fs.focus();
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                    if (root.modal-transform-active) {
                        root.modal-click-pending = true;
                        if (event.button == PointerEventButton.left) { root.modal-transform-finish(true); }
                        else if (event.button == PointerEventButton.right) { root.modal-transform-finish(false); }
                    } else if (event.button == PointerEventButton.left) {
                        root.left-pressed = true;
                        root.viewport-pointer-down(ta.mouse-x, ta.mouse-y, {
                            shift: event.modifiers.shift,
                            control: event.modifiers.control,
                            alt: event.modifiers.alt,
                            meta: event.modifiers.meta,
                        });
                    } else if (event.button == PointerEventButton.right) {
                        root.active-gesture = event.modifiers.shift ? 2 : 1;
                        if (root.active-gesture == 1) { root.orbit-begin(ta.mouse-x, ta.mouse-y); }
                        root.viewport-right-pointer-down(ta.mouse-x, ta.mouse-y);
                    } else if (event.button == PointerEventButton.middle) {
                        root.active-gesture = event.modifiers.shift ? 2 : 1;
                        if (root.active-gesture == 1) { root.orbit-begin(ta.mouse-x, ta.mouse-y); }
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (root.modal-click-pending) { root.modal-click-pending = false; }
                    else if (event.button == PointerEventButton.left) {
                        root.left-pressed = false;
                        root.viewport-pointer-up(ta.mouse-x, ta.mouse-y, {
                            shift: event.modifiers.shift,
                            control: event.modifiers.control,
                            alt: event.modifiers.alt,
                            meta: event.modifiers.meta,
                        });
                    } else if (event.button == PointerEventButton.right) {
                        if (root.active-gesture == 1) { root.orbit-end(); }
                        root.active-gesture = 0;
                        root.viewport-right-pointer-up(ta.mouse-x, ta.mouse-y);
                    } else if (event.button == PointerEventButton.middle) {
                        if (root.active-gesture == 1) { root.orbit-end(); }
                        root.active-gesture = 0;
                    }
                } else if (event.kind == PointerEventKind.move && root.active-gesture == 0) {
                    // Camera gestures (right/middle drag) take priority
                    // over the move stream, when one is active we
                    // suppress moves entirely so the gizmo drag FSM
                    // doesn't fight the camera. Otherwise the same
                    // callback drives both the left-pressed drag-update
                    // path and the no-button hover-tint path, so the
                    // controller can hit-test the gizmo handles in
                    // both states. The Move case lives in
                    // `pointer-event` (not `moved`) because only
                    // `pointer-event` carries the `event.modifiers`
                    // snapshot the drag FSM needs to read the Shift
                    // state inline.
                    root.viewport-pointer-move(ta.mouse-x, ta.mouse-y, {
                        shift: event.modifiers.shift,
                        control: event.modifiers.control,
                        alt: event.modifiers.alt,
                        meta: event.modifiers.meta,
                    });
                }
            }

            moved => {
                if (root.active-gesture == 1) {
                    root.rotate-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                } else if (root.active-gesture == 2) {
                    root.pan-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                }
            }

            scroll-event(event) => {
                if (root.modal-transform-active) { return accept; }
                root.zoom-at(event.delta-y, ta.mouse-x, ta.mouse-y);
                return accept;
            }
        }

        // ContextMenuArea owns the popup lifecycle natively: it
        // renders the items as platform-styled menu entries,
        // dismisses on click-outside or Escape, and routes
        // selection through the MenuItem `activated` callback.
        // `enabled: false` disables its built-in right-click
        // trigger; the click-vs-drag detection lives in Rust and
        // calls `show({x, y})` explicitly when the gesture is a
        // click.
        ctx-menu := ContextMenuArea {
            enabled: false;
            Menu {
                if (root.context-can-copy): MenuItem {
                    title: @tr("MeshViewer" => "Copy");
                    activated => {
                        root.context-copy-pressed();
                    }
                }
                if (root.context-can-delete): MenuItem {
                    title: @tr("MeshViewer" => "Delete");
                    activated => {
                        root.delete-requested();
                    }
                }
                if (root.context-can-paste): MenuItem {
                    title: @tr("MeshViewer" => "Paste");
                    activated => {
                        root.context-paste-pressed(
                            root.context-anchor-x,
                            root.context-anchor-y,
                        );
                    }
                }
            }
        }
    }
    // The orbit's pivot. It holds still on screen while the camera turns;
    // off screen it waits on the edge with an arrow toward the pivot.
    if root.orbit-pivot-visible: Rectangle {
        x: root.orbit-pivot-x - self.width / 2;
        y: root.orbit-pivot-y - self.height / 2;
        width: 26px;
        height: 26px;
        transform-rotation: root.orbit-pivot-edge ? root.orbit-pivot-toward * 1deg : 0deg;
        accessible-role: none;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            border-width: 2px;
            border-color: #f0f0f0;
            background: #3a8fd9;
        }
        if root.orbit-pivot-edge: Path {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 7px;
            height: 10px;
            viewbox-width: 7;
            viewbox-height: 10;
            commands: "M 0 0 L 7 5 L 0 10 Z";
            fill: #f0f0f0;
        }
    }
    if root.modal-transform-active: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 48px;
        width: status.preferred-width + 24px;
        height: 32px;
        border-radius: 5px;
        border-width: 1px;
        border-color: #555;
        background: #202024;
        status := Text {
            text: root.modal-transform-status + "  |  " + @tr("Enter / click: confirm | Esc / right click: cancel") + "  |  " + @tr("Ctrl: snap | Shift: fine");
            color: #eee;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Small visible projection control, usable without knowing the shortcut.
    Rectangle {
        x: 12px; y: parent.height - 38px;
        width: 122px; height: 26px;
        border-radius: 4px;
        background: #252527;
        border-color: #454548; border-width: 1px;
        Text {
            text: root.orthographic-view ? "Orthographic  5" : "Perspective  5";
            color: #cccccc; font-size: 11px;
            horizontal-alignment: center; vertical-alignment: center;
        }
        TouchArea {
            clicked => { if (!root.modal-transform-active) { root.toggle-projection-requested(); fs.focus(); } }
        }
    }
    if root.view-wheel-open: ViewWheel {
        width: parent.width; height: parent.height;
        origin-x: root.view-wheel-x; origin-y: root.view-wheel-y;
        orthographic: root.orthographic-view;
        key-held: root.view-wheel-key-held;
        aimed(code) => { root.view-wheel-selection = code; }
        chosen(code) => { root.choose-view(code); }
    }

}
