export component MeshViewer inherits Rectangle {
    in property <image> rendering;
    in property <string> placeholder-text: "";

    // 0 = none, 1 = rotating, 2 = panning
    property <int> active-gesture: 0;
    property <length> last-x;
    property <length> last-y;

    callback viewport-resized(length, length);
    callback rotate-drag(length, length);
    callback pan-drag(length, length);
    callback zoom-at(length, length, length);
    callback frame-view-requested();
    callback axis-view-requested(int);

    background: #1e1e1e;
    border-color: #2d2d2d;
    border-width: 1px;

    changed width => {
        root.viewport-resized(self.width, self.height);
    }
    changed height => {
        root.viewport-resized(self.width, self.height);
    }

    Image {
        source: root.rendering;
        image-fit: fill;
        width: parent.width;
        height: parent.height;
    }

    if (root.rendering.width == 0 || root.rendering.height == 0): Text {
        text: root.placeholder-text;
        color: #888;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Home || event.text == "f" || event.text == "F") {
                root.frame-view-requested();
                return accept;
            }
            if (event.text == "1") {
                root.axis-view-requested(0);
                return accept;
            }
            if (event.text == "3") {
                root.axis-view-requested(2);
                return accept;
            }
            if (event.text == "7") {
                root.axis-view-requested(4);
                return accept;
            }
            return reject;
        }

        ta := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: root.active-gesture == 1 ? MouseCursor.grabbing : (root.active-gesture == 2 ? MouseCursor.move : MouseCursor.default);

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    fs.focus();
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                    if (event.button == PointerEventButton.right) {
                        root.active-gesture = event.modifiers.shift ? 2 : 1;
                    } else if (event.button == PointerEventButton.middle) {
                        root.active-gesture = 2;
                    }
                } else if (event.kind == PointerEventKind.up) {
                    if (event.button == PointerEventButton.right || event.button == PointerEventButton.middle) {
                        root.active-gesture = 0;
                    }
                }
            }

            moved => {
                if (root.active-gesture != 0) {
                    if (root.active-gesture == 1) {
                        root.rotate-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    } else if (root.active-gesture == 2) {
                        root.pan-drag(ta.mouse-x - root.last-x, ta.mouse-y - root.last-y);
                    }
                    root.last-x = ta.mouse-x;
                    root.last-y = ta.mouse-y;
                }
            }

            scroll-event(event) => {
                root.zoom-at(event.delta-y, ta.mouse-x, ta.mouse-y);
                return accept;
            }
        }
    }
}
