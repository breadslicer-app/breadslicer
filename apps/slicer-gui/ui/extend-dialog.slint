import { Button, ComboBox, Palette } from "std-widgets.slint";
import { EditField } from "profile-view-dialog.slint";
import { ThemePreference } from "preferences/appearance.slint";

// Extend dialog: adds one calibration block to a resin's extension
// file. The target picker lists only the targets the resin does not
// cover yet (derived on the Rust side); the value fields appear once a
// target is picked, and partial values are allowed.
export component ExtendDialog inherits Window {
    title: @tr("ExtendDialog" => "Extend resin profile");
    icon: @image-url("../assets/images/breadslicer.png");
    default-font-family: "Noto Sans";

    in-out property <ThemePreference> theme: ThemePreference.System;

    in property <string> source-name;
    in property <[string]> target-labels;
    in-out property <int> target-index: -1;
    // The resin's existing calibration blocks, to start a new one
    // from instead of typing all the values again.
    in property <[string]> copy-source-labels;
    in-out property <int> copy-source-index: -1;
    in-out property <string> normal-exposure-text;
    in-out property <string> bottom-exposure-text;
    in-out property <string> bottom-count-text;
    in-out property <string> wait-before-cure-text;
    in-out property <string> wait-after-cure-text;
    in-out property <string> wait-after-lift-text;
    in-out property <string> bottom-wait-before-cure-text;
    in-out property <string> bottom-wait-after-cure-text;
    in-out property <string> bottom-wait-after-lift-text;
    in-out property <string> lift-distance-text;
    in-out property <string> lift-speed-text;
    in-out property <string> retract-speed-text;
    in-out property <string> second-lift-distance-text;
    in-out property <string> second-lift-speed-text;
    in-out property <string> second-retract-speed-text;
    in-out property <string> bottom-lift-distance-text;
    in-out property <string> bottom-lift-speed-text;
    in-out property <string> bottom-retract-speed-text;
    in-out property <string> bottom-second-lift-distance-text;
    in-out property <string> bottom-second-lift-speed-text;
    in-out property <string> bottom-second-retract-speed-text;
    in-out property <string> light-pwm-text;
    in-out property <string> bottom-light-pwm-text;
    in property <string> error-message;

    callback copy-requested(int);
    callback save-requested();
    callback cancel-requested();

    min-width: 420px;
    preferred-width: 460px;
    min-height: 280px;
    preferred-height: 420px;

    forward-focus: cancel-button;

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: @tr("ExtendDialog" => "Extend {}", root.source-name);
                font-size: 1.1rem;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                text: @tr("ExtendDialog" => "Add calibration values for a target this resin does not cover yet.");
                font-size: 0.85rem;
                color: Palette.foreground.transparentize(0.3);
                wrap: word-wrap;
            }

            // Created only once the labels are set: on a new model, Slint
            // 1.18.1 moves an index of -1 to 0, so a picker that existed before
            // them would open with the 1st target picked.
            if root.target-labels.length > 0: ComboBox {
                model: root.target-labels;
                current-index <=> root.target-index;
            }

            VerticalLayout {
                spacing: 6px;
                alignment: start;
                vertical-stretch: 1;

                if root.target-index >= 0: VerticalLayout {
                    spacing: 6px;
                    if root.copy-source-labels.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("ExtendDialog" => "Copy values from");
                            font-size: 0.85rem;
                            color: Palette.foreground.transparentize(0.3);
                        }
                        ComboBox {
                            model: root.copy-source-labels;
                            current-index <=> root.copy-source-index;
                            selected => {
                                root.copy-requested(self.current-index);
                            }
                        }
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Normal exposure (s)");
                        value <=> root.normal-exposure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom exposure (s)");
                        value <=> root.bottom-exposure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom layer count");
                        value <=> root.bottom-count-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Wait before cure (s)");
                        value <=> root.wait-before-cure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Wait after cure (s)");
                        value <=> root.wait-after-cure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Wait after lift (s)");
                        value <=> root.wait-after-lift-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom wait before cure (s)");
                        value <=> root.bottom-wait-before-cure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom wait after cure (s)");
                        value <=> root.bottom-wait-after-cure-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom wait after lift (s)");
                        value <=> root.bottom-wait-after-lift-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Lift distance (mm)");
                        value <=> root.lift-distance-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Lift speed (mm/min)");
                        value <=> root.lift-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Retract speed (mm/min)");
                        value <=> root.retract-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Second lift distance (mm)");
                        value <=> root.second-lift-distance-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Second lift speed (mm/min)");
                        value <=> root.second-lift-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Second retract speed (mm/min)");
                        value <=> root.second-retract-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom lift distance (mm)");
                        value <=> root.bottom-lift-distance-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom lift speed (mm/min)");
                        value <=> root.bottom-lift-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom retract speed (mm/min)");
                        value <=> root.bottom-retract-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom second lift distance (mm)");
                        value <=> root.bottom-second-lift-distance-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom second lift speed (mm/min)");
                        value <=> root.bottom-second-lift-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom second retract speed (mm/min)");
                        value <=> root.bottom-second-retract-speed-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Light power (%)");
                        value <=> root.light-pwm-text;
                    }
                    EditField {
                        label: @tr("ExtendDialog" => "Bottom light power (%)");
                        value <=> root.bottom-light-pwm-text;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.error-message;
                    color: #d32f2f;
                    font-size: 0.85rem;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("ExtendDialog" => "Save");
                    primary: true;
                    enabled: root.target-index >= 0;
                    clicked => {
                        root.save-requested();
                    }
                }
                cancel-button := Button {
                    text: @tr("ExtendDialog" => "Cancel");
                    clicked => {
                        root.cancel-requested();
                    }
                }
            }
        }
    }
}
