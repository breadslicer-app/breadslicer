// The app's messages, drawn inside the main window (#133): a dimmed layer over
// the whole window with the message card centred on it, so every message opens
// in the same place, over the window it is about. Rust (`error_dialog.rs`)
// owns the queue and the policy: it decides which messages a click outside
// closes and which offer "Don't show again"; this layer only reports what the
// person did.
//
// The cards speak the start dialog's language (#385): a head with the kind's
// icon, the title and a line under it, and the close button; the body under
// a line; the buttons in a foot under another line. Where a card offers
// several ways to go on, they are rows like the start dialog's, 1 click each.

import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "kit/theme.slint";
import { Icons } from "kit/icons.slint";
import { ButtonKind, DisclosureChevron, ScButton } from "kit/controls.slint";
import { ActionRow, DialogHead, DialogRule } from "kit/dialog.slint";

// `diagnostics` is Help > Export Diagnostics (#74); `diagnostic-log` asks
// before the diagnostic log starts (Preferences > Privacy); `stale-supports`
// is a notice that a model's supports are out of date, with the ways to make
// them again (#408).
export enum MessageKind { info, error, scene-change, slice-overwrite, recovery, diagnostics, diagnostic-log, stale-supports, add-supports, separate-supports }

// What the person did with the message. `cancel` is also Escape and Enter;
// Rust reads it as "close" for a message with nothing to decide.
// `regenerate` and `keep-edits` are the stale supports' rows (#408).
export enum MessageAnswer { close, discard, save, export, confirm, cancel, regenerate, keep-edits }

export struct AppMessage {
    kind: MessageKind,
    heading: string,
    // What the message is about, such as the file; empty shows no line.
    context: string,
    text: string,
    // Shown behind a toggle; empty shows no toggle.
    details: string,
    // Whether the message offers "Don't show again".
    can-silence: bool,
    // Scene change only: closing the scene (true) or opening another file.
    closing: bool,
    // Scene change only: the file about to open; empty shows no line.
    source-name: string,
    // Scene change only: offer Save and Export, and say how to keep changes.
    has-unsaved-changes: bool,
    // Scene change only: the scene has no project file yet ("Save As").
    save-as-mode: bool,
    // Diagnostics only: there is a scene, so its models can go in.
    has-scene: bool,
    // Stale supports only: the set has edits made by hand, so the card
    // offers to make it again keeping them (#408).
    hand-edited: bool,
    // Error only: the text of a button that does something about the error
    // (#407), such as Repair; it answers `confirm`. Empty shows none.
    action: string,
}

// A paragraph of a card's body.
component BodyText inherits Text {
    font-size: Theme.font-sm;
    color: Theme.text-soft;
    wrap: word-wrap;
}

export component MessageLayer inherits Rectangle {
    in property <AppMessage> message;
    in property <bool> open: false;
    // Changes with each message shown, so a new message gets the keyboard and
    // starts with its details open.
    in property <int> serial: 0;
    in-out property <bool> silence: false;
    // Diagnostics only: whether the scene's models go in the file.
    in-out property <bool> include-models: false;
    // Shown when the message brings no heading of its own.
    in property <string> default-heading;

    callback answered(MessageAnswer);
    // A click on the dimmed window around the card.
    callback outside-clicked();

    visible: root.open;
    background: #0000008c;

    // A notice opens with its details shown whole (#392): the card grows
    // down to hold them, and they scroll only when the window is too short.
    property <bool> details-visible: true;
    // The least room left above and below a card.
    property <length> margin: 24px;
    // `Theme.well` as a colour, for the fades over the details' edges.
    property <color> well-color: Theme.dark ? #16181a : #e7eaec;
    // The details were copied since they were last shown.
    property <bool> copied: false;
    property <MessageKind> kind: root.message.kind;
    // Stale supports (#408) are a notice with ways to go on under its text.
    property <bool> notice: root.kind == MessageKind.info || root.kind == MessageKind.error || root.kind == MessageKind.stale-supports;
    // A scene change with changes to keep: its ways to go on are rows.
    property <bool> scene-rows: root.kind == MessageKind.scene-change && root.message.has-unsaved-changes;
    // A notice of a heading alone has no body.
    property <bool> has-body: !root.notice || root.message.text != "" || root.message.details != "";
    // An error that offers to do something about itself (#407).
    property <bool> has-action: root.kind == MessageKind.error && root.message.action != "";
    // The questions whose main answer is to go ahead: Enter gives it.
    property <MessageAnswer> go-ahead: root.kind == MessageKind.diagnostics ? MessageAnswer.export
        : root.kind == MessageKind.diagnostic-log ? MessageAnswer.confirm
        : root.kind == MessageKind.separate-supports ? MessageAnswer.confirm
        : root.has-action ? MessageAnswer.confirm
        : MessageAnswer.cancel;
    // Whether Enter's button shows its ring: while the card has the keyboard.
    property <bool> keyboard: fs.has-focus;

    changed serial => {
        root.details-visible = true;
        root.copied = false;
        if (root.open) {
            fs.focus();
        }
    }
    changed open => {
        if (root.open) {
            fs.focus();
        }
    }

    // Owns the keyboard while a message is open: Escape gives the safe
    // answer, and so does Enter unless the message's main answer is to go
    // ahead. Other keys are swallowed so no shortcut acts under it.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.open;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.answered(MessageAnswer.cancel);
            } else if (event.text == Key.Return) {
                root.answered(root.go-ahead);
            }
            return accept;
        }

        // The dimmed window around the card.
        TouchArea {
            clicked => {
                root.outside-clicked();
            }
            scroll-event(event) => {
                return accept;
            }
        }

        card := Rectangle {
            // Wider than its kind's width when the buttons need it (Spanish
            // runs longer), as long as the window has room.
            width: Math.min(
                parent.width - 32px,
                Math.max(
                    // A notice with details is wider, so the report's
                    // lines fit on 1 line each.
                    root.kind == MessageKind.diagnostics || (root.notice && root.message.details != "") ? 600px
                        : root.kind == MessageKind.slice-overwrite || root.kind == MessageKind.add-supports || root.kind == MessageKind.separate-supports ? 480px
                        : root.kind == MessageKind.diagnostic-log ? 540px
                        : 520px,
                    foot.preferred-width));
            // Down to the foot as the layout placed it. The layout's
            // preferred height can't serve: Slint measures a wrapping text in
            // an `if` element as 1 line, so with long texts the buttons hung
            // below the card's edge.
            height: foot.y + foot.height;
            x: (parent.width - self.width) / 2;
            // Centred, however tall the card grows.
            y: Math.max(root.margin, (parent.height - self.height) / 2);
            background: Theme.card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-lg;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;

            // A click on the card itself is not a click outside.
            TouchArea {
                scroll-event(event) => {
                    return accept;
                }
            }

            VerticalLayout {
                // Its own height, not the card's: the card's height comes
                // from where this layout puts the foot. At the top: with a
                // height of its own it would be centred. No taller than the
                // window leaves room for: then the details give up height,
                // the only part that can, and scroll.
                y: 0;
                height: Math.min(self.preferred-height, root.height - 2 * root.margin);

                DialogHead {
                    icon: root.kind == MessageKind.error ? Icons.error
                        : root.kind == MessageKind.info ? Icons.info
                        : root.kind == MessageKind.stale-supports || root.kind == MessageKind.add-supports || root.kind == MessageKind.separate-supports ? Icons.supports
                        : root.kind == MessageKind.scene-change ? (root.message.has-unsaved-changes ? Icons.save : Icons.file)
                        : root.kind == MessageKind.slice-overwrite ? Icons.warning
                        : root.kind == MessageKind.recovery ? Icons.history
                        : Icons.pulse;
                    tint: root.kind == MessageKind.error ? Theme.danger : Theme.accent;
                    title: root.notice ? (root.message.heading != "" ? root.message.heading : root.default-heading)
                        : root.kind == MessageKind.scene-change ? (root.message.closing ? @tr("ReplaceSceneDialog" => "Close the current scene?") : @tr("ReplaceSceneDialog" => "Replace the current scene?"))
                        : root.kind == MessageKind.slice-overwrite ? @tr("SliceOverwriteDialog" => "Re-slice this scene?")
                        : root.kind == MessageKind.recovery || root.kind == MessageKind.add-supports || root.kind == MessageKind.separate-supports ? root.message.heading
                        : root.kind == MessageKind.diagnostics ? @tr("DiagnosticsDialog" => "Export diagnostics")
                        : @tr("DiagnosticLogDialog" => "Save a diagnostic log?");
                    subtitle: root.notice ? root.message.context
                        : root.kind == MessageKind.scene-change ? (root.message.source-name != "" ? @tr("ReplaceSceneDialog" => "Opening: {}", root.message.source-name)
                            : root.message.has-unsaved-changes ? @tr("ReplaceSceneDialog" => "The scene has changes that are not saved")
                            : "")
                        : root.kind == MessageKind.recovery ? @tr("RecoveryDialog" => "Scenes left with unsaved changes")
                        : root.kind == MessageKind.diagnostics ? @tr("DiagnosticsDialog" => "A .zip file to attach to a bug report")
                        : root.kind == MessageKind.separate-supports ? root.message.context
                        : "";
                    // A file's path must show whole.
                    subtitle-wraps: true;
                    close-label: @tr("MessageLayer" => "Close");
                    close => {
                        root.answered(MessageAnswer.cancel);
                    }
                }

                DialogRule { }

                // A notice: its text, and its details folded under a toggle.
                // Stretched, not packed at the start: the text takes the
                // card's width, so the details wrap at it.
                if root.notice && root.has-body: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 16px;
                    padding-bottom: 18px;
                    spacing: 10px;

                    if root.message.text != "": BodyText {
                        text: root.message.text;
                    }

                    // The toggle, and the details folded under it. The
                    // details are always there, of no height while folded,
                    // so the Copy link beside the toggle reaches them.
                    if root.message.details != "": VerticalLayout {
                        spacing: root.details-visible ? 8px : 0px;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 16px;

                            TouchArea {
                                width: toggle.preferred-width;
                                height: toggle.preferred-height;
                                mouse-cursor: pointer;
                                toggle := HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;
                                    DisclosureChevron {
                                        open: root.details-visible;
                                        color: Theme.accent;
                                        size: 9px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.kind == MessageKind.error
                                            ? (root.details-visible ? @tr("ErrorDialog" => "Hide technical details") : @tr("ErrorDialog" => "Show technical details"))
                                            : (root.details-visible ? @tr("InfoDialog" => "Hide details") : @tr("InfoDialog" => "Show details"));
                                        font-size: Theme.font-sm;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }

                                clicked => {
                                    root.details-visible = !root.details-visible;
                                }
                            }

                            // Copies the details as text, to paste them in
                            // a message or an issue.
                            if root.details-visible: TouchArea {
                                width: copy-label.preferred-width;
                                height: copy-label.preferred-height;
                                mouse-cursor: pointer;
                                copy-label := Text {
                                    text: root.copied ? @tr("InfoDialog" => "Copied") : @tr("InfoDialog" => "Copy details");
                                    font-size: Theme.font-sm;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                                clicked => {
                                    details-text.select-all();
                                    details-text.copy();
                                    details-text.clear-selection();
                                    root.copied = true;
                                }
                            }
                        }

                        // In a well, as the start dialog shows a file. As
                        // tall as the details, so the whole report shows;
                        // shorter only when the window is, down to a few
                        // lines, and then they scroll.
                        Rectangle {
                            visible: root.details-visible;
                            property <length> full: details-text.preferred-height + 16px;
                            preferred-height: root.details-visible ? self.full : 0px;
                            min-height: root.details-visible ? Math.min(self.full, 72px) : 0px;
                            max-height: root.details-visible ? self.full : 0px;
                            vertical-stretch: 1;
                            background: Theme.well;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border-soft;

                            details-scroll := ScrollView {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                // A viewport as wide as the view, so the text
                                // wraps instead of scrolling sideways.
                                content-width: self.visible-width;
                                content-height: details-text.height;
                                // Selectable, so a part can be copied too.
                                details-text := TextInput {
                                    width: details-scroll.visible-width;
                                    height: self.preferred-height;
                                    text: root.message.details;
                                    font-family: Theme.mono;
                                    font-size: Theme.font-sm;
                                    wrap: word-wrap;
                                    single-line: false;
                                    read-only: true;
                                    horizontal-alignment: left;
                                    color: Theme.text-soft;
                                }
                            }

                            // A fade at an edge with more of the report past
                            // it, so a report that scrolls says so.
                            Rectangle {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: 20px;
                                visible: details-scroll.viewport-y < -0.5px;
                                border-top-left-radius: Theme.radius - 1px;
                                border-top-right-radius: Theme.radius - 1px;
                                background: @linear-gradient(180deg, root.well-color 0%, root.well-color.transparentize(100%) 100%);
                            }
                            Rectangle {
                                x: 1px;
                                y: parent.height - self.height - 1px;
                                width: parent.width - 2px;
                                height: 28px;
                                visible: details-scroll.viewport-y > details-scroll.visible-height - details-scroll.viewport-height + 0.5px;
                                border-bottom-left-radius: Theme.radius - 1px;
                                border-bottom-right-radius: Theme.radius - 1px;
                                background: @linear-gradient(0deg, root.well-color 0%, root.well-color.transparentize(100%) 100%);
                            }
                        }
                    }
                }

                // Supports out of date (#408): 1 row per way to make them
                // again; Close leaves them as they are.
                if root.kind == MessageKind.stale-supports: VerticalLayout {
                    padding: 12px;
                    padding-top: 0px;
                    spacing: 4px;

                    // With edits made by hand, keeping them comes first.
                    if root.message.hand-edited: ActionRow {
                        lead: true;
                        icon: Icons.add-support;
                        title: @tr("StaleSupportsDialog" => "Recalculate, keeping my edits");
                        detail: @tr("StaleSupportsDialog" => "Make them again; put back what was added, moved or removed by hand");
                        clicked => {
                            root.answered(MessageAnswer.keep-edits);
                        }
                    }
                    if root.message.hand-edited: Rectangle {
                        height: 6px;
                    }
                    ActionRow {
                        lead: !root.message.hand-edited;
                        icon: Icons.supports;
                        title: @tr("StaleSupportsDialog" => "Regenerate");
                        detail: root.message.hand-edited
                            ? @tr("StaleSupportsDialog" => "Make them again with the current settings; the hand edits are lost")
                            : @tr("StaleSupportsDialog" => "Make this model's supports again with the current settings");
                        clicked => {
                            root.answered(MessageAnswer.regenerate);
                        }
                    }
                }

                // A scene change with changes to keep: 1 row per way to go
                // on, saving first.
                if root.scene-rows: VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    ActionRow {
                        lead: true;
                        icon: Icons.save;
                        title: root.message.save-as-mode ? @tr("ReplaceSceneDialog" => "Save as project…") : @tr("ReplaceSceneDialog" => "Save the project");
                        detail: root.message.save-as-mode
                            ? @tr("ReplaceSceneDialog" => "Keep everything in a .bread file first")
                            : @tr("ReplaceSceneDialog" => "Save the changes to its .bread file first");
                        clicked => {
                            root.answered(MessageAnswer.save);
                        }
                    }
                    Rectangle {
                        height: 6px;
                    }
                    ActionRow {
                        icon: Icons.export;
                        title: @tr("ReplaceSceneDialog" => "Export a copy…");
                        detail: @tr("ReplaceSceneDialog" => "Save the models as STL, OBJ or 3MF first");
                        clicked => {
                            root.answered(MessageAnswer.export);
                        }
                    }
                    ActionRow {
                        icon: Icons.trash;
                        tint: Theme.danger;
                        title: @tr("ReplaceSceneDialog" => "Discard the changes");
                        detail: root.message.closing
                            ? @tr("ReplaceSceneDialog" => "Close without saving; the changes are lost")
                            : @tr("ReplaceSceneDialog" => "Open without saving; the changes are lost");
                        clicked => {
                            root.answered(MessageAnswer.discard);
                        }
                    }
                }

                // A scene change with nothing to keep: what happens.
                if root.kind == MessageKind.scene-change && !root.message.has-unsaved-changes: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 16px;
                    padding-bottom: 18px;

                    BodyText {
                        text: @tr("ReplaceSceneDialog" => "The current scene will be closed.");
                    }
                }

                if root.kind == MessageKind.slice-overwrite: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 16px;
                    padding-bottom: 18px;

                    BodyText {
                        text: @tr(
                            "SliceOverwriteDialog"
                            => "The geometry or the print settings changed since the last slice. Re-slicing replaces the slice data you already have."
                        );
                    }
                }

                if root.kind == MessageKind.add-supports || root.kind == MessageKind.separate-supports: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 16px;
                    padding-bottom: 18px;

                    BodyText {
                        text: root.message.text;
                    }
                }

                // The scenes a run left unsaved (#18), 1 line each, then the
                // ways to go on.
                if root.kind == MessageKind.recovery: VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 8px;

                        Rectangle {
                            background: Theme.well;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border-soft;

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;

                                scenes-scroll := ScrollView {
                                    height: Math.min(scenes-text.preferred-height, 120px);
                                    // As wide as the view, so the lines
                                    // wrap instead of scrolling sideways.
                                    content-width: self.visible-width;
                                    scenes-text := Text {
                                        width: scenes-scroll.visible-width;
                                        text: root.message.context;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-soft;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    ActionRow {
                        lead: true;
                        icon: Icons.history;
                        title: @tr("RecoveryDialog" => "Recover the scenes");
                        detail: @tr("RecoveryDialog" => "Each one opens with its changes, to keep working on it");
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }
                    Rectangle {
                        height: 6px;
                    }
                    ActionRow {
                        icon: Icons.trash;
                        tint: Theme.danger;
                        title: @tr("RecoveryDialog" => "Discard them");
                        detail: @tr("RecoveryDialog" => "Their changes are deleted for good");
                        clicked => {
                            root.answered(MessageAnswer.discard);
                        }
                    }
                }

                if root.kind == MessageKind.diagnostics: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 14px;
                    padding-bottom: 16px;
                    spacing: 6px;

                    BodyText {
                        text: @tr("DiagnosticsDialog" => "Saves a .zip file to attach to a bug report. It holds:");
                    }

                    // The bullet is kept out of the translatable strings so
                    // translators can't drop it.
                    for item in [
                        @tr("DiagnosticsDialog" => "What the app did in this session: steps, times and errors, without models, file names or anything you typed."),
                        @tr("DiagnosticsDialog" => "The logs saved on this computer: crash reports, and the diagnostic log if you turned it on."),
                        @tr("DiagnosticsDialog" => "The app version, the system, the graphics card and the screens."),
                        @tr("DiagnosticsDialog" => "Your preferences, without folders."),
                        @tr("DiagnosticsDialog" => "The scene in numbers: models, triangles, supports and hollowing."),
                    ]: HorizontalLayout {
                        padding-left: 4px;
                        spacing: 8px;

                        Text {
                            text: "•";
                            font-size: Theme.font-sm;
                            color: Theme.accent;
                            accessible-role: none;
                        }
                        BodyText {
                            text: item;
                            horizontal-stretch: 1;
                        }
                    }

                    BodyText {
                        text: @tr("DiagnosticsDialog" => "Your user name and your user folder are replaced in every file.");
                    }

                    if root.message.has-scene: CheckBox {
                        text: @tr("DiagnosticsDialog" => "Include the scene's models (.bread)");
                        checked <=> root.include-models;
                    }

                    BodyText {
                        text: @tr("DiagnosticsDialog" => "Breadslicer never sends us anything. The file stays on your computer, and only reaches us if you send it yourself.");
                        font-weight: 600;
                        color: Theme.text;
                    }
                }

                if root.kind == MessageKind.diagnostic-log: VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 14px;
                    padding-bottom: 16px;
                    spacing: 8px;

                    BodyText {
                        text: @tr(
                            "DiagnosticLogDialog"
                            => "Until you close Breadslicer, closing included, it writes what it does to the logs folder on this computer: steps, times and errors, without models, file names or anything you type."
                        );
                    }

                    BodyText {
                        text: @tr("DiagnosticLogDialog" => "The next time you open Breadslicer, the log turns off by itself.");
                    }

                    BodyText {
                        text: @tr("DiagnosticLogDialog" => "Breadslicer never sends us anything. The log stays on your computer, and only reaches us if you send it yourself.");
                        font-weight: 600;
                        color: Theme.text;
                    }
                }

                if root.has-body: DialogRule { }

                // "Don't show again" on the left, the buttons on the right;
                // the one Enter presses has a ring.
                foot := HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    if root.message.can-silence: CheckBox {
                        text: @tr("MessageLayer" => "Don't show again");
                        checked <=> root.silence;
                    }

                    // What Escape and Enter do with the scenes.
                    if root.kind == MessageKind.recovery: Text {
                        text: @tr("RecoveryDialog" => "Breadslicer asks again the next time it opens.");
                        font-size: Theme.font-xs;
                        color: Theme.text-faint;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // With an action beside it, or rows to pick from
                    // (#408), Close steps back: no accent.
                    if root.notice: ScButton {
                        text: root.kind == MessageKind.error ? @tr("ErrorDialog" => "Close") : @tr("InfoDialog" => "Close");
                        kind: root.has-action || root.kind == MessageKind.stale-supports ? ButtonKind.normal : ButtonKind.primary;
                        ring: root.keyboard && !root.has-action;
                        clicked => {
                            root.answered(MessageAnswer.close);
                        }
                    }

                    if root.has-action: ScButton {
                        text: root.message.action;
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }

                    if root.kind == MessageKind.scene-change && !root.message.has-unsaved-changes: ScButton {
                        text: root.message.closing ? @tr("ReplaceSceneDialog" => "Discard & Close") : @tr("ReplaceSceneDialog" => "Discard & Open");
                        clicked => {
                            root.answered(MessageAnswer.discard);
                        }
                    }

                    // With rows to pick from, Cancel steps back: no accent.
                    if root.kind == MessageKind.scene-change: ScButton {
                        text: @tr("ReplaceSceneDialog" => "Cancel");
                        kind: root.scene-rows ? ButtonKind.normal : ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.slice-overwrite: ScButton {
                        text: @tr("SliceOverwriteDialog" => "Re-slice");
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }

                    if root.kind == MessageKind.slice-overwrite: ScButton {
                        text: @tr("SliceOverwriteDialog" => "Cancel");
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.add-supports: ScButton {
                        text: @tr("AddSupportsDialog" => "Yes");
                        min-width: 96px;
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }

                    if root.kind == MessageKind.add-supports: ScButton {
                        text: @tr("AddSupportsDialog" => "No");
                        min-width: 96px;
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.separate-supports: ScButton {
                        text: @tr("SeparateSupportsDialog" => "Leave as is");
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.separate-supports: ScButton {
                        text: @tr("SeparateSupportsDialog" => "Separate");
                        min-width: 96px;
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }

                    if root.kind == MessageKind.recovery: ScButton {
                        text: @tr("RecoveryDialog" => "Decide later");
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.diagnostics: ScButton {
                        text: @tr("DiagnosticsDialog" => "Cancel");
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.diagnostics: ScButton {
                        text: @tr("DiagnosticsDialog" => "Save…");
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.export);
                        }
                    }

                    if root.kind == MessageKind.diagnostic-log: ScButton {
                        text: @tr("DiagnosticLogDialog" => "Cancel");
                        clicked => {
                            root.answered(MessageAnswer.cancel);
                        }
                    }

                    if root.kind == MessageKind.diagnostic-log: ScButton {
                        text: @tr("DiagnosticLogDialog" => "Turn on");
                        kind: ButtonKind.primary;
                        ring: root.keyboard;
                        clicked => {
                            root.answered(MessageAnswer.confirm);
                        }
                    }
                }
            }
        }
    }
}
