import { AboutWindow } from "about-window.slint";

export { AboutWindow }

export component MainWindow inherits Window {
    title: @tr("SoulCrafted Slicer");
    icon: @image-url("../assets/images/soulcrafted.svg");

    min-height: 400px;
    min-width: 600px;
    preferred-width: 600px;
    preferred-height: 400px;

    callback open-file-requested();
    callback show-about-requested();

    MenuBar {
        Menu {
            title: @tr("MenuBar" => "File");
            MenuItem {
                title: @tr("MenuBar" => "Open");
                // shortcut: @keys(Control + O);
                activated => {
                    root.open-file-requested();
                }
            }
            // TODO: "Open Recent"
            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Save");
            }

            Menu {
                title: @tr("MenuBar" => "Save As");
            }
        }

        Menu {
            title: @tr("MenuBar" => "Help");
            MenuItem {
                title: @tr("MenuBar" => "Documentation");
            }

            MenuItem {
                title: @tr("MenuBar" => "Show Release Notes");
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Report Issue");
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Check for Updates…");
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "About");
                activated => {
                    root.show-about-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "View License");
            }
        }
    }

    Text {
        text: "SoulCrafted Slicer";
        color: green;
    }
}
