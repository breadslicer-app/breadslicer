import { Palette, ScrollView } from "std-widgets.slint";
import { ScButton as Button } from "kit/controls.slint";
import { ScProgress as ProgressIndicator } from "./kit/controls.slint";
import { AboutWindow } from "about-window.slint";
import { AxisView, MeshViewer, PointerModifiers } from "./mesh-viewer.slint";
import { Theme } from "./kit/theme.slint";
import { Icons } from "./kit/icons.slint";
import { CaptionButton, CaptionKind, Icon, LayerRuler, SupportLink, ToolButton, ToolTip, ToolTipState, WorkflowTab } from "./kit/controls.slint";
import { CutCard, ExportInspector, HollowInspector, OrientCard, OrientOption, ReviewRow, SliceInspector, SupportsFooter, SupportsInspector, TransformInspector } from "./workspace/inspectors.slint";
import { LayerView } from "./workspace/layer-view.slint";
import { PresetCard, ShapeCallout, ShapeSize, ShareItem, SharePicker, ZoneRow } from "./workspace/support-shape.slint";
import { ThemePreference } from "./preferences/appearance.slint";
import { PreferencesWindow } from "./preferences/preferences-window.slint";
import { ExtendDialog } from "extend-dialog.slint";
import { ForkDialog } from "fork-dialog.slint";
import { AppMessage, MessageAnswer, MessageKind, MessageLayer } from "message-layer.slint";
import { RecentFileRow, StartLayer, StartOpen } from "start-dialog.slint";
import { ProfileViewDialog } from "profile-view-dialog.slint";

// Embeds Noto Sans into the executable and registers it process wide.
// Text layout then resolves to this in-memory font instead of scanning
// the system font set through fontconfig, which otherwise stalls the UI
// thread the first time any text is laid out (e.g. opening a menu).
import "../assets/fonts/NotoSans-Variable.ttf";

export { AboutWindow, AppMessage, AxisView, ExtendDialog, ForkDialog, MessageAnswer, MessageKind, PointerModifiers, PreferencesWindow, ProfileViewDialog, RecentFileRow, StartOpen, Theme, ThemePreference }

// Load-pipeline phase shown by the floating progress panel. Values
// mirror the Rust-side worker phases; the Rust poll maps between the
// two.
export enum LoadPhase { ReadingFile, PreparingGeometry, UploadingToGpu }

// Phases of a project save, mirroring the Rust-side worker phases; the
// Rust poll maps between the two.
// Shared by the save and export flows: both drive the same progress
// panel and busy flag, and each phase value maps onto one panel line.
// Flattening is only ever set by exports (STL formats merge the scene
// into one mesh first); saves start at Serializing.
export enum SavePhase { Flattening, Serializing, Compressing, Writing }

// Menu presentation for the main window. `Bar` shows the top menu bar;
// `Compact` hides it to reclaim vertical space. Linux and Windows only:
// macOS always resolves to `Bar` in Rust because it renders a global
// top-of-screen menu bar. Persisted app-wide.
export enum MenuLayout { Bar, Compact }

// The pages the top bar links to so people can support the project.
export enum SupportPage { Patreon, KoFi }

// The workflow tabs (BS-68): Transform hosts the scene-editing tools and
// the mesh repair; Hollow and Supports are taken in either order once the
// pose is set; Slice holds the slicing flow and the layer view; Export
// writes the printer file. Per-window live state, not persisted; a freshly
// loaded scene opens in Transform.
export enum WorkspaceSection { Transform, Hollow, Supports, Slice, Export }

export component MainWindow inherits Window {
    // The window's focus goes to the workspace, so the keys it takes work
    // before anything is clicked (#501).
    forward-focus: layer-keys;
    // Window title. Once a file is open it shows the file's name (with a
    // `*` prefix while there are unsaved changes); with no file open it
    // falls back to the application name.
    title: root.document-name != ""
        ? (root.scene-dirty ? "* " : "") + root.document-name + " — Breadslicer"
        : "Breadslicer";
    icon: @image-url("../assets/images/breadslicer.png");
    default-font-family: "Noto Sans";

    // The app draws its own title bar (#507): the top bar takes the
    // window's caption buttons, is where the window is dragged from, and
    // the edges are where it is resized. Rust turns it on where it is
    // supported (Windows).
    in property <bool> custom-chrome: false;
    in property <bool> window-maximized: false;
    callback window-drag();
    callback window-minimize();
    callback window-maximize-toggle();
    callback window-close();
    // 0 N, 1 S, 2 E, 3 W, 4 NE, 5 NW, 6 SE, 7 SW.
    callback window-resize(int);
    no-frame: root.custom-chrome;

    min-height: 560px;
    min-width: 960px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.ground;

    in property <image> mesh-rendering;
    // The app message on show (#133), centred over the window on a dimmed
    // layer; Rust (`error_dialog::DialogManager`) owns the queue and decides
    // what a click outside does.
    in property <AppMessage> message;
    in property <bool> message-open: false;
    in property <int> message-serial: 0;
    in-out property <bool> message-silence: false;
    // Help > Export Diagnostics: whether the scene's models go in the file.
    in-out property <bool> message-include-models: false;
    // Heading of an error message that brings none of its own.
    out property <string> message-default-heading: @tr("ErrorDialog" => "An error occurred");
    callback message-answered(MessageAnswer);
    callback message-outside-clicked();
    // The start dialog (#381), over the window like the messages. Rust
    // (`start_dialog.rs`) opens it and fills the list; it hides while a file
    // loads and closes once the window holds a scene, or objects again.
    in-out property <bool> start-open: false;
    in property <[RecentFileRow]> start-recent;
    // The name of the file "Reopen" opens; empty offers no Reopen.
    in property <string> start-last-name;
    in property <string> start-version;
    in-out property <bool> start-dont-show: false;
    callback start-open-recent(int);
    callback start-reopen-last();
    callback start-remove-recent(int);
    // Open project or Import model: File > Open's dialog, led by that kind.
    callback start-open-file(StartOpen);
    callback start-dont-show-changed(bool);
    in property <bool> loading: false;
    in property <bool> has-scene: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    // True while the loaded scene has unsaved changes (mirrored from
    // the document's dirty tracking); prefixes the title with `*`.
    in property <bool> scene-dirty: false;
    // Name of the currently open file (with extension), mirrored from
    // the document's source path. Empty when no file is open, which
    // makes the title fall back to the application name.
    in property <string> document-name: "";
    // The open project has earlier versions kept (#18): enables File >
    // Previous Versions.
    in property <bool> has-versions: false;
    // True while the user is dragging a file over the window (between
    // winit's `HoveredFile` and the matching `DroppedFile` /
    // `HoveredFileCancelled`). Toggled from Rust; drives the
    // translucent "Drop to open" overlay below. Wayland users won't
    // see this until winit ships Wayland DnD support upstream.
    in property <bool> drop-hovering: false;
    // True from worker dispatch (a file was actually picked and
    // handed to the load pipeline) until the load ends on any path;
    // drives the floating progress panel below. Distinct from
    // `loading`, which is already true while the file dialog is
    // still open and nothing is being read yet.
    in property <bool> load-in-progress: false;
    // Current load phase and its 0..1 fraction, polled from Rust
    // while `load-in-progress` is true.
    in property <LoadPhase> load-phase: LoadPhase.ReadingFile;
    in property <float> load-progress: 0.0;
    // True from save dispatch (the write worker was spawned) until the
    // write ends on any path; drives the floating save-progress panel
    // and disables the Save commands. Current phase and its 0..1
    // fraction are polled from Rust while it is true.
    in property <bool> saving-in-progress: false;
    in property <SavePhase> save-phase: SavePhase.Serializing;
    in property <float> save-progress: 0.0;
    in property <ThemePreference> theme: ThemePreference.System;
    in property <[StandardListViewItem]> object-list: [];
    in-out property <int> selected-object-index: -1;
    // Every selected row (#13), indexed like `object-list`, and how many
    // objects are selected. `selected-object-index` is the primary one.
    in property <[bool]> selected-object-rows: [];
    in property <int> selected-object-count: 0;
    // A Shift+left drag that grabbed no gizmo handle: the viewport draws
    // the selection box while it lasts.
    in property <bool> box-select-armed: false;
    in-out property <bool> show-object-list: true;
    // Floating object-list panel geometry, persisted per window. The
    // position is stored relative to the window edges: `anchor-right` /
    // `anchor-bottom` pick the corner the panel hugs and `offset-x` /
    // `offset-y` are the distances to those edges, so a resize keeps the
    // panel pinned to its corner. Width is a length; height uses 0px to
    // mean "auto-size to the row count". Defaults place the panel at the
    // top right; Rust overwrites them at window creation when a previous
    // session saved a position.
    in-out property <bool> object-list-anchor-right: true;
    in-out property <bool> object-list-anchor-bottom: false;
    in-out property <length> object-list-offset-x: 12px;
    in-out property <length> object-list-offset-y: 12px;
    in-out property <length> object-list-width: 220px;
    in-out property <length> object-list-height: 0px;
    in-out property <bool> object-list-minimized: false;
    // Set from Rust at window creation (cfg!(target_os = "macos")).
    // Selects the platform's fullscreen accelerator shown in the View
    // menu: Cmd+Ctrl+F on macOS, F11 elsewhere.
    in property <bool> is-macos: false;
    // Menu presentation, pushed from the persisted preference. macOS
    // always resolves to Bar in Rust because it renders a global menu
    // bar.
    in property <MenuLayout> menu-layout: MenuLayout.Bar;
    // Active workspace section, driven by Rust: the pill switcher
    // reflects it and clicking a segment requests a change through
    // `section-change-requested` rather than writing it directly, so
    // Rust stays the single source of truth (it also sets the initial
    // section from mesh health at load time).
    in property <WorkspaceSection> workspace-section: WorkspaceSection.Transform;
    // Whether undo and redo apply in the active tab: everywhere a scene can
    // still be edited, not in Slice and Export, which show a held result.
    out property <bool> history-allowed: root.workspace-section != WorkspaceSection.Slice
        && root.workspace-section != WorkspaceSection.Export;
    // True when a mesh of the scene does not slice: the Transform inspector
    // then leads with the repair card, which says which objects and why.
    // Pushed by Rust on load, after a repair, and as the scene changes.
    in property <bool> mesh-needs-repair: false;
    in property <string> mesh-check-note: "";
    in property <string> mesh-check-text: "";
    // A one-line summary of the last support run, for the Supports tab.
    in property <string> supports-last-run: "";
    // A short note of what the last action did, shown in the status bar in
    // place of the hint until Rust clears it a few seconds later.
    in property <string> status-notice: "";
    // What the last load changed or left out of the file (#301), such as
    // "Opened with 2 notes"; empty when nothing. A click opens the list.
    in property <string> import-notes: "";
    // The selected object numbers for the Transform inspector, pushed by
    // Rust at most once per frame (`ViewportController::refresh_readout`).
    in property <bool> selection-valid: false;
    in property <float> selection-size-x;
    // Size along the selected object's own axes, and whether a tilt makes
    // it differ from the world box (BS-393).
    in property <float> selection-model-x;
    in property <float> selection-model-y;
    in property <float> selection-model-z;
    in property <bool> selection-tilted;
    in property <float> selection-size-y;
    in property <float> selection-size-z;
    in property <float> selection-pos-x;
    in property <float> selection-pos-y;
    in property <float> selection-pos-z;
    in property <float> selection-rot-x;
    in property <float> selection-rot-y;
    in property <float> selection-rot-z;
    in property <float> selection-scale;
    // A value typed into the Transform inspector: its field code and value.
    callback numeric-edit(int, float);
    // Gesture aids (BS-69): what the gesture in flight has done so far, and
    // for a modal G/R/S locked to an axis, a line along it in the axis
    // colour (SVG path commands in viewport pixels).
    in property <string> gesture-readout: "";
    in property <bool> axis-guide-visible: false;
    // A move in a plane (#207) or of a model's body (#209) draws a line along
    // each of its two axes: this is the second one.
    in property <bool> axis-guide-2-visible: false;
    in property <string> axis-guide-2-commands: "";
    in property <brush> axis-guide-2-color: #ffffff;
    // The figure next to the dragged handle (or the cursor, in G/R/S), left
    // of its anchor point in viewport pixels; empty when none.
    in property <string> gesture-tag: "";
    in property <length> gesture-tag-x;
    in property <length> gesture-tag-y;
    // While moving: a dashed line from the start position (SVG path commands
    // in viewport pixels) and a dot at the start.
    in property <bool> move-trail-visible: false;
    in property <string> move-trail-commands: "";
    in property <length> move-trail-start-x;
    in property <length> move-trail-start-y;
    // The Supports tab options (DfSupportOptions) and presets, pushed by
    // `DfSupportRun`.
    in property <[string]> support-preset-names: [];
    in property <int> support-preset-index: -1;
    in property <int> support-sizing-index: 1;
    in property <float> support-density;
    in property <float> support-angle;
    in property <float> support-size-scale;
    in property <float> support-min-island;
    in property <float> support-coverage;
    in property <bool> support-stabilization: true;
    in property <bool> support-bracing: true;
    in property <bool> support-smooth: true;
    in property <int> support-raft-index: 0;
    in property <float> support-raft-thickness;
    in property <bool> support-raft-wall: true;
    // The zone preset's summary (#360), empty without one.
    in property <string> support-zone-summary;
    // The shape of a support (#564).
    in property <[PresetCard]> support-preset-cards;
    in property <int> support-preset-card-index: -1;
    in property <string> support-based-on;
    callback support-preset-revert();
    in property <string> support-shape-scope;
    in property <image> support-shape-picture;
    in property <[ShapeCallout]> support-shape-callouts;
    in-out property <int> support-shape-hot;
    callback support-shape-dragged(float, float);
    callback support-shape-pointed(int);
    in property <[ShapeSize]> support-shape-sizes;
    in property <int> support-shape-size;
    in property <string> support-shape-size-name;
    in property <[float]> support-shape-defaults;
    in property <float> support-zone-angle-default: -1;
    callback support-shape-size-picked(int);
    in property <[float]> support-shape-values;
    callback support-shape-value(int, float);
    in property <[ZoneRow]> support-zone-rows;
    in property <[string]> support-zone-size-names;
    in property <float> support-zone-angle;
    callback support-zone-size(int, int);
    callback support-zone-spacing(int, float);
    callback support-zone-angle-edited(float);
    // A zone preset's pillar grid (#464): on or off, its spacing, and the
    // spacing its preset recommends in words, empty when none does.
    in property <bool> support-grid-on;
    in property <float> support-grid-spacing: 7;
    in property <string> support-grid-hint;
    callback support-option-changed(int, float);
    // The raft would take the models' first layers (#131): the warning and
    // the label of its lift button, both empty when it does not.
    in property <string> support-raft-clash-message;
    in property <string> support-raft-lift-label;
    callback support-raft-lift-requested();
    // Generate lifts the models resting on the plate first (#389): the
    // setting, its box's text, and a click on the box.
    in property <bool> support-lift-on-plate;
    in property <string> support-lift-on-plate-label;
    callback support-lift-on-plate-toggled(bool);
    // The Supports tab's FROM BELOW card: "Hide the raft" (#492) and
    // "Supports as dotted lines" (#493).
    in property <bool> support-hide-rafts-under-plate: true;
    callback support-hide-rafts-under-plate-toggled(bool);
    in property <bool> support-lines-under-plate;
    callback support-lines-under-plate-toggled(bool);
    // The Supports tab's IMPORTED SUPPORTS card (#259): the bodies of the
    // selected model's imported supports, 0 for none.
    in property <int> imported-support-bodies;
    callback imported-supports-remove-requested();
    // The islands an analysis found (#525): how many no tip covers yet, -1
    // with no analysis of the models as they stand.
    in property <int> support-islands-left: -1;
    callback support-islands-analyze-requested();
    callback support-islands-add-requested();
    callback support-islands-go-requested();
    callback imported-supports-replace-requested();
    callback support-raft-off-requested();
    callback support-raft-ignore-requested();
    // The Supports tab manual tool: 0 none, 1 add a support where the model
    // is clicked, 2 remove the support clicked, 3 move a tip, 4 brace two
    // supports (#3).
    in-out property <int> support-tool: 0;
    // The page of the Supports tab: 0 what Generate places, 1 what the hand
    // tools place, with the sizes they place.
    in-out property <int> support-page: 0;
    callback support-page-changed();
    changed support-page => {
        root.support-page-changed();
    }
    in property <bool> support-hand-changed;
    callback support-hand-reset();
    in property <[string]> support-own-presets;
    in property <int> support-own-preset-index: -1;
    // Support settings as a file: 0 nothing asked, 1 picking what to
    // export, 2 picking what to import.
    in property <int> support-share-mode;
    in property <[ShareItem]> support-share-items;
    in property <int> support-share-picked;
    callback support-share-export();
    callback support-share-import();
    callback support-share-toggled(int, bool);
    callback support-share-accepted();
    callback support-share-cancelled();
    // Shows the hand tools' page; Add places a hand size there, the small
    // one until another is picked.
    function show-hand-page() {
        root.support-page = 1;
        if root.support-tip-size == 0 {
            root.support-tip-size = 2;
        }
    }
    // Arms hand tool `tool` (or puts it away when armed), on its page.
    function arm-support-tool(tool: int) {
        root.support-tool = root.support-tool == tool ? 0 : tool;
        if root.support-tool != 0 {
            root.show-hand-page();
        }
    }
    // A click of the tool at a world point; with Shift, Add hangs the
    // support from the nearest one or places nothing.
    callback support-tool-clicked(float, float, float, bool);
    // The cursor over the model with a tab tool armed: the world point,
    // whether there is one (false clears the preview) and whether Shift is
    // held.
    callback support-tool-hover(float, float, float, bool, bool);
    // The tip size a support added by hand takes (#3): 0 the preset's,
    // 1 to 4 extra small, small, medium and large (keys 1 to 4).
    in-out property <int> support-tip-size: 0;
    callback support-tip-size-changed();
    changed support-tip-size => {
        root.support-tip-size-changed();
    }
    // The Add tool card: the tip it places, and the hover preview's line
    // (why the support stands on its own, or cannot be placed), with
    // whether that line warns.
    in property <string> support-tip-label;
    in property <string> support-add-note;
    in property <bool> support-add-note-warns;
    // Remove's drag (#3): 0 a box, 1 a brush of this radius (logical px).
    in-out property <int> support-remove-mode: 0;
    in-out property <float> support-brush-radius: 24;
    // Drops a Supports tab drag in flight (Esc); whether there was one.
    callback support-drag-cancel() -> bool;
    // The drain tool's hover: point, surface normal (world), whether on the model.
    // The point and normal under the cursor, whether the cursor is on a
    // model, and whether that model is the selected one.
    callback hollow-drain-hover(float, float, float, float, float, float, bool, bool);
    // A tab tool was armed or put away, or the tab changed.
    callback tab-tools-changed();
    // The Supports tab's tool was armed or put away.
    callback support-tool-changed();
    changed support-tool => {
        root.tab-tools-changed();
        root.support-tool-changed();
    }
    changed hollow-drain-tool => {
        if root.hollow-drain-tool {
            root.hollow-lasso-tool = false;
        }
        root.tab-tools-changed();
    }
    changed hollow-lasso-tool => {
        if root.hollow-lasso-tool {
            root.hollow-drain-tool = false;
        }
        root.tab-tools-changed();
    }
    changed workspace-section => {
        // The change takes away the button under the pointer, and with it
        // the end of its hover.
        ToolTipState.text = "";
        root.tab-tools-changed();
        if root.orient-open && root.workspace-section != WorkspaceSection.Transform {
            root.orient-close-requested();
        }
        if root.cut-open && root.workspace-section != WorkspaceSection.Transform {
            root.cut-close-requested();
        }
    }
    // The Hollow tab (BS-8): the selected model's hollow job, its options
    // (HollowRun::on_option) and the drain tool (a click drills a drain).
    in property <bool> hollow-running: false;
    // The Hollow tab is computing (a hollow or its preview): work done ahead
    // elsewhere waits so it stays responsive.
    in property <bool> hollow-busy: false;
    in property <string> hollow-phase;
    in property <float> hollow-progress;
    in property <string> hollow-last-run;
    in property <int> hollow-model-state: 0;
    in property <int> hollow-drain-count: 0;
    in-out property <bool> hollow-drain-tool: false;
    // The lasso (#179): a stroke drawn over the viewport keeps what lies
    // behind it solid. The regions the selected model keeps, and the stroke
    // in flight as path commands in viewport pixels.
    in-out property <bool> hollow-lasso-tool: false;
    in property <int> hollow-solid-count: 0;
    in property <string> hollow-lasso-commands: "";
    // What the drain under the cursor would do (#302): 0 no drain there,
    // 1 it opens into the cavity, 2 it does not reach it (left out), 3 not
    // known yet (the cavity is not computed), 4 it opens, shorter than its
    // set depth, which would reach the cavity's far side (#316).
    in property <int> hollow-drain-reach: 0;
    property <bool> drain-misses: root.workspace-section == WorkspaceSection.Hollow
        && root.hollow-drain-tool && root.hollow-drain-reach == 2;
    // Show the cavity the current settings carve, over the selected model.
    in-out property <bool> hollow-show-cavity: true;
    in property <float> hollow-wall: 2;
    // The wall the selected model's size calls for (HollowRun).
    in property <float> hollow-recommended-wall: 2;
    in property <float> hollow-voxel: 0.65;
    in property <int> hollow-fill-index: 0;
    in property <float> hollow-cell: 6;
    in property <float> hollow-beam: 0.8;
    in property <float> hollow-drain-radius: 1.5;
    // The drain tool's shape: a set depth (#316), a cone (#317), a plug (#318).
    in property <bool> hollow-drain-depth-set: false;
    in property <float> hollow-drain-depth: 3;
    in property <bool> hollow-drain-cone: false;
    in property <float> hollow-drain-inner-radius: 1;
    in property <bool> hollow-drain-plug: false;
    in property <float> hollow-plug-clearance: 0.1;
    callback hollow-apply();
    callback hollow-cancel();
    callback hollow-restore();
    callback hollow-clear-drains();
    callback hollow-remove-last-solid();
    callback hollow-clear-solids();
    callback hollow-option-changed(int, float);
    callback hollow-drain-clicked(float, float, float, float, float, float);
    // The held slice's estimate (the printer file's own figures), or why
    // there is none.
    in property <bool> slice-estimate-valid: false;
    in property <string> slice-estimate-time;
    in property <string> slice-estimate-volume;
    in property <string> slice-estimate-mass;
    in property <string> slice-estimate-note;
    // The Review card of the Slice tab (#90), driven by Rust
    // (`review_panel`): see `SliceInspector` for the meaning of each.
    in property <int> review-state: 0;
    in property <string> review-summary;
    in property <int> review-worst: -1;
    in property <[ReviewRow]> review-rows: [];
    in property <bool> review-stale: false;
    in property <string> review-message;
    in-out property <int> review-selected: -1;
    in property <int> review-notes;
    in property <bool> review-notes-open;
    in property <int> review-fill-small;
    in property <string> review-fills-note;
    in property <bool> review-fills-clearable;
    in property <string> review-fills-clear-label;
    in property <int> review-fix-all;
    // Fix All placing its supports off the UI thread (#390): how far, and
    // what it is doing.
    in property <bool> review-fixing;
    in property <float> review-fix-progress;
    in property <string> review-fix-phase;
    // "Repeat until clean" next to Fix all (#163): the setting, and a click
    // on its box.
    in property <bool> review-fix-repeat;
    callback review-fix-repeat-toggled(bool);
    callback review-finding-clicked(int);
    callback review-fix-requested(int);
    callback review-fill-toggled(int);
    callback review-leave-requested(int);
    callback review-fill-small-requested();
    callback review-fills-cleared();
    callback review-notes-toggled();
    callback review-fix-all-requested();
    callback review-fix-all-cancel();
    // The second fix of a model inside the raft: turn the raft off (#131).
    callback review-raft-off-requested(int);
    // The Slice tab shows the layer image beside the 3D view (BS-72).
    in-out property <bool> slice-split: false;
    // The L key opens and closes the pane: on the Slice tab with layers to
    // show, unless a field is taking the letter or something modal is up.
    property <bool> layer-key-on: root.has-scene && root.workspace-section == WorkspaceSection.Slice
        && root.slice-layer-count > 0 && !TextInputInterface.text-input-focused
        && !root.message-open && !start-layer.visible && !root.loading
        && !root.slicing-in-progress && !root.saving-in-progress && !root.modal-transform-active;
    callback support-preset-picked(int);
    callback support-preset-save(string);
    callback support-preset-delete();
    in property <string> axis-guide-commands: "";
    in property <brush> axis-guide-color: #ffffff;
    // Slice control panel picker models and selection, driven by Rust.
    // Each list is the union of the global favourites, the global
    // default, and the scene's current choice; `*-current-index` is the
    // selected entry in the matching options model, or -1 when none is
    // selected.
    in property <[string]> slice-printer-options: [];
    in-out property <int> slice-printer-current-index: -1;
    in property <[string]> slice-resin-options: [];
    in-out property <int> slice-resin-current-index: -1;
    in property <[string]> slice-print-format-options: [];
    in-out property <int> slice-print-format-current-index: -1;
    in property <string> slice-print-format-note;
    in property <bool> slice-export-enabled: false;
    in-out property <string> slice-first-layer-height-text;
    // Slice run state, driving the Slice button's disabled state and the
    // input-capturing progress modal. `slicing-in-progress` is set by the
    // Rust driver when a slice starts and cleared on every exit path.
    in-out property <bool> slicing-in-progress: false;
    // The Fix All pass a slice is for (#163), under the modal's title;
    // empty for any other slice.
    in property <string> slice-fix-pass;
    // Repair run state: set by the Rust driver when a repair starts
    // and cleared on every exit path. Gates the Repair button and
    // undo/redo (an undo landing mid-run would invalidate the
    // worker's result).
    in-out property <bool> repairing-in-progress: false;
    // The run's step and how far it is, polled from Rust (#253); and whether
    // the viewport marks what a run left broken.
    in property <string> repair-phase;
    in property <float> repair-progress;
    in property <bool> repair-marks-available;
    in property <bool> repair-marks-shown;
    // The overhang map (#91): its box, and the angle it paints by, as text.
    in-out property <bool> overhang-map-on;
    in property <string> overhang-map-limit;

    // support-generatoin run state (Menu: Tools > Generate Support (trivial for test)):
    // set when the job is submitted and cleared on
    // completion, error, or submission failure. `support-gen-phase` /
    // `support-gen-progress` are polled from Rust while it is true.
    in-out property <bool> support-gen-in-progress: false;
    in property <string> support-gen-phase: "";
    in property <float> support-gen-progress: 0.0;
    // Whether the run in progress can be stopped from its panel (the
    // DragonFruit generator can; the trivial one cannot).
    in property <bool> support-gen-cancelable: false;

    in property <int> slice-completed: 0;
    // Raised once every layer is cut, while the slice is reviewed.
    in property <bool> slice-reviewing: false;
    in property <int> slice-total: 0;
    in property <float> slice-progress: 0.0;
    // Raised by the Rust driver after a Slice press whose inputs already
    // match the held slice, then lowered again after a short delay; shows
    // the transient "already up to date" hint in the Slice panel.
    in property <bool> slice-up-to-date: false;
    // What Slice every plate did, line by line, until the next slice (#547).
    in property <string> slice-every-plate-note;
    // Slice control panel geometry (per-window live state). Same
    // anchor/offset model as the object-list panel; the defaults hug the
    // top-left corner, clear of the top-right object-list panel. Height
    // 0px auto-sizes to the content.
    in-out property <bool> slice-panel-anchor-right: false;
    in-out property <bool> slice-panel-anchor-bottom: false;
    in-out property <length> slice-panel-offset-x: 12px;
    in-out property <length> slice-panel-offset-y: 12px;
    in-out property <length> slice-panel-width: 240px;
    in-out property <length> slice-panel-height: 0px;
    // Slice viewing (per-layer height slider). `slice-layer-count` is the
    // held slice's layer count, driven by Rust: 0 disables the slider, a
    // positive n sizes it to indices 0..n-1. `selected-layer-index` is the
    // slider's current layer (a `float` so it can two-way bind to the
    // Slider's value; it only ever holds whole layer numbers, which Rust
    // rounds when it reads them).
    in property <int> slice-layer-count: 0;
    in-out property <float> selected-layer-index: 0;
    // Floating slice-view panel: shows the selected layer's 2D cross-
    // section. Toggled from the View menu (`show-slice-view`) on top of
    // the section/slice gate. Geometry is persisted per window with the
    // same anchor/offset model as the object-list panel; the defaults
    // hug the bottom-left corner, clear of the other panels. Height 0px
    // auto-sizes. `slice-view-image` is the cross-section pushed by Rust.
    in-out property <bool> show-slice-view: true;
    in-out property <bool> slice-view-anchor-right: false;
    in-out property <bool> slice-view-anchor-bottom: true;
    in-out property <length> slice-view-offset-x: 12px;
    in-out property <length> slice-view-offset-y: 12px;
    in-out property <length> slice-view-width: 240px;
    in-out property <length> slice-view-height: 0px;
    in-out property <bool> slice-view-minimized: false;
    in property <image> slice-view-image;

    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    callback open-file-requested();
    // File > Import model (#384): models join the scene.
    callback import-model-requested();
    callback close-current-scene();
    // File > Clear Scene: the scene goes, the window stays, empty.
    callback clear-current-scene();
    callback save-requested();
    callback save-as-requested();
    // Projects are .bread for now (#439): no menu reaches this one.
    callback save-as-3mf-requested();
    callback previous-versions-requested();
    callback export-as-requested();
    callback scene-load-finished();
    callback import-notes-requested();
    callback show-about-requested();
    // Help > Export Diagnostics (#74).
    callback export-diagnostics-requested();
    // The top bar's links to support the project; Rust opens the page.
    callback support-page-requested(SupportPage);
    callback show-preferences-requested();
    callback new-window-requested();
    // Requests the persisted menu layout be switched to the given value.
    // Rust routes it through the preferences bus so every window and the
    // settings file stay in sync.
    callback menu-layout-change-requested(MenuLayout);
    // Requests a workspace-section switch from the pill switcher. Rust
    // updates the per-window section state and pushes it back into
    // `workspace-section`.
    callback section-change-requested(WorkspaceSection);
    // Reports the object-list panel's new visibility so Rust can persist
    // it. Per-window live state: the settings file records the last
    // value but other open windows keep their own panel visibility.
    callback object-list-visibility-changed(bool);
    // Reports the panel's geometry (anchor-right, anchor-bottom,
    // offset-x, offset-y, width, height, minimized) after a drag,
    // resize, or minimize so Rust can persist it. Also per-window live
    // state.
    callback object-list-geometry-changed(bool, bool, length, length, length, length, bool);
    // A printer/resin pick from the Slice control panel; carries the
    // picked option's index into the matching options model.
    callback slice-printer-picked(int);
    callback slice-resin-picked(int);
    callback slice-print-format-picked(int);
    callback slice-first-layer-height-edited(string);
    // The Slice panel's export action: write the held slice as the
    // selected printer file.
    callback slice-export-requested();
    // Each plate with models sliced in turn, a file each (#549).
    callback slice-export-every-plate-requested();
    // Each plate with models sliced in turn (#547).
    callback slice-every-plate-requested();
    // Slice lifecycle: `slice-requested` from the panel button starts a
    // run; `slice-cancel-requested` from the modal trips the cancel
    // token; `slice-finished` is invoked from the Rust worker to drain
    // the result on the UI thread.
    callback slice-requested();
    callback slice-cancel-requested();
    callback slice-finished();
    // Reports the Slice control panel's geometry (anchor-right,
    // anchor-bottom, offset-x, offset-y, width, height) after a drag or
    // resize so Rust can persist it. Per-window live state.
    callback slice-panel-geometry-changed(bool, bool, length, length, length, length);
    // Reports the slice-view panel's new visibility so Rust can persist
    // it. Per-window live state, like the object-list panel.
    callback slice-view-visibility-changed(bool);
    // Reports the slice-view panel's geometry (anchor-right,
    // anchor-bottom, offset-x, offset-y, width, height, minimized) after
    // a drag, resize, or minimize so Rust can persist it.
    callback slice-view-geometry-changed(bool, bool, length, length, length, length, bool);
    // The slice height slider moved: Rust repaints so the mesh clip
    // follows the selected layer.
    callback selected-layer-changed();
    // The layer keys of the Slice tab (#501): Up (1) or Down (-1) pressed or
    // repeated while held, with Shift or not; let go; Shift down or up; Home
    // (false) or End (true).
    callback layer-key-pressed(direction: int, shift: bool);
    callback layer-key-released(direction: int);
    callback layer-key-shift(down: bool);
    callback layer-key-jump(to-last: bool);
    callback viewport-resized(length, length);
    callback rotate-drag(length, length);
    callback orbit-begin(length, length);
    callback orbit-end();
    callback orbit-step(int, int);
    in property <bool> orbit-pivot-visible: false;
    in property <length> orbit-pivot-x;
    in property <length> orbit-pivot-y;
    in property <bool> orbit-pivot-edge: false;
    in property <float> orbit-pivot-toward;
    callback pan-drag(length, length);
    callback zoom-at(length, length, length);
    in property <bool> orthographic-view: false;
    callback toggle-projection-requested();
    callback frame-selected-requested();
    callback frame-view-requested();
    callback axis-view-requested(AxisView);
    callback object-list-selection-changed(int);
    // Shift+click or Ctrl+click on a row: it joins the selection or leaves it.
    callback object-list-toggle(int);
    callback viewport-pointer-down(length, length, PointerModifiers);
    callback viewport-pointer-move(length, length, PointerModifiers);
    callback viewport-pointer-up(length, length, PointerModifiers);
    callback selection-cleared();
    callback undo-requested();
    callback redo-requested();
    callback repair-requested();
    callback repair-finished();
    callback repair-cancel();
    callback repair-marks-toggled(bool);
    callback overhang-map-toggled(bool);
    // Arrange (#180), the Transform tab's Arrange card: a run in flight, what
    // the last one did, and the card's settings (Rust keeps them).
    in property <bool> arranging: false;
    in property <string> arrange-last-run;
    in property <float> arrange-gap: 1;
    in property <float> arrange-margin: 5;
    in property <bool> arrange-turns: true;
    in property <bool> arrange-shadow-only: false;
    // Fill bed (#356): a fill in flight (`arranging` is set too), its count
    // so far, and at most how many copies it adds (0: as many as fit).
    in property <bool> arrange-filling: false;
    in property <string> arrange-fill-progress;
    in property <float> arrange-max-copies: 0;
    // Arrange all (false) or the selection (true).
    callback arrange-requested(bool);
    // The scene's plates (#545): how many, the active one (from 0) and
    // whether a model stands on it.
    in property <int> plate-count: 1;
    in property <int> active-plate: 0;
    in property <bool> active-plate-used;
    // The plates' names, with several (#547).
    in property <[string]> plate-names;
    // A plate picked in the Slice card (#547): it becomes the active one.
    callback plate-picked(int);
    // The selection sent to another plate (#549).
    callback plate-send-requested(int);
    callback plate-add-requested();
    // With the models on it (Shift on the plate's tool) or not.
    callback plate-remove-requested(bool);
    // The Arrange tool of the active plate, drawn on its rim (#545).
    callback plate-arrange-requested();
    // A plate's name being edited where it lies on the plate (#545): the keys
    // go to a hidden field, the name shows on the plate as it is typed.
    in-out property <string> plate-name-text;
    // The text, the byte the caret stands at and the byte the selection's
    // other end stands at (the caret's own when nothing is selected).
    callback plate-name-edited(string, int, int);
    // Done: kept (Enter, or the field left) or not (Escape).
    callback plate-name-done(bool);
    public function focus-plate-name(anchor: int, caret: int) {
        plate-name-input.focus();
        plate-name-input.set-selection-offsets(anchor, caret);
    }
    public function end-plate-name() {
        mv.focus-viewport();
    }
    callback arrange-fill-requested();
    callback arrange-finished();
    callback arrange-cancel();
    callback arrange-option-changed(int, float);
    // Orient (#182), the Transform tab's auto-orient tool: whether it is
    // open, a search in flight, the options found and the tool's settings
    // (Rust keeps them; see `orient_run.rs`).
    in property <bool> orient-open: false;
    // Cut (#56), the Transform tab's plane cut (Rust keeps it; see
    // `cut_run.rs`).
    in property <bool> cut-open: false;
    in property <bool> cut-working: false;
    in property <float> cut-height: 0;
    in property <float> cut-height-min: 0;
    in property <float> cut-height-max: 100;
    in property <float> cut-tilt-x: 0;
    in property <float> cut-tilt-y: 0;
    in property <bool> cut-bounded: false;
    in property <float> cut-width: 20;
    in property <float> cut-depth: 20;
    in property <float> cut-offset-u: 0;
    in property <float> cut-offset-v: 0;
    in property <string> cut-status;
    in property <string> cut-warning;
    in property <bool> cut-can-cut: false;
    // Opens the tool, or closes it when open (the rail button, K).
    callback cut-toggle-requested();
    callback cut-close-requested();
    callback cut-option-changed(int, float);
    callback cut-apply();
    // A worker of the tool finished.
    callback cut-worked();
    in property <bool> orient-running: false;
    // 0 preparing the model, 1 searching, 2 refining, 3 judging the best.
    in property <int> orient-phase: 0;
    in property <float> orient-progress: 0;
    in property <int> orient-preset: 0;
    in property <float> orient-max-tilt: 180;
    in property <bool> orient-align: false;
    in property <float> orient-weight-supports: 100;
    in property <float> orient-weight-force: 100;
    in property <float> orient-weight-height: 100;
    in property <[OrientOption]> orient-options;
    in property <int> orient-selected: -1;
    in property <string> orient-current;
    in property <string> orient-status;
    in property <string> orient-warning;
    in property <bool> orient-offer-arrange: false;
    // The protect-detail brush (#184).
    in property <bool> orient-brush-on: false;
    in property <float> orient-brush-size: 3;
    in property <bool> orient-brush-erase: false;
    in property <bool> orient-brush-visible-only: true;
    in property <string> orient-painted;
    callback orient-brush-toggled();
    callback orient-brush-size-changed(float);
    // [ and ]: true for a bigger brush.
    callback orient-brush-step(bool);
    callback orient-brush-erase-toggled();
    callback orient-brush-visible-changed(bool);
    // 0 grow, 1 shrink, 2 invert, 3 clear all.
    callback orient-brush-op(int);
    // Esc: drops a stroke, else leaves the brush. Whether it did anything.
    callback orient-brush-escape() -> bool;
    // Opens the tool, or closes it when open (the rail button, O, Auto-orient).
    callback orient-toggle-requested();
    // Closes the tool, putting back a pose an option shows.
    callback orient-close-requested();
    // 0 Quick, 1 Full.
    callback orient-search(int);
    callback orient-cancel();
    callback orient-finished();
    // 0 preset, 1 max tilt, 2 align (0/1), 3-5 term weights (%).
    callback orient-option-changed(int, float);
    callback orient-option-hovered(int, bool);
    callback orient-option-picked(int);
    callback orient-apply();
    // Tools > Generate Support (trivial): runs `sc-geom`'s
    // support-generation trivial (stub) algorithm end to end against the loaded scene.
    // Each generated component (mesh) is pasted into the scene as a real object (see
    // `support-gen-in-progress` above) and the run is reported through
    // an info dialog. It is for end-to-end testing of integration.
    // N ot a real support-generation feature yet.
    // It proves the crate's interface works inside the GUI.

    callback support-gen-requested();
    // Tools > Generate Supports (DragonFruit): the native port of
    // DragonFruit's auto-support (islands, placement, bracing, raft), run on
    // the scene as a cancellable job. The supports and raft are pasted as one
    // undoable object. Shares the progress panel above.
    callback df-support-requested();
    callback support-gen-cancel-requested();
    in property <bool> modal-transform-active: false;
    in property <string> modal-transform-status: "";
    callback modal-transform-start(int, length, length);
    callback modal-transform-axis(int, length, length);
    callback modal-transform-finish(bool);
    in property <bool> gizmo-keyboard-focus-active: false;
    callback gizmo-focus-translate-pressed();
    callback gizmo-focus-rotate-pressed();
    callback gizmo-focus-scale-pressed();
    // The focused gizmo style (#274): the rail's Move, Rotate and Scale pick
    // which handles show; the button of the tool in use stays lit.
    in property <bool> gizmo-focused-style: false;
    in property <int> gizmo-tool: 0;
    callback gizmo-arrow-pressed(int);
    callback gizmo-arrow-released(int);
    // Tab / Shift+Tab selection cycling, the property gates whether
    // the viewport's FocusScope accepts Tab or lets it fall through
    // to native focus traversal. True iff a scene with at least one
    // object is loaded.
    callback selection-cycle(int);
    // Copy / paste: forwarded from the embedded MeshViewer's
    // `Ctrl+C` / `Ctrl+V` handler. The Rust wiring layer routes
    // these to the app-wide clipboard so a copy in one window is
    // pasteable in any other.
    callback copy-pressed();
    callback paste-pressed();
    // Cursor left the viewport rectangle. The Rust paste path
    // clears its cached hover-cursor on this event so a subsequent
    // `Ctrl+V` falls back to the viewport-centre placement.
    callback viewport-pointer-leave();
    // Right-click context menu. `show-context-menu` is invoked
    // from Rust after the right-click is classified as a click
    // (not an orbit drag); it forwards the call into the embedded
    // MeshViewer which positions and shows the PopupWindow.
    // `context-copy-pressed` / `context-paste-pressed` surface the
    // menu-item activations so the Rust wiring can route them to
    // the AppState clipboard methods.
    callback show-context-menu(length, length, bool, bool, bool);
    show-context-menu(x, y, copy, paste, del) => {
        mv.show-context-menu(x, y, copy, paste, del);
    }
    callback context-copy-pressed();
    callback context-paste-pressed(length, length);
    // Single Delete callback shared by the Delete key, the
    // context-menu Delete item, and the Edit > Delete menu item.
    callback delete-requested();
    // Edit > Split into Bodies and Keep Only This Body (#257).
    callback split-bodies-requested();
    callback keep-only-body-requested();
    // Whether the selected object came from a split that left other bodies.
    in property <bool> can-keep-only-body: false;
    // Right-button press / release positions for the context-menu
    // click-vs-orbit classifier on the Rust side.
    callback viewport-right-pointer-down(length, length);
    callback viewport-right-pointer-up(length, length);

    MenuBar {
        // In Compact layout the bar is hidden; it stays mounted so its
        // shortcuts keep firing (a hidden MenuBar reclaims its space but
        // still registers accelerators). macOS always resolves to Bar in
        // Rust, so the bar is never hidden there.
        visible: root.menu-layout == MenuLayout.Bar;

        Menu {
            title: @tr("MenuBar" => "File");

            MenuItem {
                title: @tr("MenuBar" => "New Window");
                shortcut: @keys(Control + Shift + N);
                activated => {
                    root.new-window-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Open project…");
                shortcut: @keys(Control + O);
                enabled: !root.loading;
                activated => {
                    root.open-file-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Import model…");
                shortcut: @keys(Control + I);
                enabled: !root.loading;
                activated => {
                    root.import-model-requested();
                }
            }
            // TODO: "Open Recent"
            MenuItem {
                title: @tr("MenuBar" => "Close");
                shortcut: @keys(Control + W);
                enabled: root.loading || root.has-scene;
                activated => {
                    root.close-current-scene();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Clear Scene");
                enabled: root.loading || root.has-scene;
                activated => {
                    root.clear-current-scene();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Save");
                shortcut: @keys(Control + S);
                enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                activated => {
                    root.save-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Save As…");
                shortcut: @keys(Control + Shift + S);
                enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                activated => {
                    root.save-as-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Previous Versions…");
                enabled: root.has-versions && !root.loading && !root.saving-in-progress;
                activated => {
                    root.previous-versions-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Export As…");
                shortcut: @keys(Control + Shift + E);
                enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                activated => {
                    root.export-as-requested();
                }
            }
        }

        Menu {
            title: @tr("MenuBar" => "Edit");
            MenuItem {
                title: @tr("MenuBar" => "Undo");
                shortcut: @keys(Control + Z);
                enabled: root.has-scene && !root.loading && root.can-undo
                    && !root.repairing-in-progress
                    && root.history-allowed;
                activated => {
                    root.undo-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Redo");
                shortcut: @keys(Control + Shift + Z);
                enabled: root.has-scene && !root.loading && root.can-redo
                    && !root.repairing-in-progress
                    && root.history-allowed;
                activated => {
                    root.redo-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Delete");
                enabled: root.has-scene && !root.loading && root.selected-object-index != -1
                    && (root.workspace-section == WorkspaceSection.Transform
                        || root.workspace-section == WorkspaceSection.Supports);
                activated => {
                    root.delete-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Split into Bodies");
                enabled: root.has-scene && !root.loading && root.selected-object-index != -1
                && root.workspace-section == WorkspaceSection.Transform && !root.repairing-in-progress;
                activated => {
                    root.split-bodies-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Keep Only This Body");
                enabled: root.has-scene && !root.loading && root.can-keep-only-body
                && root.workspace-section == WorkspaceSection.Transform && !root.repairing-in-progress;
                activated => {
                    root.keep-only-body-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Preferences");
                shortcut: @keys(Control + Comma);
                activated => {
                    root.show-preferences-requested();
                }
            }
        }

        Menu {
            title: @tr("MenuBar" => "Tools");

            MenuItem {
                title: @tr("MenuBar" => "Generate Supports (DragonFruit)…");
                enabled: root.has-scene && !root.loading && !root.support-gen-in-progress;
                activated => {
                    root.df-support-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "Generate Support (trivial for test)…");
                enabled: root.has-scene && !root.loading && !root.support-gen-in-progress;
                activated => {
                    root.support-gen-requested();
                }
            }
        }

        Menu {
            title: @tr("MenuBar" => "View");

            // The L key's home: a shortcut of the window works wherever the
            // focus is, and is off while a field takes the letter.
            MenuItem {
                title: @tr("LayerView" => "Layer view");
                checkable: true;
                checked: root.slice-split;
                enabled: root.layer-key-on;
                shortcut: @keys(L);
                activated => {
                    root.slice-split = !root.slice-split;
                }
            }

            MenuSeparator { }

            // Switches between the top menu bar and the compact corner
            // menu button. Title flips like the object-list toggle above.
            // Disabled on macOS, which keeps its global menu bar.
            MenuItem {
                title: root.menu-layout == MenuLayout.Compact
                    ? @tr("MenuBar" => "Show Menu Bar")
                    : @tr("MenuBar" => "Hide Menu Bar");
                enabled: !root.is-macos;
                activated => {
                    root.menu-layout-change-requested(
                        root.menu-layout == MenuLayout.Compact
                            ? MenuLayout.Bar
                            : MenuLayout.Compact);
                }
            }

            MenuSeparator { }

            // Two-way bound to the window's full-screen state: the
            // checkable item's built-in toggle flips full-screen, and
            // OS-driven changes (for example the macOS green button)
            // flow back into the checkmark. The MenuBar is an isolation
            // boundary, so this reads root from inside the item.
            MenuItem {
                title: @tr("MenuBar" => "Fullscreen");
                checkable: true;
                checked <=> root.full-screen;
                shortcut: root.is-macos
                    ? @keys(Control + Meta + F)
                    : @keys(F11);
            }
        }

        Menu {
            title: @tr("MenuBar" => "Help");
            MenuItem {
                title: @tr("MenuBar" => "Documentation");
                enabled: false;
            }

            MenuItem {
                title: @tr("MenuBar" => "Show Release Notes");
                enabled: false;
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Report Issue");
                enabled: false;
            }

            MenuItem {
                title: @tr("MenuBar" => "Export Diagnostics…");
                activated => {
                    root.export-diagnostics-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "Check for Updates…");
                enabled: false;
            }

            MenuSeparator { }

            MenuItem {
                title: @tr("MenuBar" => "About");
                activated => {
                    root.show-about-requested();
                }
            }

            MenuItem {
                title: @tr("MenuBar" => "View License");
                enabled: false;
            }
        }
    }

    // The Slice tab walks the layers with the keyboard (#501), wherever the
    // focus is in the workspace: the window takes Up, Down, Home and End
    // before the view, the slider or a button does, unless a field takes
    // them or something modal is up. The pace of a key held is the app's.
    layer-keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (!root.layer-key-on) {
                return reject;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.layer-key-pressed(event.text == Key.UpArrow ? 1 : -1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Home || event.text == Key.End) {
                if (!event.repeat) {
                    root.layer-key-jump(event.text == Key.End);
                }
                return accept;
            }
            if (event.text == Key.Shift) {
                root.layer-key-shift(true);
            }
            return reject;
        }
        capture-key-released(event) => {
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                root.layer-key-released(event.text == Key.UpArrow ? 1 : -1);
            }
            if (event.text == Key.Shift) {
                root.layer-key-shift(false);
            }
            return reject;
        }

    // The workspace (BS-68): the top bar with the workflow tabs, the tool
    // rail, the viewport, the inspector of the active tab and the status
    // bar. Rust stays the source of truth for the active tab: a tab click
    // only requests the change.
        VerticalLayout {
            spacing: 0px;

            // Top bar.
            Rectangle {
                height: Theme.topbar-height;
                background: Theme.chrome;

                // With the app's own title bar, what of the bar holds no
                // control drags the window; a double click maximises it.
                if root.custom-chrome: TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            root.window-drag();
                        }
                    }
                    double-clicked => {
                        root.window-maximize-toggle();
                    }
                }

                HorizontalLayout {
                    // Room for the compact menu button in its corner.
                    padding-left: root.menu-layout == MenuLayout.Compact ? 48px : 12px;
                    padding-right: root.custom-chrome ? 0px : 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        min-width: 240px;
                        spacing: 10px;
                        alignment: start;

                        Image {
                            source: @image-url("../assets/images/breadslicer.png");
                            width: 22px;
                            height: 22px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Breadslicer";
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        if root.document-name != "": Text {
                            text: "/";
                            color: Theme.border-strong;
                            vertical-alignment: center;
                        }
                        if root.document-name != "": Text {
                            text: root.document-name;
                            color: Theme.text-soft;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 260px;
                        }
                        if root.scene-dirty: Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: Theme.brand;
                        }
                    }

                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        WorkflowTab {
                            number: "1";
                            label: @tr("Workspace" => "Transform");
                            active: root.workspace-section == WorkspaceSection.Transform;
                            enabled: root.has-scene;
                            dot: root.mesh-needs-repair ? Theme.warning : transparent;
                            clicked => {
                                root.section-change-requested(WorkspaceSection.Transform);
                            }
                        }
                        Rectangle {
                            width: 1px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.border;
                        }
                        WorkflowTab {
                            number: "2";
                            label: @tr("Workspace" => "Hollow");
                            active: root.workspace-section == WorkspaceSection.Hollow;
                            enabled: root.has-scene;
                            clicked => {
                                root.section-change-requested(WorkspaceSection.Hollow);
                            }
                        }
                        Text {
                            text: "/";
                            color: Theme.border-strong;
                            vertical-alignment: center;
                        }
                        WorkflowTab {
                            number: "3";
                            label: @tr("Workspace" => "Supports");
                            active: root.workspace-section == WorkspaceSection.Supports;
                            enabled: root.has-scene;
                            clicked => {
                                root.section-change-requested(WorkspaceSection.Supports);
                            }
                        }
                        Rectangle {
                            width: 1px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            background: Theme.border;
                        }
                        WorkflowTab {
                            number: "4";
                            label: @tr("Workspace" => "Slice");
                            active: root.workspace-section == WorkspaceSection.Slice;
                            enabled: root.has-scene;
                            dot: root.slice-layer-count > 0 ? Theme.success : transparent;
                            clicked => {
                                root.section-change-requested(WorkspaceSection.Slice);
                            }
                        }
                        WorkflowTab {
                            number: "5";
                            label: @tr("Workspace" => "Export");
                            active: root.workspace-section == WorkspaceSection.Export;
                            enabled: root.has-scene;
                            clicked => {
                                root.section-change-requested(WorkspaceSection.Export);
                            }
                        }
                    }

                    HorizontalLayout {
                        min-width: 240px;
                        spacing: 4px;
                        alignment: end;

                        SupportLink {
                            label: @tr("Support us on Patreon");
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.support-page-requested(SupportPage.Patreon);
                            }
                        }
                        SupportLink {
                            label: @tr("Support us on Ko-fi");
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.support-page-requested(SupportPage.KoFi);
                            }
                        }
                        Rectangle { width: 8px; }
                        Text {
                            text: root.slice-printer-current-index >= 0
                                ? root.slice-printer-options[root.slice-printer-current-index]
                                : @tr("Workspace" => "No printer");
                            color: Theme.text-muted;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 200px;
                        }
                        ToolButton {
                            icon: Icons.undo;
                            label: @tr("MenuBar" => "Undo");
                            enabled: root.has-scene && !root.loading && root.can-undo
                                && !root.repairing-in-progress && root.history-allowed;
                            clicked => {
                                root.undo-requested();
                            }
                        }
                        ToolButton {
                            icon: Icons.redo;
                            label: @tr("MenuBar" => "Redo");
                            enabled: root.has-scene && !root.loading && root.can-redo
                                && !root.repairing-in-progress && root.history-allowed;
                            clicked => {
                                root.redo-requested();
                            }
                        }
                        if root.custom-chrome: Rectangle {
                            width: 9px;
                        }
                        if root.custom-chrome: CaptionButton {
                            kind: CaptionKind.minimize;
                            label: @tr("Workspace" => "Minimize");
                            clicked => {
                                root.window-minimize();
                            }
                        }
                        if root.custom-chrome: CaptionButton {
                            kind: root.window-maximized ? CaptionKind.restore : CaptionKind.maximize;
                            label: root.window-maximized ? @tr("Workspace" => "Restore") : @tr("Workspace" => "Maximize");
                            clicked => {
                                root.window-maximize-toggle();
                            }
                        }
                        if root.custom-chrome: CaptionButton {
                            kind: CaptionKind.close;
                            label: @tr("Workspace" => "Close");
                            clicked => {
                                root.window-close();
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Tool rail: the active tab's tools.
                Rectangle {
                    width: Theme.rail-width;
                    background: Theme.chrome;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;

                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.move;
                            label: @tr("Inspector" => "Move");
                            shortcut: "G";
                            active: root.gizmo-focused-style && root.gizmo-tool == 0;
                            enabled: root.has-scene && root.selected-object-index >= 0;
                            clicked => {
                                root.orient-close-requested();
                                root.gizmo-focus-translate-pressed();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.rotate;
                            label: @tr("Inspector" => "Rotate");
                            shortcut: "R";
                            active: root.gizmo-focused-style && root.gizmo-tool == 1;
                            enabled: root.has-scene && root.selected-object-index >= 0;
                            clicked => {
                                root.orient-close-requested();
                                root.gizmo-focus-rotate-pressed();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.scale;
                            label: @tr("Inspector" => "Scale");
                            shortcut: "S";
                            active: root.gizmo-focused-style && root.gizmo-tool == 2;
                            enabled: root.has-scene && root.selected-object-index >= 0;
                            clicked => {
                                root.orient-close-requested();
                                root.gizmo-focus-scale-pressed();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.orient;
                            label: @tr("Inspector" => "Orient: the best way up for printing");
                            shortcut: "O";
                            active: root.orient-open;
                            enabled: root.has-scene && root.selection-valid;
                            clicked => {
                                root.cut-close-requested();
                                root.orient-toggle-requested();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.cut;
                            label: @tr("Inspector" => "Cut with a plane");
                            shortcut: "K";
                            active: root.cut-open;
                            enabled: root.has-scene && root.selection-valid;
                            clicked => {
                                root.orient-close-requested();
                                root.cut-toggle-requested();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: Rectangle {
                            height: 9px;
                            Rectangle {
                                width: 28px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Transform: ToolButton {
                            icon: Icons.repair;
                            label: @tr("Inspector" => "Repair meshes");
                            active: root.mesh-needs-repair;
                            enabled: root.has-scene && !root.loading && !root.slicing-in-progress
                                && !root.repairing-in-progress;
                            clicked => {
                                root.repair-requested();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Hollow: ToolButton {
                            icon: Icons.hollow;
                            label: @tr("Workspace" => "Hollow");
                            shortcut: "H";
                            active: true;
                            enabled: false;
                        }
                        if root.workspace-section == WorkspaceSection.Hollow: ToolButton {
                            icon: Icons.hole;
                            label: @tr("Inspector" => "Drain holes");
                            shortcut: "D";
                            enabled: false;
                        }
                        if root.workspace-section == WorkspaceSection.Supports: ToolButton {
                            icon: Icons.auto;
                            label: @tr("Inspector" => "Generate supports");
                            shortcut: "U";
                            active: true;
                            enabled: root.has-scene && !root.loading && !root.support-gen-in-progress;
                            clicked => {
                                root.df-support-requested();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Slice: ToolButton {
                            icon: Icons.slice;
                            label: @tr("SlicePanel" => "Slice");
                            active: true;
                            enabled: root.slice-printer-current-index >= 0
                                && root.slice-resin-current-index >= 0 && !root.slicing-in-progress;
                            clicked => {
                                root.slice-requested();
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Slice: ToolButton {
                            icon: Icons.layers;
                            label: root.slice-layer-count > 0
                                ? @tr("LayerView" => "Layer view: the layer's image beside the 3D view")
                                : @tr("LayerView" => "Layer view: slice first to see each layer's image");
                            shortcut: "L";
                            active: root.slice-split && root.slice-layer-count > 0;
                            enabled: root.slice-layer-count > 0;
                            clicked => {
                                root.slice-split = !root.slice-split;
                            }
                        }
                        if root.workspace-section == WorkspaceSection.Export: ToolButton {
                            icon: Icons.file;
                            label: root.plate-count > 1
                                ? @tr("SlicePanel" => "Export “{}”", root.plate-names[root.active-plate])
                                : @tr("SlicePanel" => "Export for printer");
                            active: true;
                            enabled: root.slice-export-enabled && !root.slicing-in-progress
                                && !root.saving-in-progress;
                            clicked => {
                                root.slice-export-requested();
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border;
                    }
                }

                // Viewport.
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.ground;

                    HorizontalLayout {
                    mv := MeshViewer {
                        horizontal-stretch: 1;
                        rendering: root.mesh-rendering;
                        box-select-armed: root.box-select-armed;
                        placeholder-text: @tr("Open a 3D model to visualize it here");
                        modal-transform-active: root.modal-transform-active;
                        modal-transform-status: root.modal-transform-status;
                        modal-transform-start(code,x,y) => {
                            root.orient-close-requested();
                            root.modal-transform-start(code,x,y);
                        }
                        brush-on: root.workspace-section == WorkspaceSection.Supports && root.support-tool == 2
                            && root.support-remove-mode == 1;
                        brush-radius: root.support-brush-radius * 1px;
                        brush-wheel(up) => {
                            root.support-brush-radius = clamp(root.support-brush-radius + (up ? 4 : -4), 4, 200);
                        }
                        paint-brush-on: root.orient-open && root.orient-brush-on;
                        tool-escape => {
                            if root.support-drag-cancel() {
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Hollow && root.hollow-lasso-tool {
                                root.hollow-lasso-tool = false;
                                return true;
                            }
                            if root.orient-open && root.orient-brush-escape() {
                                return true;
                            }
                            if root.orient-open {
                                root.orient-close-requested();
                                return true;
                            }
                            if root.cut-open {
                                root.cut-close-requested();
                                return true;
                            }
                            return false;
                        }
                        tab-tool-key(key) => {
                            if root.workspace-section == WorkspaceSection.Hollow && root.selection-valid
                                && root.hollow-model-state != 2 && !root.hollow-running && (key == "d" || key == "D") {
                                root.hollow-drain-tool = !root.hollow-drain-tool;
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Hollow && root.selection-valid
                                && root.hollow-model-state != 2 && !root.hollow-running && (key == "m" || key == "M") {
                                root.hollow-lasso-tool = !root.hollow-lasso-tool;
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Supports && root.has-scene
                                && !root.support-gen-in-progress {
                                if key == "a" || key == "A" {
                                    root.arm-support-tool(1);
                                    return true;
                                }
                                if key == "x" || key == "X" {
                                    root.arm-support-tool(2);
                                    return true;
                                }
                                if key == "m" || key == "M" {
                                    root.arm-support-tool(3);
                                    return true;
                                }
                                if key == "c" || key == "C" {
                                    root.arm-support-tool(4);
                                    return true;
                                }
                                // Remove: B a box or a brush; [ and ] the brush.
                                if root.support-tool == 2 && (key == "b" || key == "B") {
                                    root.support-remove-mode = root.support-remove-mode == 1 ? 0 : 1;
                                    return true;
                                }
                                if root.support-tool == 2 && root.support-remove-mode == 1 && (key == "[" || key == "]") {
                                    root.support-brush-radius = clamp(root.support-brush-radius + (key == "]" ? 4 : -4), 4, 200);
                                    return true;
                                }
                                // The tip size while Add is armed; the view keys
                                // otherwise.
                                if root.support-tool == 1 && (key == "1" || key == "2" || key == "3" || key == "4") {
                                    root.support-tip-size = key.to-float();
                                    return true;
                                }
                            }
                            if root.workspace-section == WorkspaceSection.Transform && root.orient-open
                                && root.selection-valid && (key == "b" || key == "B") {
                                root.orient-brush-toggled();
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Transform && root.orient-open
                                && root.orient-brush-on && (key == "[" || key == "]") {
                                root.orient-brush-step(key == "]");
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Transform && root.has-scene
                                && root.selection-valid && (key == "o" || key == "O") {
                                root.cut-close-requested();
                                root.orient-toggle-requested();
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Transform && root.has-scene
                                && root.selection-valid && (key == "k" || key == "K") {
                                root.orient-close-requested();
                                root.cut-toggle-requested();
                                return true;
                            }
                            if root.workspace-section == WorkspaceSection.Transform && root.has-scene
                                && !root.loading && !root.slicing-in-progress && !root.repairing-in-progress
                                && !root.arranging && (key == "a" || key == "A") {
                                root.arrange-requested(false);
                                return true;
                            }
                            return false;
                        }
                        modal-transform-axis(axis,x,y) => { root.modal-transform-axis(axis,x,y); }
                        modal-transform-finish(confirm) => { root.modal-transform-finish(confirm); }
                        gizmo-keyboard-focus-active: root.gizmo-keyboard-focus-active;
                        // Tab cycles selection while a scene is loaded; without a
                        // scene there's nothing to cycle, so Tab returns to its
                        // native role of moving focus through the GUI's
                        // interactive elements.
                        can-cycle-selection: root.has-scene;
                        viewport-resized(w, h) => {
                            root.viewport-resized(w, h);
                        }
                        rotate-drag(dx, dy) => {
                            root.rotate-drag(dx, dy);
                        }
                        orbit-begin(x, y) => {
                            root.orbit-begin(x, y);
                        }
                        orbit-end() => {
                            root.orbit-end();
                        }
                        orbit-step(h, v) => {
                            root.orbit-step(h, v);
                        }
                        orbit-pivot-visible: root.orbit-pivot-visible;
                        orbit-pivot-x: root.orbit-pivot-x;
                        orbit-pivot-y: root.orbit-pivot-y;
                        orbit-pivot-edge: root.orbit-pivot-edge;
                        orbit-pivot-toward: root.orbit-pivot-toward;
                        pan-drag(dx, dy) => {
                            root.pan-drag(dx, dy);
                        }
                        zoom-at(dy, x, y) => {
                            root.zoom-at(dy, x, y);
                        }
                        orthographic-view: root.orthographic-view;
                        toggle-projection-requested() => { root.toggle-projection-requested(); }
                        frame-selected-requested() => { root.frame-selected-requested(); }
                        frame-view-requested() => {
                            root.frame-view-requested();
                        }
                        axis-view-requested(view) => {
                            root.axis-view-requested(view);
                        }
                        viewport-pointer-down(x, y, modifiers) => {
                            root.viewport-pointer-down(x, y, modifiers);
                        }
                        viewport-pointer-move(x, y, modifiers) => {
                            root.viewport-pointer-move(x, y, modifiers);
                        }
                        viewport-pointer-up(x, y, modifiers) => {
                            root.viewport-pointer-up(x, y, modifiers);
                        }
                        selection-cleared() => {
                            root.selection-cleared();
                        }
                        gizmo-focus-translate-pressed() => {
                            root.gizmo-focus-translate-pressed();
                        }
                        gizmo-focus-rotate-pressed() => {
                            root.gizmo-focus-rotate-pressed();
                        }
                        gizmo-focus-scale-pressed() => {
                            root.gizmo-focus-scale-pressed();
                        }
                        gizmo-arrow-pressed(code) => {
                            root.gizmo-arrow-pressed(code);
                        }
                        gizmo-arrow-released(code) => {
                            root.gizmo-arrow-released(code);
                        }
                        selection-cycle(delta) => {
                            root.selection-cycle(delta);
                        }
                        copy-pressed() => {
                            root.copy-pressed();
                        }
                        paste-pressed() => {
                            root.paste-pressed();
                        }
                        viewport-pointer-leave() => {
                            root.viewport-pointer-leave();
                        }
                        context-copy-pressed() => {
                            root.context-copy-pressed();
                        }
                        context-paste-pressed(x, y) => {
                            root.context-paste-pressed(x, y);
                        }
                        delete-requested() => {
                            root.delete-requested();
                        }
                        viewport-right-pointer-down(x, y) => {
                            root.viewport-right-pointer-down(x, y);
                        }
                        viewport-right-pointer-up(x, y) => {
                            root.viewport-right-pointer-up(x, y);
                        }
                    }

                        if root.has-scene && root.workspace-section == WorkspaceSection.Slice
                            && root.slice-split && root.slice-layer-count > 0: LayerView {
                            horizontal-stretch: 1;
                            // The layer slider sits over the pane's right edge.
                            right-gutter: 48px;
                            source: root.slice-view-image;
                            caption: @tr("LayerView" => "Layer {} of {}", Math.round(root.selected-layer-index) + 1, root.slice-layer-count);
                            close-requested => {
                                root.slice-split = false;
                            }
                        }
                    }

                    if root.axis-guide-visible: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: parent.width / 1px;
                        viewbox-height: parent.height / 1px;
                        commands: root.axis-guide-commands;
                        stroke: root.axis-guide-color;
                        stroke-width: 1.5px;
                        fill: transparent;
                    }

                    if root.axis-guide-2-visible: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: parent.width / 1px;
                        viewbox-height: parent.height / 1px;
                        commands: root.axis-guide-2-commands;
                        stroke: root.axis-guide-2-color;
                        stroke-width: 1.5px;
                        fill: transparent;
                    }

                    // The lasso stroke in flight (#179).
                    if root.hollow-lasso-commands != "": Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: parent.width / 1px;
                        viewbox-height: parent.height / 1px;
                        commands: root.hollow-lasso-commands;
                        stroke: Theme.accent;
                        stroke-width: 1.5px;
                        fill: Theme.accent.transparentize(0.85);
                    }

                    if root.move-trail-visible: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: parent.width / 1px;
                        viewbox-height: parent.height / 1px;
                        commands: root.move-trail-commands;
                        stroke: #c9ced2cc;
                        stroke-width: 1.5px;
                        fill: transparent;
                    }

                    if root.move-trail-visible: Rectangle {
                        x: root.move-trail-start-x - 3.5px;
                        y: root.move-trail-start-y - 3.5px;
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: #c9ced2;
                        border-width: 1px;
                        border-color: #0e1011;
                    }

                    if root.gesture-tag != "": Rectangle {
                        x: max(4px, min(root.gesture-tag-x + 4px, parent.width - self.width - 4px));
                        y: max(4px, min(root.gesture-tag-y - self.height / 2, parent.height - self.height - 4px));
                        width: tag-text.preferred-width + 14px;
                        height: 24px;
                        border-radius: 4px;
                        background: #16181af0;
                        border-width: 1px;
                        border-color: #4a5056;

                        tag-text := Text {
                            text: root.gesture-tag;
                            font-family: Theme.mono;
                            font-size: Theme.font-sm;
                            color: #eef0f2;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    if root.gesture-readout != "": Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        width: readout-text.preferred-width + 24px;
                        height: 30px;
                        border-radius: Theme.radius;
                        background: Theme.chrome;
                        border-width: 1px;
                        border-color: Theme.border;

                        readout-text := Text {
                            text: root.gesture-readout;
                            font-family: Theme.mono;
                            font-size: Theme.font;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // Per-layer height slider on the viewport's right edge, in
                    // the Slice tab; disabled until a slice exists. Its value is
                    // the selected layer index, the top layer at the top.
                    if root.has-scene && root.workspace-section == WorkspaceSection.Slice: Rectangle {
                        x: parent.width - self.width - 8px;
                        y: 48px;
                        width: 92px;
                        height: parent.height - 96px;

                        LayerRuler {
                            width: parent.width;
                            height: parent.height;
                            enabled: root.slice-layer-count > 0;
                            count: root.slice-layer-count;
                            value <=> root.selected-layer-index;
                            changed(v) => {
                                root.selected-layer-changed();
                            }
                        }
                    }
                }

                // Inspector.
                Rectangle {
                    width: Theme.inspector-width;
                    background: Theme.panel;

                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.border;
                    }

                    // The Slice tab does not scroll as a whole: its setup, Slice
                    // button and result stay put, and only the review list
                    // scrolls inside it.
                    if root.workspace-section == WorkspaceSection.Slice: VerticalLayout {
                        x: 1px;
                        width: parent.width - 1px;
                        padding: 12px;

                        SliceInspector {
                            plate-options: root.plate-names;
                            plate-current-index: root.active-plate;
                            plate-picked(i) => {
                                root.plate-picked(i);
                            }
                            slice-every-plate => {
                                root.slice-every-plate-requested();
                            }
                            overhang-map-on <=> root.overhang-map-on;
                            overhang-map-limit: root.overhang-map-limit;
                            overhang-map-toggled(on) => {
                                root.overhang-map-toggled(on);
                            }
                            printer-options: root.slice-printer-options;
                            printer-current-index <=> root.slice-printer-current-index;
                            resin-options: root.slice-resin-options;
                            resin-current-index <=> root.slice-resin-current-index;
                            first-layer-height-text <=> root.slice-first-layer-height-text;
                            slicing: root.slicing-in-progress;
                            up-to-date: root.slice-up-to-date;
                            every-plate-note: root.slice-every-plate-note;
                            layer-count: root.slice-layer-count;
                            selected-layer: root.selected-layer-index;
                            layer-image: root.slice-view-image;
                            estimate-valid: root.slice-estimate-valid;
                            estimate-time: root.slice-estimate-time;
                            estimate-volume: root.slice-estimate-volume;
                            estimate-mass: root.slice-estimate-mass;
                            estimate-note: root.slice-estimate-note;
                            review-state: root.review-state;
                            review-summary: root.review-summary;
                            review-worst: root.review-worst;
                            review-rows: root.review-rows;
                            review-stale: root.review-stale;
                            review-message: root.review-message;
                            review-selected <=> root.review-selected;
                            review-notes: root.review-notes;
                            review-notes-open: root.review-notes-open;
                            review-fill-small: root.review-fill-small;
                            review-fills-note: root.review-fills-note;
                            review-fills-clearable: root.review-fills-clearable;
                            review-fills-clear-label: root.review-fills-clear-label;
                            review-fix-all: root.review-fix-all;
                            review-fixing: root.review-fixing;
                            review-fix-progress: root.review-fix-progress;
                            review-fix-phase: root.review-fix-phase;
                            review-fix-repeat: root.review-fix-repeat;
                            review-fix-repeat-toggled(on) => {
                                root.review-fix-repeat-toggled(on);
                            }
                            review-fix-all-requested => {
                                root.review-fix-all-requested();
                            }
                            review-fix-all-cancel => {
                                root.review-fix-all-cancel();
                            }
                            review-fill-toggled(id) => {
                                root.review-fill-toggled(id);
                            }
                            review-leave-requested(id) => {
                                root.review-leave-requested(id);
                            }
                            review-fill-small-requested => {
                                root.review-fill-small-requested();
                            }
                            review-fills-cleared => {
                                root.review-fills-cleared();
                            }
                            review-notes-toggled => {
                                root.review-notes-toggled();
                            }
                            review-finding-clicked(id) => {
                                root.review-finding-clicked(id);
                            }
                            review-fix-requested(id) => {
                                root.review-fix-requested(id);
                            }
                            review-raft-off-requested(id) => {
                                root.review-raft-off-requested(id);
                            }
                            printer-picked(i) => {
                                root.slice-printer-picked(i);
                            }
                            resin-picked(i) => {
                                root.slice-resin-picked(i);
                            }
                            first-layer-height-edited(t) => {
                                root.slice-first-layer-height-edited(t);
                            }
                            slice-requested => {
                                root.slice-requested();
                            }
                        }
                    }

                    if root.workspace-section != WorkspaceSection.Slice: VerticalLayout {
                        x: 1px;
                        width: parent.width - 1px;

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 12px;
                                alignment: start;

                                if root.workspace-section == WorkspaceSection.Transform && root.cut-open: CutCard {
                                    enabled: root.has-scene && root.selection-valid && !root.loading
                                        && !root.slicing-in-progress && !root.repairing-in-progress && !root.arranging;
                                    working: root.cut-working;
                                    plane-height: root.cut-height;
                                    height-min: root.cut-height-min;
                                    height-max: root.cut-height-max;
                                    tilt-x: root.cut-tilt-x;
                                    tilt-y: root.cut-tilt-y;
                                    bounded: root.cut-bounded;
                                    rect-width: root.cut-width;
                                    rect-depth: root.cut-depth;
                                    offset-u: root.cut-offset-u;
                                    offset-v: root.cut-offset-v;
                                    status: root.cut-status;
                                    warning: root.cut-warning;
                                    can-cut: root.cut-can-cut;
                                    option-changed(code, value) => {
                                        root.cut-option-changed(code, value);
                                    }
                                    apply => {
                                        root.cut-apply();
                                    }
                                    close => {
                                        root.cut-close-requested();
                                    }
                                }
                                if root.workspace-section == WorkspaceSection.Transform && root.orient-open: OrientCard {
                                    enabled: root.has-scene && root.selection-valid && !root.loading
                                        && !root.slicing-in-progress && !root.repairing-in-progress && !root.arranging;
                                    running: root.orient-running;
                                    phase: root.orient-phase;
                                    progress: root.orient-progress;
                                    preset: root.orient-preset;
                                    max-tilt: root.orient-max-tilt;
                                    align: root.orient-align;
                                    weight-supports: root.orient-weight-supports;
                                    weight-force: root.orient-weight-force;
                                    weight-height: root.orient-weight-height;
                                    options: root.orient-options;
                                    selected: root.orient-selected;
                                    current: root.orient-current;
                                    status: root.orient-status;
                                    warning: root.orient-warning;
                                    offer-arrange: root.orient-offer-arrange;
                                    brush-on: root.orient-brush-on;
                                    brush-size: root.orient-brush-size;
                                    brush-erase: root.orient-brush-erase;
                                    brush-visible-only: root.orient-brush-visible-only;
                                    painted: root.orient-painted;
                                    brush-toggled => {
                                        root.orient-brush-toggled();
                                    }
                                    brush-size-changed(mm) => {
                                        root.orient-brush-size-changed(mm);
                                    }
                                    brush-erase-toggled => {
                                        root.orient-brush-erase-toggled();
                                    }
                                    brush-visible-changed(on) => {
                                        root.orient-brush-visible-changed(on);
                                    }
                                    brush-op(code) => {
                                        root.orient-brush-op(code);
                                    }
                                    search(mode) => {
                                        root.orient-search(mode);
                                    }
                                    cancel => {
                                        root.orient-cancel();
                                    }
                                    option-changed(code, value) => {
                                        root.orient-option-changed(code, value);
                                    }
                                    option-hovered(i, on) => {
                                        root.orient-option-hovered(i, on);
                                    }
                                    option-picked(i) => {
                                        root.orient-option-picked(i);
                                    }
                                    apply => {
                                        root.orient-apply();
                                    }
                                    close => {
                                        root.orient-close-requested();
                                        mv.focus-viewport();
                                    }
                                    arrange => {
                                        root.arrange-requested(false);
                                    }
                                }
                                if root.workspace-section == WorkspaceSection.Transform: TransformInspector {
                                    objects: root.object-list;
                                    selected-index: root.selected-object-index;
                                    selected-rows: root.selected-object-rows;
                                    selected-count: root.selected-object-count;
                                    needs-repair: root.mesh-needs-repair;
                                    check-note: root.mesh-check-note;
                                    check-text: root.mesh-check-text;
                                    repairing: root.repairing-in-progress;
                                    repair-phase: root.repair-phase;
                                    repair-progress: root.repair-progress;
                                    repair-marks-available: root.repair-marks-available;
                                    repair-marks-shown: root.repair-marks-shown;
                                    overhang-map-on <=> root.overhang-map-on;
                                    overhang-map-limit: root.overhang-map-limit;
                                    overhang-map-toggled(on) => {
                                        root.overhang-map-toggled(on);
                                    }
                                    repair-cancel => {
                                        root.repair-cancel();
                                    }
                                    repair-marks-toggled(on) => {
                                        root.repair-marks-toggled(on);
                                    }
                                    repair-enabled: root.has-scene && !root.loading && !root.slicing-in-progress
                                        && !root.repairing-in-progress;
                                    object-picked(i) => {
                                        root.selected-object-index = i;
                                        root.object-list-selection-changed(i);
                                        mv.focus-viewport();
                                    }
                                    object-toggled(i) => {
                                        root.object-list-toggle(i);
                                        mv.focus-viewport();
                                    }
                                    repair-requested => {
                                        root.repair-requested();
                                    }
                                    selection-valid: root.selection-valid;
                                    size-x: root.selection-size-x;
                                    size-y: root.selection-size-y;
                                    size-z: root.selection-size-z;
                                    model-x: root.selection-model-x;
                                    model-y: root.selection-model-y;
                                    model-z: root.selection-model-z;
                                    tilted: root.selection-tilted;
                                    pos-x: root.selection-pos-x;
                                    pos-y: root.selection-pos-y;
                                    pos-z: root.selection-pos-z;
                                    rot-x: root.selection-rot-x;
                                    rot-y: root.selection-rot-y;
                                    rot-z: root.selection-rot-z;
                                    scale: root.selection-scale;
                                    numeric-edit(code, value) => {
                                        root.numeric-edit(code, value);
                                    }
                                    arrange-enabled: root.has-scene && !root.loading && !root.slicing-in-progress
                                        && !root.repairing-in-progress && !root.arranging;
                                    arranging: root.arranging;
                                    arrange-last-run: root.arrange-last-run;
                                    arrange-gap: root.arrange-gap;
                                    arrange-margin: root.arrange-margin;
                                    arrange-turns: root.arrange-turns;
                                    arrange-shadow-only: root.arrange-shadow-only;
                                    plate-count: root.plate-count;
                                    active-plate: root.active-plate;
                                    active-plate-used: root.active-plate-used;
                                    plate-names: root.plate-names;
                                    can-send: root.has-scene && root.selection-valid;
                                    plate-send(i) => {
                                        root.plate-send-requested(i);
                                    }
                                    plate-add => {
                                        root.plate-add-requested();
                                    }
                                    plate-remove => {
                                        root.plate-remove-requested(false);
                                    }
                                    arrange-filling: root.arrange-filling;
                                    arrange-fill-progress: root.arrange-fill-progress;
                                    arrange-max-copies: root.arrange-max-copies;
                                    arrange-requested(selection) => {
                                        root.arrange-requested(selection);
                                    }
                                    arrange-fill-requested => {
                                        root.arrange-fill-requested();
                                    }
                                    arrange-cancel => {
                                        root.arrange-cancel();
                                    }
                                    arrange-option-changed(code, value) => {
                                        root.arrange-option-changed(code, value);
                                    }
                                    orient-requested => {
                                        if !root.orient-open {
                                            root.orient-toggle-requested();
                                        }
                                    }
                                }
                                if root.workspace-section == WorkspaceSection.Hollow: HollowInspector {
                                    selection-valid: root.selection-valid && !root.loading;
                                    running: root.hollow-running;
                                    phase: root.hollow-phase;
                                    progress: root.hollow-progress;
                                    last-run: root.hollow-last-run;
                                    model-state: root.hollow-model-state;
                                    drain-count: root.hollow-drain-count;
                                    drain-tool-on: root.hollow-drain-tool;
                                    solid-count: root.hollow-solid-count;
                                    lasso-tool-on: root.hollow-lasso-tool;
                                    lasso-tool-toggled => {
                                        root.hollow-lasso-tool = !root.hollow-lasso-tool;
                                    }
                                    remove-last-solid-requested => {
                                        root.hollow-remove-last-solid();
                                    }
                                    clear-solids-requested => {
                                        root.hollow-clear-solids();
                                    }
                                    show-cavity: root.hollow-show-cavity;
                                    show-cavity-toggled(on) => {
                                        root.hollow-show-cavity = on;
                                    }
                                    wall: root.hollow-wall;
                                    recommended-wall: root.hollow-recommended-wall;
                                    voxel: root.hollow-voxel;
                                    fill-index: root.hollow-fill-index;
                                    cell: root.hollow-cell;
                                    beam: root.hollow-beam;
                                    drain-radius: root.hollow-drain-radius;
                                    drain-depth-set: root.hollow-drain-depth-set;
                                    drain-depth: root.hollow-drain-depth;
                                    drain-cone: root.hollow-drain-cone;
                                    drain-inner-radius: root.hollow-drain-inner-radius;
                                    drain-plug: root.hollow-drain-plug;
                                    plug-clearance: root.hollow-plug-clearance;
                                    apply-requested => {
                                        root.hollow-drain-tool = false;
                                        root.hollow-lasso-tool = false;
                                        root.hollow-apply();
                                    }
                                    cancel-requested => {
                                        root.hollow-cancel();
                                    }
                                    restore-requested => {
                                        root.hollow-drain-tool = false;
                                        root.hollow-lasso-tool = false;
                                        root.hollow-restore();
                                    }
                                    clear-drains-requested => {
                                        root.hollow-clear-drains();
                                    }
                                    drain-tool-toggled => {
                                        root.hollow-drain-tool = !root.hollow-drain-tool;
                                    }
                                    option-changed(code, value) => {
                                        root.hollow-option-changed(code, value);
                                    }
                                }
                                if root.workspace-section == WorkspaceSection.Supports: SupportsInspector {
                                    overhang-map-on <=> root.overhang-map-on;
                                    overhang-map-limit: root.overhang-map-limit;
                                    overhang-map-toggled(on) => {
                                        root.overhang-map-toggled(on);
                                    }
                                    has-scene: root.has-scene && !root.loading;
                                    running: root.support-gen-in-progress;
                                    phase: root.support-gen-phase;
                                    progress: root.support-gen-progress;
                                    cancelable: root.support-gen-cancelable;
                                    last-run: root.supports-last-run;
                                    generate-requested => {
                                        root.df-support-requested();
                                    }
                                    cancel-requested => {
                                        root.support-gen-cancel-requested();
                                    }
                                    preset-names: root.support-preset-names;
                                    preset-index: root.support-preset-index;
                                    preset-cards: root.support-preset-cards;
                                    preset-card-index: root.support-preset-card-index;
                                    based-on: root.support-based-on;
                                    preset-revert => {
                                        root.support-preset-revert();
                                    }
                                    shape-scope: root.support-shape-scope;
                                    shape-picture: root.support-shape-picture;
                                    shape-callouts: root.support-shape-callouts;
                                    shape-hot: root.support-shape-hot;
                                    shape-dragged(dx, dy) => {
                                        root.support-shape-dragged(dx, dy);
                                    }
                                    shape-pointed(part) => {
                                        root.support-shape-pointed(part);
                                    }
                                    shape-sizes: root.support-shape-sizes;
                                    shape-size: root.support-shape-size;
                                    shape-size-name: root.support-shape-size-name;
                                    shape-defaults: root.support-shape-defaults;
                                    zone-angle-default: root.support-zone-angle-default;
                                    shape-size-picked(i) => {
                                        root.support-shape-size-picked(i);
                                    }
                                    shape-values: root.support-shape-values;
                                    shape-value(code, v) => {
                                        root.support-shape-value(code, v);
                                    }
                                    zone-rows: root.support-zone-rows;
                                    zone-size-names: root.support-zone-size-names;
                                    zone-angle: root.support-zone-angle;
                                    zone-size(row, k) => {
                                        root.support-zone-size(row, k);
                                    }
                                    zone-spacing(row, v) => {
                                        root.support-zone-spacing(row, v);
                                    }
                                    zone-angle-edited(v) => {
                                        root.support-zone-angle-edited(v);
                                    }
                                    sizing-index: root.support-sizing-index;
                                    density: root.support-density;
                                    angle: root.support-angle;
                                    size-scale: root.support-size-scale;
                                    min-island: root.support-min-island;
                                    coverage: root.support-coverage;
                                    stabilization: root.support-stabilization;
                                    bracing: root.support-bracing;
                                    smooth: root.support-smooth;
                                    raft-index: root.support-raft-index;
                                    raft-thickness: root.support-raft-thickness;
                                    raft-wall: root.support-raft-wall;
                                    zone-summary: root.support-zone-summary;
                                    grid-on: root.support-grid-on;
                                    grid-spacing: root.support-grid-spacing;
                                    grid-hint: root.support-grid-hint;
                                    raft-clash-message: root.support-raft-clash-message;
                                    raft-lift-label: root.support-raft-lift-label;
                                    lift-on-plate: root.support-lift-on-plate;
                                    lift-on-plate-label: root.support-lift-on-plate-label;
                                    lift-on-plate-toggled(on) => {
                                        root.support-lift-on-plate-toggled(on);
                                    }
                                    hide-rafts-under-plate: root.support-hide-rafts-under-plate;
                                    hide-rafts-under-plate-toggled(on) => {
                                        root.support-hide-rafts-under-plate-toggled(on);
                                    }
                                    lines-under-plate: root.support-lines-under-plate;
                                    lines-under-plate-toggled(on) => {
                                        root.support-lines-under-plate-toggled(on);
                                    }
                                    imported-bodies: root.imported-support-bodies;
                                    islands-left: root.support-islands-left;
                                    islands-busy: root.slicing-in-progress || root.review-fixing;
                                    analyze-islands => {
                                        root.support-islands-analyze-requested();
                                    }
                                    go-to-island => {
                                        root.support-islands-go-requested();
                                    }
                                    support-islands => {
                                        root.support-islands-add-requested();
                                    }
                                    remove-imported => {
                                        root.imported-supports-remove-requested();
                                    }
                                    replace-imported => {
                                        root.imported-supports-replace-requested();
                                    }
                                    raft-lift => {
                                        root.support-raft-lift-requested();
                                    }
                                    raft-off => {
                                        root.support-raft-off-requested();
                                    }
                                    raft-ignore => {
                                        root.support-raft-ignore-requested();
                                    }
                                    add-tool-on: root.support-tool == 1;
                                    remove-tool-on: root.support-tool == 2;
                                    page: root.support-page;
                                    page-picked(i) => {
                                        if i == 1 {
                                            root.show-hand-page();
                                        } else {
                                            root.support-page = 0;
                                        }
                                    }
                                    tool: root.support-tool;
                                    tool-picked(tool) => {
                                        root.arm-support-tool(tool == 0 ? root.support-tool : tool);
                                    }
                                    own-presets: root.support-own-presets;
                                    own-preset-index: root.support-own-preset-index;
                                    own-preset-picked(i) => {
                                        root.support-preset-picked(i + root.support-preset-cards.length);
                                    }
                                    share-export => {
                                        root.support-share-export();
                                    }
                                    share-import => {
                                        root.support-share-import();
                                    }
                                    hand-changed: root.support-hand-changed;
                                    hand-reset => {
                                        root.support-hand-reset();
                                    }
                                    remove-mode: root.support-remove-mode;
                                    brush-radius: root.support-brush-radius;
                                    remove-mode-picked(i) => {
                                        root.support-remove-mode = i;
                                    }
                                    tip-size: root.support-tip-size;
                                    tip-label: root.support-tip-label;
                                    add-note: root.support-add-note;
                                    add-note-warns: root.support-add-note-warns;
                                    tip-size-picked(i) => {
                                        root.support-tip-size = i;
                                    }
                                    selection-valid: root.selection-valid;
                                    lift: root.selection-pos-z;
                                    option-changed(code, value) => {
                                        root.support-option-changed(code, value);
                                    }
                                    preset-picked(i) => {
                                        root.support-preset-picked(i);
                                    }
                                    preset-save(name) => {
                                        root.support-preset-save(name);
                                    }
                                    preset-delete => {
                                        root.support-preset-delete();
                                    }
                                    lift-edit(v) => {
                                        root.numeric-edit(2, v);
                                    }
                                    drop-to-plate => {
                                        root.numeric-edit(10, 0);
                                    }
                                }
                                if root.workspace-section == WorkspaceSection.Export: ExportInspector {
                                    format-options: root.slice-print-format-options;
                                    format-current-index <=> root.slice-print-format-current-index;
                                    format-note: root.slice-print-format-note;
                                    export-enabled: root.slice-export-enabled;
                                    plate-count: root.plate-count;
                                    plate-name: root.plate-count > 1 ? root.plate-names[root.active-plate] : "";
                                    busy: root.slicing-in-progress || root.saving-in-progress || root.loading;
                                    has-scene: root.has-scene;
                                    format-picked(i) => {
                                        root.slice-print-format-picked(i);
                                    }
                                    export-printer-file => {
                                        root.slice-export-requested();
                                    }
                                    export-every-plate => {
                                        root.slice-export-every-plate-requested();
                                    }
                                    save-project => {
                                        root.save-requested();
                                    }
                                    export-mesh => {
                                        root.export-as-requested();
                                    }
                                }
                            }
                    }
                        if root.workspace-section == WorkspaceSection.Supports && root.support-page == 0: SupportsFooter {
                            has-scene: root.has-scene && !root.loading;
                            running: root.support-gen-in-progress;
                            phase: root.support-gen-phase;
                            progress: root.support-gen-progress;
                            cancelable: root.support-gen-cancelable;
                            last-run: root.supports-last-run;
                            show-lift: root.support-raft-clash-message == "";
                            lift-on-plate: root.support-lift-on-plate;
                            lift-on-plate-label: root.support-lift-on-plate-label;
                            lift-on-plate-toggled(on) => {
                                root.support-lift-on-plate-toggled(on);
                            }
                            generate-requested => {
                                root.df-support-requested();
                            }
                            cancel-requested => {
                                root.support-gen-cancel-requested();
                            }
                        }
                    }
                }
            }

            // Status bar.
            Rectangle {
                height: Theme.statusbar-height;
                background: Theme.chrome;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 18px;

                    if root.status-notice != "": Text {
                        text: root.status-notice;
                        font-size: Theme.font-xs;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.status-notice == "": Text {
                        text: !root.has-scene ? @tr("Workspace" => "Open or drop a model to start.")
                            : root.workspace-section == WorkspaceSection.Transform ? @tr("Workspace" => "G move · R rotate · S scale, then X / Y / Z to lock an axis. Ctrl snaps, Shift is finer.")
                            : root.drain-misses ? @tr("Workspace" => "A drain here would not reach the cavity: hollowing leaves it out.")
                            : root.workspace-section == WorkspaceSection.Hollow && root.hollow-drain-tool && root.hollow-drain-reach == 3 ? @tr("Workspace" => "Not known yet whether a drain here reaches the cavity: the cavity is not computed.")
                            : root.workspace-section == WorkspaceSection.Hollow && root.hollow-drain-tool && root.hollow-drain-reach == 4 ? @tr("Workspace" => "At its set depth a drain here would reach the far side of the cavity: it is drilled shorter, as drawn.")
                            : root.workspace-section == WorkspaceSection.Hollow && root.hollow-drain-tool ? @tr("Workspace" => "Click the model's surface to drill a drain there, where it shows green: red does not reach the cavity. Undo takes it back.")
                            : root.workspace-section == WorkspaceSection.Hollow && root.hollow-lasso-tool ? @tr("Workspace" => "Drag around what should stay solid: everything behind the curve, through the model, is no longer hollowed. Turn the camera first to choose the side. Esc puts the lasso away.")
                            : root.workspace-section == WorkspaceSection.Hollow ? @tr("Workspace" => "Hollow the selected model to save resin, then place its drains with D.")
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool != 0 && root.support-add-note != "" ? root.support-add-note
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool == 1 ? @tr("Workspace" => "Click the model where a support should touch it; Shift+click hangs it from the nearest support. 1–4 set the tip size. Undo takes it back.")
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool == 2 && root.support-remove-mode == 1 ? @tr("Workspace" => "Click a support to remove it, or paint over supports to remove them; [ ] or the wheel size the brush, B a box. Esc drops it.")
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool == 2 ? @tr("Workspace" => "Click a support to remove it, or drag a box over supports to remove them; B a brush. Esc drops it.")
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool == 3 ? @tr("Workspace" => "Drag a support by its tip over the model; it is routed again where you let go. Esc or a right click drops it.")
                            : root.workspace-section == WorkspaceSection.Supports && root.support-tool == 4 ? @tr("Workspace" => "Click a support where the brace starts, then the support it goes to; it is laid by the preset's bracing rules. Esc or a right click drops the first.")
                            : root.workspace-section == WorkspaceSection.Supports ? @tr("Workspace" => "Generate supports for every model on the plate.")
                            : root.workspace-section == WorkspaceSection.Slice ? @tr("Workspace" => "Drag the layer slider to inspect the slice.")
                            : @tr("Workspace" => "The printer file uses the printer and resin in force.");
                        font-size: Theme.font-xs;
                        color: root.drain-misses
                            || (root.workspace-section == WorkspaceSection.Supports && root.support-tool != 0
                                && root.support-add-note != "" && root.support-add-note-warns)
                            ? Theme.danger : Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.has-scene && root.import-notes != "": TouchArea {
                        width: notes-text.preferred-width;
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: root.import-notes;
                        accessible-action-default => {
                            root.import-notes-requested();
                        }
                        clicked => {
                            root.import-notes-requested();
                        }

                        notes-text := Text {
                            // The glyph is kept out of the translatable string.
                            text: "ℹ " + root.import-notes;
                            font-size: Theme.font-xs;
                            color: Theme.text-soft;
                            vertical-alignment: center;
                        }
                    }
                    if root.has-scene: Text {
                        text: @tr("Workspace" => "{} object(s)", root.object-list.length);
                        font-size: Theme.font-xs;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Compact-layout menu button: a floating chip at the top-left that
    // opens the same menus as the hidden bar. Its items carry no
    // shortcut because Slint only registers accelerators on MenuBar
    // items; the hidden MenuBar keeps the shortcuts working. Behaviour
    // is single-sourced: every item calls the same root callbacks as the
    // bar. Present only in Compact layout, which Rust never selects on
    // macOS.
    if root.menu-layout == MenuLayout.Compact: hamburger := ContextMenuArea {
        x: 8px;
        y: 8px;
        width: 32px;
        height: 28px;

        Menu {
            Menu {
                title: @tr("MenuBar" => "File");

                MenuItem {
                    title: @tr("MenuBar" => "New Window");
                    activated => {
                        root.new-window-requested();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Open project…");
                    enabled: !root.loading;
                    activated => {
                        root.open-file-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Import model…");
                    enabled: !root.loading;
                    activated => {
                        root.import-model-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Close");
                    enabled: root.loading || root.has-scene;
                    activated => {
                        root.close-current-scene();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Clear Scene");
                    enabled: root.loading || root.has-scene;
                    activated => {
                        root.clear-current-scene();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Save");
                    enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                    activated => {
                        root.save-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Save As…");
                    enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                    activated => {
                        root.save-as-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Previous Versions…");
                    enabled: root.has-versions && !root.loading && !root.saving-in-progress;
                    activated => {
                        root.previous-versions-requested();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Export As…");
                    enabled: root.has-scene && !root.loading && !root.saving-in-progress;
                    activated => {
                        root.export-as-requested();
                    }
                }
            }

            Menu {
                title: @tr("MenuBar" => "Edit");

                MenuItem {
                    title: @tr("MenuBar" => "Undo");
                    enabled: root.has-scene && !root.loading && root.can-undo
                    && !root.repairing-in-progress
                    && root.history-allowed;
                    activated => {
                        root.undo-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Redo");
                    enabled: root.has-scene && !root.loading && root.can-redo
                    && !root.repairing-in-progress
                    && root.history-allowed;
                    activated => {
                        root.redo-requested();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Delete");
                    enabled: root.has-scene && !root.loading && root.selected-object-index != -1
                    && (root.workspace-section == WorkspaceSection.Transform
                        || root.workspace-section == WorkspaceSection.Supports);
                    activated => {
                        root.delete-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Split into Bodies");
                    enabled: root.has-scene && !root.loading && root.selected-object-index != -1
                    && root.workspace-section == WorkspaceSection.Transform && !root.repairing-in-progress;
                    activated => {
                        root.split-bodies-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Keep Only This Body");
                    enabled: root.has-scene && !root.loading && root.can-keep-only-body
                    && root.workspace-section == WorkspaceSection.Transform && !root.repairing-in-progress;
                    activated => {
                        root.keep-only-body-requested();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Preferences");
                    activated => {
                        root.show-preferences-requested();
                    }
                }
            }

            Menu {
                title: @tr("MenuBar" => "Tools");

                MenuItem {
                    title: @tr("MenuBar" => "Generate Supports (DragonFruit)…");
                    enabled: root.has-scene && !root.loading && !root.support-gen-in-progress;
                    activated => {
                        root.df-support-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "Generate Support (trivial for test)…");
                    enabled: root.has-scene && !root.loading && !root.support-gen-in-progress;
                    activated => {
                        root.support-gen-requested();
                    }
                }
            }

            Menu {
                title: @tr("MenuBar" => "View");

                MenuItem {
                    title: @tr("LayerView" => "Layer view");
                    checkable: true;
                    checked: root.slice-split;
                    enabled: root.layer-key-on;
                    activated => {
                        root.slice-split = !root.slice-split;
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: root.menu-layout == MenuLayout.Compact
                        ? @tr("MenuBar" => "Show Menu Bar")
                        : @tr("MenuBar" => "Hide Menu Bar");
                    enabled: !root.is-macos;
                    activated => {
                        root.menu-layout-change-requested(
                            root.menu-layout == MenuLayout.Compact
                                ? MenuLayout.Bar
                                : MenuLayout.Compact);
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Fullscreen");
                    checkable: true;
                    checked <=> root.full-screen;
                }
            }

            Menu {
                title: @tr("MenuBar" => "Help");

                MenuItem {
                    title: @tr("MenuBar" => "Documentation");
                    enabled: false;
                }

                MenuItem {
                    title: @tr("MenuBar" => "Show Release Notes");
                    enabled: false;
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Report Issue");
                    enabled: false;
                }

                MenuItem {
                    title: @tr("MenuBar" => "Export Diagnostics…");
                    activated => {
                        root.export-diagnostics-requested();
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "Check for Updates…");
                    enabled: false;
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("MenuBar" => "About");
                    activated => {
                        root.show-about-requested();
                    }
                }

                MenuItem {
                    title: @tr("MenuBar" => "View License");
                    enabled: false;
                }
            }
        }

        Rectangle {
            border-radius: 6px;
            background: #00000055;

            VerticalLayout {
                alignment: center;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 3px;
                Rectangle { height: 2px; background: white; border-radius: 1px; }
                Rectangle { height: 2px; background: white; border-radius: 1px; }
                Rectangle { height: 2px; background: white; border-radius: 1px; }
            }

            TouchArea {
                clicked => {
                    hamburger.show({ x: 0, y: parent.height });
                }
            }
        }
    }

    // Drop-target overlay. Sibling of the main HorizontalLayout above,
    // so it renders on top while drop-hovering is true and disappears
    // otherwise. The Rectangle does not intercept pointer events, so
    // OS-level drag events still reach the window underneath.
    if root.drop-hovering: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.panel.transparentize(0.25);
        border-color: Theme.indicator;
        border-width: 3px;

        Text {
            text: @tr("Drop to open");
            font-size: 1.6rem;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Floating load-progress panel: bottom-centered, visible only
    // while a file load is actually in flight. A plain Rectangle
    // without a TouchArea, so pointer events pass through to the
    // viewport underneath.
    if root.load-in-progress: Rectangle {
        width: Math.max(240px, Math.min(parent.width * 50%, 420px));
        height: progress-panel-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Theme.statusbar-height - 16px;
        background: Theme.panel;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 6px;

        progress-panel-layout := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.load-phase == LoadPhase.ReadingFile
                    ? @tr("Reading file…")
                    : root.load-phase == LoadPhase.PreparingGeometry
                    ? @tr("Preparing geometry…")
                    : @tr("Uploading to GPU…");
                color: Theme.text;
            }

            ProgressIndicator {
                progress: root.load-progress;
            }
        }
    }

    // Floating support generator progress panel: same placement/style as the
    // load panel. `support-gen-phase` is passed straight through from
    // the Rust-side `JobProgress.phase` string rather than mapped
    // through an enum, since it is purely informational here.
    // The Supports tab shows the run in its inspector instead.
    if root.support-gen-in-progress && root.workspace-section != WorkspaceSection.Supports: Rectangle {
        width: Math.max(240px, Math.min(parent.width * 50%, 420px));
        height: support-gen-progress-panel-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Theme.statusbar-height - 16px;
        background: Theme.panel;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 6px;

        support-gen-progress-panel-layout := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.support-gen-phase == ""
                    ? @tr("Generating support structure…")
                    : root.support-gen-phase;
                color: Theme.text;
            }

            ProgressIndicator {
                progress: root.support-gen-progress;
            }

            if root.support-gen-cancelable: Button {
                text: @tr("Cancel");
                clicked => {
                    root.support-gen-cancel-requested();
                }
            }
        }
    }

    // Floating save-progress panel: same placement as the load panel
    // (they never run at once, since saving is disabled while loading
    // and vice versa). A plain Rectangle without a TouchArea, so pointer
    // events pass through to the viewport underneath.
    if root.saving-in-progress: Rectangle {
        width: Math.max(240px, Math.min(parent.width * 50%, 420px));
        height: save-progress-panel-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Theme.statusbar-height - 16px;
        background: Theme.panel;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: 6px;

        save-progress-panel-layout := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.save-phase == SavePhase.Flattening
                    ? @tr("Preparing geometry…")
                    : root.save-phase == SavePhase.Serializing
                    ? @tr("Serializing model…")
                    : root.save-phase == SavePhase.Compressing
                    ? @tr("Compressing…")
                    : @tr("Writing file…");
                color: Theme.text;
            }

            ProgressIndicator {
                progress: root.save-progress;
            }
        }
    }

    // Input-capturing slice modal: a full-window dim that swallows
    // pointer and keyboard events so the scene can't be edited mid-slice,
    // with a centered progress card and a Cancel button. Last child, so
    // it renders on top of everything. Shown only while a slice runs.
    if root.slicing-in-progress: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000cc;

        // Swallow pointer events targeted at the scene underneath.
        TouchArea { }

        // Grab the keyboard: Escape cancels, other keys are swallowed.
        modal-focus := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.slice-cancel-requested();
                }
                return accept;
            }
        }

        Rectangle {
            width: Math.min(parent.width * 60%, 360px);
            height: slice-card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;

            slice-card := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: @tr("SlicePanel" => "Slicing...");
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                if root.slice-fix-pass != "": Text {
                    text: root.slice-fix-pass;
                    color: Theme.text.transparentize(0.3);
                    horizontal-alignment: center;
                }
                Text {
                    text: root.slice-reviewing
                        ? @tr("SlicePanel" => "Checking layers: {} / {}", root.slice-completed, root.slice-total)
                        : root.slice-total > 0
                        ? @tr("SlicePanel" => "{} / {} layers", root.slice-completed, root.slice-total)
                        : @tr("SlicePanel" => "Preparing...");
                    color: Theme.text.transparentize(0.3);
                    horizontal-alignment: center;
                }
                ProgressIndicator {
                    progress: root.slice-progress;
                }
                HorizontalLayout {
                    alignment: center;
                    Button {
                        text: @tr("SlicePanel" => "Cancel");
                        clicked => {
                            root.slice-cancel-requested();
                        }
                    }
                }
            }
        }
    }

    // The start dialog (#381), under the messages: a message that opens
    // while it shows sits over it.
    start-layer := StartLayer {
        width: 100%;
        height: 100%;
        open: root.start-open && !root.loading;
        recent: root.start-recent;
        last-name: root.start-last-name;
        version: root.start-version;
        dont-show <=> root.start-dont-show;
        closed => {
            root.start-open = false;
        }
        reopen-last => {
            root.start-reopen-last();
        }
        open-recent(row) => {
            root.start-open-recent(row);
        }
        remove-recent(row) => {
            root.start-remove-recent(row);
        }
        open-file(kind) => {
            root.start-open-file(kind);
        }
        dont-show-changed(on) => {
            root.start-dont-show-changed(on);
        }
    }

    // A scene in the window, however it came, ends the start dialog.
    changed has-scene => {
        if (root.has-scene) {
            root.start-open = false;
        }
    }
    // So do objects in a scene the person emptied (#397): an undo of the
    // delete, or a model imported into it.
    property <bool> holds-objects: root.has-scene && root.object-list.length > 0;
    changed holds-objects => {
        if (root.holds-objects) {
            root.start-open = false;
        }
    }
    changed start-open => {
        if (!root.start-open) {
            mv.focus-viewport();
        }
    }

    // The hidden field a plate's name is typed in (#545).
    plate-name-scope := FocusScope {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.plate-name-done(false);
                return accept;
            }
            return reject;
        }

        plate-name-input := TextInput {
            width: 1px;
            height: 1px;
            opacity: 0;
            single-line: true;
            text <=> root.plate-name-text;
            edited => {
                root.plate-name-edited(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset);
            }
            cursor-position-changed(point) => {
                root.plate-name-edited(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset);
            }
            // Ctrl+A leaves the caret where it is and moves only the anchor.
            changed anchor-position-byte-offset => {
                root.plate-name-edited(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset);
            }
            accepted => {
                root.plate-name-done(true);
            }
            changed has-focus => {
                if (!self.has-focus) {
                    root.plate-name-done(true);
                }
            }
        }
    }

    ToolTip {
        window-width: root.width;
    }

    if root.support-share-mode != 0: SharePicker {
        width: 100%;
        height: 100%;
        mode: root.support-share-mode;
        items: root.support-share-items;
        picked-count: root.support-share-picked;
        toggled(i, on) => {
            root.support-share-toggled(i, on);
        }
        accepted => {
            root.support-share-accepted();
        }
        cancelled => {
            root.support-share-cancelled();
        }
    }

    // App messages (#133): last, so they sit over everything else.
    MessageLayer {
        width: 100%;
        height: 100%;
        message: root.message;
        open: root.message-open;
        serial: root.message-serial;
        default-heading: root.message-default-heading;
        silence <=> root.message-silence;
        include-models <=> root.message-include-models;
        answered(answer) => {
            root.message-answered(answer);
        }
        outside-clicked => {
            root.message-outside-clicked();
        }
    }

    // A closed message hands the keyboard back to the start dialog when it
    // shows, to the viewport otherwise.
    changed message-open => {
        if (!root.message-open) {
            if (start-layer.visible) {
                start-layer.focus-dialog();
            } else {
                mv.focus-viewport();
            }
        }
    }

    // The window's edges and corners, while it is not maximised: where the
    // app's own frame is resized from (#507).
    if root.custom-chrome && !root.window-maximized: frame := Rectangle {
        property <length> edge: 5px;
        property <length> corner: 10px;

        for side[i] in [
            { x: frame.corner, y: 0px, w: root.width - 2 * frame.corner, h: frame.edge, d: 0, c: MouseCursor.ns-resize },
            { x: frame.corner, y: root.height - frame.edge, w: root.width - 2 * frame.corner, h: frame.edge, d: 1, c: MouseCursor.ns-resize },
            { x: root.width - frame.edge, y: frame.corner, w: frame.edge, h: root.height - 2 * frame.corner, d: 2, c: MouseCursor.ew-resize },
            { x: 0px, y: frame.corner, w: frame.edge, h: root.height - 2 * frame.corner, d: 3, c: MouseCursor.ew-resize },
            { x: root.width - frame.corner, y: 0px, w: frame.corner, h: frame.corner, d: 4, c: MouseCursor.nesw-resize },
            { x: 0px, y: 0px, w: frame.corner, h: frame.corner, d: 5, c: MouseCursor.nwse-resize },
            { x: root.width - frame.corner, y: root.height - frame.corner, w: frame.corner, h: frame.corner, d: 6, c: MouseCursor.nwse-resize },
            { x: 0px, y: root.height - frame.corner, w: frame.corner, h: frame.corner, d: 7, c: MouseCursor.nesw-resize },
        ]: TouchArea {
            x: side.x;
            y: side.y;
            width: side.w;
            height: side.h;
            mouse-cursor: side.c;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.window-resize(side.d);
                }
            }
        }
    }
}
