    out property <string> close: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    // The message cards (#385): export a copy (the import arrow turned
    // up), throw away, and the diagnostics (a pulse).
    out property <string> export: "M12 14.5 L12 3.5 M7.5 8 L12 3.5 L16.5 8 M4 15 L4 20 L20 20 L20 15";
    out property <string> trash: "M4 7 L20 7 M9.5 7 L9.5 4 L14.5 4 L14.5 7 M6 7 L7 20 L17 20 L18 7 M10 11 L10 16.5 M14 11 L14 16.5";
    out property <string> pulse: "M3 12.5 L7.5 12.5 L10 6 L14 19 L16.5 12.5 L21 12.5";
}
