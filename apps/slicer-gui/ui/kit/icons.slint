// Stroke icons for the rail and buttons, as SVG path commands on a 24 x 24
// grid (drawn by `Icon` in controls.slint). Plain geometry, no font.

export global Icons {
    out property <string> logo: "M12 2 L20 6.5 L20 15.5 L12 20 L4 15.5 L4 6.5 Z M12 11 L20 6.5 M12 11 L12 20 M12 11 L4 6.5";
    out property <string> select: "M5 3 L17 11 L12 12.5 L9.5 18 Z";
    out property <string> move: "M12 3 L12 21 M3 12 L21 12 M12 3 L9 6 M12 3 L15 6 M12 21 L9 18 M12 21 L15 18 M3 12 L6 9 M3 12 L6 15 M21 12 L18 9 M21 12 L18 15";
    out property <string> rotate: "M20 12 A8 8 0 1 1 17.7 6.3 M20 4 L20 9 L15 9";
    out property <string> scale: "M4 20 L4 10 L14 10 L14 20 Z M14 10 L20 4 M15 4 L20 4 L20 9";
    out property <string> repair: "M14 6 A4 4 0 0 0 9.5 11.5 L4 17 L7 20 L12.5 14.5 A4 4 0 0 0 18 10 L15.5 12.5 L11.5 8.5 Z";
    out property <string> hollow: "M12 3 A9 9 0 1 0 12.01 3 Z M12 8 A4 4 0 1 0 12.01 8 Z";
    out property <string> hole: "M12 4 A8 8 0 1 0 12.01 4 Z M12 9 L12 15 M9 12 L15 12";
    // A slab on its edge with the way up above it (#182).
    out property <string> brush: "M14 4 L20 10 L11.5 18.5 L5.5 12.5 Z M5.5 12.5 C3 15 4.5 17.5 3 20.5 C6.5 20.5 9 21 11.5 18.5";
    out property <string> orient: "M12 2 L12 9 M9 5 L12 2 L15 5 M4 15 L12 11 L20 15 L12 19 Z M4 15 L4 18 L12 22 L20 18 L20 15 M12 19 L12 22";
    out property <string> auto: "M12 3 L14 8 L19 8.5 L15 12 L16.5 17 L12 14 L7.5 17 L9 12 L5 8.5 L10 8 Z";
    out property <string> supports: "M6 20 L18 20 M8 20 L10 9 M12 20 L12 7 M16 20 L14 9 M10 9 L12 4 L14 9";
    out property <string> add-support: "M12 3 L12 15 M8 19 L16 19 M12 15 L9 19 M12 15 L15 19 M17 6 L21 6 M19 4 L19 8";
    out property <string> move-tip: "M12 9 L12 15 M8 19 L16 19 M12 15 L9 19 M12 15 L15 19 M6 5 L18 5 M8 3 L6 5 L8 7 M16 3 L18 5 L16 7";
    out property <string> remove-support: "M12 3 L12 15 M8 19 L16 19 M12 15 L9 19 M12 15 L15 19 M17 6 L21 6";
    out property <string> brace-supports: "M7 4 L7 20 M17 4 L17 20 M7 17 L17 7 M4 20 L10 20 M14 20 L20 20";
    out property <string> layers: "M12 3 L21 8 L12 13 L3 8 Z M3 13 L12 18 L21 13";
    out property <string> slice: "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18";
    out property <string> file: "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7";
    out property <string> save: "M5 3 L16 3 L20 7 L20 21 L5 21 Z M8 3 L8 9 L15 9 L15 3 M8 21 L8 14 L17 14 L17 21";
    out property <string> printer: "M6 3 L18 3 L18 13 L6 13 Z M8 13 L8 21 L16 21 L16 13";
    out property <string> undo: "M9 14 L4 9 L9 4 M4 9 L15 9 A5 5 0 0 1 15 19 L12 19";
    out property <string> redo: "M15 14 L20 9 L15 4 M20 9 L9 9 A5 5 0 0 0 9 19 L12 19";
    out property <string> menu: "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18";
    out property <string> heart: "M12 20 L4.6 12.6 A4.6 4.6 0 0 1 12 6.8 A4.6 4.6 0 0 1 19.4 12.6 Z";
    // Review severities (#90) and an all-clear tick.
    out property <string> error: "M12 3 A9 9 0 1 0 12.01 3 Z M12 7.5 L12 13 M12 16.5 L12 16.51";
    out property <string> warning: "M12 3.5 L21.5 20 L2.5 20 Z M12 9.5 L12 14 M12 17 L12 17.01";
    out property <string> info: "M12 3 A9 9 0 1 0 12.01 3 Z M12 11 L12 16.5 M12 7.5 L12 7.51";
    out property <string> check: "M5 12.5 L10 17 L19 7";
    out property <string> list: "M8 6 L20 6 M8 12 L20 12 M8 18 L20 18 M4 6 L4.01 6 M4 12 L4.01 12 M4 18 L4.01 18";
    // The start dialog (#381): open a project, import a model, a new scene,
    // reopen the last file (a clock turning back), and close.
    out property <string> folder: "M3 6 L3 19 L21 19 L21 8.5 L11.5 8.5 L9.5 6 Z";
    out property <string> import: "M12 3.5 L12 14.5 M7.5 10 L12 14.5 L16.5 10 M4 15 L4 20 L20 20 L20 15";
