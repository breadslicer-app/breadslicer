import { Theme } from "kit/theme.slint";
import { Palette, ScrollView } from "std-widgets.slint";
import { ScButton as Button, ScLineEdit as LineEdit } from "kit/controls.slint";
import { ThemePreference } from "preferences/appearance.slint";

// One printer of the picker (#151). `index` is its place in the Rust
// catalog, the handle the callbacks carry.
export struct PickPrinter {
    index: int,
    brand: string,
    name: string,
    // "223.6 × 127 × 230 mm" and the file it writes (".azf").
    size: string,
    file: string,
    // A file this build cannot write yet: listed, and said so.
    exports: bool,
    image: image,
    has-image: bool,
    in-use: bool,
    mine: bool,
}

// One entry of the left column: a group or a maker, with its count.
export struct PickNav {
    label: string,
    count: int,
    // Draws a line above it.
    rule: bool,
}

// One resin of the chosen printer.
export struct PickResin {
    index: int,
    brand: string,
    name: string,
    // "2 s" with the printer's own block, "" with none.
    exposure: string,
    calibrated: bool,
}

// One control layout of the first run (#609).
export struct PickLayout {
    name: string,
    summary: string,
}

component NavRow inherits Rectangle {
    in property <PickNav> nav;
    in property <bool> current;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    background: root.current ? Theme.hover : touch.has-hover ? Theme.raised : transparent;

    if root.nav.rule: Rectangle {
        y: -4px;
        height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: 0;
        width: 2px;
        background: root.current ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        Text {
            text: root.nav.label;
            color: root.current ? Theme.text : Theme.text-soft;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.nav.count;
            color: Theme.text-faint;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PrinterTile inherits Rectangle {
    in property <PickPrinter> printer;
    in property <bool> selected;
    callback clicked();
    callback double-clicked();

    border-radius: Theme.radius-lg;
    background: Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    accessible-role: list-item;
    accessible-label: root.printer.brand + " " + root.printer.name;
    accessible-item-selected: root.selected;

    VerticalLayout {
        padding: 9px;
        spacing: 3px;
        Rectangle {
            height: 92px;
            border-radius: Theme.radius;
            background: Theme.well;
            if root.printer.has-image: Image {
                source: root.printer.image;
                height: 84px;
                width: parent.width - 8px;
                image-fit: contain;
            }
            if !root.printer.has-image: Text {
                text: @tr("PrinterPicker" => "NO PICTURE YET");
                font-family: Theme.mono;
                font-size: 9.5px;
                color: Theme.text-faint;
            }
        }
        Text {
            text: root.printer.brand;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            overflow: elide;
        }
        Text {
            text: root.printer.name;
            font-size: Theme.font;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        HorizontalLayout {
            Text {
                text: root.printer.size;
                font-family: Theme.mono;
                font-size: 10px;
                color: Theme.text-soft;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.printer.file;
                font-family: Theme.mono;
                font-size: 10px;
                color: root.printer.exports ? Theme.text-soft : Theme.warning;
            }
        }
    }
    if root.printer.in-use || !root.printer.exports || root.printer.mine: Rectangle {
        x: 8px;
        y: 8px;
        width: tag.preferred-width + 10px;
        height: 16px;
        border-radius: 2px;
        background: root.printer.in-use ? #e2a75022 : #e9c85a1a;
        border-width: 1px;
        border-color: root.printer.in-use ? #e2a75066 : #e9c85a55;
        tag := Text {
            text: root.printer.in-use ? @tr("PrinterPicker" => "IN USE")
                : !root.printer.exports ? @tr("PrinterPicker" => "CAN'T EXPORT YET")
                : @tr("PrinterPicker" => "MINE");
            font-family: Theme.mono;
            font-size: 9px;
            color: root.printer.in-use ? Theme.accent : Theme.warning;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
}

component ResinRowView inherits Rectangle {
    in property <PickResin> resin;
    in property <bool> selected;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.hover : touch.has-hover ? Theme.raised : transparent;
    border-width: root.selected ? 1px : 0;
    border-color: Theme.border-strong;
    accessible-role: list-item;
    accessible-label: root.resin.brand + " " + root.resin.name;
    accessible-item-selected: root.selected;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.resin.brand;
            width: 76px;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.resin.name;
            font-size: Theme.font;
            color: root.resin.calibrated ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.resin.exposure;
            font-family: Theme.mono;
            font-size: Theme.font-xs;
            color: Theme.text-soft;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LayoutCard inherits Rectangle {
    in property <PickLayout> layout;
    in property <bool> selected;
    callback clicked();

    border-radius: Theme.radius-lg;
    background: Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border-soft;
    accessible-role: list-item;
    accessible-label: root.layout.name;
    accessible-item-selected: root.selected;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.layout.name;
            font-size: Theme.font-lg;
            font-weight: 600;
            color: Theme.text;
        }
        Text {
            text: root.layout.summary;
            font-size: Theme.font-sm;
            color: Theme.text-soft;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Printer & resin, in one window (#151), and the first run (#608): what you
// print on, the resin, and in the first run the controls (#609).
export component SetupWindow inherits Window {
    background: Theme.panel;
    title: root.welcome ? @tr("PrinterPicker" => "Welcome to Breadslicer") : @tr("PrinterPicker" => "Printer & resin");
    icon: @image-url("../assets/images/breadslicer.png");
    default-font-family: "Noto Sans";
    preferred-width: 1120px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;

    in-out property <ThemePreference> theme: ThemePreference.System;
    changed theme => {
        Palette.color-scheme =
            (root.theme == ThemePreference.Light) ? ColorScheme.light :
            (root.theme == ThemePreference.Dark) ? ColorScheme.dark :
            ColorScheme.unknown;
    }

    // The first run: three steps, 0 printer, 1 resin, 2 controls.
    in property <bool> welcome;
    in-out property <int> step: 0;

    in property <[PickNav]> nav;
    in-out property <int> current-nav: 0;
    in-out property <string> search;
    in property <[PickPrinter]> printers;
    in property <string> list-title;
    // The printer chosen in the window, `index` -1 for none.
    in property <PickPrinter> chosen: { index: -1 };
    in property <[PickResin]> resins;
    in-out property <int> chosen-resin: -1;
    in property <string> resins-note;
    in property <[PickLayout]> layouts;
    in-out property <int> chosen-layout: 0;

    callback search-edited(string);
    callback nav-picked(int);
    callback printer-picked(int);
    callback resin-picked(int);
    callback layout-picked(int);
    // Use these: the printer and resin chosen become the ones in use.
    callback use-pressed();
    callback add-printer-pressed();
    callback import-pressed();
    callback skip-pressed();

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.skip-pressed();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            if root.welcome: Rectangle {
                height: 40px;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    for label[i] in [
                        @tr("PrinterPicker" => "1  Printer"),
                        @tr("PrinterPicker" => "2  Resin"),
                        @tr("PrinterPicker" => "3  Controls"),
                    ]: Rectangle {
                        Text {
                            text: label + (i < root.step ? "  ✓" : "");
                            font-size: Theme.font;
                            color: i == root.step ? Theme.text : i < root.step ? Theme.text-soft : Theme.text-faint;
                        }
                        Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: i == root.step ? Theme.accent : transparent;
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            if root.welcome && root.step == 2: VerticalLayout {
                padding: 26px;
                spacing: 14px;
                vertical-stretch: 1;
                Text {
                    text: @tr("PrinterPicker" => "How do you like to move around?");
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("PrinterPicker" => "Pick the mouse you already know. Change it later in Preferences.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: stretch;
                    for layout[i] in root.layouts: LayoutCard {
                        width: (parent.width - (root.layouts.length - 1) * 12px) / max(1, root.layouts.length);
                        height: 190px;
                        layout: layout;
                        selected: i == root.chosen-layout;
                        clicked => {
                            root.chosen-layout = i;
                            root.layout-picked(i);
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }

            if !root.welcome || root.step < 2: HorizontalLayout {
                vertical-stretch: 1;

                // Search and groups.
                Rectangle {
                    width: 210px;
                    background: Theme.chrome;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        search-field := LineEdit {
                            placeholder-text: @tr("PrinterPicker" => "Search printers");
                            text <=> root.search;
                            edited(t) => {
                                root.search-edited(t);
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                alignment: start;
                                for nav[i] in root.nav: NavRow {
                                    nav: nav;
                                    current: i == root.current-nav;
                                    clicked => {
                                        root.current-nav = i;
                                        root.nav-picked(i);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        background: Theme.border;
                    }
                }

                // The printers.
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 14px;
                    spacing: 10px;
                    if root.welcome: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: root.step == 0 ? @tr("PrinterPicker" => "What do you print on?") : @tr("PrinterPicker" => "Which resin?");
                            font-size: 20px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: root.step == 0
                                ? @tr("PrinterPicker" => "Pick your printer so the plate, the pixels and the file are right from the first print. You can change it any time.")
                                : @tr("PrinterPicker" => "The resins on the right are set for your printer. Pick the one in the vat.");
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: root.list-title;
                        font-family: Theme.mono;
                        font-size: 10.5px;
                        color: Theme.text-muted;
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        property <int> columns: max(1, floor((self.visible-width + 6px) / 176px));
                        property <length> tile-w: (self.visible-width - 4px - (self.columns - 1) * 10px) / self.columns;
                        viewport-height: ceil(root.printers.length / self.columns) * 186px;
                        for printer[i] in root.printers: PrinterTile {
                            x: mod(i, parent.columns) * (parent.tile-w + 10px);
                            y: floor(i / parent.columns) * 186px;
                            width: parent.tile-w;
                            height: 176px;
                            printer: printer;
                            selected: printer.index == root.chosen.index;
                            clicked => {
                                root.printer-picked(printer.index);
                            }
                            double-clicked => {
                                root.printer-picked(printer.index);
                                if !root.welcome {
                                    root.use-pressed();
                                }
                            }
                        }
                    }
                }

                // The printer chosen and its resins.
                Rectangle {
                    width: 330px;
                    background: Theme.chrome;
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        if root.chosen.index >= 0: Rectangle {
                            height: 140px;
                            border-radius: Theme.radius;
                            background: Theme.well;
                            if root.chosen.has-image: Image {
                                source: root.chosen.image;
                                height: 130px;
                                width: parent.width - 10px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: root.chosen.index >= 0 ? root.chosen.name : @tr("PrinterPicker" => "Pick a printer");
                            font-size: 16px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                        if root.chosen.index >= 0: Text {
                            text: root.chosen.brand + "  ·  " + root.chosen.size + "  ·  " + root.chosen.file;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.chosen.index >= 0 && !root.chosen.exports: Text {
                            text: @tr("PrinterPicker" => "This build cannot write this printer's file yet: you can prepare a project, not export it.");
                            font-size: Theme.font-sm;
                            color: Theme.warning;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        Text {
                            text: @tr("PrinterPicker" => "RESIN");
                            font-family: Theme.mono;
                            font-size: 10.5px;
                            color: Theme.text-muted;
                        }
                        if root.resins-note != "": Text {
                            text: root.resins-note;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for resin[i] in root.resins: ResinRowView {
                                    resin: resin;
                                    selected: resin.index == root.chosen-resin;
                                    clicked => {
                                        root.chosen-resin = resin.index;
                                        root.resin-picked(resin.index);
                                    }
                                }
                            }
                        }
                        Button {
                            text: @tr("PrinterPicker" => "Import my resins…");
                            clicked => {
                                root.import-pressed();
                            }
                        }
                    }
                }
            }

            // The foot.
            Rectangle {
                height: 52px;
                background: Theme.chrome;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: stretch;
                    if !root.welcome || root.step == 0: Button {
                        text: @tr("PrinterPicker" => "Add a printer…");
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.add-printer-pressed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if root.welcome && root.step > 0: Button {
                        text: @tr("PrinterPicker" => "← Back");
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.step = root.step - 1;
                        }
                    }
                    Button {
                        text: root.welcome ? @tr("PrinterPicker" => "Skip for now") : @tr("PrinterPicker" => "Cancel");
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.skip-pressed();
                        }
                    }
                    Button {
                        primary: true;
                        y: (parent.height - self.height) / 2;
                        enabled: root.chosen.index >= 0 && (root.step != 1 || root.chosen-resin >= 0 || root.resins.length == 0);
                        text: !root.welcome ? @tr("PrinterPicker" => "Use these")
                            : root.step == 0 ? @tr("PrinterPicker" => "Next: resin →")
                            : root.step == 1 ? @tr("PrinterPicker" => "Next: controls →")
                            : @tr("PrinterPicker" => "Start printing");
                        clicked => {
                            if root.welcome && root.step < 2 {
                                root.step = root.step + 1;
                            } else {
                                root.use-pressed();
                            }
                        }
                    }
                }
            }
        }
    }
}
