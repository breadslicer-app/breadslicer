# Corpus hashes identify exact file bytes on every checkout (including STL ASCII/OBJ).

# Archived SC-14 evidence is byte-identified; preserve it on every platform.
docs/sc/evidence/sc14/** -text

# Captured support checkpoints and logs keep their recorded byte hashes.
docs/sc/evidence/manual-v1/** -text

# Exact attributed DF kernel/license bytes are checked against UPSTREAM.json.
libs/sc-geom/support-need-analysis/src/df/*.rs -text
# This exact upstream file has a final blank line; retain it, do not reformat.
libs/sc-geom/support-need-analysis/src/df/tracker.rs whitespace=-blank-at-eof
libs/sc-geom/support-need-analysis/COPYING -text
libs/sc-geom/support-need-analysis/upstream/*.rs -text

# Raw compiler/test/benchmark stdout retains original bytes and final blank line.
docs/sc/evidence/supports-p1-analysis/*.log -text whitespace=-blank-at-eof,cr-at-eol
# Rust test stdout can end a progress line in spaces before concurrent output.
docs/sc/evidence/supports-wolverine-query/*.log -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol

# Bundled profiles are checked byte-for-byte against the profile writer's
# LF output; keep them LF on every checkout (binaries stay auto-detected).
assets/profiles/** text=auto eol=lf
# .bread files are binary: a line-ending change breaks them.
*.bread binary
