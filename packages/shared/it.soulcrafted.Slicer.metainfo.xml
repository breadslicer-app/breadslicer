  <name>SoulCrafted Slicer</name>
  <summary>Open Source Community-Driven Slicer for Resin 3D Printers</summary>
  <description>
    <p>
      The SoulCrafted Slicer is a community-driven, open source slicer for
      resin (SLA) 3D printers. It loads 3D models, prepares them on the build
      plate, and produces the per-layer data that resin printers consume.
    </p>
  </description>
  <launchable type="desktop-id">it.soulcrafted.Slicer.desktop</launchable>
  <provides>
    <mediatype>model/stl</mediatype>
    <mediatype>model/obj</mediatype>
  </provides>
